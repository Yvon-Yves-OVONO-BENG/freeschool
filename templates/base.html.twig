		<!---Global-loader-->
		<div id="global-loader" >
			<img src="{{ asset ('build/custom2/images/svgs/loader3.svg')}}" alt="loader" style="width: 74px; height: 74px;">
		</div>

		<script>
			(function () {
				'use strict';

				var loader = document.getElementById('global-loader');
				var hidden = false;

				function hideGlobalLoader() {
					if (!loader || hidden) return;
					hidden = true;
					loader.classList.add('fs-global-loader--hidden');
					loader.setAttribute('aria-hidden', 'true');
					window.setTimeout(function () {
						if (loader) loader.style.display = 'none';
					}, 220);
				}

				window.fsHideGlobalLoader = hideGlobalLoader;
				document.addEventListener('DOMContentLoaded', hideGlobalLoader, { once: true });
				window.addEventListener('load', hideGlobalLoader, { once: true });
				window.addEventListener('pageshow', hideGlobalLoader);

				/* Garde-fou : même si une ressource externe répond lentement, le contenu
				   devient accessible rapidement et les scripts continuent de charger. */
				window.setTimeout(hideGlobalLoader, 850);
			})();
		</script>

