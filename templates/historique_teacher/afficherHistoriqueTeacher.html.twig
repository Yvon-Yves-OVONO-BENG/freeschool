{% extends 'base.html.twig' %}

{% block title %}{% trans %}Display Teacher History{% endtrans %}{% endblock %}

{% block infoMessage %}
	{% include "includes/_info_message.html.twig" %}
{% endblock %}

{% block stylesheets %}
	{{ parent() }}
	<link rel="stylesheet" href="{{ asset('build/custom/css/freeschool-teacher-attendance-history-premium.css') }}">
{% endblock %}

{% block body %}
	<div class="hor-content main-content fs-th-page">
		<div class="container">
			<div class="fs-th-menu-safe-space" aria-hidden="true"></div>

			<section class="fs-th-hero">
				<div class="fs-th-hero__content">
					<div>
						<span class="fs-th-eyebrow">
							<i class="fa fa-paper-plane"></i>
							{% trans %}Teacher attendance workspace{% endtrans %}
						</span>

						<h1 class="fs-th-title">
							{% trans %}HOURS TEACHER'S MANAGMENT{% endtrans %}
						</h1>

						<p class="fs-th-subtitle">
							{% trans %}Manage, filter, print and review teacher attendance hours with a refined, responsive and dynamic premium interface.{% endtrans %}
						</p>
					</div>

					<div class="fs-th-hero__actions">
						<div class="fs-th-hero-stat">
							<span class="fs-th-hero-stat__icon">
								<i class="fe fe-list"></i>
							</span>
							<span class="fs-th-hero-stat__label">{% trans %}Registered{% endtrans %}</span>
							<strong class="fs-th-hero-stat__value">{{ historiqueTeachers|length }}</strong>
						</div>

						<a href="{{ path ('print_historic_teacher', {'all': 1 }) }}" target="_blank" class="fs-th-btn fs-th-btn--light">
							<i class="fe fe-printer"></i>
							<span>{% trans %}Print all attendance{% endtrans %}</span>
						</a>

						<a href="" class="fs-th-btn fs-th-btn--light">
							<i class="fe fe-plus-circle"></i>
							<span>{% trans %}Add attendance{% endtrans %}</span>
						</a>
					</div>
				</div>
			</section>

			<section class="fs-th-filter-card">
				<div class="fs-th-filter-card__header">
					<div>
						<span class="fs-th-chip">
							<i class="fe fe-filter"></i>
							{% trans %}Period filter{% endtrans %}
						</span>

						<h2>{% trans %}Filter attendance by period{% endtrans %}</h2>

						<p>{% trans %}Choose a start date and an end date to display or print attendance for a specific period.{% endtrans %}</p>
					</div>
				</div>

				<form method="post" action="{{ path ('print_historic_teacher', {'periode': 1 }) }}" class="fs-th-filter-form needs-validation" novalidate target="_blank" data-no-spinner="1">
					<div class="fs-floating-field fs-required-field">
						<input type="date" name="dateDebut" class="form-control fs-floating-control" id="dateDebut" required>

						<label class="fs-floating-label" for="dateDebut">
							<i class="fe fe-calendar"></i>
							{% trans %}Start date{% endtrans %}
						</label>

						<div class="invalid-feedback">
							{% trans %}Required field{% endtrans %}
						</div>
					</div>

					<div class="fs-floating-field fs-required-field">
						<input type="date" name="dateFin" class="form-control fs-floating-control" id="dateFin" required>

						<label class="fs-floating-label" for="dateFin">
							<i class="fe fe-calendar"></i>
							{% trans %}End date{% endtrans %}
						</label>

						<div class="invalid-feedback">
							{% trans %}Required field{% endtrans %}
						</div>
					</div>

					<div class="fs-th-filter-form__actions">
						<button class="fs-th-btn fs-th-btn--primary fs-th-submit-btn" type="submit" name="impressionFicheVente">
							<i class="fa fa-eye fs-th-submit-icon"></i>
							<span>{% trans %}Display{% endtrans %}</span>
						</button>
					</div>
				</form>
			</section>

			<section class="fs-th-card">
				<div class="fs-th-card__header">
					<div>
						<span class="fs-th-chip fs-th-chip--soft">
							<i class="fe fe-grid"></i>
							{% trans %}Dynamic table{% endtrans %}
						</span>

						<h2>{% trans %}Teacher attendance history{% endtrans %}</h2>
					</div>

					<div class="fs-th-card__actions">
						<div class="fs-th-search">
							<i class="fe fe-search"></i>
							<input type="text" class="fs-th-search-input" placeholder="{% trans %}Search teacher, classroom, subject...{% endtrans %}">
						</div>
					</div>
				</div>

				<div class="fs-th-table-wrap">
					<table class="table fs-th-table fs-th-dynamic-table" id="fsTeacherHistoryTable">
						<thead>
							<tr>
								<th>
									<button type="button" class="fs-th-sort" data-sort-index="0">
										<span>{% trans %}Teacher{% endtrans %}</span>
										<i class="fe fe-chevron-down"></i>
									</button>
								</th>
								<th>
									<button type="button" class="fs-th-sort" data-sort-index="1">
										<span>{% trans %}Classroom{% endtrans %}</span>
										<i class="fe fe-chevron-down"></i>
									</button>
								</th>
								<th>
									<button type="button" class="fs-th-sort" data-sort-index="2">
										<span>{% trans %}Day{% endtrans %}</span>
										<i class="fe fe-chevron-down"></i>
									</button>
								</th>
								<th>
									<button type="button" class="fs-th-sort" data-sort-index="3">
										<span>{% trans %}Sequence{% endtrans %}</span>
										<i class="fe fe-chevron-down"></i>
									</button>
								</th>
								<th>
									<button type="button" class="fs-th-sort" data-sort-index="4">
										<span>{% trans %}Range{% endtrans %}</span>
										<i class="fe fe-chevron-down"></i>
									</button>
								</th>
								<th>
									<button type="button" class="fs-th-sort" data-sort-index="5">
										<span>{% trans %}Number hours{% endtrans %}</span>
										<i class="fe fe-chevron-down"></i>
									</button>
								</th>
								<th>
									<button type="button" class="fs-th-sort" data-sort-index="6">
										<span>{% trans %}Subject{% endtrans %}</span>
										<i class="fe fe-chevron-down"></i>
									</button>
								</th>

								{% if mySession.get('verrou').verrou is not null and mySession.get('verrou').verrou == 0 %}
									<th>{% trans %}Actions{% endtrans %}</th>
								{% endif %}
							</tr>
						</thead>

						<tbody>
							{% for historiqueTeacher in historiqueTeachers %}
								<tr>
									<td data-label="{% trans %}Teacher{% endtrans %}">
										<div class="fs-th-teacher-cell">
											<span class="fs-th-avatar">{{ historiqueTeacher.teacher.fullName|slice(0, 1)|upper }}</span>
											<div>
												<strong>{{ historiqueTeacher.teacher.fullName }}</strong>
												<span>
													<i class="fe fe-user-check"></i>
													{% trans %}Teacher{% endtrans %}
												</span>
											</div>
										</div>
									</td>

									<td data-label="{% trans %}Classroom{% endtrans %}">
										<span class="fs-th-pill">{{ historiqueTeacher.classroom.classroom }}</span>
									</td>

									<td data-label="{% trans %}Day{% endtrans %}">
										<span class="fs-th-pill fs-th-pill--cyan">{{ historiqueTeacher.day.day }}</span>
									</td>

									<td data-label="{% trans %}Sequence{% endtrans %}">
										<span class="fs-th-pill fs-th-pill--violet">{{ historiqueTeacher.sequence.sequence }}</span>
									</td>

									<td data-label="{% trans %}Range{% endtrans %}">
										<div class="fs-th-time-cell">
											<strong>{{ historiqueTeacher.heureDebut }} - {{ historiqueTeacher.heureFin }}</strong>
											<small>{% trans %}On{% endtrans %} : {{ historiqueTeacher.enregistreLeAt|date('d-m-Y') }}</small>
										</div>
									</td>

									<td data-label="{% trans %}Number hours{% endtrans %}">
										<span class="fs-th-hours">{{ historiqueTeacher.nombreHeure }}</span>
									</td>

									<td data-label="{% trans %}Subject{% endtrans %}">
										<span class="fs-th-subject">{{ historiqueTeacher.subject.subject }}</span>
									</td>

									{% if is_granted('ROLE_ADMIN') or is_granted ('ROLE_SUPER_ADMIN') or is_granted('ROLE_PROVISEUR') or is_granted('ROLE_SURVEILLANT_GENERAL') %}
										{% if mySession.get('verrou').verrou is not null and mySession.get('verrou').verrou == 0 %}
											<td data-label="{% trans %}Actions{% endtrans %}" class="fs-th-actions">
												<a href="{{ path('modifier_historique_teacher', {'slug': historiqueTeacher.slug}) }}" class="fs-th-icon-btn fs-th-icon-btn--primary" name="historiqueTeacherToUpdate" data-bs-toggle="tooltip" title="{% trans %}Edit the teacher history for {{ historiqueTeacher.teacher.fullName }}{% endtrans %}">
													<i class="fa fa-pencil"></i>
												</a>

												<a class="fs-th-icon-btn fs-th-icon-btn--danger" href="javascript:void(0);"
													onclick="swal({
														'title': '{% trans %}Warning !{% endtrans %}',
														'type': 'warning',
														'text': '{% trans %}Do you want to delete this hours ?{% endtrans %}',
														'showCancelButton': true,
														'confirmButtonText': '{% trans %}Yes{% endtrans %}',
														'confirmButtonColor': '#f00',
														'cancelButtonText': '{% trans %}No{% endtrans %}',
														'cancelButtonColor': '#186106',
														'confirmButtonPath': '{{ path('supprimer_historique_teacher', {'slug': historiqueTeacher.slug}) }} '});">
													<i class="fa fa-trash"></i>
												</a>
											</td>
										{% endif %}
									{% endif %}
								</tr>
							{% else %}
								<tr>
									<td colspan="{% if mySession.get('verrou').verrou is not null and mySession.get('verrou').verrou == 0 %}8{% else %}7{% endif %}">
										<div class="fs-th-empty">
											<i class="fe fe-folder"></i>
											<strong>{% trans %}No attendance found{% endtrans %}</strong>
											<span>{% trans %}No teacher attendance history is available yet.{% endtrans %}</span>
										</div>
									</td>
								</tr>
							{% endfor %}
						</tbody>
					</table>
				</div>

				<div class="fs-th-table-footer">
					<div class="fs-th-result-count"></div>

					<div class="fs-th-footer-controls">
						<label class="fs-th-page-size">
							<span>{% trans %}Rows{% endtrans %}</span>
							<select class="fs-th-rows-per-page">
								<option value="5">5</option>
								<option value="10" selected>10</option>
								<option value="25">25</option>
								<option value="50">50</option>
							</select>
						</label>

						<div class="fs-th-pagination" aria-label="{% trans %}Pagination{% endtrans %}"></div>
					</div>
				</div>
			</section>
		</div>
	</div>
{% endblock %}

{% block javascripts %}
	{{ parent() }}
	<script src="{{ asset('build/custom/js/freeschool-teacher-attendance-history-premium.js') }}"></script>
{% endblock %}
