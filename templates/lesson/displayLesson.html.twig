{% extends 'base.html.twig' %}

{% block title %}{% trans %}Display Lesson{% endtrans %}{% endblock %}

{% block subTitle %}
	{% trans %}LESSONS MANAGMENT{% endtrans %}
{% endblock %}

{% block infoMessage %}
	{% include "includes/_info_message.html.twig" %}
{% endblock %}

{% block stylesheets %}
	{{ parent() }}
	<link rel="stylesheet" href="{{ asset('build/custom/css/freeschool-lesson-display-premium.css') }}">
{% endblock %}

{% block body %}
	{% set canManageLessons = false %}
	{% if is_granted('ROLE_ADMIN') or is_granted ('ROLE_SUPER_ADMIN') or is_granted('ROLE_PROVISEUR') or is_granted('ROLE_CENSEUR') %}
		{% if mySession.get('verrou').verrou is not null and mySession.get('verrou').verrou == 0 %}
			{% set canManageLessons = true %}
		{% endif %}
	{% endif %}

	{% set canDeleteLessons = false %}
	{% if is_granted('ROLE_ADMIN') or is_granted ('ROLE_SUPER_ADMIN') or is_granted('ROLE_PROVISEUR') %}
		{% if mySession.get('verrou').verrou is not null and mySession.get('verrou').verrou == 0 %}
			{% set canDeleteLessons = true %}
		{% endif %}
	{% endif %}

	<div class="hor-content main-content fs-lesson-page">
		<div class="container">
			<div class="fs-lesson-menu-safe-space" aria-hidden="true"></div>

			<section class="fs-lesson-hero">
				<div class="fs-lesson-hero__content">
					<div>
						<span class="fs-lesson-eyebrow">
							<i class="fe fe-briefcase"></i>
							{% trans %}Teaching workspace{% endtrans %}
						</span>

						<h1 class="fs-lesson-title">{% trans %}LESSONS MANAGMENT{% endtrans %}</h1>

						<p class="fs-lesson-subtitle">
							{% trans %}Select a classroom, review lessons, teachers, coefficients and weekly hours through a premium workspace.{% endtrans %}
						</p>
					</div>

					<div class="fs-lesson-hero__right">
						{% if methodIsPost %}
							<div class="fs-lesson-hero-stat">
								<span class="fs-lesson-hero-stat__icon"><i class="fe fe-home"></i></span>
								<span class="fs-lesson-hero-stat__label">{% trans %}Classroom{% endtrans %}</span>
								<strong class="fs-lesson-hero-stat__value fs-lesson-hero-stat__value--small">{{ selectedClassroom.classroom }}</strong>
							</div>

							<div class="fs-lesson-hero-stat">
								<span class="fs-lesson-hero-stat__icon"><i class="fe fe-users"></i></span>
								<span class="fs-lesson-hero-stat__label">{% trans %}Students{% endtrans %}</span>
								<strong class="fs-lesson-hero-stat__value">{{ selectedClassroom.students|length }}</strong>
							</div>
						{% endif %}

						{% if canManageLessons %}
							<form action="{{ path('lesson_saveLesson') }}" method="post" class="fs-lesson-inline-form">
								<button type="submit" class="fs-lesson-btn fs-lesson-btn--hero-add" name="addLesson">
									<i class="fe fe-plus"></i>
									<span>{% trans %}Add new lesson{% endtrans %}</span>
								</button>
							</form>
						{% endif %}
					</div>
				</div>
			</section>

			<section class="fs-lesson-filter-card">
				<div class="fs-lesson-filter-card__header">
					<div>
						<span class="fs-lesson-card-badge">
							<i class="fe fe-filter"></i>
							{% trans %}Classroom filter{% endtrans %}
						</span>
						<h2 class="fs-lesson-card-title">{% trans %}Choose classroom{% endtrans %}</h2>
					</div>

					{% if methodIsPost %}
						<div class="fs-lesson-mini-stats">
							<span>
								<i class="fe fe-book"></i>
								{% trans %}Number of lessons{% endtrans %}
								<b>{{ lessons|length }}</b>
							</span>

							<a href="{{ path('print_lesson_classroom', {'slug': selectedClassroom.slug }) }}" class="fs-lesson-btn fs-lesson-btn--ghost" target="_blank">
								<i class="fe fe-printer"></i>
								<span>{% trans %}Print{% endtrans %}</span>
							</a>
						</div>
					{% endif %}
				</div>

				<div class="fs-lesson-filter-card__body">
					<form action="{{ path('lesson_displayLesson') }}" method="post" class="fs-lesson-filter-form needs-validation" novalidate>
						<div class="fs-select-field">
							<label class="fs-select-label">{% trans %}Classroom{% endtrans %}</label>
							<select class="form-control select2-show-search fs-select-control" data-placeholder="{% trans %}Choose a classroom{% endtrans %}" name="classroom" id="classroom" required>
								<option value="" label="{% trans %}Choose a classroom{% endtrans %}">
									{% trans %}Choose classroom{% endtrans %}
								</option>
								{% if subSystem == 'Francophone / French Speaker' %}
									{% if school.education.education == 'Général' %}
										{% include "includes/_selectClassrooms.html.twig" %}
									{% else %}
										{% include "includes/_selectClassroomsTech.html.twig" %}
									{% endif %}
								{% else %}
									{% include "includes/_selectClassroomsEn.html.twig" %}
								{% endif %}
							</select>
							<div class="invalid-feedback">{% trans %}Please choose a classroom !{% endtrans %}</div>
						</div>

						<button class="fs-lesson-btn fs-lesson-btn--primary" type="submit" name="displayStudents">
							<i class="fe fe-eye"></i>
							<span>{% trans %}Display{% endtrans %}</span>
						</button>
					</form>
				</div>
			</section>

			{% if methodIsPost %}
				<section class="fs-lesson-card">
					<div class="fs-lesson-card__header">
						<div>
							<span class="fs-lesson-card-badge">
								<i class="fe fe-list"></i>
								{% trans %}Dynamic table{% endtrans %}
							</span>

							<h2 class="fs-lesson-card-title">
								{% trans %}Registered lessons{% endtrans %}
								<span>{{ selectedClassroom.classroom }}</span>
							</h2>
						</div>

						<div class="fs-lesson-table-tools">
							<div class="fs-lesson-search">
								<i class="fe fe-search"></i>
								<input type="text" id="fsLessonSearch" placeholder="{% trans %}Search lesson...{% endtrans %}">
							</div>

							<button type="button" class="fs-lesson-btn fs-lesson-btn--ghost" id="fsLessonPrint">
								<i class="fe fe-printer"></i>
								<span>{% trans %}Print{% endtrans %}</span>
							</button>
						</div>
					</div>

					<div class="fs-lesson-table-wrap">
						<table class="table fs-lesson-table" id="fsLessonTable">
							<thead>
								<tr>
									<th>
										<button type="button" class="fs-lesson-sort" data-sort-index="0">
											<span>{% trans %}Subject{% endtrans %}</span>
											<i class="fe fe-chevron-down"></i>
										</button>
									</th>
									<th class="text-center">
										<button type="button" class="fs-lesson-sort" data-sort-index="1">
											<span>{% trans %}Coefficient{% endtrans %}</span>
											<i class="fe fe-chevron-down"></i>
										</button>
									</th>
									<th>
										<button type="button" class="fs-lesson-sort" data-sort-index="2">
											<span>{% trans %}Group{% endtrans %}</span>
											<i class="fe fe-chevron-down"></i>
										</button>
									</th>
									<th>
										<button type="button" class="fs-lesson-sort" data-sort-index="3">
											<span>{% trans %}Teacher{% endtrans %}</span>
											<i class="fe fe-chevron-down"></i>
										</button>
									</th>
									<th class="text-center">
										<button type="button" class="fs-lesson-sort" data-sort-index="4">
											<span>{% trans %}Hours per week{% endtrans %}</span>
											<i class="fe fe-chevron-down"></i>
										</button>
									</th>
									{% if canDeleteLessons %}
										<th class="text-center">{% trans %}Actions{% endtrans %}</th>
									{% endif %}
								</tr>
							</thead>

							<tbody>
								{% for lesson in lessons %}
									<tr>
										<td data-label="{% trans %}Subject{% endtrans %}">
											<div class="fs-lesson-subject-cell">
												<span class="fs-lesson-icon"><i class="fe fe-book-open"></i></span>
												<strong>{{ lesson.subject.subject }}</strong>
											</div>
										</td>

										<td class="text-center" data-label="{% trans %}Coefficient{% endtrans %}">
											<span class="fs-lesson-number-pill">{{ lesson.coefficient }}</span>
										</td>

										<td data-label="{% trans %}Group{% endtrans %}">
											<span class="fs-lesson-pill fs-lesson-pill--primary">
												<i class="fe fe-layers"></i>
												{{ lesson.subject.category.category }}
											</span>
										</td>

										<td data-label="{% trans %}Teacher{% endtrans %}">
											<div class="fs-lesson-teacher-cell">
												<span class="fs-lesson-avatar">{{ lesson.teacher.fullName|slice(0, 1)|upper }}</span>
												<div>
													<strong>{{ lesson.teacher.fullName }}</strong>
													<span>{% trans %}Teacher{% endtrans %}</span>
												</div>
											</div>
										</td>

										<td class="text-center" data-label="{% trans %}Hours per week{% endtrans %}">
											<span class="fs-lesson-pill fs-lesson-pill--danger">{{ lesson.weekHours }}</span>
										</td>

										{% if canDeleteLessons %}
											<td class="text-center" data-label="{% trans %}Actions{% endtrans %}">
												<div class="fs-lesson-actions">
													<form action="{{ path('lesson_editLesson', {'slug': lesson.slug}) }}" method="post" class="fs-lesson-action-form">
														<button type="submit" class="fs-lesson-action fs-lesson-action--edit" name="updateLesson" data-bs-toggle="tooltip" title="{% trans %}Edit the course {{ lesson.subject.subject }} in {{ selectedClassroom.classroom }}{% endtrans %}">
															<i class="fe fe-edit"></i>
															<span>{% trans %}Edit{% endtrans %}</span>
														</button>
													</form>

													{% if lesson.evaluations|length > 0 %}
														<a class="fs-lesson-action fs-lesson-action--delete" href="javascript:void(0);"
															onclick="swal({
																'title': '{% trans %}Danger{% endtrans %}',
																'text': '{% trans %}Delete denied. This lesson have evaluations !{% endtrans %}',
																'type': 'error',
																'showCancelButton': true,
																'showConfirmButton': false,
																'confirmButtonText': false,
																'cancelButtonText': 'OK',
																'cancelButtonColor': '#088318'
															})">
															<i class="fe fe-trash"></i>
															<span>{% trans %}Delete{% endtrans %}</span>
														</a>
													{% else %}
														<a class="fs-lesson-action fs-lesson-action--delete" href="javascript:void(0);"
															onclick="swal({
																'title': '{% trans %}Warning !{% endtrans %}',
																'type': 'warning',
																'text': '{% trans %}Do you want to delete this lesson ?{% endtrans %}',
																'showCancelButton': true,
																'confirmButtonText': '{% trans %}Yes{% endtrans %}',
																'confirmButtonColor': '#f00',
																'cancelButtonText': '{% trans %}No{% endtrans %}',
																'cancelButtonColor': '#186106',
																'confirmButtonPath': '{{ path('lesson_deleteLesson', {'slug': lesson.slug}) }} '});">
															<i class="fe fe-trash"></i>
															<span>{% trans %}Delete{% endtrans %}</span>
														</a>
													{% endif %}
												</div>
											</td>
										{% endif %}
									</tr>
								{% else %}
									<tr>
										<td colspan="{% if canDeleteLessons %}6{% else %}5{% endif %}">
											<div class="fs-lesson-empty">
												<i class="fe fe-folder"></i>
												<strong>{% trans %}No lesson found{% endtrans %}</strong>
												<span>{% trans %}Add a new lesson for this classroom.{% endtrans %}</span>
											</div>
										</td>
									</tr>
								{% endfor %}
							</tbody>
						</table>
					</div>

					<div class="fs-lesson-table-footer">
						<div class="fs-lesson-table-footer__left">
							<span id="fsLessonResultCount"></span>
						</div>

						<div class="fs-lesson-footer-controls">
							<label class="fs-lesson-page-size">
								<span>{% trans %}Rows{% endtrans %}</span>
								<select id="fsLessonRowsPerPage">
									<option value="5">5</option>
									<option value="10" selected>10</option>
									<option value="25">25</option>
									<option value="50">50</option>
								</select>
							</label>

							<div class="fs-lesson-pagination" id="fsLessonPagination" aria-label="{% trans %}Pagination{% endtrans %}"></div>
						</div>
					</div>
				</section>
			{% endif %}
		</div>
	</div>
{% endblock %}

{% block javascripts %}
	{{ parent() }}
	<script src="{{ asset('build/custom/js/freeschool-lesson-display-premium.js') }}"></script>
{% endblock %}
