{% extends 'base.html.twig' %}

{% block title %} {% trans %}Details evaluations of{% endtrans %} {{ student.fullName }}{% endblock %}

{% block stylesheets %}
	{{ parent() }}
	<link rel="stylesheet" href="{{ asset('build/custom/css/freeschool-evaluation-details-student-premium.css') }}">
{% endblock %}

{% block body %}
	<div class="hor-content main-content fs-eval-details-page">
		<div class="container">
			<div class="fs-eval-details-menu-safe-space" aria-hidden="true"></div>

			<section class="fs-eval-details-hero">
				<div class="fs-eval-details-hero__content">
					<div>
						<span class="fs-eval-details-eyebrow">
							<i class="fe fe-edit"></i>
							{% trans %}Evaluation details workspace{% endtrans %}
						</span>

						<h1 class="fs-eval-details-title">
							{% trans %}Details evaluations of{% endtrans %} {{ student.fullName }}
						</h1>

						<p class="fs-eval-details-subtitle">
							{% trans %}Review, correct and reconstruct student evaluation marks with a refined premium interface.{% endtrans %}
						</p>
					</div>

					<div class="fs-eval-details-hero__actions">
						<div class="fs-eval-details-hero-stat">
							<span class="fs-eval-details-hero-stat__icon">
								<i class="fe fe-user"></i>
							</span>
							<span class="fs-eval-details-hero-stat__label">{% trans %}Student{% endtrans %}</span>
							<strong class="fs-eval-details-hero-stat__value fs-eval-details-hero-stat__value--small">{{ student.fullName }}</strong>
						</div>

						<div class="fs-eval-details-hero-stat fs-eval-details-hero-stat--soft">
							<span class="fs-eval-details-hero-stat__icon">
								<i class="fe fe-home"></i>
							</span>
							<span class="fs-eval-details-hero-stat__label">{% trans %}Classroom{% endtrans %}</span>
							<strong class="fs-eval-details-hero-stat__value fs-eval-details-hero-stat__value--small">{{ student.classroom.classroom }}</strong>
						</div>

						<a href="{{ path ('display_problems')}}" class="fs-eval-details-btn fs-eval-details-btn--light">
							<i class="fa fa-wrench"></i>
							<span>{% trans %}Report reconstruction{% endtrans %} {% trans %}and{% endtrans %} {% trans %}Problems{% endtrans %}</span>
						</a>
					</div>
				</div>
			</section>

			{% for message in app.flashes('info') %}
				<div class="fs-eval-details-alert fs-eval-details-alert--success" role="alert">
					<i class="fa fa-check-circle-o" aria-hidden="true"></i>
					<span>{{ message }}</span>
					<button type="button" class="btn-close" data-bs-dismiss="alert" aria-hidden="true">×</button>
				</div>
			{% endfor %}

			{% for message in app.flashes('error') %}
				<div class="fs-eval-details-alert fs-eval-details-alert--danger" role="alert">
					<i class="fa fa-times" aria-hidden="true"></i>
					<span>{{ message }}</span>
					<button type="button" class="btn-close" data-bs-dismiss="alert" aria-hidden="true">×</button>
				</div>
			{% endfor %}

			<section class="fs-eval-details-status">
				<div class="fs-eval-details-status__item">
					<span class="fs-eval-details-status__icon">
						<i class="fe fe-user"></i>
					</span>
					<span class="fs-eval-details-status__label">{% trans %}Student{% endtrans %}</span>
					<strong class="fs-eval-details-status__value">{{ student.fullName }}</strong>
				</div>

				<div class="fs-eval-details-status__item">
					<span class="fs-eval-details-status__icon">
						<i class="fe fe-home"></i>
					</span>
					<span class="fs-eval-details-status__label">{% trans %}Classroom{% endtrans %}</span>
					<strong class="fs-eval-details-status__value">{{ student.classroom.classroom }}</strong>
				</div>

				<div class="fs-eval-details-status__item fs-eval-details-status__item--danger">
					<span class="fs-eval-details-status__icon">
						<i class="fe fe-calendar"></i>
					</span>
					<span class="fs-eval-details-status__label">
						{% if term %}
							{% trans %}Term{% endtrans %}
						{% else %}
							{% trans %}Evaluation{% endtrans %}
						{% endif %}
					</span>
					<strong class="fs-eval-details-status__value">
						{% if term %}
							{{ term.term }}
						{% else %}
							{{ sequence.sequence }}
						{% endif %}
					</strong>
				</div>
			</section>

			<section class="fs-eval-details-card">
				<div class="fs-eval-details-card__header">
					<div>
						<span class="fs-eval-details-chip">
							<i class="fe fe-grid"></i>
							{% trans %}Dynamic table{% endtrans %}
						</span>

						<h2>{% trans %}Evaluation details{% endtrans %}</h2>
					</div>

					<div class="fs-eval-details-card__actions">
						<form action="{{ path ('display_problems')}}" method="post" class="fs-eval-details-back-form">
							{% if term %}
								<input type="hidden" name="period" value="t{{ term.id }}">
							{% else %}
								<input type="hidden" name="period" value="s{{ sequence.id }}">
							{% endif %}
							<input type="hidden" name="classroom" value="{{ student.classroom.id }}">

							<button class="fs-eval-details-btn fs-eval-details-btn--ghost fs-eval-details-submit-btn" type="submit">
								<span class="fs-eval-details-submit-spinner" aria-hidden="true"></span>
								<i class="fa fa-arrow-left fs-eval-details-submit-icon"></i>
								<span>{% trans %}Back to classroom{% endtrans %}</span>
							</button>
						</form>

						<div class="fs-eval-details-search">
							<i class="fe fe-search"></i>
							<input type="text" class="fs-eval-details-search-input" placeholder="{% trans %}Search subject, mark...{% endtrans %}">
						</div>
					</div>
				</div>

				<div class="fs-eval-details-card__body">
					<form action="{{ path ('enregistrer_notes_evaluation_eleve', {'slugStudent': student.slug, 'sequenceId': sequence.id }) }}" method="post" class="fs-eval-details-marks-form">
						<div class="fs-eval-details-table-wrap">
							<table class="table fs-eval-details-table fs-eval-details-dynamic-table" id="fsEvaluationDetailsTable">
								<thead>
									<tr>
										<th>
											<button type="button" class="fs-eval-details-sort" data-sort-index="0">
												<span>{% trans %}N°{% endtrans %}</span>
												<i class="fe fe-chevron-down"></i>
											</button>
										</th>
										<th>
											<button type="button" class="fs-eval-details-sort" data-sort-index="1">
												<span>{% trans %}Subject{% endtrans %}</span>
												<i class="fe fe-chevron-down"></i>
											</button>
										</th>

										{% if term %}
											{% for sequence in sequences %}
												<th>
													<button type="button" class="fs-eval-details-sort" data-sort-index="{{ loop.index + 1 }}">
														<span>{% trans %}Evaluation{% endtrans %} {{ sequence.sequence }}</span>
														<i class="fe fe-chevron-down"></i>
													</button>
												</th>
											{% endfor %}
										{% else %}
											<th>
												<button type="button" class="fs-eval-details-sort" data-sort-index="2">
													<span>{% trans %}Evaluation{% endtrans %} {{ sequence.sequence }}</span>
													<i class="fe fe-chevron-down"></i>
												</button>
											</th>
										{% endif %}

										<th>{% trans %}Operations{% endtrans %}</th>
									</tr>
								</thead>

								<tbody>
									{% set i = 1 %}
									{% for matiere in resultats %}
										<tr>
											<td data-label="{% trans %}N°{% endtrans %}">
												<span class="fs-eval-details-rank">{{ i }}</span>
											</td>

											<td data-label="{% trans %}Subject{% endtrans %}">
												<div class="fs-eval-details-subject-cell">
													<span class="fs-eval-details-avatar">{{ matiere.subject|slice(0, 1)|upper }}</span>
													<div>
														<strong>{{ matiere.subject }}</strong>
														<span>
															<i class="fe fe-book"></i>
															{% trans %}Subject{% endtrans %}
														</span>
													</div>
												</div>
											</td>

											{% set hasIssue = false %}

											{% if term != 0 %}
												{% for sequence in sequences %}
													{% if matiere.evaluations[sequence.sequence] is not defined %}
														{% set hasIssue = true %}
													{% endif %}

													<td data-label="{% trans %}Evaluation{% endtrans %} {{ sequence.sequence }}">
														<span class="fs-eval-details-mark {% if matiere.evaluations[sequence.sequence] is not defined %}fs-eval-details-mark--danger{% endif %}">
															{{ matiere.evaluations[sequence.sequence]|default('Not rate') }}
														</span>
													</td>
												{% endfor %}
											{% else %}
												<td data-label="{% trans %}Evaluation{% endtrans %} {{ sequence.sequence }}">
													<div class="fs-eval-details-edit-mark">
														<div class="fs-floating-field fs-floating-field--readonly fs-has-value">
															<input type="text" value="{{ matiere.mark|default('Not rate') }}" class="form-control fs-floating-control" disabled>

															<label class="fs-floating-label">
																<i class="fe fe-eye"></i>
																{% trans %}Current mark{% endtrans %}
															</label>
														</div>

														<div class="fs-floating-field fs-required-field fs-has-value">
															<input type="number" name="mark{{ i }}" required="required" min="0" max="20" step="0.01" value="{{ matiere.mark|default('Not rate') }}" class="form-control fs-floating-control">
															<input type="hidden" name="evaluationId{{ i }}" value="{{ matiere.evaluationId }}" class="form-control">

															<label class="fs-floating-label">
																<i class="fe fe-edit"></i>
																{% trans %}New mark{% endtrans %}
															</label>

															<div class="invalid-feedback">
																{% trans %}Required field{% endtrans %}
															</div>
														</div>
													</div>
												</td>
											{% endif %}

											<td data-label="{% trans %}Operations{% endtrans %}" class="fs-eval-details-actions">
												<button type="submit" class="fs-eval-details-icon-btn fs-eval-details-icon-btn--primary fs-eval-details-submit-btn" name="submitOneNote">
													<span class="fs-eval-details-submit-spinner" aria-hidden="true"></span>
													<i class="fa fa-save fs-eval-details-submit-icon"></i>
													<span>{% trans %}Save{% endtrans %}</span>
												</button>

												<a href="javascript:void(0);" class="fs-eval-details-icon-btn fs-eval-details-icon-btn--danger"
													onclick="swal({
														'title': '{% trans %}Warning !{% endtrans %}',
														'type': 'warning',
														'text': '{% trans %}Do you want to delete this mark{% endtrans %} ?',
														'showCancelButton': true,
														'confirmButtonText': '{% trans %}Yes{% endtrans %}',
														'confirmButtonColor': '#f00',
														'cancelButtonText': '{% trans %}No{% endtrans %}',
														'cancelButtonColor': '#186106',
														'confirmButtonPath': '{{ path ('supprimer_notes_evaluation_eleve', {'slugStudent': student.slug, 'sequenceId': sequence.id , 'evaluationId': matiere.evaluationId }) }}'});">
													<i class="fa fa-trash"></i>
													<span>{% trans %}Delete{% endtrans %}</span>
												</a>
											</td>
										</tr>
										{% set i = i + 1 %}
									{% else %}
										<tr>
											<td colspan="{% if term %}{{ sequences|length + 3 }}{% else %}4{% endif %}">
												<div class="fs-eval-details-empty">
													<i class="fe fe-folder"></i>
													<strong>{% trans %}No evaluation detail found{% endtrans %}</strong>
													<span>{% trans %}No subject evaluation is available for this student.{% endtrans %}</span>
												</div>
											</td>
										</tr>
									{% endfor %}
								</tbody>
							</table>
						</div>

						<div class="fs-eval-details-table-footer">
							<div class="fs-eval-details-result-count"></div>

							<div class="fs-eval-details-footer-controls">
								<label class="fs-eval-details-page-size">
									<span>{% trans %}Rows{% endtrans %}</span>
									<select class="fs-eval-details-rows-per-page">
										<option value="5">5</option>
										<option value="10" selected>10</option>
										<option value="25">25</option>
										<option value="50">50</option>
									</select>
								</label>

								<div class="fs-eval-details-pagination" aria-label="{% trans %}Pagination{% endtrans %}"></div>
							</div>
						</div>
					</form>
				</div>
			</section>
		</div>
	</div>
{% endblock %}

{% block javascripts %}
	{{ parent() }}
	<script src="{{ asset('build/custom/js/freeschool-evaluation-details-student-premium.js') }}"></script>
{% endblock %}
