                <div class="card border-primary">
                            
                    <div class="card-body">
                        {% if selectedSequence is defined %}
                            {% if students|length > 0 %}
                                {# affichage de la liste des elÃ¨ves #}
                                {% if evaluationToUpdate == null and skillToUpdate == null %}
                                    {% if evaluations|length > 0 %}
                                        {# affichage de la liste des elÃ¨ves si les notes existent dÃ©jÃ  #}
                                        {% set filles = 0 %}
                                        {% set garcons = 0 %}

                                        {% for student in students %}
                                            {% if student.sex.sex == "F" %}
                                                {% set filles = filles + 1 %}
                                                {% else %}
                                                {% set garcons = garcons + 1 %}
                                            {% endif %}
                                        {% endfor %}
                                         
                                        {# ============================================================
   CALCULS SÉCURISÉS POUR LES GRAPHIQUES
   ============================================================ #}

{% set sousMoyenneFilles = nombreSousMoyenneFille|default(0) %}
{% set moyenneFilles = nombreMoyenneFille|default(0) %}

{% set sousMoyenneGarcons = nombreSousMoyenneGarcon|default(0) %}
{% set moyenneGarcons = nombreMoyenneGarcon|default(0) %}

{% set fillesClassees = sousMoyenneFilles + moyenneFilles %}
{% set garconsClasses = sousMoyenneGarcons + moyenneGarcons %}
{% set totalClasses = fillesClassees + garconsClasses %}

{% set tauxFilles = fillesClassees > 0
    ? (moyenneFilles / fillesClassees) * 100
    : 0
%}

{% set tauxGarcons = garconsClasses > 0
    ? (moyenneGarcons / garconsClasses) * 100
    : 0
%}

{% set tauxClasse = totalClasses > 0
    ? ((moyenneFilles + moyenneGarcons) / totalClasses) * 100
    : 0
%}

{% set noteMinFilles = noteMinMax['minMarkGirls']|default(0) %}
{% set noteMaxFilles = noteMinMax['maxMarkGirls']|default(0) %}
{% set noteMinGarcons = noteMinMax['minMarkBoys']|default(0) %}
{% set noteMaxGarcons = noteMinMax['maxMarkBoys']|default(0) %}
{% set noteMaxClasse = noteMinMax['maxMarkClass']|default(0) %}

{% set noteMinClasse = noteMinFilles < noteMinGarcons
    ? noteMinFilles
    : noteMinGarcons
%}
<div class="fs-stats-modern">
    <div class="fs-stats-header">
        <h3>{% trans %}Visual statistics{% endtrans %}</h3>
        <p>{% trans %}A clearer and more visual overview of classroom performance.{% endtrans %}</p>
    </div>

    <div class="fs-kpi-grid">
        <div class="fs-kpi-card">
            <span class="fs-kpi-label">{% trans %}Girls{% endtrans %}</span>
            <strong class="fs-kpi-value">{{ filles }}</strong>
        </div>

        <div class="fs-kpi-card">
            <span class="fs-kpi-label">{% trans %}Boys{% endtrans %}</span>
            <strong class="fs-kpi-value">{{ garcons }}</strong>
        </div>

        <div class="fs-kpi-card">
            <span class="fs-kpi-label">{% trans %}Classroom effective{% endtrans %}</span>
            <strong class="fs-kpi-value">{{ filles + garcons }}</strong>
        </div>

        <div class="fs-kpi-card">
