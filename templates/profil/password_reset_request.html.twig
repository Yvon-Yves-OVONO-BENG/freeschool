{% extends 'baseLoggin.html.twig' %}

{% block title %}{% trans %}Forgotten password{% endtrans %}{% endblock %}

{% block body %}
<div class="hor-content main-content">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-xl-5 col-lg-6 col-md-8">
                <div class="card border-primary mt-6 shadow-sm">
                    <div class="card-header text-center">
                        <h3 class="mb-0"><i class="fa fa-envelope me-2"></i>{% trans %}Password reset by email{% endtrans %}</h3>
                    </div>
                    <div class="card-body">
                        <p class="text-muted">
                            {% trans %}Enter your recovery email address. We will send you a 5-digit code.{% endtrans %}
                        </p>
                        <form method="post">
                            <div class="mb-3">
                                <label class="form-label" for="email">{% trans %}Email{% endtrans %}</label>
                                <input type="email" class="form-control" id="email" name="email" required autocomplete="email">
                            </div>
                            <button class="btn btn-primary w-100" type="submit">
                                <i class="fa fa-paper-plane me-2"></i>{% trans %}Send code{% endtrans %}
                            </button>
                            <a href="{{ path('login') }}" class="btn btn-outline-secondary w-100 mt-3">
                                {% trans %}Back to login{% endtrans %}
                            </a>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
