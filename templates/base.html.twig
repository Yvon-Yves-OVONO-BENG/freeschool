					<script>
						(function () {
							document.addEventListener('submit', function (event) {
								const form = event.target;
								if (!form) return;
	
								const submitter = event.submitter || form.querySelector('button[type="submit"], input[type="submit"]');
								const target = (form.getAttribute('target') || '').toLowerCase();
								const visibleLabel = submitter && submitter.textContent ? submitter.textContent.toLowerCase() : '';
								const action = (form.getAttribute('action') || '').toLowerCase();
								const isPrintSubmission =
									form.dataset.noSpinner === '1' ||
									target === '_blank' ||
									/(print|imprim|pdf)/i.test(visibleLabel + ' ' + action);
	
								if (!isPrintSubmission) return;
	
								const buttons = Array.from(form.querySelectorAll('button[type="submit"], input[type="submit"]'));
								const snapshots = buttons.map(function (button) {
									return {
										button: button,
										disabled: button.disabled,
										html: button.tagName === 'BUTTON' ? button.innerHTML : null,
										className: button.className
									};
								});
	
								// Après tous les autres handlers de submit, on restaure immédiatement le bouton d'impression.
								window.setTimeout(function () {
									form.dataset.submitting = '0';
									snapshots.forEach(function (snapshot) {
										const button = snapshot.button;
										button.disabled = snapshot.disabled;
										button.className = snapshot.className;
										if (snapshot.html !== null) {
											button.innerHTML = snapshot.html;
										}
										delete button.dataset.originalHtml;
									});
								}, 0);
							}, true);
						})();
					</script>
