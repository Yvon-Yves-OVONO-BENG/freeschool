{% extends 'base.html.twig' %}

{% block title %}
	{% if slug != 0 %}
		{% trans %}Edit Diplome{% endtrans %}
	{% else %}
		{% trans %}Save Diploma{% endtrans %}
	{% endif %}
{% endblock %}

{% block subTitle %}
	{% if slug != 0 %}
		{% trans %}UPDATING DIPLOMA{% endtrans %}
	{% else %}
		{% trans %}ADDING NEW DIPLOMA{% endtrans %}
	{% endif %}
{% endblock %}

{% block infoMessage %}
	{% include "includes/_info_message.html.twig" %}
{% endblock %}

{% block stylesheets %}
	{{ parent() }}
	<link rel="stylesheet" href="{{ asset('build/custom/css/freeschool-diploma-form-premium.css') }}">
{% endblock %}

{% block body %}
	<div class="hor-content main-content fs-diploma-page">
		<div class="container">
			<div class="fs-diploma-menu-safe-space" aria-hidden="true"></div>

			<div class="fs-diploma-hero fs-diploma-hero--compact">
				<div class="fs-diploma-hero__content">
					<span class="fs-diploma-eyebrow">
						<i class="fe fe-award"></i>
						{% trans %}School configuration{% endtrans %}
					</span>

					<h1 class="fs-diploma-title">
						{% if slug != 0 %}
							{% trans %}UPDATING DIPLOMA{% endtrans %}
						{% else %}
							{% trans %}ADDING NEW DIPLOMA{% endtrans %}
						{% endif %}
					</h1>

					<p class="fs-diploma-subtitle">
						{% trans %}Create and manage staff diplomas with a clean, secure and responsive workspace.{% endtrans %}
					</p>
				</div>

				<div class="fs-diploma-hero__actions">
					<a href="{{ path('diploma_displayDiploma') }}" class="fs-diploma-btn fs-diploma-btn--hero-secondary">
						<i class="fe fe-list"></i>
						<span>{% trans %}Display registered diplomas{% endtrans %}</span>
					</a>
				</div>
			</div>

			<div class="fs-diploma-card fs-diploma-card--clean {% if slug == 0 %}fs-diploma-card--create{% else %}fs-diploma-card--edit{% endif %}">
				<div class="fs-diploma-card__header fs-diploma-card__header--clean">
					<div>
						<span class="fs-diploma-card__badge">
							{% if slug != 0 %}
								<i class="fe fe-edit"></i>
								{% trans %}Edit mode{% endtrans %}
							{% else %}
								<i class="fe fe-plus"></i>
								{% trans %}Creation mode{% endtrans %}
							{% endif %}
						</span>

						<h2 class="fs-diploma-card__title">
							{% if slug != 0 %}
								{% trans %}UPDATING DIPLOMA{% endtrans %}
							{% else %}
								{% trans %}ADDING NEW DIPLOMA{% endtrans %}
							{% endif %}
						</h2>
					</div>

					{% if slug == 0 %}
						<button type="button" class="fs-diploma-btn fs-diploma-btn--soft fs-diploma-add-top-btn" id="fsAddDiplomaField">
							<i class="fe fe-plus"></i>
							<span>{% trans %}Add diploma{% endtrans %}</span>
						</button>
					{% endif %}
				</div>

				<div class="fs-diploma-card__body fs-diploma-card__body--clean">
					{{ form_start(formDiploma, {'attr': {'class': 'fs-diploma-form', 'novalidate': 'novalidate'}}) }}

						<input type="hidden" name="_token_bulk_diplomas" value="{{ csrf_token('bulk_save_diploma') }}">

						<div class="fs-diploma-builder">
							<div class="fs-diploma-builder-row fs-diploma-builder-row--main">
								<div class="fs-diploma-builder-index">01</div>

								<div class="fs-floating-field">
									{{ form_widget(formDiploma.diploma, {
										'attr': {
											'class': 'fs-floating-control',
											'placeholder': ' '
										}
									}) }}

									<label class="fs-floating-label">
										<i class="fe fe-award"></i>
										{% trans %}Diploma{% endtrans %}
									</label>

									<div class="fs-floating-error">
										{{ form_errors(formDiploma.diploma) }}
									</div>
								</div>

								<div class="fs-diploma-builder-status">
									<span>{% trans %}Main{% endtrans %}</span>
								</div>
							</div>

							{% if slug == 0 %}
								<div id="fsExtraDiplomasContainer" class="fs-extra-diplomas-container"></div>
							{% endif %}
						</div>

						<div class="fs-diploma-form__footer fs-diploma-form__footer--clean">
							<a href="{{ path('diploma_displayDiploma') }}" class="fs-diploma-btn fs-diploma-btn--ghost">
								<i class="fe fe-arrow-left"></i>
								<span>{% trans %}Back{% endtrans %}</span>
							</a>

							{% if slug == 0 %}
								<button type="submit" class="fs-diploma-btn fs-diploma-btn--primary" name="addDiploma">
									<i class="fe fe-save"></i>
									<span>{% trans %}Save{% endtrans %}</span>
								</button>
							{% else %}
								<button type="submit" class="fs-diploma-btn fs-diploma-btn--primary" name="editDiploma">
									<i class="fe fe-save"></i>
									<span>{% trans %}Save changes{% endtrans %}</span>
								</button>
							{% endif %}
						</div>

					{{ form_end(formDiploma) }}
				</div>
			</div>

		</div>
	</div>
{% endblock %}

{% block javascripts %}
	{{ parent() }}
	<script src="{{ asset('build/custom/js/freeschool-diploma-form-premium.js') }}"></script>
{% endblock %}
