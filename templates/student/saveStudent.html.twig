{% extends 'base.html.twig' %}

{% block title %}
	{% if slug != 0 %}
		{% trans %}Updating Student{% endtrans %}
	{% else %}
		{% trans %}Save Student{% endtrans %}
	{% endif %}
{% endblock %}

{% block subTitle %}
	{% if slug != 0 %}
		{% trans %}UPDATING STUDENT{% endtrans %}
	{% else %}
		{% trans %}ADDING NEW STUDENT{% endtrans %}
	{% endif %}
{% endblock %}

{% block infoMessage %}
	{% include "includes/_info_message.html.twig" %}
{% endblock %}

{% block stylesheets %}
	{{ parent() }}
	<link rel="stylesheet" href="{{ asset('build/custom/css/freeschool-student-form-premium.css') }}">
	<style>
		.fs-photo-source-actions{display:flex;align-items:center;gap:10px;flex-wrap:wrap}
		.fs-camera-open-btn{appearance:none;border:0;cursor:pointer;display:inline-flex;align-items:center;gap:8px;padding:10px 15px;border-radius:10px;background:#1769e0;color:#fff;font-weight:700;box-shadow:0 7px 18px rgba(23,105,224,.18);transition:.2s ease}
		.fs-camera-open-btn:hover{background:#0e56bd;transform:translateY(-1px)}
		.fs-photo-processing{display:block;margin-top:8px;color:#68758a;font-size:.78rem}
		.fs-photo-processing.is-error{color:#c0392b}
		.fs-camera-modal[hidden]{display:none!important}
		.fs-camera-modal{position:fixed;inset:0;z-index:10050;display:grid;place-items:center;padding:18px}
		.fs-camera-modal__backdrop{position:absolute;inset:0;background:rgba(9,17,31,.78);backdrop-filter:blur(5px)}
		.fs-camera-modal__dialog{position:relative;width:min(94vw,620px);height:min(94vh,760px);max-height:94vh;overflow:hidden;border-radius:20px;background:#fff;box-shadow:0 28px 70px rgba(0,0,0,.35);display:flex;flex-direction:column}
		.fs-camera-modal__header{display:flex;align-items:center;justify-content:space-between;padding:16px 18px;border-bottom:1px solid #edf0f5}
		.fs-camera-modal__header h3{margin:0;font-size:1.05rem;color:#182235}
		.fs-camera-close{border:0;background:#eef2f7;border-radius:50%;width:36px;height:36px;cursor:pointer;color:#26364d}
		.fs-camera-stage{position:relative;flex:1;min-height:280px;background:#0b1018;overflow:hidden}
		.fs-camera-stage video{display:block;width:100%;height:100%;object-fit:cover}
		.fs-camera-stage video.is-front-camera{transform:scaleX(-1)}
		.fs-camera-message{position:absolute;inset:0;display:none;place-content:center;gap:20px;padding:30px;text-align:center;color:#fff;background:#101827;z-index:2}
		.fs-camera-message.is-visible{display:grid}
		.fs-camera-controls{position:sticky;bottom:0;z-index:5;flex:0 0 auto;display:flex;justify-content:center;align-items:center;gap:14px;padding:18px;background:#07162f;border-top:1px solid rgba(255,255,255,.12);box-shadow:0 -10px 30px rgba(0,0,0,.24)}
		.fs-camera-control{border:0;border-radius:999px;cursor:pointer;display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:44px;padding:0 17px;font-weight:700}
		.fs-camera-control--switch{background:#fff;color:#1458b4}
		.fs-camera-control--capture{min-width:210px;height:58px;padding:0 24px;background:#0875f5!important;color:#fff!important;border:4px solid #cfe3ff;box-shadow:0 0 0 2px #0875f5,0 10px 26px rgba(8,117,245,.42);font-size:1rem;font-weight:900}
		.fs-camera-control[disabled]{opacity:.45;cursor:not-allowed}
		body.fs-camera-open{overflow:hidden}
		@media(max-width:576px){.fs-camera-modal{padding:0}.fs-camera-modal__dialog{width:100vw;max-height:100vh;height:100%;border-radius:0}.fs-camera-stage{flex:1;max-height:none}.fs-camera-controls{gap:10px;padding:14px 12px}.fs-camera-control{padding-left:13px;padding-right:13px}.fs-camera-control--capture{min-width:0;flex:1}.fs-camera-open-btn,.fs-photo-upload-btn{flex:1;justify-content:center}}
	</style>
{% endblock %}

{% block body %}
	<div class="hor-content main-content fs-student-page">
		<div class="container">
			<div class="fs-student-menu-safe-space" aria-hidden="true"></div>

			<section class="fs-student-hero">
				<div class="fs-student-hero__content">
					<span class="fs-student-eyebrow">
						<i class="fe fe-user"></i>
						{% trans %}Student workspace{% endtrans %}
					</span>

					<h1 class="fs-student-title">
						{% if slug != 0 %}
							{% trans %}UPDATING STUDENT{% endtrans %}
						{% else %}
							{% trans %}ADDING NEW STUDENT{% endtrans %}
						{% endif %}
					</h1>

					<p class="fs-student-subtitle">
						{% trans %}Register and update student information through a clean, guided and responsive form.{% endtrans %}
					</p>
				</div>

				<div class="fs-student-hero__right">
					<div class="fs-student-stat">
						<span class="fs-student-stat__icon">
							<i class="fe fe-users"></i>
						</span>
						<span class="fs-student-stat__label">{% trans %}Total Effective{% endtrans %}</span>
						<strong class="fs-student-stat__value">{{ numberOfStudentInSchool }}</strong>
					</div>

					<a href="{{ path('student_displayStudent') }}" class="fs-student-btn fs-student-btn--hero">
						<i class="fe fe-list"></i>
						<span>{% trans %}Display registered students{% endtrans %}</span>
					</a>
				</div>
			</section>

			{% if slug != 0 %}
				<div class="fs-student-edit-banner">
					<div class="fs-student-edit-banner__photo">
						{% if student.sex.sex == 'F' %}
							<img src="{{ student.photo ? asset('images/students/' ~ student.photo) : asset('images/students/fille.jpg')}}" alt="photo">
						{% else %}
							<img src="{{ student.photo ? asset('images/students/' ~ student.photo) : asset('images/students/garcon.jpg')}}" alt="photo">
						{% endif %}
					</div>

					<div>
						<span>{% trans %}Updating student information of : {% endtrans %}</span>
						<strong>{{ student.fullName }}</strong>
					</div>
				</div>
			{% endif %}

			<div class="fs-student-card {% if slug != 0 %}fs-student-card--edit{% else %}fs-student-card--create{% endif %}">
				<div class="fs-student-card__header">
					<div>
						<span class="fs-student-card__badge">
							{% if slug != 0 %}
								<i class="fe fe-edit"></i>
								{% trans %}Edit mode{% endtrans %}
							{% else %}
								<i class="fe fe-plus"></i>
								{% trans %}Creation mode{% endtrans %}
							{% endif %}
						</span>

						<h2 class="fs-student-card__title">
							{% if slug != 0 %}
								{% trans %}UPDATING STUDENT{% endtrans %}
							{% else %}
								{% trans %}ADDING NEW STUDENT{% endtrans %}
							{% endif %}
						</h2>
					</div>

					<div class="fs-student-card__actions">
						{% if storedClassroom.classroom is not null %}
							<div class="fs-student-mini-stat">
								<span>{% trans %}Effective{% endtrans %} {{ storedClassroom.classroom }}</span>
								<strong>{{ registeredStudents|length }}</strong>
							</div>
						{% endif %}

						{% if mySession.get('verrou').verrou is not null and mySession.get('verrou').verrou == 0 %}
							{% if is_granted('ROLE_INTENDANT') %}
								<a href="{{ path('registration_feesStatement') }}" class="fs-student-btn fs-student-btn--soft">
									<i class="fe fe-credit-card"></i>
									<span>{% trans %}Validate a receipt{% endtrans %}</span>
								</a>
							{% endif %}
						{% endif %}
					</div>
				</div>

				<div class="fs-student-card__body">
					<div aria-multiselectable="true" class="accordion fs-student-accordion" id="accordion" role="tablist">

						{{ form_start(formStudent, {'attr': {'class': 'fs-student-form needs-validation', 'novalidate': 'novalidate'}}) }}

							<div class="acc-card fs-accordion-card mb-2">
								<div class="acc-header fs-accordion-header" id="headingRequired" role="tab">
									<h5 class="mb-0">
										<a aria-controls="requiredStudentInfo" aria-expanded="true" data-bs-toggle="collapse" href="#requiredStudentInfo">
											<i class="fe fe-user-check"></i>
											<b>{% trans %}REQUIRED STUDENT INFORMATION{% endtrans %}</b>
										</a>
									</h5>
								</div>

								<div aria-labelledby="headingRequired" class="collapse show" data-parent="#accordion" id="requiredStudentInfo" role="tabpanel">
									<div class="acc-body fs-accordion-body">
										<div class="fs-required-grid">

											<div class="fs-floating-field fs-required-field">
												{{ form_widget(formStudent.classroom, {'attr': {'class': 'form-control select2-show-search fs-floating-control', 'placeholder': ' ', 'required': 'required'}}) }}
												<label class="fs-floating-label">{% trans %}Classroom{% endtrans %}</label>
												<div class="fs-field-error">{{ form_errors(formStudent.classroom) }}</div>
											</div>

											<div class="fs-floating-field fs-required-field">
												{{ form_widget(formStudent.fullName, {'attr': {'class': 'form-control form-control-sm fs-floating-control', 'placeholder': ' ', 'required': 'required'}}) }}
												<label class="fs-floating-label">{% trans %}Full name{% endtrans %}</label>
												<div class="fs-field-error">{{ form_errors(formStudent.fullName) }}</div>
											</div>

											<div class="fs-floating-field fs-required-field">
												{{ form_widget(formStudent.birthday, {'attr': {'class': 'form-control form-control-sm fs-floating-control', 'placeholder': ' ', 'required': 'required'}}) }}
												<label class="fs-floating-label">{% trans %}Birthday{% endtrans %}</label>
												<div class="fs-field-error">{{ form_errors(formStudent.birthday) }}</div>
											</div>

											<div class="fs-floating-field fs-required-field">
												{{ form_widget(formStudent.birthplace, {'attr': {'class': 'form-control form-control-sm fs-floating-control', 'placeholder': ' ', 'required': 'required'}}) }}
												<label class="fs-floating-label">{% trans %}Birthplace{% endtrans %}</label>
												<div class="fs-field-error">{{ form_errors(formStudent.birthplace) }}</div>
											</div>

											<div class="fs-floating-field fs-required-field">
												{{ form_widget(formStudent.sex, {'attr': {'class': 'form-control select2 custom-select fs-floating-control', 'placeholder': ' ', 'required': 'required'}}) }}
												<label class="fs-floating-label">{% trans %}Gender{% endtrans %}</label>
												<div class="fs-field-error">{{ form_errors(formStudent.sex) }}</div>
											</div>

											<div class="fs-floating-field fs-required-field">
												{{ form_widget(formStudent.repeater, {'attr': {'class': 'form-control select2 custom-select fs-floating-control', 'placeholder': ' ', 'required': 'required'}}) }}
												<label class="fs-floating-label">{% trans %}Repeater{% endtrans %}</label>
												<div class="fs-field-error">{{ form_errors(formStudent.repeater) }}</div>
											</div>

											<div class="fs-floating-field fs-required-field">
												{{ form_widget(formStudent.registrationNumber, {'attr': {'class': 'form-control form-control-sm fs-floating-control', 'placeholder': ' ', 'required': 'required'}}) }}
												<label class="fs-floating-label">{% trans %}NIU{% endtrans %}</label>
												<div class="fs-field-error">{{ form_errors(formStudent.registrationNumber) }}</div>
											</div>

											<div class="fs-photo-field fs-photo-field--premium">
                                                <div class="fs-photo-preview" id="fsStudentPhotoPreview">
                                                    {% if slug != 0 %}
                                                        {% if student.sex.sex == 'F' %}
                                                            <img src="{{ student.photo ? asset('images/students/' ~ student.photo) : asset('images/students/fille.jpg')}}" alt="photo">
                                                        {% else %}
                                                            <img src="{{ student.photo ? asset('images/students/' ~ student.photo) : asset('images/students/garcon.jpg')}}" alt="photo">
                                                        {% endif %}
                                                    {% else %}
                                                        <div class="fs-photo-preview__empty">
                                                            <i class="fe fe-camera"></i>
                                                        </div>
                                                    {% endif %}
                                                </div>

                                                <div class="fs-photo-content">
                                                    <label class="fs-photo-label">
                                                        <i class="fe fe-camera"></i>
                                                        <span>{% trans %}Photo{% endtrans %}</span>
                                                    </label>

                                                    <div class="fs-photo-source-actions">
                                                        <label class="fs-photo-upload-btn">
                                                            <i class="fe fe-upload"></i>
                                                            <span>{% trans %}Choose photo{% endtrans %}</span>
                                                            {{ form_widget(formStudent.imageFile, {'attr': {'class': 'fs-photo-input', 'accept': 'image/*'}}) }}
                                                        </label>

                                                        <button type="button" class="fs-camera-open-btn" id="fsOpenStudentCamera">
                                                            <i class="fe fe-camera"></i>
                                                            <span>{{ app.request.locale|slice(0, 2) == 'fr' ? 'Prendre une photo' : 'Take a photo' }}</span>
                                                        </button>
                                                    </div>

                                                    <small class="fs-photo-processing" id="fsPhotoProcessingStatus" aria-live="polite"></small>

                                                    <div class="fs-photo-actions">
                                                        <button type="button" class="fs-photo-remove-btn" id="fsRemoveSelectedPhoto">
                                                            <i class="fe fe-x"></i>
                                                            <span>{% trans %}Remove{% endtrans %}</span>
                                                        </button>

                                                        {% if slug != 0 and student.photo %}
                                                            <label class="fs-photo-delete-existing">
                                                                <input type="checkbox" name="removeStudentPhoto" value="1">
                                                                <span>{% trans %}Delete current photo{% endtrans %}</span>
                                                            </label>
                                                        {% endif %}
                                                    </div>

                                                    <div class="fs-field-error">{{ form_errors(formStudent.imageFile) }}</div>
                                                </div>
                                            </div>

											<div class="fs-camera-modal" id="fsStudentCameraModal" hidden aria-hidden="true" role="dialog" aria-modal="true" aria-labelledby="fsCameraTitle">
												<div class="fs-camera-modal__backdrop" data-camera-close></div>
												<div class="fs-camera-modal__dialog">
													<div class="fs-camera-modal__header">
														<h3 id="fsCameraTitle">{{ app.request.locale|slice(0, 2) == 'fr' ? "Photo de l'élève" : 'Student photo' }}</h3>
														<button type="button" class="fs-camera-close" data-camera-close aria-label="{{ app.request.locale|slice(0, 2) == 'fr' ? 'Fermer' : 'Close' }}"><i class="fe fe-x"></i></button>
													</div>

													<div class="fs-camera-stage">
														<video id="fsStudentCameraVideo" autoplay playsinline muted></video>
														<div class="fs-camera-message" id="fsCameraMessage">
															<span id="fsCameraMessageText"></span>
														</div>
													</div>

													<div class="fs-camera-controls">
														<button type="button" class="fs-camera-control fs-camera-control--switch" id="fsSwitchStudentCamera">
															<i class="fe fe-refresh-cw"></i>
															<span>{{ app.request.locale|slice(0, 2) == 'fr' ? 'Retourner' : 'Switch' }}</span>
														</button>
														<button type="button" class="fs-camera-control fs-camera-control--capture" id="fsCaptureStudentPhoto" aria-label="{{ app.request.locale|slice(0, 2) == 'fr' ? 'Capturer la photo' : 'Capture photo' }}">
															<i class="fe fe-camera"></i>
															<span>{{ app.request.locale|slice(0, 2) == 'fr' ? 'Prendre la photo' : 'Take photo' }}</span>
														</button>
													</div>
												</div>
											</div>

										</div>
									</div>
								</div>
							</div>

							<div class="acc-card fs-accordion-card mb-2">
								<div class="acc-header fs-accordion-header" id="headingOther" role="tab">
									<h5 class="mb-0">
										<a aria-controls="studentOtherInfo" aria-expanded="false" class="collapsed" data-bs-toggle="collapse" href="#studentOtherInfo">
											<i class="fe fe-info"></i>
											<b>{% trans %}OTHER STUDENT INFORMATION{% endtrans %}</b>
										</a>
									</h5>
								</div>

								<div aria-labelledby="headingOther" class="collapse" data-parent="#accordion" id="studentOtherInfo" role="tabpanel">
									<div class="acc-body fs-accordion-body">
										<div class="fs-other-grid">

											<div class="fs-choice-field">
												<label class="fs-choice-label">{% trans %}Native ?{% endtrans %}</label>
												<div class="selectgroup selectgroup-pills">
													<label class="selectgroup-item">
														<input type="radio" name="autochtone" value="1" class="selectgroup-input">
														<span class="selectgroup-button">{% trans %}Yes{% endtrans %}</span>
													</label>
													<label class="selectgroup-item">
														<input type="radio" name="autochtone" value="0" class="selectgroup-input">
														<span class="selectgroup-button">{% trans %}No{% endtrans %}</span>
													</label>
												</div>
											</div>

											<div class="fs-floating-field">
												{{ form_widget(formStudent.country, {'attr': {'class': 'form-control select2-show-search fs-floating-control', 'placeholder': ' '}}) }}
												<label class="fs-floating-label">{% trans %}Country{% endtrans %}</label>
												<div class="fs-field-error">{{ form_errors(formStudent.country) }}</div>
											</div>

											<div class="fs-floating-field">
												{{ form_widget(formStudent.ethnicGroup, {'attr': {'class': 'form-control select2-show-search fs-floating-control', 'placeholder': ' '}}) }}
												<label class="fs-floating-label">{% trans %}Ethnic group{% endtrans %}</label>
												<div class="fs-field-error">{{ form_errors(formStudent.ethnicGroup) }}</div>
											</div>

											<div class="fs-floating-field">
												{{ form_widget(formStudent.movement, {'attr': {'class': 'form-control select2 custom-select fs-floating-control', 'placeholder': ' '}}) }}
												<label class="fs-floating-label">{% trans %}Movement{% endtrans %}</label>
												<div class="fs-field-error">{{ form_errors(formStudent.movement) }}</div>
											</div>

											<div class="fs-floating-field">
												{{ form_widget(formStudent.numeroHcr, {'attr': {'class': 'form-control form-control-sm fs-floating-control', 'placeholder': ' '}}) }}
												<label class="fs-floating-label">{% trans %}HCR number{% endtrans %}</label>
												<div class="fs-field-error">{{ form_errors(formStudent.numeroHcr) }}</div>
											</div>

											<div class="fs-floating-field">
												{{ form_widget(formStudent.responsability, {'attr': {'class': 'form-control select2 custom-select fs-floating-control', 'placeholder': ' '}}) }}
												<label class="fs-floating-label">{% trans %}Responsability{% endtrans %}</label>
												<div class="fs-field-error">{{ form_errors(formStudent.responsability) }}</div>
											</div>

											<div class="fs-floating-field">
												{{ form_widget(formStudent.numeroWhatsapp, {'attr': {'class': 'form-control form-control-sm fs-floating-control', 'placeholder': ' '}}) }}
												<label class="fs-floating-label">{% trans %}WhatsApp number{% endtrans %}</label>
												<div class="fs-field-error">{{ form_errors(formStudent.numeroWhatsapp) }}</div>
											</div>

											<div class="fs-floating-field">
												{{ form_widget(formStudent.handicap, {'attr': {'class': 'form-control select2 custom-select fs-floating-control', 'placeholder': ' '}}) }}
												<label class="fs-floating-label">{% trans %}Handicap{% endtrans %}</label>
												<div class="fs-field-error">{{ form_errors(formStudent.handicap) }}</div>
											</div>

											<div class="fs-floating-field">
												{{ form_widget(formStudent.handicapType, {'attr': {'class': 'form-control select2 custom-select fs-floating-control', 'placeholder': ' '}}) }}
												<label class="fs-floating-label">{% trans %}Handicap type{% endtrans %}</label>
												<div class="fs-field-error">{{ form_errors(formStudent.handicapType) }}</div>
											</div>

											<div class="fs-floating-field">
												{{ form_widget(formStudent.fatherName, {'attr': {'class': 'form-control form-control-sm fs-floating-control', 'placeholder': ' '}}) }}
												<label class="fs-floating-label">{% trans %}Father name{% endtrans %}</label>
												<div class="fs-field-error">{{ form_errors(formStudent.fatherName) }}</div>
											</div>

											<div class="fs-floating-field">
												{{ form_widget(formStudent.professionPere, {'attr': {'class': 'form-control form-control-sm fs-floating-control', 'placeholder': ' '}}) }}
												<label class="fs-floating-label">{% trans %}Father profession{% endtrans %}</label>
												<div class="fs-field-error">{{ form_errors(formStudent.professionPere) }}</div>
											</div>

											<div class="fs-floating-field">
												{{ form_widget(formStudent.telephonePere, {'attr': {'class': 'form-control form-control-sm fs-floating-control', 'placeholder': ' '}}) }}
												<label class="fs-floating-label">{% trans %}Father phone{% endtrans %}</label>
												<div class="fs-field-error">{{ form_errors(formStudent.telephonePere) }}</div>
											</div>

											<div class="fs-floating-field">
												{{ form_widget(formStudent.motherName, {'attr': {'class': 'form-control form-control-sm fs-floating-control', 'placeholder': ' '}}) }}
												<label class="fs-floating-label">{% trans %}Mother name{% endtrans %}</label>
												<div class="fs-field-error">{{ form_errors(formStudent.motherName) }}</div>
											</div>

											<div class="fs-floating-field">
												{{ form_widget(formStudent.professionMere, {'attr': {'class': 'form-control form-control-sm fs-floating-control', 'placeholder': ' '}}) }}
												<label class="fs-floating-label">{% trans %}Mother profession{% endtrans %}</label>
												<div class="fs-field-error">{{ form_errors(formStudent.professionMere) }}</div>
											</div>

											<div class="fs-floating-field">
												{{ form_widget(formStudent.telephoneMere, {'attr': {'class': 'form-control form-control-sm fs-floating-control', 'placeholder': ' '}}) }}
												<label class="fs-floating-label">{% trans %}Mother phone{% endtrans %}</label>
												<div class="fs-field-error">{{ form_errors(formStudent.telephoneMere) }}</div>
											</div>

											<div class="fs-floating-field">
												{{ form_widget(formStudent.tuteur, {'attr': {'class': 'form-control form-control-sm fs-floating-control', 'placeholder': ' '}}) }}
												<label class="fs-floating-label">{% trans %}Guardian{% endtrans %}</label>
												<div class="fs-field-error">{{ form_errors(formStudent.tuteur) }}</div>
											</div>

											<div class="fs-floating-field">
												{{ form_widget(formStudent.professionTuteur, {'attr': {'class': 'form-control form-control-sm fs-floating-control', 'placeholder': ' '}}) }}
												<label class="fs-floating-label">{% trans %}Guardian profession{% endtrans %}</label>
												<div class="fs-field-error">{{ form_errors(formStudent.professionTuteur) }}</div>
											</div>

											<div class="fs-floating-field">
												{{ form_widget(formStudent.telephoneTuteur, {'attr': {'class': 'form-control form-control-sm fs-floating-control', 'placeholder': ' '}}) }}
												<label class="fs-floating-label">{% trans %}Guardian phone{% endtrans %}</label>
												<div class="fs-field-error">{{ form_errors(formStudent.telephoneTuteur) }}</div>
											</div>

											<div class="fs-floating-field">
												{{ form_widget(formStudent.emailParent, {'attr': {'class': 'form-control form-control-sm fs-floating-control', 'placeholder': ' '}}) }}
												<label class="fs-floating-label">{% trans %}Parent email{% endtrans %}</label>
