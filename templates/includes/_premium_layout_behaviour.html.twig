    font-size: 12.5px !important;
    font-weight: 600 !important;
    line-height: 1.15;
    text-decoration: none !important;
    white-space: nowrap;
    transition: transform .18s ease, box-shadow .18s ease, border-color .18s ease, color .18s ease, background .18s ease;
