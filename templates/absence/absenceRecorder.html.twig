{% extends 'base.html.twig' %}

{% block title %}{% trans %}Enter hours of absence{% endtrans %}{% endblock %}

{% block subTitle %}
    {% trans %}MANAGEMENT OF HOURS OF ABSENCE{% endtrans %}
    {% if is_granted ('ROLE_ADMIN') or is_granted ('ROLE_SUPER_ADMIN') %}
        {% trans %}OF{% endtrans %} [ {{teacher.fullName }} ]
    {% endif %}
{% endblock %}
{% block infoMessage %}
    {% include "includes/_info_message.html.twig" %}
{% endblock %}

{% block currentUser %}
    {{teacher.fullName }}
{% endblock %}

{% block stylesheets %}
	{{ parent() }}
	<link rel="stylesheet" href="{{ asset('build/custom/css/freeschool-absence-recorder-premium-clean.css') }}">
{% endblock %}

{% block body %}
<!-- App-Content -->
	<div class="hor-content main-content fs-absence-recorder-page">
		<div class="container">
			<div class="fs-abs-menu-safe-space" aria-hidden="true"></div>

			<section class="fs-abs-hero">
				<div class="fs-abs-hero__content">
					<div>
						<span class="fs-abs-eyebrow">
							<i class="fe fe-watch"></i>
							{% trans %}Absence recorder workspace{% endtrans %}
						</span>

						<h1 class="fs-abs-title">
							{% trans %}Management of Student's Absence Hours{% endtrans %}
						</h1>

						<p class="fs-abs-subtitle">
							{% trans %}Choose a period and classroom, then enter, update or review student absence hours with a refined premium interface.{% endtrans %}
						</p>
					</div>

					<div class="fs-abs-hero__actions">
						<div class="fs-abs-hero-stat">
							<span class="fs-abs-hero-stat__icon">
								<i class="fe fe-user-check"></i>
							</span>
							<span class="fs-abs-hero-stat__label">{% trans %}Supervisor{% endtrans %}</span>
							<strong class="fs-abs-hero-stat__value">{{ teacher.fullName }}</strong>
						</div>

						{% if selectedTerm is defined %}
							<div class="fs-abs-hero-stat">
								<span class="fs-abs-hero-stat__icon">
									<i class="fe fe-calendar"></i>
								</span>
								<span class="fs-abs-hero-stat__label">{% trans %}Term{% endtrans %}</span>
								<strong class="fs-abs-hero-stat__value">{% trans %}N°{% endtrans %} {{ selectedTerm.term }}</strong>
							</div>

							<div class="fs-abs-hero-stat">
								<span class="fs-abs-hero-stat__icon">
									<i class="fe fe-home"></i>
								</span>
								<span class="fs-abs-hero-stat__label">{% trans %}Class{% endtrans %}</span>
								<strong class="fs-abs-hero-stat__value">{{ selectedClassroom.classroom }}</strong>
							</div>
						{% endif %}
					</div>
				</div>
			</section>


            <!-- Row -->
				<div class="row mt-4">
                    <div class="col-lg-12">
                        <div class="expanel expanel-primary border-primary">
                            <div class="expanel-heading">
                                <h3 class="expanel-title">{% trans %}Choose term and classroom{% endtrans %}</h3>
                            </div>
                            <div class="expanel-body">
                                
                                <div class="col-md-12">
                                    <div class="row">
                                        <div class="col-md-8">
                                            <form action="{{ path('absence_absenceRecorder', {'slug': teacher.slug}) }}" method="post">
                                                <div class="row">
                                                    <div class="col-md-3">
                                                        <div class="form-group fs-floating-field fs-required-field">
                                                            <select name="term" id="term" class="form-control select2 custom-select" data-placeholder="{% trans %}Choose a period{% endtrans %}" required="required">
                                                                <option label="{% trans %}Choose a period{% endtrans %}">
                                                                    {% trans %}Choose a period{% endtrans %}
                                                                </option>
                                                                {% for term in terms %}
                                                                    {% if term.term != annualTerm %}
                                                                        <option value="{{ term.id }}" 
                                                                        {% if selectedTerm is defined %}
                                                                            {% if selectedTerm.id == term.id %} 
                                                                                selected 
                                                                            {% endif %}
                                                                        {% endif %}>
                                                                            {% trans %}Term{% endtrans %} {{ term.term }}
                                                                        </option>
                                                                    {% endif %}
                                                                {% endfor %}

                                                            </select>
                                                            <label class="fs-floating-label" for="term">
                                                                <i class="fe fe-calendar"></i>
                                                                {% trans %}Period{% endtrans %}
                                                            </label>
                                                        </div>
                                                    </div>
                                                    <div class="col-md-3">
                                                        <div class="form-group fs-floating-field fs-required-field" >
                                                            <select name="classroom" id="classroom" class="form-control select2-show-search" data-placeholder="{% trans %}Choose a class{% endtrans %}" required="required">
                                                                <option label="{% trans %}Choose a class{% endtrans %}">
                                                                    {% trans %}Choose a classroom{% endtrans %}
                                                                </option>
                                                                {% for classroom in classrooms %}
                                                                    <option value="{{ classroom.id }}" 
                                                                    {% if selectedClassroom is defined %}
                                                                        {% if selectedClassroom.id == classroom.id %}
                                                                            selected
                                                                        {% endif %}
                                                                    {% endif %}>
                                                                        {{ classroom.classroom }}
                                                                    </option>
                                                                {% endfor %}
                                                            </select>
                                                            <label class="fs-floating-label" for="classroom">
                                                                <i class="fe fe-home"></i>
                                                                {% trans %}Classroom{% endtrans %}
                                                            </label>
                                                        </div>
                                                    </div>
                                                    <div class="col-md-3">
                                                        <div class="form-group">
                                                            <button class="btn btn-outline-primary" type="submit" name="displayAbsenceRecorder">
                                                                <i class="fa fa-eye"></i>
                                                                {% trans %}Display{% endtrans %}
                                                            </button>
                                                        </div>
                                                    </div>
                                                </div>
                                            </form>
                                        </div>

                                        <div class="col-md-4">
                                            {% if selectedTerm is defined %}
                                                {# Si les absences sont déjà enregistrées #}
                                                {% if absences|length > 0 %}
                                                    {# affichage ligne de delete all absences #}
                                                    {% if not is_granted('ROLE_ADMIN') or is_granted ('ROLE_SUPER_ADMIN') %}
                                                        {% if mySession.get('verrou').verrou is not null and mySession.get('verrou').verrou == 0 %}
                                                            <form action="{{ path('absence_absenceRecorder', {'slug': teacher.slug}) }}" method="post" onsubmit="return confirm('{% trans %}Do you want to delete the hours of absence from class{% endtrans %} --- {{ selectedClassroom.classroom }} --- {% trans %}term{% endtrans %} N°{{ selectedTerm.term }} ?');">
                                                                <input type="hidden" name="term" value="{{ selectedTerm.id }}">
                                                                <input type="hidden" name="classroom" value="{{ selectedClassroom.id }}">
                                                                <div class="form-group">
                                                                    <button class="btn btn-outline-danger btn-medium w-100 br-7" type="submit" name="removeAllAbsences">
                                                                        <i class="fa fa-eraser"></i>
                                                                        {% trans %}Delete all these hours of absence{% endtrans %}
                                                                    </button>
                                                                </div>
                                                            </form>
                                                        {% endif %}
                                                    {% endif %}
                                                    {# fin affichage ligne de delete all absences #}
                                                {% endif %}
                                            {% endif %}
                                        </div>
                                    
                                    </div>
                                </div>
                                
                            </div>
                        </div>
                    </div>
                </div>		
			<!--End Row -->
            {% if selectedTerm is defined %}
                <div class="card border-primary">
                    <div class="card-header">
                        {# choix du trimestre et classe à saisir les absences #}
                        
                        {# choix du trimestre et classe à saisir les absences #}
                        {% if selectedTerm is defined %}
                            {# affichage du header contenant les information sur la saisie en cours #}
							<div class="fs-abs-summary">
								<div class="fs-abs-summary__item">
									<span class="fs-abs-summary__icon">
										<i class="fe fe-calendar"></i>
									</span>
									<span class="fs-abs-summary__label">{% trans %}Term{% endtrans %}</span>
									<strong class="fs-abs-summary__value">{% trans %}N°{% endtrans %} {{ selectedTerm.term }}</strong>
								</div>

								<div class="fs-abs-summary__item">
									<span class="fs-abs-summary__icon">
										<i class="fe fe-home"></i>
									</span>
									<span class="fs-abs-summary__label">{% trans %}Class{% endtrans %}</span>
									<strong class="fs-abs-summary__value">{{ selectedClassroom.classroom }}</strong>
								</div>

								<div class="fs-abs-summary__item">
									<span class="fs-abs-summary__icon">
										<i class="fe fe-users"></i>
									</span>
									<span class="fs-abs-summary__label">{% trans %}Effective{% endtrans %}</span>
									<strong class="fs-abs-summary__value">{{ students|length }}</strong>
								</div>
							</div>
                            {# fin affichage du header contenant les information sur la saisie en cours #}
                        {% endif %}
                    </div>
                    <div class="card-body ">
                        
                        {# affichage de la liste des elèves #}
                        {% if absenceToUpdate == null %}
                            {% if absences|length > 0 %}
                                {# affichage de la liste des elèves si les absences existent déjà #}
                                <div class="row mb-5">
                                    <div class="col-md-12">
                                        <div class="table-responsive"><table class="table table-striped fs-abs-table" id="dataTable" width="100%" cellspacing="0">
                                        <thead>
                                            <tr>
                                                <th class="border-bottom-0 indigo-gradient">{% trans %}N°{% endtrans %}</th>
                                                <th class="border-bottom-0 green-gradient">{% trans %}Full name{% endtrans %}</th>
                                                <th class="border-bottom-0 orange-gradient">{% trans %}Hours away{% endtrans %}</th>
                                                {% if is_granted('ROLE_ADMIN') or is_granted ('ROLE_SUPER_ADMIN') %}
                                                    <th class="border-bottom-0 blue-gradient">{% trans %}Entered by{% endtrans %}</th>
                                                    <th class="border-bottom-0 blue-gradient">{% trans %}Update by{% endtrans %}</th>
                                                {% endif %}
                                                <th class="border-bottom-0 blue-gradient">{% trans %}Actions{% endtrans %}</th>
                                            </tr>
                                        </thead>
                                        <tfoot>
                                        
                                            <th class="border-bottom-0 indigo-gradient">{% trans %}N°{% endtrans %}</th>
                                            <th class="border-bottom-0 green-gradient">{% trans %}Full name{% endtrans %}</th>
                                            <th class="border-bottom-0 orange-gradient">{% trans %}Hours away{% endtrans %}</th>
                                            {% if is_granted('ROLE_ADMIN') or is_granted ('ROLE_SUPER_ADMIN') %}
                                                <th class="border-bottom-0 blue-gradient">{% trans %}Entered by{% endtrans %}</th>
                                                <th class="border-bottom-0 blue-gradient">{% trans %}Update by{% endtrans %}</th>
                                            {% endif %}
                                            <th class="border-bottom-0 blue-gradient">{% trans %}Actions{% endtrans %}</th>
                                        </tfoot>
                                        
                                        {% set i = 1 %}
                                        {% for absence in absences %}
                                            <tr class="table-row">
                                                <td>{{ i }}</td>
                                                <td class="fs-abs-student-name">
                                                    {{ absence.student.fullName }}
                                                </td>
                                                <td>
                                                    <input type="text" name="absence{{i}}"   readonly="readonly" value="{{ absence.absence }}" class="form-control" >
                                                </td>
                                                
                                                {% if is_granted('ROLE_ADMIN') or is_granted ('ROLE_SUPER_ADMIN') %}
                                                    <td class="border-bottom-0 blue-gradient">{{ absence.createdBy.fullName }} <br>
                                                        {% trans %}At{% endtrans %} : {{ absence.createdAt|date('d/m/Y') }} - {{ absence.createdAt|date('H:i:s') }}
                                                    </td>
                                                    <td class="border-bottom-0 blue-gradient">{{ absence.updatedBy ? absence.updatedBy.fullName : "//" }} <br>
                                                        {% trans %}At{% endtrans %} : {{ absence.updatedBy ? absence.updatedAt|date('d/m/Y') : "//"}} - {{ absence.updatedBy ? absence.updatedAt|date('H:i:s'): "//"}}
                                                    </td>
                                                {% endif %}


                                                {% if mySession.get('verrou').verrou is not null and mySession.get('verrou').verrou == 0 %}
                                                <td>
                                                    <form action="{{ path('absence_absenceRecorder', {'slug': teacher.slug}) }}" method="post">
                                                        <input type="hidden" name="term" value="{{ selectedTerm.id }}">
                                                        <input type="hidden" name="classroom" value="{{ selectedClassroom.id }}">
                                                        <input type="hidden" name="absence" value="{{ absence.id }}">

                                                        <button type="submit" class="btn btn-outline-primary" data-bs-toggle="tooltip" title="{% trans %}Edit the absence hours for {{ absence.student.fullName }}{% endtrans %}" name="absenceToUpdate">
                                                            <i class="fa fa-pencil-square-o"></i>
                                                        </button>
                                                    </form>
                                                </td>
                                                {% endif %}
                                            </tr>
                                        {% set i = i + 1 %}
                                        {% endfor %}
                                        </table></div>
                                    </div>
                                </div>
                                {# fin affichage de la liste des elèves si les absences existent déjà #}
                            {% else %}
                                {# affichage de la liste des elèves si les absences n'existent pas encore #}
                                {% if not is_granted('ROLE_ADMIN') or is_granted ('ROLE_SUPER_ADMIN') %}
                                    <div class="row mb-5">
                                        <div class="col-md-12">
                                                {% if mySession.get('verrou').verrou is not null and mySession.get('verrou').verrou == 0 %}
                                                <form action="{{ path('absence_absenceRecorder', {'slug': teacher.slug}) }}" method="POST" onreset="return confirm('Do you want to reset all typed absences ?')">   
                                                    <input type="hidden" name="term" value="{{ selectedTerm.id }}">
                                                    <input type="hidden" name="classroom" value="{{ selectedClassroom.id }}">
                                                    <input type="hidden" name="numberOfStudents" value="{{ students|length }}">
                                                    <div class="row mb-5">
                                                        <div class="col-md-12">
                                                            <div class="table-responsive"><table class="table table-striped text-left fs-abs-table">
                                                                {% set i = 1 %}
                                                                {% for student in students %}
                                                                    <tr class="table-row">
                                                                        <td>
                                                                            <input type="hidden" name="student{{i}}" value="{{student.id}}">
                                                                        </td>
                                                                        <td class="fs-abs-student-name">
                                                                            {{ student.fullName }}
                                                                        </td>
                                                                        <td>
                                                                            <input type="number" name="absence{{i}}" required="required" min="0" max="500" step="1" class="form-control" value="0"> 
                                                                        </td>
                                                                    </tr>
                                                                    {% set i = i+1 %}
                                                                {% endfor %}
                                                            </table></div>
                                                        </div>
                                                    </div>
                                                    <div class="row">
                                                        <div class="col-md-3">
                                                            <input type="reset" class="btn btn-primary btn-medium w-100 br-7" value="Cancel">
                                                        </div>
                                                        <div class="col-md-6">
                                                        </div>
                                                        <div class="col-md-3">
                                                            <button type="submit" class="btn btn-outline-primary btn-medium w-100 br-7" name="saveAbsence">
                                                                <i class="fa fa-save"></i>
                                                                {% trans %}Save{% endtrans %}
                                                            </button>
                                                        </div>
                                                    </div>
                                                </form>
                                                {% else %}
                                                    {% trans %}Access denied. The entry of hours of absence for this quarter's account is locked.{% endtrans %}
                                                {% endif %}
                                        </div>
                                    </div>
                                    {% else %}
                                    <div class="row">
                                        <div class="col-md-12 text-center p-5">
                                            {% trans %}These hours of absence are not yet entered by the supervisor{% endtrans %}
                                        </div>
                                    </div>
                                {% endif %}

                                {# fin affichage de la liste des elèves si les absences n'existent pas encore #}
                            {% endif %}
                        {% else %}
                                {# affichage du formulaire de modification d'une absence #}
                                <div class="row mb-5">
                                    <div class="col-md-12">
                                        {% if mySession.get('verrou').verrou is not null and mySession.get('verrou').verrou == 0 %}
                                        <form action="{{ path('absence_absenceRecorder', {'slug': teacher.slug}) }}" method="post"> 
                                            <input type="hidden" name="term" value="{{ selectedTerm.id }}">
                                            <input type="hidden" name="classroom" value="{{ selectedClassroom.id }}">
                                            <input type="hidden" name="absenceToUpdateId" value="{{ absenceToUpdate.id }}">
                                            <div class="row p-5">
                                                <div class="col-md-6">
                                                    {{ absenceToUpdate.student.fullName }}
                                                </div>
                                                <div class="col-md-2">
                                                    <input type="number" name="updatedAbsence" required="required" min="0"  step="1" value="{{ absenceToUpdate.absence }}" class="form-control">
                                                </div>
                                                <div class="col-md-3">
                                                    <button type="submit" class="btn btn-outline-primary btn-medium w-100 br-7" name="updateAbsence">
                                                        {% trans %}Save Changes{% endtrans %}
                                                    </button>
                                                </div>
                                            </div>
                                        </form>
                                        {% endif %}
                                    </div>
                                </div>
                                {# fin affichage du formulaire de modification d'une absence #}
                        {% endif %}
                        {# fin affichage de la liste des elèves #}
                        
                    </div>
                </div>
            {% endif %}
        </div>
    </div>
</div>

{% endblock %}

{% block javascripts %}
	{{ parent() }}
	<script src="{{ asset('build/custom/js/freeschool-absence-recorder-premium-clean.js') }}"></script>
{% endblock %}
