<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <title>{% trans %}Reset code{% endtrans %}</title>
</head>
<body style="font-family: Arial, sans-serif; background:#f8fafc; margin:0; padding:24px;">
    <div style="max-width:560px; margin:0 auto; background:#ffffff; border-radius:18px; padding:32px; box-shadow:0 10px 35px rgba(15,23,42,.08);">
        <h2 style="margin-top:0; color:#0f172a;">{% trans %}Hello{% endtrans %} {{ fullName }},</h2>
        <p style="color:#475569; line-height:1.6;">{% trans %}Here is your FreeSchool reset code. It is valid for{% endtrans %} {{ expiration }} {% trans %}minutes.{% endtrans %}</p>
        <div style="margin:28px 0; text-align:center;">
            <span style="display:inline-block; padding:16px 28px; border-radius:16px; background:#eff6ff; color:#1d4ed8; font-size:32px; font-weight:800; letter-spacing:8px;">{{ code }}</span>
        </div>
        <p style="color:#475569; line-height:1.6;">{% trans %}If you did not request this, you can ignore this email.{% endtrans %}</p>
        <p style="color:#94a3b8; font-size:12px; margin-bottom:0;">{% trans %}FreeSchool • Secure password reset{% endtrans %}</p>
    </div>
</body>
</html>
