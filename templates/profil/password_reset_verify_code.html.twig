{% extends 'baseLoggin.html.twig' %}

{% block title %}{% trans %}Verification code{% endtrans %}{% endblock %}

{% block body %}
<div class="hor-content main-content">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-xl-5 col-lg-6 col-md-8">
                <div class="card border-primary mt-6 shadow-sm">
                    <div class="card-header text-center">
                        <h3 class="mb-0"><i class="fa fa-shield me-2"></i>{% trans %}Code verification{% endtrans %}</h3>
                    </div>
                    <div class="card-body">
                        <p class="text-muted">
                            {% trans %}We sent a 5-digit code to:{% endtrans %} <strong>{{ email }}</strong>
                        </p>
                        <form method="post">
                            <div class="mb-3">
                                <label class="form-label" for="code">{% trans %}5-digit code{% endtrans %}</label>
                                <input type="text" class="form-control text-center" id="code" name="code" required maxlength="5" pattern="[0-9]{5}" inputmode="numeric" style="font-size: 24px; letter-spacing: 8px; font-weight: 700;">
                            </div>
                            <button class="btn btn-primary w-100" type="submit">
                                <i class="fa fa-check me-2"></i>{% trans %}Validate code{% endtrans %}
                            </button>
                            <a href="{{ path('password_reset_request') }}" class="btn btn-outline-secondary w-100 mt-3">
                                {% trans %}Request a new code{% endtrans %}
                            </a>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
