{% extends 'base.html.twig' %}

{% block title %}{% trans %}Display Classroom{% endtrans %}{% endblock %}

{% block subTitle %}
	{% trans %}CLASSROOMS MANAGMENT{% endtrans %}
{% endblock %}

{% block infoMessage %}
	{% include "includes/_info_message.html.twig" %}
{% endblock %}

{% block stylesheets %}
	{{ parent() }}
	<link rel="stylesheet" href="{{ asset('build/custom/css/freeschool-classroom-display-premium.css') }}">
{% endblock %}

{% block body %}
	{% set canManageClassrooms = false %}
	{% if is_granted('ROLE_ADMIN') or is_granted ('ROLE_SUPER_ADMIN') or is_granted('ROLE_PROVISEUR') %}
		{% if mySession.get('verrou').verrou is not null and mySession.get('verrou').verrou == 0 %}
			{% set canManageClassrooms = true %}
		{% endif %}
	{% endif %}

	<div class="hor-content main-content fs-classroom-page">
		<div class="container">
			<div class="fs-classroom-menu-safe-space" aria-hidden="true"></div>

			<section class="fs-classroom-hero">
				<div class="fs-classroom-hero__content">
					<div>
						<span class="fs-classroom-eyebrow">
							<i class="fe fe-home"></i>
							{% trans %}School structure{% endtrans %}
						</span>

						<h1 class="fs-classroom-title">{% trans %}CLASSROOMS MANAGMENT{% endtrans %}</h1>

						<p class="fs-classroom-subtitle">
							{% trans %}Manage classrooms, staff attachments, students and lessons through a refined premium workspace.{% endtrans %}
						</p>
					</div>

					<div class="fs-classroom-hero__right">
						<div class="fs-classroom-hero-stat">
							<span class="fs-classroom-hero-stat__icon">
								<i class="fe fe-home"></i>
							</span>
							<span class="fs-classroom-hero-stat__label">{% trans %}Registered classrooms{% endtrans %}</span>
							<strong class="fs-classroom-hero-stat__value">{{ classrooms|length }}</strong>
						</div>

						{% if canManageClassrooms %}
							<a href="{{ path('classroom_saveClassroom') }}" class="fs-classroom-btn fs-classroom-btn--hero-add" name="addNewClassroom">
								<i class="fe fe-plus"></i>
								<span>{% trans %}Add new classroom{% endtrans %}</span>
							</a>
						{% endif %}
					</div>
				</div>
			</section>

			<section class="fs-classroom-legend-card">
				<div class="fs-classroom-legend-item fs-classroom-legend-item--info">
					<span>{% trans %}Pr. Teach{% endtrans %}</span>
					<strong>{% trans %}Principal teacher{% endtrans %}</strong>
				</div>

				<div class="fs-classroom-legend-item fs-classroom-legend-item--primary">
					<span>{% trans %}Att. Sup.{% endtrans %}</span>
					<strong>{% trans %}Attached supervisor{% endtrans %}</strong>
				</div>

				<div class="fs-classroom-legend-item fs-classroom-legend-item--violet">
					<span>{% trans %}Att. Vice Principal.{% endtrans %}</span>
					<strong>{% trans %}Attached censor{% endtrans %}</strong>
				</div>

				<div class="fs-classroom-legend-item fs-classroom-legend-item--success">
					<span>{% trans %}Att. Coun.{% endtrans %}</span>
					<strong>{% trans %}Attached counsillor{% endtrans %}</strong>
				</div>
			</section>

			<section class="fs-classroom-card">
				<div class="fs-classroom-card__header">
					<div>
						<span class="fs-classroom-card-badge">
							<i class="fe fe-list"></i>
							{% trans %}Dynamic table{% endtrans %}
						</span>

						<h2 class="fs-classroom-card-title">{% trans %}Registered classrooms{% endtrans %}</h2>
					</div>

					<div class="fs-classroom-table-tools">
						<div class="fs-classroom-search">
							<i class="fe fe-search"></i>
							<input type="text" id="fsClassroomSearch" placeholder="{% trans %}Search classroom...{% endtrans %}">
						</div>

						<button type="button" class="fs-classroom-btn fs-classroom-btn--ghost" id="fsClassroomPrint">
							<i class="fe fe-printer"></i>
							<span>{% trans %}Print{% endtrans %}</span>
						</button>
					</div>
				</div>

				<div class="fs-classroom-table-wrap">
					<table class="table fs-classroom-table" id="fsClassroomTable">
						<thead>
							<tr>
								<th>
									<button type="button" class="fs-classroom-sort" data-sort-index="0">
										<span>{% trans %}Classroom{% endtrans %}</span>
										<i class="fe fe-chevron-down"></i>
									</button>
								</th>
								<th>
									<button type="button" class="fs-classroom-sort" data-sort-index="1">
										<span>{% trans %}Att. Sup.{% endtrans %} / {% trans %}Pr. Teach{% endtrans %}</span>
										<i class="fe fe-chevron-down"></i>
									</button>
								</th>
								<th>
									<button type="button" class="fs-classroom-sort" data-sort-index="2">
										<span>{% trans %}Att. Coun.{% endtrans %} / {% trans %}Social action{% endtrans %}</span>
										<i class="fe fe-chevron-down"></i>
									</button>
								</th>
								<th>
									<button type="button" class="fs-classroom-sort" data-sort-index="3">
										<span>{% trans %}Att. censor{% endtrans %}</span>
										<i class="fe fe-chevron-down"></i>
									</button>
								</th>
								{% if canManageClassrooms %}
									<th class="text-center">{% trans %}Actions{% endtrans %}</th>
								{% endif %}
							</tr>
						</thead>

						<tbody>
							{% for classroom in classrooms %}
								<tr>
									<td data-label="{% trans %}Classroom{% endtrans %}">
										<div class="fs-classroom-main-cell">
											<span class="fs-classroom-icon">
												<i class="fe fe-home"></i>
											</span>

											<div>
												<strong>{{ classroom.classroom }}</strong>

												<div class="fs-classroom-metrics">
													<span class="{% if classroom.students|length == 0 %}fs-metric fs-metric--danger{% else %}fs-metric fs-metric--primary{% endif %}">
														<i class="fe fe-users"></i>
														{% trans %}Effective{% endtrans %} : {{ classroom.students|length }}
													</span>

													<span class="{% if classroom.lessons|length == 0 %}fs-metric fs-metric--danger{% else %}fs-metric fs-metric--info{% endif %}">
														<i class="fe fe-book"></i>
														{% trans %}Number of lessons{% endtrans %} : {{ classroom.lessons|length }}
													</span>
												</div>
											</div>
										</div>
									</td>

									<td data-label="{% trans %}Att. Sup.{% endtrans %} / {% trans %}Pr. Teach{% endtrans %}">
										<div class="fs-classroom-staff-stack">
											<span class="fs-staff-pill fs-staff-pill--primary">
												<i class="fe fe-user-check"></i>
												{{ classroom.supervisor ? classroom.supervisor.fullname : '—'}}
											</span>
											<span class="fs-staff-pill fs-staff-pill--soft">
												<i class="fe fe-user"></i>
												{{ classroom.principalTeacher ? classroom.principalTeacher.fullname : '—'}}
											</span>
										</div>
									</td>

									<td data-label="{% trans %}Att. Coun.{% endtrans %} / {% trans %}Social action{% endtrans %}">
										<div class="fs-classroom-staff-stack">
											<span class="fs-staff-pill fs-staff-pill--success">
												<i class="fe fe-heart"></i>
												{{ classroom.actionSociale ? classroom.actionSociale.fullname : '—'}}
											</span>
											<span class="fs-staff-pill fs-staff-pill--cyan">
												<i class="fe fe-compass"></i>
												{{ classroom.counsellor ? classroom.counsellor.fullname : '—'}}
											</span>
										</div>
									</td>

									<td data-label="{% trans %}Att. censor{% endtrans %}">
										<span class="fs-staff-pill fs-staff-pill--warning">
											<i class="fe fe-shield"></i>
											{{ classroom.censor ? classroom.censor.fullname : '—'}}
										</span>
									</td>

									{% if canManageClassrooms %}
										<td class="text-center" data-label="{% trans %}Actions{% endtrans %}">
											<div class="dropdown fs-classroom-actions">
												<button class="fs-classroom-action fs-classroom-action--options" data-bs-toggle="dropdown" type="button" aria-haspopup="true" aria-expanded="false">
													<span>{% trans %}Options{% endtrans %}</span>
													<i class="fe fe-chevron-down"></i>
												</button>

												<div class="dropdown-menu fs-classroom-dropdown">
													<a class="dropdown-item" href="{{ path('classroom_editClassroom', {'slug': classroom.slug}) }}">
														<i class="fe fe-edit me-2"></i>
														{% trans %}Edit{% endtrans %}
													</a>

													{% if classroom.students|length == 0 and classroom.lessons|length == 0 %}
														<a class="dropdown-item text-danger" href="javascript:void(0);"
															onclick="swal({
																'title': '{% trans %}Warning !{% endtrans %}',
																'type': 'warning',
																'text': '{% trans %}Do you want to delete classroom {% endtrans %} - {{ classroom.classroom }} ?',
																'showCancelButton': true,
																'confirmButtonText': '{% trans %}Yes{% endtrans %}',
																'confirmButtonColor': '#f00',
																'cancelButtonText': '{% trans %}No{% endtrans %}',
																'cancelButtonColor': '#186106',
																'confirmButtonPath': '{{ path('classroom_deleteClassroom', {'slug': classroom.slug}) }} '});">
															<i class="fe fe-trash me-2"></i>
															{% trans %}Delete{% endtrans %}
														</a>
													{% else %}
														<a class="dropdown-item text-danger" href="javascript:void(0);"
															onclick="swal({
																'title': '{% trans %}Danger{% endtrans %}',
																'text': '{% trans %}Delete denied. This classroom have students!{% endtrans %}',
																'type': 'error',
																'showCancelButton': true,
																'showConfirmButton': false,
																'confirmButtonText': false,
																'cancelButtonText': 'OK',
																'cancelButtonColor': '#088318'
															})">
															<i class="fe fe-trash me-2"></i>
															{% trans %}Delete{% endtrans %}
														</a>
													{% endif %}
												</div>
											</div>
										</td>
									{% endif %}
								</tr>
							{% else %}
								<tr>
									<td colspan="{% if canManageClassrooms %}5{% else %}4{% endif %}">
										<div class="fs-classroom-empty">
											<i class="fe fe-folder"></i>
											<strong>{% trans %}No classroom found{% endtrans %}</strong>
											<span>{% trans %}Start by creating a new classroom.{% endtrans %}</span>
										</div>
									</td>
								</tr>
							{% endfor %}
						</tbody>
					</table>
				</div>

				<div class="fs-classroom-table-footer">
					<div class="fs-classroom-table-footer__left">
						<span id="fsClassroomResultCount"></span>
					</div>

					<div class="fs-classroom-footer-controls">
						<label class="fs-classroom-page-size">
							<span>{% trans %}Rows{% endtrans %}</span>
							<select id="fsClassroomRowsPerPage">
								<option value="5">5</option>
								<option value="10" selected>10</option>
								<option value="25">25</option>
								<option value="50">50</option>
							</select>
						</label>

						<div class="fs-classroom-pagination" id="fsClassroomPagination" aria-label="{% trans %}Pagination{% endtrans %}"></div>
					</div>
				</div>
			</section>
		</div>
	</div>
{% endblock %}

{% block javascripts %}
	{{ parent() }}
	<script src="{{ asset('build/custom/js/freeschool-classroom-display-premium.js') }}"></script>
{% endblock %}
