									<h3>{% trans %}3rd assessment grades{% endtrans %}</h3>
									<p>{% trans %}Controls the third assessment grade entry.{% endtrans %}</p>
								</div>
							</div>

							<div class="fs-lock-switch-line">
								<span class="fs-lock-state-label {% if verrouSequence3.verrouSequence == 1 %}is-locked{% else %}is-unlocked{% endif %}" data-lock-label>
									{% if verrouSequence3.verrouSequence == 1 %}{% trans %}Locked{% endtrans %}{% else %}{% trans %}Unlocked{% endtrans %}{% endif %}
								</span>

								<label class="fs-lock-switch">
