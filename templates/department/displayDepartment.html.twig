{% extends 'base.html.twig' %}

{% block title %}{% trans %}Display Department{% endtrans %}{% endblock %}

{% block subTitle %}
	{% trans %}DEPARTMENTS MANAGMENT{% endtrans %}
{% endblock %}

{% block infoMessage %}
	{% include "includes/_info_message.html.twig" %}
{% endblock %}

{% block stylesheets %}
	{{ parent() }}
	<link rel="stylesheet" href="{{ asset('build/custom/css/freeschool-department-display-premium.css') }}">
{% endblock %}

{% block body %}
	{% set canManageDepartments = false %}
	{% if is_granted('ROLE_ADMIN') or is_granted ('ROLE_SUPER_ADMIN') or is_granted('ROLE_PROVISEUR') %}
		{% if mySession.get('verrou').verrou is not null and mySession.get('verrou').verrou == 0 %}
			{% set canManageDepartments = true %}
		{% endif %}
	{% endif %}

	<div class="hor-content main-content fs-department-page">
		<div class="container">
			<div class="fs-department-menu-safe-space" aria-hidden="true"></div>

			<section class="fs-department-hero">
				<div class="fs-department-hero__content">
					<span class="fs-department-eyebrow">
						<i class="fe fe-grid"></i>
						{% trans %}School structure{% endtrans %}
					</span>

					<h1 class="fs-department-title">
						{% trans %}DEPARTMENTS MANAGMENT{% endtrans %}
					</h1>

					<p class="fs-department-subtitle">
						{% trans %}Manage departments, facilitators, teachers and subject printing through a premium workspace.{% endtrans %}
					</p>
				</div>

				<div class="fs-department-hero__right">
					<div class="fs-department-hero-stat">
						<span class="fs-department-hero-stat__icon">
							<i class="fe fe-layers"></i>
						</span>
						<span class="fs-department-hero-stat__label">{% trans %}Registered departments{% endtrans %}</span>
						<strong class="fs-department-hero-stat__value">{{ departments|length }}</strong>
					</div>

					{% if canManageDepartments %}
						<a href="{{ path('department_saveDepartment') }}" class="fs-department-btn fs-department-btn--hero-add" name="addNewDepartment">
							<i class="fe fe-plus"></i>
							<span>{% trans %}Add new department{% endtrans %}</span>
						</a>
					{% endif %}
				</div>
			</section>

			{% if canManageDepartments %}
				<form action="{{ path('department_bulkDeleteDepartment') }}" method="post" id="fsDepartmentsBulkDeleteForm">
					<input type="hidden" name="_token" value="{{ csrf_token('bulk_delete_department') }}">
				</form>
			{% endif %}

			<section class="fs-department-card">
				<div class="fs-department-card__header">
					<div>
						<span class="fs-department-card-badge">
							<i class="fe fe-list"></i>
							{% trans %}Dynamic table{% endtrans %}
						</span>

						<h2 class="fs-department-card-title">
							{% trans %}Registered departments{% endtrans %}
						</h2>
					</div>

					<div class="fs-department-table-tools">
						<div class="fs-department-search">
							<i class="fe fe-search"></i>
							<input type="text" id="fsDepartmentSearch" placeholder="{% trans %}Search department...{% endtrans %}">
						</div>

						<button type="button" class="fs-department-btn fs-department-btn--ghost" id="fsDepartmentPrint">
							<i class="fe fe-printer"></i>
							<span>{% trans %}Print{% endtrans %}</span>
						</button>
					</div>
				</div>

				{% if canManageDepartments %}
					<div class="fs-department-bulkbar" id="fsDepartmentBulkbar">
						<div class="fs-department-bulkbar__left">
							<span class="fs-department-bulkbar__icon">
								<i class="fe fe-check"></i>
							</span>
							<strong id="fsDepartmentSelectedCount">{% trans %}0 departments selected{% endtrans %}</strong>
							<span class="fs-department-bulkbar__hint">{% trans %}Select departments to apply a grouped action.{% endtrans %}</span>
						</div>

						<div class="fs-department-bulkbar__actions">
							<button type="button" class="fs-department-bulkbar__btn fs-department-bulkbar__btn--ghost" id="fsDepartmentClearSelection">
								<i class="fe fe-x"></i>
								<span>{% trans %}Clear{% endtrans %}</span>
							</button>

							<button type="button" class="fs-department-bulkbar__btn fs-department-bulkbar__btn--danger" id="fsDepartmentBulkDelete">
								<i class="fe fe-trash"></i>
								<span>{% trans %}Delete selected departments{% endtrans %}</span>
							</button>
						</div>
					</div>
				{% endif %}

				<div class="fs-department-table-wrap">
					<table class="table fs-department-table" id="fsDepartmentTable">
						<thead>
							<tr>
								{% if canManageDepartments %}
									<th class="fs-department-check-col">
										<label class="fs-department-check" title="{% trans %}Select all visible departments{% endtrans %}">
											<input type="checkbox" id="fsDepartmentSelectAll">
											<span></span>
										</label>
									</th>
								{% endif %}

								<th>
									<button type="button" class="fs-department-sort" data-sort-index="{% if canManageDepartments %}1{% else %}0{% endif %}">
										<span>{% trans %}Department{% endtrans %}</span>
										<i class="fe fe-chevron-down"></i>
									</button>
								</th>

								<th>
									<button type="button" class="fs-department-sort" data-sort-index="{% if canManageDepartments %}2{% else %}1{% endif %}">
										<span>{% trans %}Educational facilitator{% endtrans %}</span>
										<i class="fe fe-chevron-down"></i>
									</button>
								</th>

								<th class="text-center">
									<button type="button" class="fs-department-sort" data-sort-index="{% if canManageDepartments %}3{% else %}2{% endif %}">
										<span>{% trans %}Effective{% endtrans %}</span>
										<i class="fe fe-chevron-down"></i>
									</button>
								</th>

								<th class="text-center">{% trans %}Print subjects{% endtrans %}</th>

								{% if canManageDepartments %}
									<th class="text-center">{% trans %}Actions{% endtrans %}</th>
								{% endif %}
							</tr>
						</thead>

						<tbody>
							{% for department in departments %}
								<tr data-department-slug="{{ department.slug }}" data-department-name="{{ department.department }}">
									{% if canManageDepartments %}
										<td class="fs-department-check-col" data-label="{% trans %}Select{% endtrans %}">
											<label class="fs-department-check">
												<input
													type="checkbox"
													class="fs-department-row-check"
													name="departmentSlugs[]"
													value="{{ department.slug }}"
													form="fsDepartmentsBulkDeleteForm"
													data-department-name="{{ department.department }}"
													{% if department.teachers|length > 0 or department.subjects|length > 0 %}
														data-locked="1"
													{% else %}
														data-locked="0"
													{% endif %}
												>
												<span></span>
											</label>
										</td>
									{% endif %}

									<td data-label="{% trans %}Department{% endtrans %}">
										<div class="fs-department-name-cell">
											<span class="fs-department-icon">
												<i class="fe fe-grid"></i>
											</span>
											<strong>{{ department.department }}</strong>
										</div>
									</td>

									<td data-label="{% trans %}Educational facilitator{% endtrans %}">
										<div class="fs-department-facilitator">
											<span class="fs-department-avatar">
												{{ department.educationalFacilitator ? department.educationalFacilitator.fullName|slice(0, 1)|upper : '?' }}
											</span>
											<div>
												<strong>{{ department.educationalFacilitator ? department.educationalFacilitator.fullName : '—' }}</strong>
												<span>{% trans %}Facilitator{% endtrans %}</span>
											</div>
										</div>
									</td>

									<td class="text-center" data-label="{% trans %}Effective{% endtrans %}">
										<span class="fs-department-count-badge {% if department.teachers|length > 0 %}fs-department-count-badge--active{% endif %}">
											{{ department.teachers|length }}
											<small>{% trans %}teachers{% endtrans %}</small>
										</span>
									</td>

									<td class="text-center" data-label="{% trans %}Print subjects{% endtrans %}">
										<a href="{{ path ('print_subject_by_department', {'slug': department.slug }) }}" class="fs-department-action fs-department-action--print" target="_blank">
											<i class="fe fe-printer"></i>
											<span>{% trans %}Print subjects{% endtrans %}</span>
										</a>
									</td>

									{% if canManageDepartments %}
										<td class="text-center" data-label="{% trans %}Actions{% endtrans %}">
											<div class="fs-department-actions">
												<form action="{{ path('department_editDepartment', {'slug': department.slug}) }}" method="post" class="fs-department-action-form">
													<button type="submit" class="fs-department-action fs-department-action--edit" name="departmentToUpdate" data-bs-toggle="tooltip" title="{% trans %}Edit the department of {{ department.department }}{% endtrans %}">
														<i class="fe fe-edit"></i>
														<span>{% trans %}Edit{% endtrans %}</span>
													</button>
												</form>

												{% if department.teachers|length > 0 %}
													<a class="fs-department-action fs-department-action--delete" href="javascript:void(0);"
														onclick="swal({
															'title': '{% trans %}Danger{% endtrans %}',
															'text': '{% trans %}Delete denied. This department have teachers !{% endtrans %}',
															'type': 'error',
															'showCancelButton': true,
															'showConfirmButton': false,
															'confirmButtonText': false,
															'cancelButtonText': 'OK',
															'cancelButtonColor': '#088318'
														})">
														<i class="fe fe-trash"></i>
														<span>{% trans %}Delete{% endtrans %}</span>
													</a>
												{% else %}
													<a class="fs-department-action fs-department-action--delete" href="javascript:void(0);"
														onclick="swal({
															'title': '{% trans %}Warning !{% endtrans %}',
															'type': 'warning',
															'text': '{% trans %}Do you want to delete department ?{% endtrans %} - {{ department.department }} ?',
															'showCancelButton': true,
															'confirmButtonText': '{% trans %}Yes{% endtrans %}',
															'confirmButtonColor': '#f00',
															'cancelButtonText': '{% trans %}No{% endtrans %}',
															'cancelButtonColor': '#186106',
															'confirmButtonPath': '{{ path('department_deleteDepartment', {'slug': department.slug}) }} '});">
														<i class="fe fe-trash"></i>
														<span>{% trans %}Delete{% endtrans %}</span>
													</a>
												{% endif %}
											</div>
										</td>
									{% endif %}
								</tr>
							{% else %}
								<tr>
									<td colspan="{% if canManageDepartments %}6{% else %}4{% endif %}">
										<div class="fs-department-empty">
											<i class="fe fe-folder"></i>
											<strong>{% trans %}No department found{% endtrans %}</strong>
											<span>{% trans %}Start by creating a new department.{% endtrans %}</span>
										</div>
									</td>
								</tr>
							{% endfor %}
						</tbody>
					</table>
				</div>

				<div class="fs-department-table-footer">
					<div class="fs-department-table-footer__left">
						<span id="fsDepartmentResultCount"></span>
					</div>

					<div class="fs-department-footer-controls">
						<label class="fs-department-page-size">
							<span>{% trans %}Rows{% endtrans %}</span>
							<select id="fsDepartmentRowsPerPage">
								<option value="5">5</option>
								<option value="10" selected>10</option>
								<option value="25">25</option>
								<option value="50">50</option>
							</select>
						</label>

						<div class="fs-department-pagination" id="fsDepartmentPagination" aria-label="{% trans %}Pagination{% endtrans %}"></div>
					</div>
				</div>
			</section>
		</div>
	</div>
{% endblock %}

{% block javascripts %}
	{{ parent() }}
	<script src="{{ asset('build/custom/js/freeschool-department-display-premium.js') }}"></script>
{% endblock %}
