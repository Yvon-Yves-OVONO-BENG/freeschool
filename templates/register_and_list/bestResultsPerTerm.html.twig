							<i class="fe fe-trending-up"></i>
						</span>
						<div>
							<h3>{% trans %}Top five students by level{% endtrans %}</h3>
							<p>{% trans %}Print top five students by period and level.{% endtrans %}</p>
						</div>
					</div>

					<form action="{{ path('top_five_students_by_level') }}" method="post" target="_blank" class="fs-bt-form fs-bt-form--two needs-validation" novalidate data-no-spinner="1">
						<div class="fs-floating-field fs-required-field">
							<select name="term" id="termLevelTopFive" class="form-control select2 custom-select fs-floating-control" data-placeholder="" required>
