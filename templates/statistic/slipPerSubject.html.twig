	</div>
</section>

<section class="fs-stat-card">
	<div class="fs-stat-card__header">
		<div>
			<span class="fs-stat-chip">
				<i class="fa fa-clock-o"></i>
				{% trans %}Printing workspace{% endtrans %}
			</span>
			<h2 class="fs-stat-card__title">{% trans %}Teaching hours and programm coverage synthesis form per subject{% endtrans %}</h2>
			<p class="fs-stat-card__subtitle">{% trans %}Choose a period to print teaching hours and program coverage synthesis by subject.{% endtrans %}</p>
