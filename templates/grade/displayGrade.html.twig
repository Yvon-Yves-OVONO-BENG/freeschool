{% extends 'base.html.twig' %}

{% block title %}{% trans %}Display Grade{% endtrans %}{% endblock %}

{% block infoMessage %}
	{% include "includes/_info_message.html.twig" %}
{% endblock %}

{% block stylesheets %}
	{{ parent() }}
	<link rel="stylesheet" href="{{ asset('build/custom/css/freeschool-rank-display-premium.css') }}">
{% endblock %}

{% block body %}
	{% set canManageRanks = false %}
	{% if is_granted('ROLE_ADMIN') or is_granted ('ROLE_SUPER_ADMIN') or is_granted('ROLE_PROVISEUR') %}
		{% if mySession.get('verrou').verrou is not null and mySession.get('verrou').verrou == 0 %}
			{% set canManageRanks = true %}
		{% endif %}
	{% endif %}

	<div class="hor-content main-content fs-ranks-page">
		<div class="container">
			<div class="fs-ranks-menu-safe-space" aria-hidden="true"></div>

			<section class="fs-ranks-hero fs-ranks-hero--executive">
				<div class="fs-ranks-hero__content">
					<span class="fs-ranks-eyebrow">
						<i class="fa fa-paper-plane"></i>
						{% trans %}School configuration{% endtrans %}
					</span>

					<h1 class="fs-ranks-title">
						{% trans %}RANKS MANAGMENT{% endtrans %}
					</h1>

					<p class="fs-ranks-subtitle">
						{% trans %}Manage registered ranks, monitor their usage and keep your staff structure organized.{% endtrans %}
					</p>
				</div>

				<div class="fs-ranks-hero__right">
					<div class="fs-ranks-hero-stats">
						<div class="fs-ranks-hero-stat">
							<span class="fs-ranks-hero-stat__icon">
								<i class="fa fa-list"></i>
							</span>
							<span class="fs-ranks-hero-stat__label">{% trans %}Number of registered ranks{% endtrans %}</span>
							<strong class="fs-ranks-hero-stat__value">{{ grades|length }}</strong>
						</div>

						<div class="fs-ranks-hero-stat">
							<span class="fs-ranks-hero-stat__icon">
								<i class="fa fa-shield-alt"></i>
							</span>
							<span class="fs-ranks-hero-stat__label">{% trans %}Management status{% endtrans %}</span>
							<strong class="fs-ranks-hero-stat__value fs-ranks-hero-stat__value--status">
								{% if mySession.get('verrou').verrou is not null and mySession.get('verrou').verrou == 0 %}
									{% trans %}Unlocked{% endtrans %}
								{% else %}
									{% trans %}Locked{% endtrans %}
								{% endif %}
							</strong>
						</div>
					</div>

					{% if canManageRanks %}
						<form action="{{ path('grade_saveGrade') }}" method="post" class="fs-ranks-inline-form" data-fs-modal-form="true" data-fs-preserve-action="true" data-modal-title="{% trans %}Add new rank{% endtrans %}" data-modal-size="md">
							<button type="submit" class="fs-ranks-btn fs-ranks-btn--hero" name="addNewGrade">
								<i class="fa fa-plus"></i>
								<span>{% trans %}Add new rank{% endtrans %}</span>
							</button>
						</form>
					{% endif %}
				</div>
			</section>

            {% if canManageRanks %}
                <form action="{{ path('grade_bulkDeleteGrade') }}" method="post" id="fsRanksBulkDeleteForm">
                    <input type="hidden" name="_token" value="{{ csrf_token('bulk_delete_grade') }}">
                </form>
            {% endif %}

			<section class="fs-ranks-card">
				<div class="fs-ranks-card__header">
					<div>
						<span class="fs-ranks-card__badge">
							<i class="fa fa-table"></i>
							{% trans %}Dynamic table{% endtrans %}
						</span>

						<h2 class="fs-ranks-card__title">
							{% trans %}Registered ranks{% endtrans %}
						</h2>
					</div>

					<div class="fs-ranks-card__tools">
						<div class="fs-ranks-search">
							<i class="fa fa-search"></i>
							<input type="text" id="fsRanksSearch" placeholder="{% trans %}Search rank...{% endtrans %}">
						</div>

						<button type="button" class="fs-ranks-btn fs-ranks-btn--ghost" id="fsRanksPrint">
							<i class="fe fe-printer"></i>
							<span>{% trans %}Print{% endtrans %}</span>
						</button>
					</div>
				</div>

				{% if canManageRanks %}
					<div class="fs-ranks-bulkbar" id="fsRanksBulkbar">
						<div class="fs-ranks-bulkbar__left">
							<span class="fs-ranks-bulkbar__icon">
								<i class="fa fa-check"></i>
							</span>
							<strong id="fsRanksSelectedCount">{% trans %}0 ranks selected{% endtrans %}</strong>
							<span class="fs-ranks-bulkbar__hint">{% trans %}Select ranks to apply a grouped action.{% endtrans %}</span>
						</div>

						<div class="fs-ranks-bulkbar__actions">
							<button type="button" class="fs-ranks-bulkbar__btn fs-ranks-bulkbar__btn--ghost" id="fsRanksClearSelection">
								<i class="fa fa-times"></i>
								<span>{% trans %}Clear{% endtrans %}</span>
							</button>

							<button type="submit" form="fsRanksBulkDeleteForm" class="fs-ranks-bulkbar__btn fs-ranks-bulkbar__btn--danger" id="fsRanksBulkDelete">
								<i class="fe fe-trash"></i>
								<span>{% trans %}Delete selected ranks{% endtrans %}</span>
							</button>
						</div>
					</div>
				{% endif %}

				<div class="fs-ranks-card__body">
					<div class="fs-ranks-table-wrap">
						<table class="table fs-ranks-table" id="fsRanksTable">
							<thead>
								<tr>
									{% if canManageRanks %}
										<th class="fs-ranks-check-col">
											<label class="fs-ranks-check fs-ranks-check--head" title="{% trans %}Select all visible ranks{% endtrans %}">
												<input type="checkbox" id="fsRanksSelectAll">
												<span></span>
											</label>
										</th>
									{% endif %}

									<th>
										<button type="button" class="fs-ranks-sort" data-sort-index="{% if canManageRanks %}1{% else %}0{% endif %}">
											<span>{% trans %}Rank{% endtrans %}</span>
											<i class="fa fa-sort"></i>
										</button>
									</th>

									<th class="text-center">
										<button type="button" class="fs-ranks-sort" data-sort-index="{% if canManageRanks %}2{% else %}1{% endif %}">
											<span>{% trans %}Effective{% endtrans %}</span>
											<i class="fa fa-sort"></i>
										</button>
									</th>

									{% if canManageRanks %}
										<th class="text-center">{% trans %}Actions{% endtrans %}</th>
									{% endif %}
								</tr>
							</thead>

							<tbody>
								{% for grade in grades %}
									<tr data-grade-slug="{{ grade.slug }}" data-grade-name="{{ grade.grade }}" data-can-delete="{% if grade.teachers|length > 0 %}0{% else %}1{% endif %}">
										{% if canManageRanks %}
											<td class="fs-ranks-check-col" data-label="{% trans %}Select{% endtrans %}">
												<label class="fs-ranks-check">
													<input
														type="checkbox"
														class="fs-ranks-row-check"
														name="gradeSlugs[]"
														value="{{ grade.slug }}"
														form="fsRanksBulkDeleteForm"
														data-rank-name="{{ grade.grade }}"
														{% if grade.teachers|length > 0 %}
															data-locked="1"
														{% else %}
															data-locked="0"
														{% endif %}
													>
													<span></span>
												</label>
											</td>
										{% endif %}

										<td data-label="{% trans %}Rank{% endtrans %}">
											<div class="fs-ranks-rank-cell">
												<span class="fs-ranks-rank-icon">
													<i class="fa fa-paper-plane"></i>
												</span>
												<strong>{{ grade.grade }}</strong>
											</div>
										</td>

										<td class="text-center" data-label="{% trans %}Effective{% endtrans %}">
											<span class="fs-ranks-count-badge {% if grade.teachers|length > 0 %}fs-ranks-count-badge--active{% endif %}">
												{{ grade.teachers|length }}
											</span>
										</td>

										{% if canManageRanks %}
											<td class="text-center" data-label="{% trans %}Actions{% endtrans %}">
												<div class="fs-ranks-actions">
													<a href="{{ path('grade_editGrade', {'slug': grade.slug}) }}" class="fs-ranks-action fs-ranks-action--edit" name="gradeToUpdate" data-fs-modal="true" data-modal-size="md" data-bs-toggle="tooltip" title="{% trans %}Edit the grade {{ grade.grade }}{% endtrans %}">
														<i class="fa fa-pencil"></i>
														<span>{% trans %}Edit{% endtrans %}</span>
													</a>

													{% if grade.teachers|length > 0 %}
														<a class="fs-ranks-action fs-ranks-action--delete" href="javascript:void(0);"
															onclick="swal({
																'title': '{% trans %}Danger{% endtrans %}',
																'text': '{% trans %}Delete denied. This rank is allowed to teacher !{% endtrans %}',
																'type': 'error',
																'showCancelButton': true,
																'showConfirmButton': false,
																'confirmButtonText': false,
																'cancelButtonText': 'OK',
																'cancelButtonColor': '#088318'
															})">
															<i class="fa fa-trash"></i>
															<span>{% trans %}Delete{% endtrans %}</span>
														</a>
													{% else %}
														<a class="fs-ranks-action fs-ranks-action--delete" href="javascript:void(0);"
															data-delete-url="{{ path('grade_deleteGrade', {'slug': grade.slug}) }}"
															onclick="swal({
																'title': '{% trans %}Warning !{% endtrans %}',
																'type': 'warning',
																'text': '{% trans %}Do you want to delete this rank ?{% endtrans %}',
																'showCancelButton': true,
																'confirmButtonText': '{% trans %}Yes{% endtrans %}',
																'confirmButtonColor': '#f00',
																'cancelButtonText': '{% trans %}No{% endtrans %}',
																'cancelButtonColor': '#186106',
																'confirmButtonPath': '{{ path('grade_deleteGrade', {'slug': grade.slug}) }} '
															});">
															<i class="fa fa-trash"></i>
															<span>{% trans %}Delete{% endtrans %}</span>
														</a>
													{% endif %}
												</div>
											</td>
										{% endif %}
									</tr>
								{% else %}
									<tr>
										<td colspan="{% if canManageRanks %}4{% else %}2{% endif %}">
											<div class="fs-ranks-empty">
												<i class="fa fa-folder-open"></i>
												<strong>{% trans %}No rank found{% endtrans %}</strong>
												<span>{% trans %}Start by creating a new rank.{% endtrans %}</span>
											</div>
										</td>
									</tr>
								{% endfor %}
							</tbody>
						</table>
					</div>

					<div class="fs-ranks-table-footer">
						<div class="fs-ranks-table-footer__left">
							<span id="fsRanksResultCount"></span>
						</div>

						<div class="fs-ranks-footer-controls">
							<label class="fs-ranks-page-size">
								<span>{% trans %}Rows{% endtrans %}</span>
								<select id="fsRanksRowsPerPage">
									<option value="5">5</option>
									<option value="10" selected>10</option>
									<option value="25">25</option>
									<option value="50">50</option>
								</select>
							</label>

							<div class="fs-ranks-pagination" id="fsRanksPagination" aria-label="{% trans %}Pagination{% endtrans %}"></div>
						</div>
					</div>
				</div>
			</section>

		</div>
	</div>
{% endblock %}

{% block javascripts %}
	{{ parent() }}
	<script src="{{ asset('build/custom/js/freeschool-rank-display-premium.js') }}"></script>
{% endblock %}
