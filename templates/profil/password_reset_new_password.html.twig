{% extends 'baseLoggin.html.twig' %}

{% block title %}{% trans %}Reset password{% endtrans %}{% endblock %}

{% block body %}
<div class="hor-content main-content">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-xl-5 col-lg-6 col-md-8">
                <div class="card border-primary mt-6 shadow-sm">
                    <div class="card-header text-center">
                        <h3 class="mb-0"><i class="fa fa-key me-2"></i>{% trans %}New password{% endtrans %}</h3>
                    </div>
                    <div class="card-body">
                        <p class="text-muted">
                            {% trans %}Create a new password for:{% endtrans %} <strong>{{ email }}</strong>
                        </p>
                        <form method="post">
                            <div class="mb-3">
                                <label class="form-label" for="password">{% trans %}Password{% endtrans %}</label>
                                <input type="password" class="form-control" id="password" name="password" required minlength="6" autocomplete="new-password">
                            </div>
                            <div class="mb-4">
                                <label class="form-label" for="confirm_password">{% trans %}Confirm password{% endtrans %}</label>
                                <input type="password" class="form-control" id="confirm_password" name="confirm_password" required minlength="6" autocomplete="new-password">
                            </div>
                            <button class="btn btn-primary w-100" type="submit">
                                <i class="fa fa-save me-2"></i>{% trans %}Reset password{% endtrans %}
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
