<!DOCTYPE html>
<html lang="fr">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        
        <title>{% trans %}Transcript{% endtrans %}</title>
        <style>
            body {
                font-family: Arial, sans-serif;
                            line-height: 1.6;
                color: #333;
            }
            .header {
                background-color: #f4f4f4;
                padding: 20px;
                text-align: center;
            }
            .content {
                margin: 20px;
            }
            .footer {
                margin-top: 30px;
                font-size: 0.9em;
                text-align: center;
                color: #888;
            }
        </style>
    </head>     
    <body>
        <div class="header">
            <h1>{{ school.frenchName }} / {{ school.englishName }}</h1>
        </div>
        <div class="content">
            <p>{% trans %}Dear Parent / Hello dear parent{% endtrans %}</p>
            <p>
                {% trans %}We hope you are well. Please find attached your child's report card{% endtrans %} <b> {{ student ? student.fullName : studentName }}</b> {% trans %}in class{% endtrans %} <b>{{ student ? student.classroom.classroom : classroom.classroom }}</b> {% trans %}for{% endtrans %}
                {% if sequence %}
                    {% trans %}of the{% endtrans %} 
                    {{ sequence.sequence }}
                    {% if sequence.sequence == 1 %}
                        {% trans %}st{% endtrans %} 
                        {% else %}
                        {% trans %}th{% endtrans %}
                    {% endif %} 
                    {% trans %}assessment.{% endtrans %}
                {% endif %}

                {% if term %}
                    {% trans %}of the{% endtrans %}
                    {{ term.term }} 
                    {% if term.term == 1 %}
                        {% trans %}er Term{% endtrans %}
                        {% else %}
                        {% if term.term == 2 or term.term == 3%}
                            {% trans %}th  term.{% endtrans %}
                            {% else %}
                            {% trans %}Annual.{% endtrans %}
                        {% endif %}
                        
                    {% endif %}
                {% endif %}
                

                <br>
                <br>
                {% trans %}Hoping tha you are well, you will find attached the transcript of you child marks{% endtrans %} <b>{{ student ? student.fullName : studentName }}</b> {% trans %}in class{% endtrans %} <b>{{ student ? student.classroom.classroom : classroom.classroom }} </b> {% trans %}for the{% endtrans %} 
                {% if sequence %}
                    {{ sequence.sequence }}
                    {% if sequence.sequence == 1 %}
                        {% trans %}st{% endtrans %} 
                        {% else %}
                        {% if sequence.sequence == 2 %}
                            {% trans %}nd{% endtrans %}
                            {% else %}
                            {% if sequence.sequence == 3 %}
                                {% trans %}rd{% endtrans %} 
                                {% else %}
                                {% trans %}th{% endtrans %}
                            {% endif %}
                        {% endif %}
                    {% endif %} {% trans %}assessment.{% endtrans %}
                {% endif %}
                
                {% if term %}
                    {{ term.term }} 
                    {% if term.term == 1 %}
                        {% trans %}st term.{% endtrans %}
                        {% else %}
                        {% if term.term == 2 %}
                            {% trans %}nd term.{% endtrans %}
                            {% else %}
                            {% if term.term == 3 %}
                                {% trans %}rd term.{% endtrans %}
                                {% else %}
                                {% trans %}Annual.{% endtrans %}
                            {% endif %}
                        {% endif %}
                    {% endif %} 
                {% endif %}
                    
            </p>
            
            <p>
                {% trans %}School administration / School administration.{% endtrans %}
            </p>
            <p>{% trans %}Thank you for your trust. / Thank you for your confidence.{% endtrans %}</p>
        </div>
        <div class="footer">
            <p>{% trans %}&copy;{% endtrans %} {{ "now"|date("Y") }} {% trans %}| Freeschool | All rights reserved / All rights reserved.{% endtrans %}</p>
        </div>
    </body>
</html>