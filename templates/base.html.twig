			#fs-toast-container {
				position: fixed !important;
				top: 92px !important;
				right: 22px !important;
				width: min(380px, calc(100vw - 28px));
				pointer-events: none;
			}

			#fs-toast-container .alert,
			#fs-toast-container .toast,
			#fs-toast-container .fs-toast {
				pointer-events: auto;
			}

			.fs-toast {
				border: 0;
				border-radius: 14px;
				padding: 14px 16px;
				margin-bottom: 12px;
				color: #fff;
				font-weight: 800;
				box-shadow: 0 18px 40px rgba(15, 23, 42, .22);
				animation: fsToastIn .25s ease-out;
			}

			.fs-toast-success {
				background: linear-gradient(135deg, #16a34a, #22c55e);
			}

			.fs-toast-info {
				background: linear-gradient(135deg, #2563eb, #06b6d4);
			}

			.fs-toast-warning {
				background: linear-gradient(135deg, #f59e0b, #f97316);
			}

			.fs-toast-danger,
			.fs-toast-error {
				background: linear-gradient(135deg, #dc2626, #ef4444);
			}

			@keyframes fsToastIn {
				from {
					opacity: 0;
					transform: translateY(-10px) scale(.98);
				}
				to {
					opacity: 1;
					transform: translateY(0) scale(1);
				}
			}

			@media (max-width: 767px) {
