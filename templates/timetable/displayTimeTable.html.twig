{% extends 'base.html.twig' %}

{% block title %}{% trans %}Display Time Table{% endtrans %}{% endblock %}

{% block subTitle %}
    {% trans %}TIME TABLES MANAGEMENT{% endtrans %}
{% endblock %}

{% block infoMessage %}
    {% include 'includes/_info_message.html.twig' %}
{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('build/custom/css/freeschool-timetable-premium.css') }}">
    <link rel="stylesheet" href="{{ asset('build/custom/css/freeschool-timetable-v5-hotfix.css') }}">
    <link rel="stylesheet" href="{{ asset('build/custom/css/freeschool-form-select-clarity-hotfix.css') }}">
    <link rel="stylesheet" href="{{ asset('build/custom/css/freeschool-timetable-ajax-hotfix.css') }}">
{% endblock %}

{% block body %}
<div class="hor-content main-content fs-tt-page">
    <div class="container">
        <div class="fs-tt-menu-safe-space" aria-hidden="true"></div>

        <section class="fs-tt-hero">
            <div class="fs-tt-hero__content">
                <div>
                    <span class="fs-tt-eyebrow">
                        <i class="fe fe-calendar"></i>
                        {% trans %}Timetable workspace{% endtrans %}
                    </span>

                    <h1 class="fs-tt-title">{% trans %}Smart Timetable Management{% endtrans %}</h1>
                    <p class="fs-tt-subtitle">
                        {% trans %}Display one classroom, drag lessons from the left panel, assign teachers and subjects visually, manage double periods and customize the school schedule up to late afternoon with a refined SaaS premium workspace.{% endtrans %}
                    </p>
                </div>

                <div class="fs-tt-hero__stats">
                    <div class="fs-tt-stat-card">
                        <span class="fs-tt-stat-card__icon"><i class="fe fe-layers"></i></span>
                        <span class="fs-tt-stat-card__label">{% trans %}Classrooms{% endtrans %}</span>
                        <strong class="fs-tt-stat-card__value">{{ classrooms|length }}</strong>
                    </div>

                    <div class="fs-tt-stat-card">
                        <span class="fs-tt-stat-card__icon"><i class="fe fe-clock"></i></span>
                        <span class="fs-tt-stat-card__label">{% trans %}Daily slots{% endtrans %}</span>
                        <strong class="fs-tt-stat-card__value">{{ courseSlotCount }}</strong>
                    </div>

                    {% if selectedClassroom %}
                        <div class="fs-tt-stat-card fs-tt-stat-card--active">
                            <span class="fs-tt-stat-card__icon"><i class="fe fe-check-circle"></i></span>
                            <span class="fs-tt-stat-card__label">{% trans %}Active classroom{% endtrans %}</span>
                            <strong class="fs-tt-stat-card__value fs-tt-stat-card__value--small">{{ selectedClassroom.classroom }}</strong>
                        </div>
                    {% endif %}
                </div>
            </div>
        </section>

        <section class="fs-tt-filter-card">
            <div class="fs-tt-filter-card__header">
                <div>
                    <span class="fs-tt-section-chip"><i class="fe fe-filter"></i>{% trans %}Display a classroom timetable{% endtrans %}</span>
                    <h2>{% trans %}Choose a classroom{% endtrans %}</h2>
                </div>

                <div class="fs-tt-filter-card__actions">
                    {% if selectedClassroom %}
                        <button type="button" class="fs-tt-btn fs-tt-btn--ghost js-open-slots-modal">
                            <i class="fe fe-settings"></i>
                            <span>{% trans %}Schedule settings{% endtrans %}</span>
                        </button>
                    {% endif %}
                </div>
            </div>

            <form action="{{ path('display_time_table') }}" method="post" class="fs-tt-selector-form">
                <div class="fs-tt-field fs-tt-field--select fs-select-clean-field">
                    <label for="classroom">{% trans %}Classroom{% endtrans %}</label>
                    <select name="classroom" id="classroom" class="form-control form-control-sm fs-select-clean-control">
                        <option value="">{% trans %}Choose classroom{% endtrans %}</option>
                        {% for classroom in classrooms %}
                            <option value="{{ classroom.id }}" {{ selectedClassroom and selectedClassroom.id == classroom.id ? 'selected' : '' }}>
                                {{ classroom.classroom }}
                            </option>
                        {% endfor %}
                    </select>
                </div>

                <button type="submit" class="fs-tt-btn fs-tt-btn--primary">
                    <i class="fe fe-eye"></i>
                    <span>{% trans %}Display{% endtrans %}</span>
                </button>
            </form>
        </section>

        {% if selectedClassroom %}
            <section
                class="fs-tt-workspace"
                data-save-entry-url="{{ path('timetable_planner_save_entry') }}"
                data-save-slots-url="{{ path('timetable_planner_save_slots') }}"
                data-selected-classroom-id="{{ selectedClassroom.id }}"
                data-selected-classroom-slug="{{ selectedClassroom.slug }}"
            >
                <aside class="fs-tt-sidebar">
                    <div class="fs-tt-sidebar__header">
                        <div>
                            <span class="fs-tt-section-chip"><i class="fe fe-book-open"></i>{% trans %}Drag source{% endtrans %}</span>
                            <h3>{% trans %}Lessons and assigned teachers{% endtrans %}</h3>
                            <p>{% trans %}Drag one lesson into the planner. Use 2 slots for subjects that run over two consecutive periods.{% endtrans %}</p>
                        </div>

                        <div class="fs-tt-sidebar__counter">
                            {{ lessons|length }} {% trans %}lessons{% endtrans %}
                        </div>
                    </div>

                    <div class="fs-tt-sidebar__search">
                        <i class="fe fe-search"></i>
                        <input type="text" class="form-control form-control-sm js-lesson-search" placeholder="{% trans %}Search subject or teacher...{% endtrans %}">
                    </div>

                    <div class="fs-tt-lesson-list">
                        {% for lesson in lessons %}
                            <article
                                class="fs-tt-lesson-card js-lesson-card"
                                draggable="true"
                                data-lesson-id="{{ lesson.id }}"
                                data-subject-name="{{ lesson.subject ? lesson.subject.subject : '' }}"
                                data-teacher-name="{{ lesson.teacher ? lesson.teacher.fullName : '' }}"
                                data-default-duration="{{ lesson.weekHours is not null and lesson.weekHours >= 2 ? 2 : 1 }}"
                            >
                                <div class="fs-tt-lesson-card__head">
                                    <div class="fs-tt-lesson-card__subject">
                                        <span class="fs-tt-lesson-card__icon"><i class="fe fe-book"></i></span>
                                        <div>
                                            <strong>{{ lesson.subject ? lesson.subject.subject : '---' }}</strong>
                                            <small>{{ lesson.teacher ? lesson.teacher.fullName : '---' }}</small>
                                        </div>
                                    </div>

                                    <span class="fs-tt-pill fs-tt-pill--soft">{{ lesson.classroom.classroom }}</span>
                                </div>

                                <div class="fs-tt-lesson-card__meta">
                                    <span class="fs-tt-mini-pill"><i class="fe fe-clock"></i>{{ lesson.weekHours ?? 0 }}{% trans %}h / sem.{% endtrans %}</span>
                                    <span class="fs-tt-mini-pill"><i class="fe fe-award"></i>{% trans %}Coef{% endtrans %} {{ lesson.coefficient }}</span>
                                </div>

                                <div class="fs-tt-duration-toggle-wrap" role="group" aria-label="{% trans %}Duration{% endtrans %}">
                                    <span class="fs-tt-duration-toggle-label fs-tt-duration-toggle-label--one">{% trans %}1 period{% endtrans %}</span>

                                    <label class="fs-tt-duration-toggle">
                                        <input
                                            type="checkbox"
                                            class="js-duration-toggle"
                                            aria-label="{% trans %}Change the lesson duration{% endtrans %}"
                                            {% if lesson.weekHours is not null and lesson.weekHours >= 2 %}checked{% endif %}
                                        >
                                        <span class="fs-tt-duration-toggle__slider">
                                            <span class="fs-tt-duration-toggle__dot"></span>
                                        </span>
                                    </label>

                                    <span class="fs-tt-duration-toggle-label fs-tt-duration-toggle-label--two">{% trans %}2 periods{% endtrans %}</span>
                                </div>
                            </article>
                        {% else %}
                            <div class="fs-tt-empty-block">
                                <i class="fe fe-alert-circle"></i>
                                <p>{% trans %}No lesson has been assigned to this classroom yet. Create the classroom lessons first, then come back to plan the timetable.{% endtrans %}</p>
                            </div>
                        {% endfor %}
                    </div>
                </aside>

                <div class="fs-tt-board-card">
                    <div class="fs-tt-board-card__header">
                        <div>
                            <span class="fs-tt-section-chip"><i class="fe fe-grid"></i>{% trans %}Interactive board{% endtrans %}</span>
                            <h3>{% trans %}Weekly planner{% endtrans %}</h3>
                            <p>{% trans %}Drop a lesson on the desired time slot. Drag an existing scheduled lesson to move it. Delete it directly from the timetable card when needed.{% endtrans %}</p>
                        </div>

                        <div class="fs-tt-board-card__actions">
                            <div class="fs-tt-board-classroom-pill">
                                <span>{% trans %}Classroom{% endtrans %}</span>
                                <strong>{{ selectedClassroom.classroom }}</strong>
                            </div>

                            <button type="button" class="fs-tt-btn fs-tt-btn--ghost js-open-slots-modal">
                                <i class="fe fe-sliders"></i>
                                <span>{% trans %}Edit hours{% endtrans %}</span>
                            </button>

                            <a href="{{ path('print_timetable_classroom', {'slug': selectedClassroom.slug}) }}" target="_blank" class="fs-tt-btn fs-tt-btn--light">
                                <i class="fe fe-printer"></i>
                                <span>{% trans %}Print{% endtrans %}</span>
                            </a>
                        </div>
                    </div>

                    <div class="fs-tt-board-wrapper">
                        <table class="fs-tt-board-table">
                            <thead>
                                <tr>
                                    <th>{% trans %}Hours{% endtrans %}</th>
                                    {% for day in days %}
                                        <th>{{ day.day|split('/')|last }}</th>
                                    {% endfor %}
                                </tr>
                            </thead>
                            <tbody>
                                {% for row in boardRows %}
                                    {% if row.type == 'break' %}
                                        <tr class="fs-tt-break-row">
                                            <td class="fs-tt-hours-cell fs-tt-hours-cell--break">{{ row.timeLabel }}</td>
                                            <td colspan="{{ days|length }}" class="fs-tt-break-cell">{{ row.label ?: 'BREAK' }}</td>
                                        </tr>
                                    {% else %}
                                        <tr>
                                            <td class="fs-tt-hours-cell">{{ row.timeLabel }}</td>
                                            {% for day in days %}
                                                {% set cell = row.cells[day.id] ?? null %}
                                                {% if cell and not cell.skip %}
                                                    <td
                                                        class="fs-tt-slot-cell js-slot-cell {{ cell.entry ? 'is-occupied' : 'is-empty' }}"
                                                        data-day-id="{{ day.id }}"
                                                        data-day-label="{% trans %}{{ day.day|split('/')|last }}{% endtrans %}"
                                                        data-start-time="{{ row.start }}"
                                                        data-slot-label="{% trans %}{{ row.timeLabel }}{% endtrans %}"
                                                        {% if cell.rowspan > 1 %}rowspan="{{ cell.rowspan }}"{% endif %}
                                                    >
                                                        {% if cell.entry %}
                                                            <div
                                                                class="fs-tt-scheduled-card js-scheduled-card"
                                                                draggable="true"
                                                                data-entry-id="{{ cell.entry.id }}"
                                                                {% set scheduledLessonKey = cell.entry.subject and cell.entry.teacher ? cell.entry.teacher.id ~ '_' ~ cell.entry.subject.id : '' %}
                                                                data-lesson-id="{{ lessonMap[scheduledLessonKey]|default('') }}"
                                                                data-duration="{{ cell.duration }}"
                                                            >
                                                                <div class="fs-tt-scheduled-card__top">
                                                                    <span class="fs-tt-scheduled-card__subject">{{ cell.entry.subject ? cell.entry.subject.subject : '---' }}</span>
                                                                    <button type="button" class="fs-tt-card-delete js-delete-entry" data-entry-id="{{ cell.entry.id }}" data-delete-url="{{ path('timetable_planner_delete_entry', {'id': cell.entry.id}) }}" title="{% trans %}Delete this lesson{% endtrans %}" aria-label="{% trans %}Delete this lesson{% endtrans %}">
                                                                        <i class="fe fe-trash-2"></i>
                                                                    </button>
                                                                </div>
                                                                <div class="fs-tt-scheduled-card__teacher">{{ cell.entry.teacher ? cell.entry.teacher.fullName : '---' }}</div>
                                                                <div class="fs-tt-scheduled-card__footer">
                                                                    <span class="fs-tt-mini-pill fs-tt-mini-pill--filled"><i class="fe fe-clock"></i>{{ cell.entry.startTime|slice(0,5) }} - {{ cell.entry.endTime|slice(0,5) }}</span>
                                                                    <span class="fs-tt-mini-pill fs-tt-mini-pill--filled"><i class="fe fe-copy"></i>{{ cell.duration }} {% trans %}period{% endtrans %}{{ cell.duration > 1 ? 's' : '' }}</span>
                                                                </div>
                                                            </div>
                                                        {% else %}
                                                            <div class="fs-tt-slot-empty-state">
                                                                <i class="fe fe-plus-circle"></i>
                                                                <span>{% trans %}Drop here{% endtrans %}</span>
                                                            </div>
                                                        {% endif %}
                                                    </td>
                                                {% endif %}
                                            {% endfor %}
                                        </tr>
                                    {% endif %}
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                </div>
            </section>
        {% else %}
            <section class="fs-tt-empty-state-card">
                <div class="fs-tt-empty-state-card__icon"><i class="fe fe-calendar"></i></div>
                <h3>{% trans %}No classroom selected yet{% endtrans %}</h3>
                <p>{% trans %}Start by selecting a classroom above to open the interactive timetable planner, drag lessons and organize the weekly schedule beautifully.{% endtrans %}</p>
            </section>
        {% endif %}
    </div>
</div>

{% if selectedClassroom %}
    <div class="fs-tt-modal js-slots-modal" aria-hidden="true">
        <div class="fs-tt-modal__backdrop js-close-slots-modal"></div>
        <div class="fs-tt-modal__dialog" role="dialog" aria-modal="true" aria-labelledby="fs-tt-slots-title">
            <div class="fs-tt-modal__header">
                <div>
                    <span class="fs-tt-section-chip"><i class="fe fe-clock"></i>{% trans %}Schedule designer{% endtrans %}</span>
                    <h3 id="fs-tt-slots-title">{% trans %}Edit school hours{% endtrans %}</h3>
                    <p>{% trans %}Adjust the daily timetable for institutions that finish earlier or later. The configuration is saved permanently in the database for the current school year and subsystem.{% endtrans %}</p>
                </div>
                <button type="button" class="fs-tt-modal__close js-close-slots-modal"><i class="fe fe-x"></i></button>
            </div>

            <div class="fs-tt-modal__body">
                <div class="fs-tt-slots-builder js-slots-builder">
                    {% for slot in slotConfiguration %}
                        <div class="fs-tt-slot-row js-slot-row">
                            <select class="form-control form-control-sm js-slot-type">
                                <option value="course" {{ slot.type == 'course' ? 'selected' : '' }}>{% trans %}Course{% endtrans %}</option>
                                <option value="break" {{ slot.type == 'break' ? 'selected' : '' }}>{% trans %}Break{% endtrans %}</option>
                            </select>
                            <input type="time" class="form-control form-control-sm js-slot-start" value="{{ slot.start|slice(0,5) }}">
                            <input type="time" class="form-control form-control-sm js-slot-end" value="{{ slot.end|slice(0,5) }}">
                            <input type="text" class="form-control form-control-sm js-slot-label" placeholder="{% trans %}Label (for break rows){% endtrans %}" value="{{ slot.label }}">
                            <button type="button" class="fs-tt-row-delete js-remove-slot-row"><i class="fe fe-trash-2"></i></button>
                        </div>
                    {% endfor %}
                </div>

                <button type="button" class="fs-tt-btn fs-tt-btn--light js-add-slot-row">
                    <i class="fe fe-plus"></i>
                    <span>{% trans %}Add row{% endtrans %}</span>
                </button>
            </div>

            <div class="fs-tt-modal__footer">
                <button type="button" class="fs-tt-btn fs-tt-btn--ghost js-close-slots-modal">
                    <i class="fe fe-x"></i>
                    <span>{% trans %}Close{% endtrans %}</span>
                </button>
                <button type="button" class="fs-tt-btn fs-tt-btn--primary js-save-slot-settings">
                    <span class="fs-tt-btn__spinner"></span>
                    <i class="fe fe-save"></i>
                    <span>{% trans %}Save schedule{% endtrans %}</span>
                </button>
            </div>
        </div>
    </div>
{% endif %}
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script src="{{ asset('build/custom/js/freeschool-timetable-premium.js') }}"></script>
    <script src="{{ asset('build/custom/js/freeschool-timetable-ajax-hotfix.js') }}"></script>
{% endblock %}
