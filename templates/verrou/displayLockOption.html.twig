{% extends 'base.html.twig' %}

{% block title %}{% trans %}Lock option{% endtrans %}{% endblock %}

{% block subTitle %}
	{% trans %}LOCK OPTIONS{% endtrans %}
{% endblock %}

{% block infoMessage %}
	{% include "includes/_info_message.html.twig" %}
{% endblock %}

{% block stylesheets %}
	{{ parent() }}
	<link rel="stylesheet" href="{{ asset('build/custom/css/freeschool-lock-options-toggle-premium.css') }}">
{% endblock %}

{% block body %}
	<div class="hor-content main-content fs-lock-page">
		<div class="container">
			<div class="fs-lock-menu-safe-space" aria-hidden="true"></div>

			<section class="fs-lock-hero">
				<div class="fs-lock-hero__content">
					<div>
						<span class="fs-lock-eyebrow">
							<i class="fa fa-lock"></i>
							{% trans %}Security workspace{% endtrans %}
						</span>

						<h1 class="fs-lock-title">
							{% trans %}Data lock{% endtrans %}
						</h1>

						<p class="fs-lock-subtitle">
							{% trans %}Lock or unlock school year changes, assessment grade entries and report card printing instantly without reloading the page.{% endtrans %}
						</p>
					</div>

					<div class="fs-lock-hero__actions">
						<div class="fs-lock-hero-stat {% if verrou.verrou == 1 %}fs-lock-hero-stat--danger{% else %}fs-lock-hero-stat--success{% endif %}" data-global-status-card>
							<span class="fs-lock-hero-stat__icon">
								{% if verrou.verrou == 1 %}
									<i class="fa fa-lock"></i>
								{% else %}
									<i class="fa fa-unlock"></i>
								{% endif %}
							</span>

							<span class="fs-lock-hero-stat__label">{% trans %}School year{% endtrans %}</span>

							<strong class="fs-lock-hero-stat__value" data-global-status-text>
								{% if verrou.verrou == 1 %}
									{% trans %}Locked{% endtrans %}
								{% else %}
									{% trans %}Unlocked{% endtrans %}
								{% endif %}
							</strong>
						</div>
					</div>
				</div>
			</section>

			<div class="fs-lock-toast-zone" id="fsLockToastZone" aria-live="polite" aria-atomic="true"></div>

			<section class="fs-lock-card fs-lock-card--main">
				<div class="fs-lock-card__header">
					<div>
						<span class="fs-lock-chip">
							<i class="fe fe-shield"></i>
							{% trans %}Global access{% endtrans %}
						</span>

						<h2>{% trans %}All additions and changes to data{% endtrans %}</h2>

						<p>{% trans %}This switch controls the complete school year write access. It is updated using Ajax without page refresh.{% endtrans %}</p>
					</div>

					<div class="fs-lock-switch-line">
						<span class="fs-lock-state-label {% if verrou.verrou == 1 %}is-locked{% else %}is-unlocked{% endif %}" data-lock-label>
							{% if verrou.verrou == 1 %}
								{% trans %}Locked{% endtrans %}
							{% else %}
								{% trans %}Unlocked{% endtrans %}
							{% endif %}
						</span>

						<label class="fs-lock-switch">
							<input
								type="checkbox"
								class="fs-lock-toggle fs-lock-global-toggle"
								data-lock-type="school-year"
								data-url-lock="{{ path('verrou_lockSchoolYear') }}"
								data-url-unlock="{{ path('verrou_unlockSchoolYear') }}"
								data-label-locked="{% trans %}Locked{% endtrans %}"
								data-label-unlocked="{% trans %}Unlocked{% endtrans %}"
								{% if verrou.verrou == 1 %}checked{% endif %}
							>
							<span class="fs-lock-slider">
								<span class="fs-lock-slider__icon fs-lock-slider__icon--off">
									<i class="fa fa-unlock"></i>
								</span>
								<span class="fs-lock-slider__icon fs-lock-slider__icon--on">
									<i class="fa fa-lock"></i>
								</span>
							</span>
						</label>
					</div>
				</div>
			</section>

			<section class="fs-lock-grid">
				<article class="fs-lock-section-card">
					<div class="fs-lock-section-card__header">
						<div>
							<span class="fs-lock-chip fs-lock-chip--blue">
								<i class="fe fe-edit-3"></i>
								{% trans %}Assessments{% endtrans %}
							</span>

							<h2>{% trans %}Grade entry locks{% endtrans %}</h2>

							<p>{% trans %}Lock or unlock grade entry for each assessment independently.{% endtrans %}</p>
						</div>
					</div>

					<div class="fs-lock-option-list">
						<div class="fs-lock-option">
							<div class="fs-lock-option__content">
								<span class="fs-lock-option__icon"><i class="fe fe-edit"></i></span>
								<div>
									<h3>{% trans %}1st assessment grades{% endtrans %}</h3>
									<p>{% trans %}Controls the first assessment grade entry.{% endtrans %}</p>
								</div>
							</div>

							<div class="fs-lock-switch-line">
								<span class="fs-lock-state-label {% if verrouSequence1.verrouSequence == 1 %}is-locked{% else %}is-unlocked{% endif %}" data-lock-label>
									{% if verrouSequence1.verrouSequence == 1 %}{% trans %}Locked{% endtrans %}{% else %}{% trans %}Unlocked{% endtrans %}{% endif %}
								</span>

								<label class="fs-lock-switch">
									<input
										type="checkbox"
										class="fs-lock-toggle"
										data-url-lock="{{ path('verrou_lockSequence', {'idS': 1, 'lock': 1}) }}"
										data-url-unlock="{{ path('verrou_lockSequence', {'idS': 1, 'lock': 0}) }}"
										data-label-locked="{% trans %}Locked{% endtrans %}"
										data-label-unlocked="{% trans %}Unlocked{% endtrans %}"
										{% if verrouSequence1.verrouSequence == 1 %}checked{% endif %}
									>
									<span class="fs-lock-slider">
										<span class="fs-lock-slider__icon fs-lock-slider__icon--off"><i class="fa fa-unlock"></i></span>
										<span class="fs-lock-slider__icon fs-lock-slider__icon--on"><i class="fa fa-lock"></i></span>
									</span>
								</label>
							</div>
						</div>

