{% block javascripts %}
	{{ parent() }}
	<script src="{{ asset('build/custom/js/freeschool-student-form-premium.js') }}"></script>
	<script>
	(function () {
		'use strict';

		const initStudentPhoto = function () {
			const photoField = document.querySelector('.fs-photo-field--premium');
			if (!photoField) return;

			const fileInput = photoField.querySelector('.fs-photo-input input[type="file"], input.fs-photo-input[type="file"], input[type="file"]');
			const preview = document.getElementById('fsStudentPhotoPreview');
			const status = document.getElementById('fsPhotoProcessingStatus');
			const openButton = document.getElementById('fsOpenStudentCamera');
			const modal = document.getElementById('fsStudentCameraModal');
			const video = document.getElementById('fsStudentCameraVideo');
			const cameraMessage = document.getElementById('fsCameraMessage');
			const cameraMessageText = document.getElementById('fsCameraMessageText');
			const switchButton = document.getElementById('fsSwitchStudentCamera');
			const captureButton = document.getElementById('fsCaptureStudentPhoto');
			const removeButton = document.getElementById('fsRemoveSelectedPhoto');
			const form = photoField.closest('form');
			const isFrench = (document.documentElement.lang || '{{ app.request.locale }}').toLowerCase().startsWith('fr');
			const words = isFrench ? {
				compressing: 'Compression de la photo…',
				ready: 'Photo optimisée : ',
				camera: "Ouverture de la caméra…",
				denied: "Impossible d'accéder à la caméra. Autorisez la caméra dans le navigateur puis réessayez.",
				noCamera: "Aucune caméra ou webcam n'a été détectée.",
				captureError: "La photo n'a pas pu être capturée.",
				formatError: "Ce format ne peut pas être compressé par ce navigateur. Le serveur essaiera de l'optimiser.",
				selected: 'Photo sélectionnée'
			} : {
				compressing: 'Compressing photo…',
				ready: 'Optimized photo: ',
				camera: 'Opening camera…',
				denied: 'Camera access failed. Allow camera access in your browser and try again.',
				noCamera: 'No camera or webcam was detected.',
				captureError: 'The photo could not be captured.',
				formatError: 'This browser cannot compress this format. The server will try to optimize it.',
				selected: 'Photo selected'
			};

			if (!fileInput || !modal || !video) return;
			// La fiche élève est elle-même affichée dans une modale Bootstrap.
			// Placer la caméra directement sous <body> empêche la modale parente
			// de masquer les boutons situés sous l'aperçu vidéo.
			document.body.appendChild(modal);
			fileInput.setAttribute('accept', 'image/*');

			let stream = null;
			let facingMode = 'environment';
			let videoDevices = [];
			let currentDeviceIndex = -1;
			let processing = false;
			let previewUrl = null;

			const showCameraMessage = function (message) {
				cameraMessageText.textContent = message || '';
				cameraMessage.classList.toggle('is-visible', Boolean(message));
			};

			const humanSize = function (bytes) {
				if (bytes < 1024) return bytes + ' o';
				if (bytes < 1048576) return Math.round(bytes / 1024) + ' Ko';
				return (bytes / 1048576).toFixed(1) + ' Mo';
			};

			const setStatus = function (message, error) {
				status.textContent = message || '';
				status.classList.toggle('is-error', Boolean(error));
			};

			const setProcessing = function (active) {
				processing = active;
				if (!form) return;
				form.querySelectorAll('button[type="submit"]').forEach(function (button) {
					button.disabled = active;
				});
			};

			const showPreview = function (file) {
				if (previewUrl) URL.revokeObjectURL(previewUrl);
				previewUrl = URL.createObjectURL(file);
				preview.innerHTML = '';
				const image = document.createElement('img');
				image.src = previewUrl;
				image.alt = words.selected;
				preview.appendChild(image);
			};

			const putFileInForm = function (file) {
				const transfer = new DataTransfer();
				transfer.items.add(file);
				fileInput.files = transfer.files;
				showPreview(file);
			};

			const canvasBlob = function (canvas, quality) {
				return new Promise(function (resolve) {
					canvas.toBlob(resolve, 'image/jpeg', quality);
				});
			};

			const loadBitmap = async function (file) {
				if ('createImageBitmap' in window) {
					return createImageBitmap(file, {imageOrientation: 'from-image'});
				}

				return new Promise(function (resolve, reject) {
					const image = new Image();
					const url = URL.createObjectURL(file);
					image.onload = function () { URL.revokeObjectURL(url); resolve(image); };
					image.onerror = function () { URL.revokeObjectURL(url); reject(new Error('image')); };
					image.src = url;
				});
			};

			const compressImage = async function (file) {
				const source = await loadBitmap(file);
				const sourceWidth = source.width || source.naturalWidth;
				const sourceHeight = source.height || source.naturalHeight;
				const ratio = Math.min(1, 1200 / sourceWidth, 1600 / sourceHeight);
				let width = Math.max(1, Math.round(sourceWidth * ratio));
				let height = Math.max(1, Math.round(sourceHeight * ratio));
				const canvas = document.createElement('canvas');
				const context = canvas.getContext('2d', {alpha: false});

				canvas.width = width;
				canvas.height = height;
				context.fillStyle = '#fff';
				context.fillRect(0, 0, width, height);
				context.drawImage(source, 0, 0, width, height);
				if (source.close) source.close();

				let quality = 0.82;
				let blob = await canvasBlob(canvas, quality);
				while (blob && blob.size > 500 * 1024 && quality > 0.52) {
					quality -= 0.08;
					blob = await canvasBlob(canvas, quality);
				}

				// Si la qualité seule ne suffit pas, réduire progressivement les dimensions.
				while (blob && blob.size > 500 * 1024 && width > 480 && height > 640) {
					const copy = document.createElement('canvas');
					copy.width = canvas.width;
					copy.height = canvas.height;
					copy.getContext('2d').drawImage(canvas, 0, 0);
					width = Math.round(width * 0.82);
					height = Math.round(height * 0.82);
					canvas.width = width;
					canvas.height = height;
					context.fillStyle = '#fff';
					context.fillRect(0, 0, width, height);
					context.drawImage(copy, 0, 0, width, height);
					blob = await canvasBlob(canvas, 0.62);
				}

				if (!blob) throw new Error('compression');
				const baseName = (file.name || 'photo-eleve').replace(/\.[^.]+$/, '').replace(/[^a-zA-Z0-9_-]+/g, '-');
				return new File([blob], baseName + '.jpg', {type: 'image/jpeg', lastModified: Date.now()});
			};

			const optimizeAndSelect = async function (file) {
				if (!file || !file.type.startsWith('image/')) return;
				setProcessing(true);
				setStatus(words.compressing, false);
				try {
					const optimized = await compressImage(file);
					putFileInForm(optimized);
					setStatus(words.ready + humanSize(file.size) + ' → ' + humanSize(optimized.size), false);
				} catch (error) {
					try { putFileInForm(file); } catch (ignored) {}
					setStatus(words.formatError, true);
				} finally {
					setProcessing(false);
				}
			};

			fileInput.addEventListener('change', function () {
				if (fileInput.files && fileInput.files[0]) optimizeAndSelect(fileInput.files[0]);
			});

			const stopCamera = function () {
				if (stream) stream.getTracks().forEach(function (track) { track.stop(); });
				stream = null;
				video.srcObject = null;
			};

			const refreshDevices = async function () {
				if (!navigator.mediaDevices || !navigator.mediaDevices.enumerateDevices) return;
				videoDevices = (await navigator.mediaDevices.enumerateDevices()).filter(function (device) {
					return device.kind === 'videoinput';
				});
				switchButton.disabled = videoDevices.length < 2;
			};

			const startCamera = async function (deviceId) {
				stopCamera();
				showCameraMessage(words.camera);
				captureButton.disabled = true;
				try {
					const videoConstraint = deviceId ? {
						deviceId: {exact: deviceId}, width: {ideal: 1280}, height: {ideal: 1600}
					} : {
						facingMode: {ideal: facingMode}, width: {ideal: 1280}, height: {ideal: 1600}
					};
					stream = await navigator.mediaDevices.getUserMedia({video: videoConstraint, audio: false});
					video.srcObject = stream;
					await video.play();
					showCameraMessage('');
					captureButton.disabled = false;
					video.classList.toggle('is-front-camera', facingMode === 'user');
					await refreshDevices();
					const activeId = stream.getVideoTracks()[0].getSettings().deviceId;
					currentDeviceIndex = videoDevices.findIndex(function (device) { return device.deviceId === activeId; });
				} catch (error) {
					showCameraMessage(error && error.name === 'NotFoundError' ? words.noCamera : words.denied);
					captureButton.disabled = true;
				}
			};

			const openCamera = function () {
				modal.hidden = false;
				modal.setAttribute('aria-hidden', 'false');
				document.body.classList.add('fs-camera-open');
				if (!navigator.mediaDevices || !navigator.mediaDevices.getUserMedia) {
					showCameraMessage(words.noCamera);
					captureButton.disabled = true;
					return;
				}
				facingMode = 'environment';
				startCamera();
			};

			const closeCamera = function () {
				stopCamera();
				modal.hidden = true;
				modal.setAttribute('aria-hidden', 'true');
				document.body.classList.remove('fs-camera-open');
				openButton.focus();
			};

			openButton.addEventListener('click', openCamera);
			modal.querySelectorAll('[data-camera-close]').forEach(function (element) {
				element.addEventListener('click', closeCamera);
			});

			switchButton.addEventListener('click', function () {
				facingMode = facingMode === 'environment' ? 'user' : 'environment';
				if (videoDevices.length > 1) {
					currentDeviceIndex = (currentDeviceIndex + 1 + videoDevices.length) % videoDevices.length;
					startCamera(videoDevices[currentDeviceIndex].deviceId);
				} else {
					startCamera();
				}
			});

			captureButton.addEventListener('click', async function () {
				if (!stream || !video.videoWidth) return;
				captureButton.disabled = true;
				try {
					const canvas = document.createElement('canvas');
					canvas.width = video.videoWidth;
					canvas.height = video.videoHeight;
					const context = canvas.getContext('2d');
					if (facingMode === 'user') {
						context.translate(canvas.width, 0);
						context.scale(-1, 1);
					}
					context.drawImage(video, 0, 0);
					const blob = await canvasBlob(canvas, 0.9);
					if (!blob) throw new Error('capture');
					closeCamera();
					await optimizeAndSelect(new File([blob], 'photo-eleve.jpg', {type: 'image/jpeg', lastModified: Date.now()}));
				} catch (error) {
					showCameraMessage(words.captureError);
					captureButton.disabled = false;
				}
			});

			if (removeButton) {
				removeButton.addEventListener('click', function () {
					fileInput.value = '';
					setStatus('', false);
					if (previewUrl) URL.revokeObjectURL(previewUrl);
					previewUrl = null;
				});
			}

			document.addEventListener('keydown', function (event) {
				if (event.key === 'Escape' && !modal.hidden) closeCamera();
			});

			if (form) {
				form.addEventListener('submit', function (event) {
					if (processing) event.preventDefault();
				});
			}
		};

		if (document.readyState === 'loading') {
			document.addEventListener('DOMContentLoaded', initStudentPhoto);
		} else {
			initStudentPhoto();
		}
	})();
	</script>
{% endblock %}
