{% extends 'base.html.twig' %}

{% block title %}{% trans %}Automatic duplicata removal{% endtrans %}{% endblock %}

{% block body %}
<h1>{% trans %}Automatic duplicata removal{% endtrans %}</h1>

<form action="{{ path('supprimer_doublons') }}" method="post">
    <label for="classe">{% trans %}Choose a class:{% endtrans %}</label>
    <select name="classe_id" id="classe" required>
        {% for classrooms in classroom %}
            <option value="{{ classroom.id }}">{{ classroom.classroom }}</option>
        {% endfor %}
    </select>

    <button type="submit">{% trans %}Delete duplicate{% endtrans %}</button>
</form>

{% endblock %}