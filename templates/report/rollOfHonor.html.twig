{% extends 'base.html.twig' %}

{% block title %}{% trans %}Roll of Honor management{% endtrans %}{% endblock %}

{% block subTitle %}
	{% trans %}ROLLS OF HONOR MANAGMENT{% endtrans %}
{% endblock %}

{% block stylesheets %}
	{{ parent() }}
	<link rel="stylesheet" href="{{ asset('build/custom/css/freeschool-roll-of-honor-premium.css') }}">
{% endblock %}

{% block body %}
	<div class="hor-content main-content fs-roll-page">
		<div class="container">
			<div class="fs-roll-menu-safe-space" aria-hidden="true"></div>

			<section class="fs-roll-hero">
				<div class="fs-roll-hero__content">
					<div>
						<span class="fs-roll-eyebrow">
							<i class="fe fe-award"></i>
							{% trans %}Merit awards workspace{% endtrans %}
						</span>

						<h1 class="fs-roll-title">
							{% trans %}Roll Honor's Students management{% endtrans %}
						</h1>

						<p class="fs-roll-subtitle">
							{% trans %}Display, download, send and print rolls of honor for meritorious students through a refined premium workspace.{% endtrans %}
						</p>
					</div>

					<div class="fs-roll-hero__actions">
						{% if methodIsPost and selectedClassroom.id is not null %}
							<div class="fs-roll-stat">
								<span class="fs-roll-stat__icon">
									<i class="fe fe-users"></i>
								</span>
								<span class="fs-roll-stat__label">{% trans %}Students{% endtrans %}</span>
								<strong class="fs-roll-stat__value">{{ numberOfStudents }}</strong>
							</div>

							<div class="fs-roll-stat">
								<span class="fs-roll-stat__icon">
									<i class="fe fe-award"></i>
								</span>
								<span class="fs-roll-stat__label">{% trans %}Rolls of honor{% endtrans %}</span>
								<strong class="fs-roll-stat__value">{{ numberOfRollOfHonors }}</strong>
							</div>
						{% endif %}

						{% if numberOfRollOfHonors > 0 %}
							<form action="{{ path('report_printRollOfHonor', {'slug': selectedClassroom.slug, 'slugTerm': selectedTerm.slug}) }}" method="post" target="_blank" class="fs-roll-hero-form" data-no-spinner="1">
								<button type="submit" class="fs-roll-btn fs-roll-btn--light" name="printAllRollsOfHonor">
									<i class="fa fa-print"></i>
									<span>{% trans %}Print all rolls of honor{% endtrans %}</span>
								</button>
							</form>
						{% endif %}
					</div>
				</div>
			</section>

			<section class="fs-roll-filter-card">
				<div class="fs-roll-filter-card__header">
					<div>
						<span class="fs-roll-chip">
							<i class="fe fe-filter"></i>
							{% trans %}Filters{% endtrans %}
						</span>

						<h2>{% trans %}Choose a class and term{% endtrans %}</h2>
					</div>
				</div>

				<form action="{{ path('report_rollOfHonor') }}" method="post" class="fs-roll-form fs-roll-filter-form needs-validation" novalidate>
					<div class="fs-floating-field fs-required-field">
						<select class="form-control select2-show-search fs-floating-control" data-placeholder="" name="classroom" id="classroom" required>
							<option value="" label=""></option>

							{% if subSystem == 'Francophone / French Speaker' %}
								{% if school.education.education == 'Général' %}
									{% include "includes/_selectClassrooms.html.twig" %}
								{% else %}
									{% include "includes/_selectClassroomsTech.html.twig" %}
								{% endif %}
							{% else %}
								{% include "includes/_selectClassroomsEn.html.twig" %}
							{% endif %}
						</select>

						<label class="fs-floating-label" for="classroom">
							<i class="fe fe-home"></i>
							{% trans %}Classroom{% endtrans %}
						</label>

						<div class="invalid-feedback">
							{% trans %}Please choose a classroom !{% endtrans %}
						</div>
					</div>

					<div class="fs-floating-field fs-required-field">
						<select name="term" id="term" class="form-control select2 custom-select fs-floating-control" required>
							<option value=""></option>

							{% for term in terms %}
								{% if term.term != annualTerm %}
									<option value="{{ term.id }}" {% if selectedTerm.id == term.id %}selected{% endif %}>
										{% trans %}Term{% endtrans %} {{ term.term }}
									</option>
								{% endif %}
							{% endfor %}

							{% for term in terms %}
								{% if term.term == annualTerm %}
									<option value="{{ term.id }}" {% if selectedTerm.id == term.id %}selected{% endif %}>
										{% trans %}Annual{% endtrans %}
									</option>
								{% endif %}
							{% endfor %}
						</select>

						<label class="fs-floating-label" for="term">
							<i class="fe fe-calendar"></i>
							{% trans %}Period{% endtrans %}
						</label>

						<div class="invalid-feedback">
							{% trans %}Please choose a period !{% endtrans %}
						</div>
					</div>

					<button class="fs-roll-btn fs-roll-btn--primary fs-roll-submit-btn" type="submit" name="displayStudents">
						<span class="fs-roll-submit-spinner" aria-hidden="true"></span>
						<i class="fa fa-eye fs-roll-submit-icon"></i>
						<span>{% trans %}Display{% endtrans %}</span>
					</button>

					<a href="javascript:void(0);" class="fs-roll-btn fs-roll-btn--ghost" data-bs-toggle="tooltip" title="{% trans %}Send roll of honor to whole class{% endtrans %}">
						<i class="fa fa-send-o"></i>
						<span>{% trans %}Send to whole class{% endtrans %}</span>
					</a>
				</form>
			</section>

			{% if methodIsPost %}
				<section class="fs-roll-card">
					<div class="fs-roll-card__header">
						<div>
							<span class="fs-roll-chip">
								<i class="fe fe-grid"></i>
								{% trans %}Dynamic table{% endtrans %}
							</span>

							<h2 class="fs-roll-card-title">
								{% if selectedTerm.term != annualTerm %}
									{% trans %}Rolls of honor term{% endtrans %} {% trans %}N° 0{% endtrans %}{{ selectedTerm.term }}
								{% else %}
									{% trans %}Annual rolls of honor{% endtrans %}
								{% endif %}
							</h2>
						</div>

						<div class="fs-roll-card__actions">
							<div class="fs-roll-search">
								<i class="fe fe-search"></i>
								<input type="text" id="fsRollSearch" class="fs-roll-search-input" placeholder="{% trans %}Search student...{% endtrans %}">
							</div>

							<button type="button" class="fs-roll-btn fs-roll-btn--ghost fs-roll-print-table">
								<i class="fe fe-printer"></i>
								<span>{% trans %}Print table{% endtrans %}</span>
							</button>
						</div>
					</div>

					{% if selectedClassroom.id is not null %}
						<div class="fs-roll-actions-panel">
							<div class="fs-roll-mini-stat">
								<span class="fs-roll-mini-stat__icon">
									<i class="fe fe-users"></i>
								</span>
								<span class="fs-roll-mini-stat__label">{% trans %}Number of students{% endtrans %}</span>
								<strong class="fs-roll-mini-stat__value">{{ numberOfStudents }}</strong>
							</div>

							<div class="fs-roll-mini-stat fs-roll-mini-stat--award">
								<span class="fs-roll-mini-stat__icon">
									<i class="fe fe-award"></i>
								</span>
								<span class="fs-roll-mini-stat__label">{% trans %}Number of Rolls of honor{% endtrans %}</span>
								<strong class="fs-roll-mini-stat__value">{{ numberOfRollOfHonors }}</strong>
							</div>

							{% if numberOfRollOfHonors > 0 %}
								<form action="{{ path('report_printRollOfHonor', {'slug': selectedClassroom.slug, 'slugTerm': selectedTerm.slug}) }}" method="post" target="_blank" class="fs-roll-actions-panel__form" data-no-spinner="1">
									<button type="submit" class="fs-roll-btn fs-roll-btn--primary" name="printAllRollsOfHonor">
										<i class="fa fa-print"></i>
										<span>{% trans %}Print all rolls of honor{% endtrans %}</span>
									</button>
								</form>
							{% endif %}
						</div>
					{% endif %}

					<div class="fs-roll-table-wrap">
						{% if reports|length > 0 %}
							<table class="table fs-roll-table fs-roll-dynamic-table" id="fsRollTable">
								<thead>
									<tr>
										<th>
											<button type="button" class="fs-roll-sort" data-sort-index="0">
												<span>{% trans %}N°{% endtrans %}</span>
												<i class="fe fe-chevron-down"></i>
											</button>
										</th>
										<th>{% trans %}Photo{% endtrans %}</th>
										<th>
											<button type="button" class="fs-roll-sort" data-sort-index="2">
												<span>{% trans %}Full name{% endtrans %}</span>
												<i class="fe fe-chevron-down"></i>
											</button>
										</th>
										<th class="text-center">{% trans %}Roll of honor{% endtrans %}</th>
									</tr>
								</thead>

								<tbody>
									{% set i = 1 %}
									{% for report in reports %}
										{% if report.moyenne >= 12 %}
											<tr class="table-row">
												<td data-label="{% trans %}N°{% endtrans %}">
													<span class="fs-roll-index">{{ i }}</span>
												</td>

												<td data-label="{% trans %}Photo{% endtrans %}" class="text-center">
													{% if report.student.sex.sex == 'F' %}
														<img alt="{{ report.student.fullName }}" class="fs-roll-photo" src="{{ report.student.photo ? asset('images/students/' ~ report.student.photo) : asset('images/students/fille.jpg')}}">
													{% else %}
														<img alt="{{ report.student.fullName }}" class="fs-roll-photo" src="{{ report.student.photo ? asset('images/students/' ~ report.student.photo) : asset('images/students/garcon.jpg')}}">
													{% endif %}
												</td>

												<td data-label="{% trans %}Full name{% endtrans %}">
													<div class="fs-roll-student-cell">
														<div>
															<strong>{{ report.student.fullName }}</strong>
															<span class="fs-roll-status">
																<i class="fe fe-award"></i>
																{% trans %}Meritorious student{% endtrans %}
															</span>
														</div>
													</div>
												</td>

												<td class="text-center" data-label="{% trans %}Roll of honor{% endtrans %}">
													<div class="fs-roll-action-group">
														<a href="{{ path('report_printRollOfHonor', {'slug': selectedClassroom.slug, 'slugTerm': selectedTerm.slug, 'slugStudent': report.student.slug}) }}" target="_blank" class="fs-roll-action fs-roll-action--download" data-bs-toggle="tooltip" title="{% trans %}Download roll of honnor of {% endtrans %}{{ report.student.fullName }}">
															<i class="fa fa-download"></i>
															<span>{% trans %}Download{% endtrans %}</span>
														</a>

														<a href="javascript:void(0);" class="fs-roll-action fs-roll-action--send" data-bs-toggle="tooltip" title="{% trans %}Send roll of honor{% endtrans %} {{ report.student.fullName }}">
															<i class="fa fa-send-o"></i>
															<span>{% trans %}Send{% endtrans %}</span>
														</a>
													</div>
												</td>
											</tr>
										{% endif %}
										{% set i = i + 1 %}
									{% endfor %}
								</tbody>
							</table>
						{% else %}
							<div class="fs-roll-empty">
								<i class="fe fe-alert-circle"></i>
								<strong>{% trans %}Printing rolls of honor failed{% endtrans %}</strong>
								<span>{% trans %}You must first print reports to allow the printing of the honor rolls to the meritorious{% endtrans %}</span>
							</div>
						{% endif %}
					</div>

					{% if reports|length > 0 %}
						<div class="fs-roll-table-footer">
							<div class="fs-roll-table-footer__left">
								<span class="fs-roll-result-count"></span>
							</div>

							<div class="fs-roll-footer-controls">
								<label class="fs-roll-page-size">
									<span>{% trans %}Rows{% endtrans %}</span>
									<select class="fs-roll-rows-per-page">
										<option value="5">5</option>
										<option value="10" selected>10</option>
										<option value="25">25</option>
										<option value="50">50</option>
									</select>
								</label>

								<div class="fs-roll-pagination" aria-label="{% trans %}Pagination{% endtrans %}"></div>
							</div>
						</div>
					{% endif %}
				</section>
			{% endif %}
		</div>
	</div>
{% endblock %}

{% block javascripts %}
	{{ parent() }}
	<script src="{{ asset('build/custom/js/freeschool-roll-of-honor-premium.js') }}"></script>
{% endblock %}
