{% extends 'baseLoggin.html.twig' %}

{% block title %}{% trans %}Reset password{% endtrans %}{% endblock %}

{% block body %}
<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-6">
            <div class="card shadow border-0 rounded-4">
                <div class="card-body p-4 p-lg-5">
                    <h2 class="fw-bold mb-2">{% trans %}New password{% endtrans %}</h2>
                    <p class="text-muted mb-4">{% trans %}Set a new password for{% endtrans %} <strong>{{ fullName }}</strong>.</p>

                    {% for message in app.flashes('warning') %}
                        <div class="alert alert-warning">{{ message }}</div>
                    {% endfor %}

                    {{ form_start(userForm) }}
                        <div class="mb-3">
                            {{ form_row(userForm.password, {'attr': {'class': 'form-control form-control-lg'}}) }}
                        </div>
                        <div class="mb-4">
                            {{ form_row(userForm.confirmPassword, {'attr': {'class': 'form-control form-control-lg'}}) }}
                        </div>
                        <button type="submit" class="btn btn-primary w-100">
                            <i class="fe fe-lock me-2"></i>{% trans %}Reset{% endtrans %}
                        </button>
                    {{ form_end(userForm) }}
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
