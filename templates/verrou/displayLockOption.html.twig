								</label>
							</div>
						</div>
					</div>
				</article>

				<article class="fs-lock-section-card">
					<div class="fs-lock-section-card__header">
						<div>
							<span class="fs-lock-chip fs-lock-chip--cyan">
								<i class="fe fe-file-text"></i>
								{% trans %}Report cards{% endtrans %}
							</span>

							<h2>{% trans %}Report printing locks{% endtrans %}</h2>

							<p>{% trans %}Lock or unlock report card printing for each term and annual report.{% endtrans %}</p>
						</div>
					</div>

					<div class="fs-lock-option-list">
