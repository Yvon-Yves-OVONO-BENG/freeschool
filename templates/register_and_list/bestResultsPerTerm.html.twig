{% extends 'base.html.twig' %}

{% block title %}{% trans %}Best results{% endtrans %}{% endblock %}

{% block subTitle %}
	{% trans %}BEST STUDENTS MANAGEMENT{% endtrans %}
{% endblock %}

{% block stylesheets %}
	{{ parent() }}
	<link rel="stylesheet" href="{{ asset('build/custom/css/freeschool-best-results-per-term-premium.css') }}">
{% endblock %}

{% block body %}
	<div class="hor-content main-content fs-bt-page">
		<div class="container">
			<div class="fs-bt-menu-safe-space" aria-hidden="true"></div>

			<section class="fs-bt-hero">
				<div class="fs-bt-hero__content">
					<div>
						<span class="fs-bt-eyebrow">
							<i class="si si-badge"></i>
							{% trans %}Academic excellence workspace{% endtrans %}
						</span>

						<h1 class="fs-bt-title">
							{% trans %}Best results{% endtrans %}
						</h1>

						<p class="fs-bt-subtitle">
							{% trans %}Print and display the best student rankings by period, class, subject, cycle, level and science classroom through a premium responsive workspace.{% endtrans %}
						</p>
					</div>

					<div class="fs-bt-hero__actions">
						<div class="fs-bt-hero-stat">
							<span class="fs-bt-hero-stat__icon">
								<i class="fe fe-award"></i>
							</span>
							<span class="fs-bt-hero-stat__label">{% trans %}Modules{% endtrans %}</span>
							<strong class="fs-bt-hero-stat__value">10</strong>
						</div>

						<div class="fs-bt-hero-stat fs-bt-hero-stat--soft">
							<span class="fs-bt-hero-stat__icon">
								<i class="fe fe-calendar"></i>
							</span>
							<span class="fs-bt-hero-stat__label">{% trans %}Period{% endtrans %}</span>
							<strong class="fs-bt-hero-stat__value">{% trans %}Term{% endtrans %}</strong>
						</div>
					</div>
				</div>
			</section>

			<section class="fs-bt-main-print">
				<div>
					<span class="fs-bt-chip">
						<i class="fe fe-printer"></i>
						{% trans %}School ranking{% endtrans %}
					</span>

					<h2>{% trans %}The School's top five students{% endtrans %}</h2>

					<p>{% trans %}Choose a period and print the global school ranking for that period.{% endtrans %}</p>
				</div>

				<form action="{{ path('print_school_top_five_students_per_term') }}" method="post" target="_blank" class="fs-bt-form fs-bt-form--hero needs-validation" novalidate data-no-spinner="1">
					<div class="fs-floating-field fs-required-field">
						<select name="term" id="termSchoolTopFive" class="form-control select2 custom-select fs-floating-control" data-placeholder="" required>
							<option label="" value=""></option>

							<optgroup label="{% trans %}Term{% endtrans %}">
								{% for term in terms %}
									{% if term.term != annualTerm %}
										<option value="{{ term.id }}">{% trans %}Term{% endtrans %} {{ term.term }}</option>
									{% endif %}
								{% endfor %}
							</optgroup>

							{% for term in terms %}
								{% if term.term == annualTerm %}
									<option value="{{ term.id }}">{% trans %}Annual{% endtrans %}</option>
								{% endif %}
							{% endfor %}
						</select>

						<label class="fs-floating-label" for="termSchoolTopFive">
							<i class="fe fe-calendar"></i>
							{% trans %}Period{% endtrans %}
						</label>

						<div class="invalid-feedback">{% trans %}Please choose a period !{% endtrans %}</div>
					</div>

					<div class="fs-bt-form__actions">
						<button class="fs-bt-btn fs-bt-btn--primary fs-bt-submit-btn" type="submit" name="printBestStudentsPerClass">
							<i class="fa fa-print fs-bt-submit-icon"></i>
							<span>{% trans %}Print{% endtrans %}</span>
						</button>
					</div>
				</form>
			</section>

			<section class="fs-bt-toolbar">
				<div>
					<span class="fs-bt-chip">
						<i class="fe fe-grid"></i>
						{% trans %}Ranking modules{% endtrans %}
					</span>
					<h2>{% trans %}Choose the ranking module{% endtrans %}</h2>
				</div>

				<div class="fs-bt-toolbar__search">
					<i class="fe fe-search"></i>
					<input type="text" class="fs-bt-module-search" placeholder="{% trans %}Search a module...{% endtrans %}">
				</div>
			</section>

			<div class="fs-bt-grid">
				<section class="fs-bt-card" data-module-card>
					<div class="fs-bt-card__header">
						<span class="fs-bt-card__icon">
							<i class="si si-badge"></i>
						</span>
						<div>
							<h3>{% trans %}Printing of the list of first by class{% endtrans %}</h3>
							<p>{% trans %}Print first students by class for the selected period.{% endtrans %}</p>
						</div>
					</div>

