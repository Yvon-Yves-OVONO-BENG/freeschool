{% extends 'baseLoggin.html.twig' %}

{% block title %}{% trans %}Forgot password{% endtrans %}{% endblock %}

{% block body %}
<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-6">
            <div class="card shadow border-0 rounded-4">
                <div class="card-body p-4 p-lg-5">
                    <h2 class="fw-bold mb-2">{% trans %}Forgot password{% endtrans %}</h2>
                    <p class="text-muted mb-4">{% trans %}Choose your profile. We will email you a 5-digit reset code.{% endtrans %}</p>

                    {% for message in app.flashes('info') %}
                        <div class="alert alert-success">{{ message }}</div>
                    {% endfor %}
                    {% for message in app.flashes('warning') %}
                        <div class="alert alert-warning">{{ message }}</div>
                    {% endfor %}

                    <form method="post">
                        <div class="mb-3">
                            <label class="form-label fw-bold">{% trans %}Personnel{% endtrans %}</label>
                            <select class="form-select" name="userId" required>
                                <option value="">{% trans %}-- Select --{% endtrans %}</option>
                                {% for user in users %}
                                    <option value="{{ user.id }}">{{ user.fullName }} - {{ user.username }}</option>
                                {% endfor %}
                            </select>
                        </div>

                        <button type="submit" class="btn btn-primary w-100">
                            <i class="fe fe-send me-2"></i>{% trans %}Send code{% endtrans %}
                        </button>
                    </form>

                    <div class="text-center mt-4">
                        <a href="{{ path('login') }}" class="text-decoration-none">{% trans %}← Back to login{% endtrans %}</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
