{% extends 'base.html.twig' %}

{% block title %}
	{% trans %}Report reconstruction{% endtrans %} {% trans %}and{% endtrans %} {% trans %}Problems{% endtrans %}
{% endblock %}

{% block stylesheets %}
	{{ parent() }}
	<link rel="stylesheet" href="{{ asset('build/custom/css/freeschool-report-reconstruction-problems-premium.css') }}">
{% endblock %}

{% block body %}
	<div class="hor-content main-content fs-report-problems-page">
		<div class="container">
			<div class="fs-report-problems-menu-safe-space" aria-hidden="true"></div>

			<section class="fs-report-problems-hero">
				<div class="fs-report-problems-hero__content">
					<div>
						<span class="fs-report-problems-eyebrow">
							<i class="fa fa-wrench"></i>
							{% trans %}Academic control workspace{% endtrans %}
						</span>

						<h1 class="fs-report-problems-title">
							{% trans %}Report reconstruction{% endtrans %} {% trans %}and{% endtrans %} {% trans %}Problems{% endtrans %}
						</h1>

						<p class="fs-report-problems-subtitle">
							{% trans %}Detect missing or inconsistent evaluation entries, then reconstruct reports with a refined and responsive premium interface.{% endtrans %}
						</p>
					</div>

					<div class="fs-report-problems-hero__actions">
						<div class="fs-report-problems-hero-stat">
							<span class="fs-report-problems-hero-stat__icon">
								<i class="fe fe-alert-triangle"></i>
							</span>
							<span class="fs-report-problems-hero-stat__label">{% trans %}Problems{% endtrans %}</span>
							<strong class="fs-report-problems-hero-stat__value">{{ tableauResultats|length }}</strong>
						</div>

						{% if classroom %}
							<div class="fs-report-problems-hero-stat fs-report-problems-hero-stat--soft">
								<span class="fs-report-problems-hero-stat__icon">
									<i class="fe fe-home"></i>
								</span>
								<span class="fs-report-problems-hero-stat__label">{% trans %}Classroom{% endtrans %}</span>
								<strong class="fs-report-problems-hero-stat__value fs-report-problems-hero-stat__value--small">{{ classroom.classroom }}</strong>
							</div>
						{% endif %}
					</div>
				</div>
			</section>

			<section class="fs-report-problems-filter-card">
				<div class="fs-report-problems-filter-card__header">
					<div>
						<span class="fs-report-problems-chip">
							<i class="fe fe-filter"></i>
							{% trans %}Search filters{% endtrans %}
						</span>

						<h2>{% trans %}Choose period and classroom{% endtrans %}</h2>

						<p>{% trans %}Select an evaluation or term, then choose the classroom to display detected report problems.{% endtrans %}</p>
					</div>
				</div>

				<form action="{{ path('display_problems') }}" method="post" class="fs-report-problems-filter-form needs-validation" novalidate>
					<div class="fs-floating-field fs-required-field">
						<select name="period" id="period" class="form-control select2-show-search fs-floating-control" data-placeholder="" required>
							<option label="" value="">
								
							</option>

							<optgroup label="{% trans %}Evaluations{% endtrans %}">
								{% for sequence in sequences %}
									<option value="s{{ sequence.id }}">{% trans %}Evaluation{% endtrans %} {{ sequence.sequence }}</option>
								{% endfor %}
							</optgroup>

							<optgroup label="{% trans %}Terms{% endtrans %}">
								{% for term in terms %}
									{% if term.term != annualTerm %}
										<option value="t{{ term.id }}">{% trans %}Term{% endtrans %} {{ term.term }}</option>
									{% endif %}
								{% endfor %}
							</optgroup>
						</select>

						<label class="fs-floating-label" for="period">
							<i class="fe fe-calendar"></i>
							{% trans %}Period{% endtrans %}
						</label>

						<div class="invalid-feedback">
							{% trans %}Please choose a period !{% endtrans %}
						</div>
					</div>

					<div class="fs-floating-field fs-required-field">
						<select class="form-control select2-show-search fs-floating-control" data-placeholder="{% trans %}Choose a classroom{% endtrans %}" name="classroom" id="classroom" required>
							<option label="{% trans %}Choose a classroom{% endtrans %}" value="">{% trans %}Choose a class{% endtrans %}</option>

							{% if subSystem == 'Francophone / French Speaker' %}
								{% if school.education.education == 'Général' %}
									{% include "includes/_selectClassrooms.html.twig" %}
								{% else %}
									{% include "includes/_selectClassroomsTech.html.twig" %}
								{% endif %}
							{% else %}
								{% include "includes/_selectClassroomsEn.html.twig" %}
							{% endif %}
						</select>

						<label class="fs-floating-label" for="classroom">
							<i class="fe fe-home"></i>
							{% trans %}Classroom{% endtrans %}
						</label>

						<div class="invalid-feedback">
							{% trans %}Please choose a classroom !{% endtrans %}
						</div>
					</div>

					<div class="fs-report-problems-filter-form__actions">
						<button class="fs-report-problems-btn fs-report-problems-btn--primary fs-report-problems-submit-btn" type="submit" name="printBestStudentsPerClass">
							<span class="fs-report-problems-submit-spinner" aria-hidden="true"></span>
							<i class="fa fa-eye fs-report-problems-submit-icon"></i>
							<span>{% trans %}Display{% endtrans %}</span>
						</button>
					</div>
				</form>
			</section>

			{% if display == true and tableauResultats|length > 0 %}
				<section class="fs-report-problems-status">
					{% if firstPeriodLetter == 't' %}
						<div class="fs-report-problems-status__item">
							<span class="fs-report-problems-status__icon">
								<i class="fe fe-calendar"></i>
							</span>
							<span class="fs-report-problems-status__label">{% trans %}Term{% endtrans %}</span>
							<strong class="fs-report-problems-status__value">{{ term.term }}</strong>
						</div>
					{% else %}
						{% if firstPeriodLetter == 's' %}
							<div class="fs-report-problems-status__item">
								<span class="fs-report-problems-status__icon">
									<i class="fe fe-calendar"></i>
								</span>
								<span class="fs-report-problems-status__label">{% trans %}Evaluation{% endtrans %}</span>
								<strong class="fs-report-problems-status__value">{{ sequence.sequence }}</strong>
							</div>
						{% endif %}
					{% endif %}

					<div class="fs-report-problems-status__item">
						<span class="fs-report-problems-status__icon">
							<i class="fe fe-home"></i>
						</span>
						<span class="fs-report-problems-status__label">{% trans %}Classroom{% endtrans %}</span>
						<strong class="fs-report-problems-status__value">{{ classroom.classroom }}</strong>
					</div>

					<div class="fs-report-problems-status__item fs-report-problems-status__item--danger">
						<span class="fs-report-problems-status__icon">
							<i class="fe fe-alert-triangle"></i>
						</span>
						<span class="fs-report-problems-status__label">{% trans %}Detected{% endtrans %}</span>
						<strong class="fs-report-problems-status__value">{{ tableauResultats|length }}</strong>
					</div>
				</section>
			{% else %}
				{% if firstPeriodLetter == 't' or firstPeriodLetter == 's' or classroom %}
					<section class="fs-report-problems-status">
						{% if firstPeriodLetter == 't' %}
							<div class="fs-report-problems-status__item">
								<span class="fs-report-problems-status__icon">
									<i class="fe fe-calendar"></i>
								</span>
								<span class="fs-report-problems-status__label">{% trans %}Term{% endtrans %}</span>
								<strong class="fs-report-problems-status__value">{{ term.term }}</strong>
							</div>
						{% else %}
							{% if firstPeriodLetter == 's' %}
								<div class="fs-report-problems-status__item">
									<span class="fs-report-problems-status__icon">
										<i class="fe fe-calendar"></i>
									</span>
									<span class="fs-report-problems-status__label">{% trans %}Evaluation{% endtrans %}</span>
									<strong class="fs-report-problems-status__value">{{ sequence.sequence }}</strong>
								</div>
							{% endif %}
						{% endif %}

						{% if classroom %}
							<div class="fs-report-problems-status__item">
								<span class="fs-report-problems-status__icon">
									<i class="fe fe-home"></i>
								</span>
								<span class="fs-report-problems-status__label">{% trans %}Classroom{% endtrans %}</span>
								<strong class="fs-report-problems-status__value">{{ classroom.classroom }}</strong>
							</div>

							<div class="fs-report-problems-status__item fs-report-problems-status__item--danger">
								<span class="fs-report-problems-status__icon">
									<i class="fe fe-alert-triangle"></i>
								</span>
								<span class="fs-report-problems-status__label">{% trans %}Status{% endtrans %}</span>
								<strong class="fs-report-problems-status__value">{% trans %}Notes not yet entered{% endtrans %}</strong>
							</div>
						{% endif %}
					</section>
				{% endif %}
			{% endif %}

			<section class="fs-report-problems-card">
				<div class="fs-report-problems-card__header">
					<div>
						<span class="fs-report-problems-chip fs-report-problems-chip--soft">
							<i class="fe fe-grid"></i>
							{% trans %}Dynamic table{% endtrans %}
						</span>

						<h2>{% trans %}Detected report problems{% endtrans %}</h2>
					</div>

					<div class="fs-report-problems-card__actions">
						<div class="fs-report-problems-search">
							<i class="fe fe-search"></i>
							<input type="text" class="fs-report-problems-search-input" placeholder="{% trans %}Search student, evaluation...{% endtrans %}">
						</div>
					</div>
				</div>

				<div class="fs-report-problems-table-wrap">
					<table id="fsReportProblemsTable" class="table fs-report-problems-table fs-report-problems-dynamic-table">
						<thead>
							<tr>
								<th>
									<button type="button" class="fs-report-problems-sort" data-sort-index="0">
										<span>{% trans %}N°{% endtrans %}</span>
										<i class="fe fe-chevron-down"></i>
									</button>
								</th>
								<th>
									<button type="button" class="fs-report-problems-sort" data-sort-index="1">
										<span>{% trans %}Full Name{% endtrans %}</span>
										<i class="fe fe-chevron-down"></i>
									</button>
								</th>
								<th>
									<button type="button" class="fs-report-problems-sort" data-sort-index="2">
										<span>{% trans %}Evaluation{% endtrans %} | {% trans %}Number of assessments{% endtrans %}</span>
										<i class="fe fe-chevron-down"></i>
									</button>
								</th>

								{% if sequence %}
									<th>{% trans %}Operations{% endtrans %}</th>
								{% endif %}
							</tr>
						</thead>

						<tbody>
							{% if tableauResultats|length > 0 %}
								{% set i = 1 %}
								{% for tableauResultat in tableauResultats %}
									<tr>
										<td data-label="{% trans %}N°{% endtrans %}">
											<span class="fs-report-problems-rank">{{ i }}</span>
										</td>

										<td data-label="{% trans %}Full Name{% endtrans %}">
											<div class="fs-report-problems-student-cell">
												<span class="fs-report-problems-avatar">{{ tableauResultat['nomEleve']|slice(0, 1)|upper }}</span>
												<div>
													<strong>{{ tableauResultat['nomEleve'] }}</strong>
													<span>
														<i class="fe fe-user"></i>
														{% trans %}Student{% endtrans %}
													</span>
												</div>
											</div>
										</td>

										<td data-label="{% trans %}Evaluation{% endtrans %} | {% trans %}Number of assessments{% endtrans %}">
											{% if firstPeriodLetter == 's' %}
												<span class="fs-report-problems-evaluation fs-report-problems-evaluation--single">
													<strong>{{ tableauResultat['sequences'][sequence.sequence] }}</strong>
													<small>{% trans %}Evaluations{% endtrans %}</small>
												</span>
											{% else %}
												{% if firstPeriodLetter == 't' %}
													<div class="fs-report-problems-evaluation-list">
														{% if term.term == 1 %}
															{% for sequenceId in [1, 2] %}
																{% set nbEvaluations = tableauResultat['sequences'][sequenceId] ?? 0 %}
																<span class="fs-report-problems-evaluation {% if tableauResultat['sequences'][1] != tableauResultat['sequences'][2] %}fs-report-problems-evaluation--danger{% endif %}">
																	<strong>{% trans %}Evaluation{% endtrans %} {{ sequenceId }}</strong>
																	<small>{{ nbEvaluations }} {% trans %}Evaluations{% endtrans %}</small>
																</span>
															{% endfor %}
														{% else %}
															{% if term.term == 2 %}
																{% for sequenceId in [3, 4] %}
																	{% set nbEvaluations = tableauResultat['sequences'][sequenceId] ?? 0 %}
																	<span class="fs-report-problems-evaluation {% if tableauResultat['sequences'][3] != tableauResultat['sequences'][4] %}fs-report-problems-evaluation--danger{% endif %}">
																		<strong>{% trans %}Evaluation{% endtrans %} {{ sequenceId }}</strong>
																		<small>{{ nbEvaluations }} {% trans %}Evaluations{% endtrans %}</small>
																	</span>
																{% endfor %}
															{% else %}
																{% if term.term == 3 %}
																	{% for sequenceId in [5, 6] %}
																		{% set nbEvaluations = tableauResultat['sequences'][sequenceId] ?? 0 %}
																		<span class="fs-report-problems-evaluation {% if tableauResultat['sequences'][5] != tableauResultat['sequences'][6] %}fs-report-problems-evaluation--danger{% endif %}">
																			<strong>{% trans %}Evaluation{% endtrans %} {{ sequenceId }}</strong>
																			<small>{{ nbEvaluations }} {% trans %}Evaluations{% endtrans %}</small>
																		</span>
																	{% endfor %}
																{% endif %}
															{% endif %}
														{% endif %}
													</div>
												{% endif %}
											{% endif %}
										</td>

										{% if sequence %}
											<td data-label="{% trans %}Operations{% endtrans %}" class="fs-report-problems-actions">
												<a href="{{ path('details_evaluations_sequence_student', {'slugStudent': tableauResultat['slugStudent'], 'sequenceId': sequence.id, 'slugClassroom': tableauResultat['slugClassroom'] }) }}" class="fs-report-problems-btn fs-report-problems-btn--ghost" rel="noopener noreferrer">
													<i class="fa fa-wrench"></i>
													<span>{% trans %}Recontructing the report{% endtrans %}</span>
												</a>
											</td>
										{% endif %}
									</tr>
									{% set i = i + 1 %}
								{% endfor %}
							{% else %}
								<tr>
									<td colspan="{% if sequence %}4{% else %}3{% endif %}">
										<div class="fs-report-problems-empty">
											<i class="fe fe-check-circle"></i>
											<strong>{% trans %}No problem found{% endtrans %}</strong>
											<span>{% trans %}Choose a period and classroom to display report reconstruction issues.{% endtrans %}</span>
										</div>
									</td>
								</tr>
							{% endif %}
						</tbody>
					</table>
				</div>

				<div class="fs-report-problems-table-footer">
					<div class="fs-report-problems-result-count"></div>

					<div class="fs-report-problems-footer-controls">
						<label class="fs-report-problems-page-size">
							<span>{% trans %}Rows{% endtrans %}</span>
							<select class="fs-report-problems-rows-per-page">
								<option value="5">5</option>
								<option value="10" selected>10</option>
								<option value="25">25</option>
								<option value="50">50</option>
							</select>
						</label>

						<div class="fs-report-problems-pagination" aria-label="{% trans %}Pagination{% endtrans %}"></div>
					</div>
				</div>
			</section>
		</div>
	</div>
{% endblock %}

{% block javascripts %}
	{{ parent() }}
	<script src="{{ asset('build/custom/js/freeschool-report-reconstruction-problems-premium.js') }}"></script>
{% endblock %}
