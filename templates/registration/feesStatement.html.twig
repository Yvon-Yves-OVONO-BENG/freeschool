{% extends 'base.html.twig' %}

{% block title %}{% trans %}Display Student{% endtrans %}{% endblock %}

{% block infoMessage %}
	{% include "includes/_info_message.html.twig" %}
{% endblock %}

{% block stylesheets %}
	{{ parent() }}
	<link rel="stylesheet" href="{{ asset('build/custom/css/freeschool-registration-fees-statement-premium.css') }}">
{% endblock %}

{% block body %}
	<div class="hor-content main-content fs-fees-page">
		<div class="container">
			<div class="fs-fees-menu-safe-space" aria-hidden="true"></div>

			{% if is_granted('ROLE_PROVISEUR') or is_granted('ROLE_INTENDANT') or is_granted('ROLE_ADMIN') or is_granted ('ROLE_SUPER_ADMIN') or headmasterFees == 1 %}
				<section class="fs-fees-hero">
					<div class="fs-fees-hero__content">
						<div>
							<span class="fs-fees-eyebrow">
								<i class="fa fa-money"></i>
								{% trans %}Financial registration workspace{% endtrans %}
							</span>

							<h1 class="fs-fees-title">
								{% trans %}STUDENTS REGISTRATION MANAGMENT{% endtrans %}
							</h1>

							<p class="fs-fees-subtitle">
								{% trans %}Display students by classroom, review payment status and print financial statements with a refined premium interface.{% endtrans %}
							</p>
						</div>

						<div class="fs-fees-hero__actions">
							<div class="fs-fees-hero-stat">
								<span class="fs-fees-hero-stat__icon">
									<i class="fe fe-users"></i>
								</span>
								<span class="fs-fees-hero-stat__label">{% trans %}Total effective{% endtrans %}</span>
								<strong class="fs-fees-hero-stat__value">{{ numberOfStudentInSchool }}</strong>
							</div>

							<a href="{{ path('registration_printSchoolFeesStatement') }}" class="fs-fees-btn fs-fees-btn--light" name="printSchoolFeesStatement" target="_blank">
								<i class="fa fa-print"></i>
								<span>{% trans %}Print Financial Statements{% endtrans %}</span>
							</a>

							<a href="{{ path('print_student_solvable_all') }}" class="fs-fees-btn fs-fees-btn--success-light" target="_blank">
								<i class="fa fa-thumbs-o-up"></i>
								<span>{% trans %}List of solvents{% endtrans %}</span>
							</a>

							<a href="{{ path('print_student_insolvable_all') }}" class="fs-fees-btn fs-fees-btn--danger-light" target="_blank">
								<i class="fa fa-thumbs-o-down"></i>
								<span>{% trans %}List of insolvents{% endtrans %}</span>
							</a>
						</div>
					</div>
				</section>
			{% else %}
				<section class="fs-fees-hero">
					<div class="fs-fees-hero__content">
						<div>
							<span class="fs-fees-eyebrow">
								<i class="fe fe-users"></i>
								{% trans %}Students workspace{% endtrans %}
							</span>

							<h1 class="fs-fees-title">
								{% trans %}STUDENTS MANAGMENT{% endtrans %}
							</h1>

							<p class="fs-fees-subtitle">
								{% trans %}Display students by classroom through a clean and responsive premium interface.{% endtrans %}
							</p>
						</div>
					</div>
				</section>
			{% endif %}

			<section class="fs-fees-filter-card">
				<div class="fs-fees-filter-card__header">
					<div>
						<span class="fs-fees-chip">
							<i class="fe fe-filter"></i>
							{% trans %}Classroom filter{% endtrans %}
						</span>

						<h2>{% trans %}Choose a classroom{% endtrans %}</h2>

						<p>{% trans %}Select a classroom to display the registration fee statement and students payment status.{% endtrans %}</p>
					</div>
				</div>

				<form action="{{ path('registration_feesStatement', {'headmasterFees': headmasterFees}) }}" method="post" class="fs-fees-filter-form needs-validation" novalidate>
					<div class="fs-floating-field fs-required-field">
						<select class="form-control select2-show-search fs-floating-control" data-placeholder="" name="classroom" id="classroom" required="required">
							<option label="" value="">
								
							</option>

							{% if subSystem == 'Francophone / French Speaker' %}
								{% if school.education.education == 'Général' %}
									{% include "includes/_selectClassrooms.html.twig" %}
								{% else %}
									{% include "includes/_selectClassroomsTech.html.twig" %}
								{% endif %}
							{% else %}
								{% include "includes/_selectClassroomsEn.html.twig" %}
							{% endif %}
						</select>

						<label class="fs-floating-label" for="classroom">
							<i class="fe fe-home"></i>
							{% trans %}Classroom{% endtrans %}
						</label>

						<div class="invalid-feedback">
							{% trans %}Please choose a classroom !{% endtrans %}
						</div>
					</div>

					<div class="fs-fees-filter-form__actions">
						<button class="fs-fees-btn fs-fees-btn--primary fs-fees-submit-btn" type="submit" name="displayStudents">
							<span class="fs-fees-submit-spinner" aria-hidden="true"></span>
							<i class="fa fa-list fs-fees-submit-icon"></i>
							<span>{% trans %}Display{% endtrans %}</span>
						</button>

						<a class="fs-fees-btn fs-fees-btn--ghost" name="displayStudents" href="{{ path('student_saveStudent') }}">
							<i class="fa fa-plus"></i>
							<span>{% trans %}Add student{% endtrans %}</span>
						</a>
					</div>
				</form>
			</section>

			{% if methodIsPost %}
				<section class="fs-fees-summary">
					<div class="fs-fees-summary__item">
						<span class="fs-fees-summary__icon">
							<i class="fe fe-home"></i>
						</span>
						<span class="fs-fees-summary__label">{% trans %}Class{% endtrans %}</span>
						<strong class="fs-fees-summary__value">{{ selectedClassroom.classroom }}</strong>
					</div>

					<div class="fs-fees-summary__item">
						<span class="fs-fees-summary__icon fs-fees-summary__icon--cyan">
							<i class="fe fe-users"></i>
						</span>
						<span class="fs-fees-summary__label">{% trans %}Effective{% endtrans %}</span>
						<strong class="fs-fees-summary__value">{{ students|length }}</strong>
					</div>

					<div class="fs-fees-summary__item">
						<span class="fs-fees-summary__icon fs-fees-summary__icon--gold">
							<i class="fe fe-info"></i>
						</span>
						<span class="fs-fees-summary__label">{% trans %}NB{% endtrans %}</span>
						<strong class="fs-fees-summary__value">{% trans %}All amounts are in{% endtrans %} {% trans %}F CFA{% endtrans %}</strong>
					</div>
				</section>

				<section class="fs-fees-card">
					<div class="fs-fees-card__header">
						<div>
							<span class="fs-fees-chip fs-fees-chip--soft">
								<i class="fe fe-grid"></i>
								{% trans %}Dynamic table{% endtrans %}
							</span>

							<h2>{% trans %}Class financial statement{% endtrans %}</h2>
						</div>

						<div class="fs-fees-card__actions">
							{% if students|length > 0 %}
								<a href="{{ path('registration_printSchoolFeesStatement', {'slugClassroom': selectedClassroom.slug}) }}" target="_blank" class="fs-fees-btn fs-fees-btn--ghost" name="printSchoolFeesStatement">
									<i class="fa fa-print"></i>
									<span>{% trans %}Print the class financial statement{% endtrans %}</span>
								</a>
							{% endif %}

							<a href="{{ path('print_student_solvable', {'slugClassroom': selectedClassroom.slug}) }}" class="fs-fees-btn fs-fees-btn--success" target="_blank">
								<i class="fa fa-print"></i>
								<span>{% trans %}Solvents{% endtrans %}</span>
								<i class="fa fa-smile-o"></i>
							</a>

							<a href="{{ path('print_student_insolvable', {'slugClassroom': selectedClassroom.slug}) }}" class="fs-fees-btn fs-fees-btn--danger" target="_blank">
								<i class="fa fa-print"></i>
								<span>{% trans %}Insolvents{% endtrans %}</span>
								<i class="fa fa-meh-o"></i>
							</a>

							<div class="fs-fees-search">
								<i class="fe fe-search"></i>
								<input type="text" class="fs-fees-search-input" placeholder="{% trans %}Search student, status, amount...{% endtrans %}">
							</div>
						</div>
					</div>

					<div class="fs-fees-card__body">
						<div class="fs-fees-table-wrap">
							<table class="table fs-fees-table fs-fees-dynamic-table" id="fsFeesStatementTable">
								<thead>
									<tr>
										<th><button type="button" class="fs-fees-sort" data-sort-index="0"><span>{% trans %}N°{% endtrans %}</span><i class="fe fe-chevron-down"></i></button></th>
										<th>{% trans %}Photo{% endtrans %}</th>
										<th><button type="button" class="fs-fees-sort" data-sort-index="2"><span>{% trans %}Full name{% endtrans %}</span><i class="fe fe-chevron-down"></i></button></th>
										<th><button type="button" class="fs-fees-sort" data-sort-index="3"><span>{% trans %}PTA{% endtrans %}</span><i class="fe fe-chevron-down"></i></button></th>
										<th><button type="button" class="fs-fees-sort" data-sort-index="4"><span>{% trans %}IT Fees{% endtrans %}</span><i class="fe fe-chevron-down"></i></button></th>
										<th><button type="button" class="fs-fees-sort" data-sort-index="5"><span>{% trans %}Booklet{% endtrans %}</span><i class="fe fe-chevron-down"></i></button></th>
										<th><button type="button" class="fs-fees-sort" data-sort-index="6"><span>{% trans %}Cl Schl{% endtrans %}</span><i class="fe fe-chevron-down"></i></button></th>
										<th><button type="button" class="fs-fees-sort" data-sort-index="7"><span>{% trans %}Photo{% endtrans %}</span><i class="fe fe-chevron-down"></i></button></th>
										<th><button type="button" class="fs-fees-sort" data-sort-index="8"><span>{% trans %}State{% endtrans %}</span><i class="fe fe-chevron-down"></i></button></th>
										<th>{% trans %}Actions{% endtrans %}</th>
									</tr>
								</thead>

								<tbody>
									{% set i = 1 %}
									{% for registrationHistory in registrationHistories %}
										{% set student = registrationHistory.student %}
										{% set registrations = registrationHistory.registration %}

										{% set totalApeeFees = 0 %}
										{% set totalComputerFees = 0 %}
										{% set totalMedicalBookletFees = 0 %}
										{% set totalCleanSchoolFees = 0 %}
										{% set totalPhotoFees = 0 %}

										{% for registration in registrations %}
											{% set totalApeeFees = totalApeeFees + registration.apeeFees %}
											{% set totalComputerFees = totalComputerFees + registration.computerFees %}
											{% set totalMedicalBookletFees = totalMedicalBookletFees + registration.medicalBookletFees %}
											{% set totalCleanSchoolFees = totalCleanSchoolFees + registration.cleanSchoolFees %}
											{% set totalPhotoFees = totalPhotoFees + registration.photoFees %}
										{% endfor %}

										{% set totalAvance = totalApeeFees + totalComputerFees + totalMedicalBookletFees + totalCleanSchoolFees + totalPhotoFees %}
										{% set totalFees = feesTable.apeeFees + feesTable.computerFees + feesTable.medicalBookletFees + feesTable.cleanSchoolFees + feesTable.photoFees %}
										{% set isPaid = totalFees - totalAvance == 0 %}

										<tr>
											<td data-label="{% trans %}N°{% endtrans %}">
												<span class="fs-fees-rank">{{ i }}</span>
											</td>

											<td data-label="{% trans %}Photo{% endtrans %}">
												{% if student.photo %}
													<img alt="Photo eleve" class="fs-fees-avatar" src="{{ asset ('images/students/' ~ student.photo) }}">
												{% else %}
													{% if student.sex.sex == "F" %}
														<img alt="Photo eleve" class="fs-fees-avatar" src="{{ asset ('images/students/fille.jpg')}}">
													{% else %}
														<img alt="Photo eleve" class="fs-fees-avatar" src="{{ asset ('images/students/garcon.jpg')}}">
													{% endif %}
												{% endif %}
											</td>

											<td data-label="{% trans %}Full name{% endtrans %}">
												<div class="fs-fees-student-cell">
													<span class="fs-fees-student-initial">{{ student.fullName|slice(0, 1)|upper }}</span>
													<div>
														<strong>{{ student.fullName }}</strong>
														<span>
															<i class="fe fe-user"></i>
															{% trans %}Student{% endtrans %}
														</span>
													</div>
												</div>
											</td>

											<td data-label="{% trans %}PTA{% endtrans %}">
												<span class="fs-fees-amount">{{ totalApeeFees }} / {{ feesTable.apeeFees }}</span>
											</td>

											<td data-label="{% trans %}IT Fees{% endtrans %}">
												<span class="fs-fees-amount">{{ totalComputerFees }} / {{ feesTable.computerFees }}</span>
											</td>

											<td data-label="{% trans %}Booklet{% endtrans %}">
												<span class="fs-fees-amount">{{ totalMedicalBookletFees }} / {{ feesTable.medicalBookletFees }}</span>
											</td>

											<td data-label="{% trans %}Cl Schl{% endtrans %}">
												<span class="fs-fees-amount">{{ totalCleanSchoolFees }} / {{ feesTable.cleanSchoolFees }}</span>
											</td>

											<td data-label="{% trans %}Photo{% endtrans %}">
												<span class="fs-fees-amount">{{ totalPhotoFees }} / {{ feesTable.photoFees }}</span>
											</td>

											<td data-label="{% trans %}State{% endtrans %}">
												{% if isPaid %}
													<span class="fs-fees-status fs-fees-status--paid">
														<i class="fe fe-check-circle"></i>
														{% trans %}Paid{% endtrans %}
													</span>
												{% else %}
													<span class="fs-fees-status fs-fees-status--unpaid">
														<i class="fe fe-alert-circle"></i>
														{% trans %}Not Paid{% endtrans %}
													</span>
												{% endif %}
											</td>

											<td data-label="{% trans %}Actions{% endtrans %}" class="fs-fees-actions">
												<div class="dropdown fs-fees-dropdown">
													<a href="javascript:void(0);" class="fs-fees-option-btn" data-bs-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
														<span>{% trans %}Options{% endtrans %}</span>
														<i class="fa fa-angle-down"></i>
													</a>

													<div class="dropdown-menu">
														<a class="dropdown-item" href="{{ path('print_quitus', {'slugStudent': student.slug}) }}" target="_blank">
															<i class="fe fe-printer me-2"></i>
															{% trans %}Clearance{% endtrans %}
														</a>

														<a class="dropdown-item" href="{{ path('registration_printStudentFeesHistory', {'slugStudent': student.slug}) }}" target="_blank">
															<i class="fe fe-printer me-2"></i>
															{% trans %}Payment history{% endtrans %}
														</a>

														<a class="dropdown-item" href="{{ path('registration_printPaymentReceipt', {'slugStudent': student.slug}) }}" target="_blank">
															<i class="fe fe-printer me-2"></i>
															{% trans %}Payment receipt{% endtrans %}
														</a>

														<a class="dropdown-item" href="{{ path('registration_schoolFees', {'slugStudent': student.slug, 'headmasterFees': headmasterFees}) }}">
															<i class="fe fe-edit me-2"></i>
															{% trans %}To manage{% endtrans %}
														</a>
													</div>
												</div>
											</td>
										</tr>
										{% set i = i + 1 %}
									{% else %}
										<tr>
											<td colspan="10">
												<div class="fs-fees-empty">
													<i class="fe fe-folder"></i>
													<strong>{% trans %}No student found{% endtrans %}</strong>
													<span>{% trans %}Choose a classroom to display registration financial statements.{% endtrans %}</span>
												</div>
											</td>
										</tr>
									{% endfor %}
								</tbody>
							</table>
						</div>

						<div class="fs-fees-table-footer">
							<div class="fs-fees-result-count"></div>

							<div class="fs-fees-footer-controls">
								<label class="fs-fees-page-size">
									<span>{% trans %}Rows{% endtrans %}</span>
									<select class="fs-fees-rows-per-page">
										<option value="5">5</option>
										<option value="10" selected>10</option>
										<option value="25">25</option>
										<option value="50">50</option>
									</select>
								</label>

								<div class="fs-fees-pagination" aria-label="{% trans %}Pagination{% endtrans %}"></div>
							</div>
						</div>
					</div>
				</section>
			{% endif %}
		</div>
	</div>
{% endblock %}

{% block javascripts %}
	{{ parent() }}
	<script src="{{ asset('build/custom/js/freeschool-registration-fees-statement-premium.js') }}"></script>
{% endblock %}
