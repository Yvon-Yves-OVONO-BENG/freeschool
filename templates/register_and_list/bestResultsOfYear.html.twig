{% extends 'base.html.twig' %}

{% block title %}{% trans %}Best results of the year{% endtrans %}{% endblock %}

{% block subTitle %}
	{% trans %}BEST STUDENTS MANAGEMENT{% endtrans %}
{% endblock %}

{% block stylesheets %}
	{{ parent() }}
	<link rel="stylesheet" href="{{ asset('build/custom/css/freeschool-best-results-management-premium.css') }}">
{% endblock %}

{% block body %}
	<div class="hor-content main-content fs-br-page">
		<div class="container">
			<div class="fs-br-menu-safe-space" aria-hidden="true"></div>

			<section class="fs-br-hero">
				<div class="fs-br-hero__content">
					<div>
						<span class="fs-br-eyebrow">
							<i class="si si-badge"></i>
							{% trans %}Academic excellence workspace{% endtrans %}
						</span>

						<h1 class="fs-br-title">
							{% trans %}Best results of the year{% endtrans %}
						</h1>

						<p class="fs-br-subtitle">
							{% trans %}Print and display top student rankings by school, class, subject, cycle, level and science classrooms through a refined premium workspace.{% endtrans %}
						</p>
					</div>

					<div class="fs-br-hero__actions">
						<div class="fs-br-hero-stat">
							<span class="fs-br-hero-stat__icon">
								<i class="fe fe-award"></i>
							</span>
							<span class="fs-br-hero-stat__label">{% trans %}Reports{% endtrans %}</span>
							<strong class="fs-br-hero-stat__value">10</strong>
						</div>

						<form action="{{ path('print_school_top_five_students') }}" method="post" target="_blank" class="fs-br-hero-form" data-no-spinner="1">
							<button class="fs-br-btn fs-br-btn--light fs-br-submit-btn" type="submit" name="printBestStudentsPerClass">
								<i class="fa fa-print fs-br-submit-icon"></i>
								<span>{% trans %}The School's top five students{% endtrans %}</span>
							</button>
						</form>
					</div>
				</div>
			</section>

			<section class="fs-br-toolbar">
				<div>
					<span class="fs-br-chip">
						<i class="fe fe-grid"></i>
						{% trans %}Ranking modules{% endtrans %}
					</span>
					<h2>{% trans %}Choose the ranking to print or display{% endtrans %}</h2>
				</div>

				<div class="fs-br-toolbar__search">
					<i class="fe fe-search"></i>
					<input type="text" class="fs-br-module-search" placeholder="{% trans %}Search a module...{% endtrans %}">
				</div>
			</section>

			<div class="fs-br-grid">
				<section class="fs-br-card" data-module-card>
					<div class="fs-br-card__header">
						<span class="fs-br-card__icon">
							<i class="si si-badge"></i>
						</span>
						<div>
							<h3>{% trans %}Printing of the list of first by class{% endtrans %}</h3>
							<p>{% trans %}Print first students by class for the selected period.{% endtrans %}</p>
						</div>
					</div>

					<form action="{{ path('register_and_list_printBestStudentsPerClass') }}" method="post" target="_blank" class="fs-br-form needs-validation" novalidate data-no-spinner="1">
						<div class="fs-floating-field fs-required-field">
							<select name="term" id="termFirstClass" class="form-control select2 custom-select fs-floating-control" data-placeholder="" required>
								<option label="" value=""></option>
								<optgroup label="{% trans %}Terms{% endtrans %}">
									{% for term in terms %}
										{% if term.term != annualTerm %}
											<option value="{{ term.id }}">{% trans %}Term{% endtrans %} {{ term.term }}</option>
										{% endif %}
									{% endfor %}
								</optgroup>
								{% for term in terms %}
									{% if term.term == annualTerm %}
										<option value="{{ term.id }}">{% trans %}Annual{% endtrans %}</option>
									{% endif %}
								{% endfor %}
							</select>

							<label class="fs-floating-label" for="termFirstClass">
								<i class="fe fe-calendar"></i>
								{% trans %}Period{% endtrans %}
							</label>

							<div class="invalid-feedback">{% trans %}Please choose a period !{% endtrans %}</div>
						</div>

						<div class="fs-br-form__actions">
							<button class="fs-br-btn fs-br-btn--primary fs-br-submit-btn" type="submit" name="printBestStudentsPerClass">
								<i class="fa fa-print fs-br-submit-icon"></i>
								<span>{% trans %}Print{% endtrans %}</span>
							</button>
						</div>
					</form>
				</section>

				<section class="fs-br-card" data-module-card>
					<div class="fs-br-card__header">
						<span class="fs-br-card__icon fs-br-card__icon--violet">
							<i class="fe fe-book-open"></i>
						</span>
						<div>
							<h3>{% trans %}Top five by subjects{% endtrans %}</h3>
							<p>{% trans %}Print top five students by discipline.{% endtrans %}</p>
						</div>
					</div>

					<form action="{{ path('print_school_top_five_students_subject') }}" method="post" target="_blank" class="fs-br-form needs-validation" novalidate data-no-spinner="1">
						<div class="fs-floating-field fs-required-field">
							<select name="subject" id="subjectTopFive" class="form-control select2-show-search fs-floating-control" data-placeholder="{% trans %}Choose a subject{% endtrans %}" required>
								<option label="{% trans %}Choose a subject{% endtrans %}" value="">{% trans %}Choose a subject{% endtrans %}</option>
								{% for subject in subjects %}
									<option value="{{ subject.id }}">{{ subject.subject }}</option>
								{% endfor %}
							</select>

							<label class="fs-floating-label" for="subjectTopFive">
								<i class="fe fe-book"></i>
								{% trans %}Subject{% endtrans %}
							</label>

							<div class="invalid-feedback">{% trans %}Please choose a subject !{% endtrans %}</div>
						</div>

						<div class="fs-br-form__actions">
							<button class="fs-br-btn fs-br-btn--primary fs-br-submit-btn" type="submit" name="printBestStudentsPerClass">
								<i class="fa fa-print fs-br-submit-icon"></i>
								<span>{% trans %}Print{% endtrans %}</span>
							</button>
						</div>
					</form>
				</section>

				<section class="fs-br-card" data-module-card>
					<div class="fs-br-card__header">
						<span class="fs-br-card__icon fs-br-card__icon--cyan">
							<i class="fe fe-refresh-cw"></i>
						</span>
						<div>
							<h3>{% trans %}Top five students by cycle{% endtrans %}</h3>
							<p>{% trans %}Print top five students for the selected cycle.{% endtrans %}</p>
						</div>
					</div>

					<form action="{{ path('top_five_students_by_cycle') }}" method="post" target="_blank" class="fs-br-form needs-validation" novalidate data-no-spinner="1">
						<div class="fs-floating-field fs-required-field">
							<select name="cycle" id="cycleTopFive" class="form-control select2-show-search fs-floating-control" data-placeholder="{% trans %}Choose a cycle{% endtrans %}" required>
								<option value="" label="{% trans %}Choose a cycle{% endtrans %}">{% trans %}Choose a cycle{% endtrans %}</option>
								{% for cycle in cycles %}
									<option value="{{ cycle.id }}">{% trans %}Cycle :{% endtrans %} {{ cycle.cycle }}</option>
								{% endfor %}
							</select>

							<label class="fs-floating-label" for="cycleTopFive">
								<i class="fe fe-refresh-cw"></i>
								{% trans %}Cycle{% endtrans %}
							</label>

							<div class="invalid-feedback">{% trans %}Please choose a cycle !{% endtrans %}</div>
						</div>

						<div class="fs-br-form__actions">
							<button class="fs-br-btn fs-br-btn--primary fs-br-submit-btn" type="submit" name="printBestStudentsPerClass">
								<i class="fa fa-print fs-br-submit-icon"></i>
								<span>{% trans %}Print{% endtrans %}</span>
							</button>
						</div>
					</form>
				</section>

				<section class="fs-br-card" data-module-card>
					<div class="fs-br-card__header">
						<span class="fs-br-card__icon fs-br-card__icon--gold">
							<i class="fe fe-layers"></i>
						</span>
						<div>
							<h3>{% trans %}Top five students by cycle and discipline{% endtrans %}</h3>
							<p>{% trans %}Filter rankings by cycle and discipline.{% endtrans %}</p>
						</div>
					</div>

					<form action="{{ path('top_five_students_by_cycle_and_subject') }}" method="post" target="_blank" class="fs-br-form fs-br-form--two needs-validation" novalidate data-no-spinner="1">
						<div class="fs-floating-field fs-required-field">
							<select name="cycle" id="cycleSubjectTopFive" class="form-control select2-show-search fs-floating-control" data-placeholder="{% trans %}Choose cycle{% endtrans %}" required>
								<option value="" label="{% trans %}Choose a cycle{% endtrans %}">{% trans %}Choose cycle{% endtrans %}</option>
								<option value="0" label="{% trans %}Choose a cycle{% endtrans %}">{% trans %}All cycle{% endtrans %}</option>
								{% for cycle in cycles %}
									<option value="{{ cycle.id }}">{% trans %}Cycle  :{% endtrans %} {{ cycle.cycle }}</option>
								{% endfor %}
							</select>

							<label class="fs-floating-label" for="cycleSubjectTopFive">
								<i class="fe fe-refresh-cw"></i>
								{% trans %}Cycle{% endtrans %}
							</label>

							<div class="invalid-feedback">{% trans %}Please choose a cycle !{% endtrans %}</div>
						</div>

						<div class="fs-floating-field fs-required-field">
							<select name="subject" id="subjectCycleTopFive" class="form-control select2-show-search fs-floating-control" data-placeholder="{% trans %}Choose a subject{% endtrans %}" required>
								<option value="" label="{% trans %}Choose a subject{% endtrans %}">{% trans %}Choose a subject{% endtrans %}</option>
								<option value="0" label="{% trans %}Choose a cycle{% endtrans %}">{% trans %}All subject{% endtrans %}</option>
								{% for subject in subjects %}
									<option value="{{ subject.id }}">{{ subject.subject }}</option>
								{% endfor %}
							</select>

							<label class="fs-floating-label" for="subjectCycleTopFive">
								<i class="fe fe-book"></i>
								{% trans %}Subject{% endtrans %}
							</label>

							<div class="invalid-feedback">{% trans %}Please choose a subject !{% endtrans %}</div>
						</div>

						<div class="fs-br-form__actions">
							<button class="fs-br-btn fs-br-btn--primary fs-br-submit-btn" type="submit" name="printBestStudentsPerClass">
								<i class="fa fa-print fs-br-submit-icon"></i>
								<span>{% trans %}Print{% endtrans %}</span>
							</button>
						</div>
					</form>
				</section>

				<section class="fs-br-card" data-module-card>
					<div class="fs-br-card__header">
						<span class="fs-br-card__icon">
							<i class="fe fe-trending-up"></i>
						</span>
						<div>
							<h3>{% trans %}Top five students by level{% endtrans %}</h3>
							<p>{% trans %}Print top five students for the selected level.{% endtrans %}</p>
						</div>
					</div>

					<form action="{{ path('top_five_students_by_level') }}" method="post" target="_blank" class="fs-br-form needs-validation" novalidate data-no-spinner="1">
						<div class="fs-floating-field fs-required-field">
							<select name="level" id="levelTopFive" class="form-control select2-show-search fs-floating-control" data-placeholder="{% trans %}Choose a level{% endtrans %}" required>
								<option value="" label="{% trans %}Choose a level{% endtrans %}">{% trans %}Choose a level{% endtrans %}</option>
								{% for level in levels %}
									<option value="{{ level.id }}">{% trans %}Level{% endtrans %} : {{ level.level }}</option>
								{% endfor %}
							</select>

							<label class="fs-floating-label" for="levelTopFive">
								<i class="fe fe-trending-up"></i>
								{% trans %}Level{% endtrans %}
							</label>

							<div class="invalid-feedback">{% trans %}Please choose a level !{% endtrans %}</div>
						</div>

						<div class="fs-br-form__actions">
							<button class="fs-br-btn fs-br-btn--primary fs-br-submit-btn" type="submit" name="printBestStudentsPerClass">
								<i class="fa fa-print fs-br-submit-icon"></i>
								<span>{% trans %}Print{% endtrans %}</span>
							</button>
						</div>
					</form>
				</section>

				<section class="fs-br-card" data-module-card>
					<div class="fs-br-card__header">
						<span class="fs-br-card__icon fs-br-card__icon--violet">
							<i class="fe fe-book"></i>
						</span>
						<div>
							<h3>{% trans %}Top five students by level and discipline{% endtrans %}</h3>
							<p>{% trans %}Filter rankings by level and discipline.{% endtrans %}</p>
						</div>
					</div>

					<form action="{{ path('top_five_students_level_and_subject') }}" method="post" target="_blank" class="fs-br-form fs-br-form--two needs-validation" novalidate data-no-spinner="1">
						<div class="fs-floating-field fs-required-field">
							<select name="level" id="levelSubjectTopFive" class="form-control select2-show-search fs-floating-control" data-placeholder="{% trans %}Choose a level{% endtrans %}" required>
								<option value="" label="{% trans %}Choose a level{% endtrans %}">{% trans %}Choose a level{% endtrans %}</option>
								{% for level in levels %}
									<option value="{{ level.id }}">{% trans %}Level{% endtrans %} : {{ level.level }}</option>
								{% endfor %}
							</select>

							<label class="fs-floating-label" for="levelSubjectTopFive">
								<i class="fe fe-trending-up"></i>
								{% trans %}Level{% endtrans %}
							</label>

							<div class="invalid-feedback">{% trans %}Please choose a level !{% endtrans %}</div>
						</div>

						<div class="fs-floating-field fs-required-field">
							<select name="subject" id="subjectLevelTopFive" class="form-control select2-show-search fs-floating-control" data-placeholder="{% trans %}Choose a subject{% endtrans %}" required>
								<option value="" label="{% trans %}Choose a subject{% endtrans %}">{% trans %}Choose a subject{% endtrans %}</option>
								{% for subject in subjects %}
									<option value="{{ subject.id }}">{{ subject.subject }}</option>
								{% endfor %}
							</select>

							<label class="fs-floating-label" for="subjectLevelTopFive">
								<i class="fe fe-book"></i>
								{% trans %}Subject{% endtrans %}
							</label>

							<div class="invalid-feedback">{% trans %}Please choose a subject !{% endtrans %}</div>
						</div>

						<div class="fs-br-form__actions">
							<button class="fs-br-btn fs-br-btn--primary fs-br-submit-btn" type="submit" name="printBestStudentsPerClass">
								<i class="fa fa-print fs-br-submit-icon"></i>
								<span>{% trans %}Print{% endtrans %}</span>
							</button>
						</div>
					</form>
				</section>

				<section class="fs-br-card" data-module-card>
					<div class="fs-br-card__header">
						<span class="fs-br-card__icon fs-br-card__icon--cyan">
							<i class="fe fe-home"></i>
						</span>
						<div>
							<h3>{% trans %}Top five students by classroom{% endtrans %}</h3>
							<p>{% trans %}Print top five students for a classroom.{% endtrans %}</p>
						</div>
					</div>

					<form action="{{ path('top_five_students_by_classroom') }}" method="post" target="_blank" class="fs-br-form needs-validation" novalidate data-no-spinner="1">
						<div class="fs-floating-field fs-required-field">
							<select name="classroom" id="classroomTopFive" class="form-control select2-show-search fs-floating-control" data-placeholder="{% trans %}Choose a classroom{% endtrans %}" required>
								<option value="">{% trans %}Choose a classroom{% endtrans %}</option>

								{% if subSystem == 'Francophone / French Speaker' %}
									{% if school.education.education == 'Général' %}
										{% include "includes/_selectClassrooms.html.twig" %}
									{% else %}
										{% include "includes/_selectClassroomsTech.html.twig" %}
									{% endif %}
								{% else %}
									{% include "includes/_selectClassroomsEn.html.twig" %}
								{% endif %}
							</select>

							<label class="fs-floating-label" for="classroomTopFive">
								<i class="fe fe-home"></i>
								{% trans %}Classroom{% endtrans %}
							</label>

							<div class="invalid-feedback">{% trans %}Please choose a classroom !{% endtrans %}</div>
						</div>

						<div class="fs-br-form__actions">
							<button class="fs-br-btn fs-br-btn--primary fs-br-submit-btn" type="submit" name="printBestStudentsPerClass">
								<i class="fa fa-print fs-br-submit-icon"></i>
								<span>{% trans %}Print{% endtrans %}</span>
							</button>
						</div>
					</form>
				</section>

				<section class="fs-br-card" data-module-card>
					<div class="fs-br-card__header">
						<span class="fs-br-card__icon fs-br-card__icon--gold">
							<i class="fe fe-layers"></i>
						</span>
						<div>
							<h3>{% trans %}Top five students by classroom and discipline{% endtrans %}</h3>
							<p>{% trans %}Filter rankings by classroom and discipline.{% endtrans %}</p>
						</div>
					</div>

					<form action="{{ path('print_school_top_five_students_classroom_and_subject') }}" method="post" target="_blank" class="fs-br-form fs-br-form--two needs-validation" novalidate data-no-spinner="1">
						<div class="fs-floating-field fs-required-field">
							<select name="classroom" id="classroomSubjectTopFive" class="form-control select2-show-search fs-floating-control" data-placeholder="{% trans %}Choose a classroom{% endtrans %}" required>
								<option value="">{% trans %}Choose a classroom{% endtrans %}</option>

								{% if subSystem == 'Francophone / French Speaker' %}
									{% if school.education.education == 'Général' %}
										{% include "includes/_selectClassrooms.html.twig" %}
									{% else %}
										{% include "includes/_selectClassroomsTech.html.twig" %}
									{% endif %}
								{% else %}
									{% include "includes/_selectClassroomsEn.html.twig" %}
								{% endif %}
							</select>

							<label class="fs-floating-label" for="classroomSubjectTopFive">
								<i class="fe fe-home"></i>
								{% trans %}Classroom{% endtrans %}
							</label>

							<div class="invalid-feedback">{% trans %}Please choose a classroom !{% endtrans %}</div>
						</div>

						<div class="fs-floating-field fs-required-field">
							<select name="subject" id="subjectClassroomTopFive" class="form-control select2-show-search fs-floating-control" data-placeholder="{% trans %}Choose a subject{% endtrans %}" required>
								<option value="" label="{% trans %}Choose a subject{% endtrans %}">{% trans %}Choose a subject{% endtrans %}</option>
								<option value="0">{% trans %}All Subjects{% endtrans %}</option>
								{% for subject in subjects %}
									<option value="{{ subject.id }}">{{ subject.subject }}</option>
								{% endfor %}
							</select>

							<label class="fs-floating-label" for="subjectClassroomTopFive">
								<i class="fe fe-book"></i>
								{% trans %}Subject{% endtrans %}
							</label>

							<div class="invalid-feedback">{% trans %}Please choose a subject !{% endtrans %}</div>
						</div>

						<div class="fs-br-form__actions">
							<button class="fs-br-btn fs-br-btn--primary fs-br-submit-btn" type="submit" name="printBestStudentsPerClass">
								<i class="fa fa-print fs-br-submit-icon"></i>
								<span>{% trans %}Print{% endtrans %}</span>
							</button>
						</div>
					</form>
				</section>

				<section class="fs-br-card" data-module-card>
					<div class="fs-br-card__header">
						<span class="fs-br-card__icon">
							<i class="fe fe-eye"></i>
						</span>
						<div>
							<h3>{% trans %}Best students per level{% endtrans %}</h3>
							<p>{% trans %}Display or print best students per level.{% endtrans %}</p>
						</div>
					</div>

					<form action="{{ path('best_students_by_level') }}" method="post" target="_blank" class="fs-br-form fs-br-form--actions-two needs-validation" novalidate data-no-spinner="1">
						<div class="fs-floating-field fs-required-field">
							<select name="level" id="bestLevel" class="form-control select2-show-search fs-floating-control" data-placeholder="{% trans %}Choose a level{% endtrans %}" required>
								<option value="" label="{% trans %}Choose a level{% endtrans %}">{% trans %}Choose a level{% endtrans %}</option>
								{% for level in levels %}
									<option value="{{ level.id }}">{% trans %}Level{% endtrans %} : {{ level.level }}</option>
								{% endfor %}
							</select>

							<label class="fs-floating-label" for="bestLevel">
								<i class="fe fe-trending-up"></i>
								{% trans %}Level{% endtrans %}
							</label>

							<div class="invalid-feedback">{% trans %}Please choose a level !{% endtrans %}</div>
						</div>

						<div class="fs-br-form__actions fs-br-form__actions--two">
							<button class="fs-br-btn fs-br-btn--ghost fs-br-submit-btn" type="submit" name="display">
								<i class="fa fa-eye fs-br-submit-icon"></i>
								<span>{% trans %}Display{% endtrans %}</span>
							</button>

							<button class="fs-br-btn fs-br-btn--primary fs-br-submit-btn" type="submit" name="printBestStudentsPerClass">
								<i class="fa fa-print fs-br-submit-icon"></i>
								<span>{% trans %}Print{% endtrans %}</span>
							</button>
						</div>
					</form>
				</section>

				<section class="fs-br-card" data-module-card>
					<div class="fs-br-card__header">
						<span class="fs-br-card__icon fs-br-card__icon--rose">
							<i class="fe fe-star"></i>
						</span>
						<div>
							<h3>{% trans %}Top girls science classes{% endtrans %}</h3>
							<p>{% trans %}Display or print top girls in science classrooms.{% endtrans %}</p>
						</div>
					</div>

					<form action="{{ path('top_girls_students_by_science_classroom') }}" method="post" target="_blank" class="fs-br-form fs-br-form--actions-two needs-validation" novalidate data-no-spinner="1">
						<div class="fs-floating-field fs-required-field">
							<select name="classroom" id="scienceGirlClassroom" class="form-control select2-show-search fs-floating-control" data-placeholder="{% trans %}Choose a classroom{% endtrans %}" required>
								<option value="">{% trans %}Choose a classroom{% endtrans %}</option>

								{% if subSystem == 'Francophone / French Speaker' %}
									{% if school.education.education == 'Général' %}
										{% include "includes/_selectClassrooms.html.twig" %}
									{% else %}
										{% include "includes/_selectClassroomsTech.html.twig" %}
									{% endif %}
								{% else %}
									{% include "includes/_selectClassroomsEn.html.twig" %}
								{% endif %}
							</select>

							<label class="fs-floating-label" for="scienceGirlClassroom">
								<i class="fe fe-home"></i>
								{% trans %}Classroom{% endtrans %}
							</label>

							<div class="invalid-feedback">{% trans %}Please choose a classroom !{% endtrans %}</div>
						</div>

						<div class="fs-br-form__actions fs-br-form__actions--two">
							<button class="fs-br-btn fs-br-btn--ghost fs-br-submit-btn" type="submit" name="display">
								<i class="fa fa-eye fs-br-submit-icon"></i>
								<span>{% trans %}Display{% endtrans %}</span>
							</button>

							<button class="fs-br-btn fs-br-btn--primary fs-br-submit-btn" type="submit" name="printBestStudentsPerClass">
								<i class="fa fa-print fs-br-submit-icon"></i>
								<span>{% trans %}Print{% endtrans %}</span>
							</button>
						</div>
					</form>
				</section>
			</div>
		</div>
	</div>
{% endblock %}

