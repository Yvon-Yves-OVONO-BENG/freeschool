{% extends 'base.html.twig' %}

{% block title %}{% trans %}Slip Per Class{% endtrans %}{% endblock %}

{% block subTitle %}
	{% trans %}STATISTIC SHEETS PER CLASS MANAGMENT{% endtrans %}
{% endblock %}

{% block infoMessage %}
	{% include "includes/_info_message.html.twig" %}
{% endblock %}

{% block stylesheets %}
	{{ parent() }}
	<link rel="stylesheet" href="{{ asset('build/custom/css/freeschool-statistics-suite-premium.css') }}">
{% endblock %}

{% block body %}
	<div class="hor-content main-content fs-stat-page">
		<div class="container">
			<div class="fs-stat-menu-safe-space" aria-hidden="true"></div>

			<section class="fs-stat-hero">
				<div class="fs-stat-hero__content">
					<div>
						<span class="fs-stat-eyebrow">
							<i class="fa fa-bar-chart"></i>
							{% trans %}Class statistics{% endtrans %}
						</span>

						<h1 class="fs-stat-title">{% trans %}Statistic sheet per class printing{% endtrans %}</h1>

						<p class="fs-stat-subtitle">
							{% trans %}Print statistic sheets by classroom and period.{% endtrans %}
						</p>
					</div>

					<div class="fs-stat-hero__actions">
						
						<div class="fs-stat-hero-stat">
							<span class="fs-stat-hero-stat__icon">
								<i class="fe fe-printer"></i>
							</span>
							<span class="fs-stat-hero-stat__label">{% trans %}Output{% endtrans %}</span>
							<strong class="fs-stat-hero-stat__value">{% trans %}PDF{% endtrans %}</strong>
						</div>
					</div>
				</div>
			</section>

			<div class="fs-stat-grid fs-stat-grid--single">
				
<section class="fs-stat-card">
	<div class="fs-stat-card__header">
		<div>
			<span class="fs-stat-chip">
				<i class="fa fa-bar-chart"></i>
				{% trans %}Printing workspace{% endtrans %}
			</span>
			<h2 class="fs-stat-card__title">{% trans %}Statistic sheet per class printing{% endtrans %}</h2>
			<p class="fs-stat-card__subtitle">{% trans %}Select the classroom and period before printing the statistic sheet.{% endtrans %}</p>
		</div>
		<span class="fs-stat-card__icon">
			<i class="fa fa-bar-chart"></i>
		</span>
	</div>
	<div class="fs-stat-card__body">
		<form action="{{ path('statistic_printSlipPerClass') }}" method="post" target="_blank" class="fs-stat-form needs-validation" novalidate data-no-spinner="1">
			<div class="fs-floating-field fs-required-field">
	<select name="classroom" id="classroom" class="form-control select2-show-search fs-floating-control" data-placeholder="" required>
		<option value="" label=""></option>
		{% if subSystem == 'Francophone / French Speaker' %}
			{% if school.education.education == 'Général' %}
				{% include "includes/_selectClassrooms.html.twig" %}
			{% else %}
				{% include "includes/_selectClassroomsTech.html.twig" %}
			{% endif %}
		{% else %}
			{% include "includes/_selectClassroomsEn.html.twig" %}
		{% endif %}
	</select>
	<label class="fs-floating-label" for="classroom">
		<i class="fe fe-home"></i>
		{% trans %}Classroom{% endtrans %}
	</label>
	<div class="invalid-feedback">{% trans %}Please choose a classroom !{% endtrans %}</div>
</div>
<div class="fs-floating-field fs-required-field">
	<select name="period" id="period_class" class="form-control select2-show-search fs-floating-control" data-placeholder="" required>
		<option value="" label=""></option>
		<optgroup label="{% trans %}Evaluations{% endtrans %}">
			{% for sequence in sequences %}
				<option value="s{{ sequence.id }}">{% trans %}Evaluation{% endtrans %} {{ sequence.sequence }}</option>
			{% endfor %}
		</optgroup>
		<optgroup label="{% trans %}Trimestres{% endtrans %}">
			{% for term in terms %}
				{% if term.term != annualTerm %}
					<option value="t{{ term.id }}">{% trans %}Term{% endtrans %} {{ term.term }}</option>
				{% endif %}
			{% endfor %}
		</optgroup>
		{% for term in terms %}
			{% if term.term == annualTerm %}
				<option value="a{{ term.id }}">{% trans %}Annual{% endtrans %}</option>
			{% endif %}
		{% endfor %}
	</select>
	<label class="fs-floating-label" for="period_class">
		<i class="fe fe-calendar"></i>
		{% trans %}Period{% endtrans %}
	</label>
	<div class="invalid-feedback">{% trans %}Please choose a period !{% endtrans %}</div>
</div>
			<div class="fs-stat-form__actions">
				<button class="fs-stat-btn fs-stat-btn--primary fs-stat-submit-btn" type="submit" name="printSlipPerClass">
					<i class="fa fa-print fs-stat-submit-icon"></i>
					<span>{% trans %}Print{% endtrans %}</span>
				</button>
			</div>
		</form>
		
	</div>
</section>

			</div>
		</div>
	</div>
{% endblock %}

{% block javascripts %}
	{{ parent() }}
	<script src="{{ asset('build/custom/js/freeschool-statistics-suite-premium.js') }}"></script>
{% endblock %}
