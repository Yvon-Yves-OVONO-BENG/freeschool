{% extends 'base.html.twig' %}

{% block title %}{% trans %}Grade{% endtrans %}{% endblock %}

{% block subTitle %}
	{% if slug != 0 %}
		{% trans %}UPDATING RANK{% endtrans %}
	{% else %}
		{% trans %}ADDING NEW RANK{% endtrans %}
	{% endif %}
{% endblock %}

{% block infoMessage %}
	{% include "includes/_info_message.html.twig" %}
{% endblock %}

{% block stylesheets %}
	{{ parent() }}
	<link rel="stylesheet" href="{{ asset('build/custom/css/freeschool-rank-form-premium.css') }}">
{% endblock %}

{% block body %}
	<div class="hor-content main-content fs-rank-page">
		<div class="container">
	        <div class="fs-rank-menu-safe-space" aria-hidden="true"></div>

			<div class="fs-rank-hero fs-rank-hero--compact">
                <div class="fs-rank-hero__content">
                    <span class="fs-rank-eyebrow">
                        <i class="fe fe-settings"></i>
                        {% trans %}School configuration{% endtrans %}
                    </span>

                    <h1 class="fs-rank-title">
                        {% if slug != 0 %}
                            {% trans %}UPDATING RANK{% endtrans %}
                        {% else %}
                            {% trans %}ADDING NEW RANK{% endtrans %}
                        {% endif %}
                    </h1>

                    <p class="fs-rank-subtitle">
                        {% trans %}Create and manage staff ranks with a clean, secure and responsive workspace.{% endtrans %}
                    </p>
                </div>

                <div class="fs-rank-hero__actions">
                    <a href="{{ path('grade_displayGrade', {'notification':0}) }}" class="fs-rank-btn fs-rank-btn--hero-secondary">
                        <i class="fe fe-list"></i>
                        <span>{% trans %}Display registered ranks{% endtrans %}</span>
                    </a>
                </div>
            </div>

			<div class="fs-rank-card fs-rank-card--clean {% if slug == 0 %}fs-rank-card--create{% else %}fs-rank-card--edit{% endif %}">
	<div class="fs-rank-card__header fs-rank-card__header--clean">
		<div>
			<span class="fs-rank-card__badge">
				{% if slug != 0 %}
					<i class="fe fe-edit"></i>
					{% trans %}Edit mode{% endtrans %}
				{% else %}
					<i class="fe fe-plus"></i>
					{% trans %}Creation mode{% endtrans %}
				{% endif %}
			</span>

			<h2 class="fs-rank-card__title">
				{% if slug != 0 %}
					{% trans %}UPDATING RANK{% endtrans %}
				{% else %}
					{% trans %}ADDING NEW RANK{% endtrans %}
				{% endif %}
			</h2>
		</div>

		{% if slug == 0 %}
			<button type="button" class="fs-rank-btn fs-rank-btn--soft fs-rank-add-top-btn" id="fsAddRankField">
				<i class="fe fe-plus"></i>
				<span>{% trans %}Add rank{% endtrans %}</span>
			</button>
		{% endif %}
	</div>

	<div class="fs-rank-card__body fs-rank-card__body--clean">
		{{ form_start(formGrade, {'attr': {'class': 'fs-rank-form', 'novalidate': 'novalidate'}}) }}

			<input type="hidden" name="_token_bulk_ranks" value="{{ csrf_token('bulk_save_grade') }}">

			<div class="fs-rank-builder">
				<div class="fs-rank-builder-row fs-rank-builder-row--main">
					<div class="fs-rank-builder-index">01</div>

					<div class="fs-floating-field">
						{{ form_widget(formGrade.grade, {
							'attr': {
								'class': 'fs-floating-control',
								'placeholder': ' '
							}
						}) }}

						<label class="fs-floating-label">
							<i class="fe fe-award"></i>
							{% trans %}Rank{% endtrans %}
						</label>

						<div class="fs-floating-error">
							{{ form_errors(formGrade.grade) }}
						</div>
					</div>

					<div class="fs-rank-builder-status">
						<span>{% trans %}Main{% endtrans %}</span>
					</div>
				</div>

				{% if slug == 0 %}
					<div id="fsExtraRanksContainer" class="fs-extra-ranks-container"></div>
				{% endif %}
			</div>

			<div class="fs-rank-form__footer fs-rank-form__footer--clean">
				<a href="{{ path('grade_displayGrade', {'notification':0}) }}" class="fs-rank-btn fs-rank-btn--ghost">
					<i class="fe fe-arrow-left"></i>
					<span>{% trans %}Back{% endtrans %}</span>
				</a>

				{% if slug == 0 %}
					<button type="submit" class="fs-rank-btn fs-rank-btn--primary" name="addGrade">
						<i class="fe fe-save"></i>
						<span>{% trans %}Save{% endtrans %}</span>
					</button>
				{% else %}
					<button type="submit" class="fs-rank-btn fs-rank-btn--primary" name="editGrade">
						<i class="fe fe-save"></i>
						<span>{% trans %}Save changes{% endtrans %}</span>
					</button>
				{% endif %}
			</div>

		{{ form_end(formGrade) }}
	</div>
</div>

		</div>
	</div>
{% endblock %}

{% block javascripts %}
	{{ parent() }}
	<script src="{{ asset('build/custom/js/freeschool-rank-form-premium.js') }}"></script>
{% endblock %}
