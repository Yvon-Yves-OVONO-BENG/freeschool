<script>
	(function () {
		'use strict';

		function directSubmenu(li) {
			if (!li) return null;

			for (const child of li.children) {
				if (
					child.classList &&
					(
						child.classList.contains('sub-menu') ||
						child.classList.contains('horizontal-megamenu')
					)
				) {
					return child;
				}
			}

			return null;
		}

		function buildMobileLeftMenu() {
			const body = document.body;
			const header = document.querySelector('.fs4-header');
			const horizontalMenu = document.getElementById('fs4HorizontalMenu');
			const sourceList = horizontalMenu
				? horizontalMenu.querySelector('.horizontalMenu-list')
				: null;

			if (header) {
				body.classList.add('fs4-has-header');
			}

			if (horizontalMenu) {
				body.classList.add('fs4-has-menu');
			}

			document.getElementById('fs4MobileLeftPanel')?.remove();
			document.getElementById('fs4MobileLeftOverlay')?.remove();

			if (!sourceList) {
				return;
			}

			const overlay = document.createElement('div');
			overlay.id = 'fs4MobileLeftOverlay';
			overlay.className = 'fs4-mobile-left-overlay';
			overlay.setAttribute('aria-hidden', 'true');

			const panel = document.createElement('nav');
			panel.id = 'fs4MobileLeftPanel';
			panel.className = 'fs4-mobile-left-panel';
			panel.setAttribute('aria-label', 'Menu principal');
			panel.setAttribute('aria-hidden', 'true');

			const clonedList = sourceList.cloneNode(true);
			clonedList.className = 'fs4-mobile-left-list';

			clonedList.querySelectorAll('.fs4-open').forEach(function (item) {
				item.classList.remove('fs4-open');
			});

			clonedList.querySelectorAll('[style]').forEach(function (item) {
				item.style.removeProperty('display');
				item.style.removeProperty('left');
				item.style.removeProperty('right');
				item.style.removeProperty('top');
				item.style.removeProperty('height');
				item.style.removeProperty('max-height');
				item.style.removeProperty('transform');
				item.style.removeProperty('opacity');
				item.style.removeProperty('visibility');
			});

			panel.appendChild(clonedList);
			body.appendChild(overlay);
			body.appendChild(panel);
		}

		function closeMenu() {
			const body = document.body;
			const menuToggle = document.getElementById('fs4MenuToggle');
			const panel = document.getElementById('fs4MobileLeftPanel');

			body.classList.remove('fs4-menu-open');
			body.style.overflow = '';
			document.documentElement.style.overflow = '';

			if (menuToggle) {
				menuToggle.setAttribute('aria-expanded', 'false');
			}

			if (panel) {
				panel.setAttribute('aria-hidden', 'true');
				panel.querySelectorAll('.fs4-mobile-open').forEach(function (item) {
					item.classList.remove('fs4-mobile-open');
				});
				panel.querySelectorAll('[aria-expanded="true"]').forEach(function (item) {
					item.setAttribute('aria-expanded', 'false');
				});
			}
		}

		function openMenu() {
			const body = document.body;
			const menuToggle = document.getElementById('fs4MenuToggle');
			const panel = document.getElementById('fs4MobileLeftPanel');

			closeActions();
			body.classList.add('fs4-menu-open');
			body.style.overflow = 'hidden';
			document.documentElement.style.overflow = 'hidden';

			if (menuToggle) {
				menuToggle.setAttribute('aria-expanded', 'true');
			}

			if (panel) {
				panel.setAttribute('aria-hidden', 'false');
				panel.scrollTop = 0;
			}
		}

		function closeActions() {
			const body = document.body;
			const actions = document.getElementById('fs4Actions');
			const actionsToggle = document.getElementById('fs4ActionsToggle');

			if (actions) {
				actions.classList.remove('fs4-actions-open');
			}

			if (actionsToggle) {
				actionsToggle.setAttribute('aria-expanded', 'false');
			}

			body.classList.remove('fs4-actions-open');
		}

		function openActions() {
			const body = document.body;
			const actions = document.getElementById('fs4Actions');
			const actionsToggle = document.getElementById('fs4ActionsToggle');

			closeMenu();

			if (actions) {
				actions.classList.add('fs4-actions-open');
			}

			if (actionsToggle) {
				actionsToggle.setAttribute('aria-expanded', 'true');
			}

			body.classList.add('fs4-actions-open');
		}

		function updateGreeting() {
			const greetingIcon = document.getElementById('fs4GreetingIcon');
			const greetingText = document.getElementById('fs4GreetingText');

			if (!greetingIcon || !greetingText) {
				return;
			}

			const hour = new Date().getHours();

			if (hour >= 18 || hour < 6) {
				greetingIcon.textContent = '🌙';
				greetingText.textContent = '{% trans %}Good evening{% endtrans %}';
			} else if (hour >= 12) {
				greetingIcon.textContent = '🌤️';
				greetingText.textContent = '{% trans %}Good afternoon{% endtrans %}';
			} else {
				greetingIcon.textContent = '☀️';
				greetingText.textContent = '{% trans %}Hello{% endtrans %}';
			}
		}

		function initializeMenu() {
			buildMobileLeftMenu();
			updateGreeting();
			closeMenu();
			closeActions();
		}

		if (!window.__fs4MobileLeftMenuV3Bound) {
			window.__fs4MobileLeftMenuV3Bound = true;

			document.addEventListener('click', function (event) {
				const menuToggle = event.target.closest('#fs4MenuToggle');
				const actionsToggle = event.target.closest('#fs4ActionsToggle');
				const overlay = event.target.closest('#fs4MobileLeftOverlay');
				const panel = event.target.closest('#fs4MobileLeftPanel');
				const actions = document.getElementById('fs4Actions');

				if (menuToggle) {
					event.preventDefault();
					event.stopPropagation();

					if (!document.getElementById('fs4MobileLeftPanel')) {
						buildMobileLeftMenu();
					}

					if (document.body.classList.contains('fs4-menu-open')) {
						closeMenu();
					} else {
						openMenu();
					}

					return;
				}

				if (actionsToggle) {
					event.preventDefault();
					event.stopPropagation();

					if (document.body.classList.contains('fs4-actions-open')) {
						closeActions();
					} else {
						openActions();
					}

					return;
				}

				if (overlay) {
					event.preventDefault();
					closeMenu();
					return;
				}

				if (panel) {
					const link = event.target.closest('a');

					if (!link || !panel.contains(link)) {
						return;
					}

					const li = link.closest('li');
					const submenu = directSubmenu(li);

					if (!submenu) {
						closeMenu();
						return;
					}

					event.preventDefault();
					event.stopPropagation();

					const parentList = li.parentElement;

					if (parentList) {
						Array.from(parentList.children).forEach(function (sibling) {
							if (
								sibling !== li &&
								sibling.classList &&
								sibling.classList.contains('fs4-mobile-open')
							) {
								sibling.classList.remove('fs4-mobile-open');

								const siblingLink = sibling.querySelector(':scope > a');
								if (siblingLink) {
									siblingLink.setAttribute('aria-expanded', 'false');
								}
							}
						});
					}

					const willOpen = !li.classList.contains('fs4-mobile-open');
					li.classList.toggle('fs4-mobile-open', willOpen);
					link.setAttribute('aria-expanded', willOpen ? 'true' : 'false');
					return;
				}

				if (
					actions &&
					document.body.classList.contains('fs4-actions-open') &&
					!actions.contains(event.target)
				) {
					closeActions();
				}
			}, true);

			document.addEventListener('keydown', function (event) {
				if (event.key === 'Escape') {
					closeMenu();
					closeActions();
				}
			});

			window.addEventListener('resize', function () {
				if (window.innerWidth >= 992) {
					closeMenu();
					closeActions();
				}
			});
		}

		if (document.readyState === 'loading') {
			document.addEventListener('DOMContentLoaded', function () {
				initializeMenu();
				window.setTimeout(buildMobileLeftMenu, 0);
			}, { once: true });
		} else {
			initializeMenu();
			window.setTimeout(buildMobileLeftMenu, 0);
		}

		document.addEventListener('turbo:load', initializeMenu);
	})();
</script>
