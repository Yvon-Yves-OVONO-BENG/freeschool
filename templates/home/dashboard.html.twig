            }
        }
    </style>

    <style>
        /* =========================================================
        FIX POSITION DASHBOARD SOUS LE MENU FIXE
        ========================================================= */
        @media (min-width: 992px) {
            body.fs4-has-header.fs4-has-menu .hor-content.main-content.fs-dashboard-shell,
            body.fs4-has-header.fs4-has-menu .fs-dashboard-shell {
                padding-top: 85px !important;
                margin-top: 0 !important;
            }

            body.fs4-has-header.fs4-has-menu .fs-dashboard-shell > .container,
            body.fs4-has-header.fs4-has-menu .fs-dashboard-shell .container {
                padding-top: 0 !important;
                margin-top: 0 !important;
            }

            body.fs4-has-header.fs4-has-menu .page-header.fs-dashboard-header,
            body.fs4-has-header.fs4-has-menu .fs-dashboard-header {
                margin-top: 0 !important;
                padding-top: .5rem !important;
            }
        }
    </style>

{% endblock %}

{% block body %}
<div class="hor-content main-content fs-dashboard-shell mt-5">
    <div class="container">
        <div class="page-header fs-dashboard-header mt-5">
            <div class="page-leftheader mt-4">
                <h4 class="page-title mb-0 text-primary">
                    {% trans %}Dashboard {% endtrans %}
                </h4>
                
            </div>

            <div class="page-rightheader fs-top-actions mt-4">
                {% if dashboardType == 'admin' %}
                    <a class="btn btn-outline-primary" href="{{ path('student_displayStudent', {'headmasterFees': 0, 'id': 0, 'a': 0, 'm': 0, 's': 0}) }}">
                        <i class="fe fe-users me-1"></i> {% trans %}Students{% endtrans %}
                    </a>

                    <a class="btn btn-outline-success" href="{{ path('teacher_displayTeacher', {'displayLaters': 0, 'a': 0, 'm': 0, 's': 0, 'rPwd': 0}) }}">
                        <i class="fe fe-user-check me-1"></i> {% trans %}Staff{% endtrans %}
                    </a>

                    <a class="btn btn-outline-warning" href="{{ path('classroom_displayClassroom', {'a': 0, 'm': 0, 's': 0}) }}">
                        <i class="fe fe-grid me-1"></i> {% trans %}Classs{% endtrans %}
                    </a>

                    <a class="btn btn-outline-primary" href="{{ path('statistiques_admin_index') }}">
                        <i class="fe fe-bar-chart-2"></i>
                        {% trans %}Statistics{% endtrans %}
                    </a>

                {% elseif teacherStats is not null %}

                    <a class="btn btn-outline-primary" href="{{ path('evaluation_markRecorder', {'slugTeacher': teacherStats.teacher.slug, 'a': 0, 'm': 0, 's': 0, 'deleteAllMarks': 0, 'sequenceSelectionnee': 0, 'lessonSelectionnee': 0}) }}">
                        <i class="fe fe-mic me-1"></i> {% trans %}Enter Grades{% endtrans %}
                    </a>

                    <a class="btn btn-outline-success" target="_blank" href="{{ path('print_timetable_teacher', {'slug': teacherStats.teacher.slug}) }}">
                        <i class="fe fe-printer me-1"></i> {% trans %}Timetable{% endtrans %}
                    </a>

                    <a class="btn btn-outline-warning" href="{{ path('teacher_editTeacher', {'slug': teacherStats.teacher.slug, 'pe': 1}) }}">
                        <i class="fe fe-edit me-1"></i> {% trans %}My Profile{% endtrans %}
                    </a>

                    <a class="btn btn-outline-info" href="{{ path('teacher_dashboard_charts') }}">
                        <i class="fe fe-bar-chart-2 me-1"></i> {% trans %}Class Statistics{% endtrans %}
                    </a>

                {% endif %}

                {# <a class="btn btn-outline-info" href="{{ path('school_ai_universal_index') }}">
                    <i class="fe fe-cpu me-1"></i> {% trans %}AI Assistant{% endtrans %}
                </a> #}
            </div>
        </div>

        {% if emailReminderNeeded and teacherStats is not null %}
            <div class="alert fs-warning-banner d-flex flex-column flex-md-row align-items-md-center justify-content-between mb-4">
                <div class="me-md-3 mb-3 mb-md-0">
                
                    <h5 class="mb-1">
                        <i class="fe fe-mail me-2"></i>
                        {% trans %}Email not provided{% endtrans %}
                    </h5>

                    <div>
                        {% trans %}Add your email address so you can easily reset your password if you forget it.{% endtrans %}
                    </div>

                </div>

                <a class="btn btn-warning" href="{{ path('teacher_editTeacher', {'slug': teacherStats.teacher.slug, 'pe': 1}) }}">
                    <i class="fe fe-edit me-2"></i>
                    {% trans %}Provide my email{% endtrans %}
                </a>
            </div>
        {% endif %}

        

        {% if dashboardType == 'admin' %}
            {% set adminStatLinks = [
                path('student_displayStudent', {'headmasterFees': 0, 'id': 0, 'a': 0, 'm': 0, 's': 0}),
                path('teacher_displayTeacher', {'displayLaters': 0, 'a': 0, 'm': 0, 's': 0, 'rPwd': 0}),
                path('classroom_displayClassroom', {'a': 0, 'm': 0, 's': 0}),
                path('subject_displaySubject', {'a': 0, 'm': 0, 's': 0}),
                null,
                null
            ] %}

                <div class="row fs-dashboard-stat-row">
                    {% for card in adminStats.cards %}
                        {% set cardLink = adminStatLinks[loop.index0]|default(null) %}

                        <div class="col-12 col-md-6 col-xl-4 mb-4">
                            {% if cardLink %}
                                <a class="fs-stat-card fs-stat-card-link" href="{{ cardLink }}">
                                    <div class="fs-stat-icon bg-{{ card.variant }}-transparent text-{{ card.variant }}">
                                        <i class="{{ card.icon }}"></i>
                                    </div>
                                    <div class="fs-stat-label">{{ card.label }}</div>
                                    <div class="fs-stat-value">{{ card.value }}</div>
                                </a>
                            {% else %}
                                <div class="fs-stat-card">
                                    <div class="fs-stat-icon bg-{{ card.variant }}-transparent text-{{ card.variant }}">
                                        <i class="{{ card.icon }}"></i>
                                    </div>
                                    <div class="fs-stat-label">{{ card.label }}</div>
                                    <div class="fs-stat-value">{{ card.value }}</div>
                                </div>
                            {% endif %}
                        </div>
                    {% endfor %}
                </div>

                <div class="row">
                    <div class="col-xl-6 mb-4">
                        <div class="fs-panel">
                            <div class="fs-panel-title">{% trans %}Financial summary{% endtrans %}</div>

                            <div class="fs-mini-kpi">
                                <span>{% trans %}Revenue{% endtrans %}</span>
                                <strong>{{ adminStats.finance.revenue|number_format(0, ',', ' ') }} {% trans %}FCFA{% endtrans %}</strong>
                            </div>

                            <div class="fs-mini-kpi">
                                <span>{% trans %}Expenses{% endtrans %}</span>
                                <strong>{{ adminStats.finance.expense|number_format(0, ',', ' ') }} {% trans %}FCFA{% endtrans %}</strong>
                            </div>

                            <div class="fs-mini-kpi">
                                <span>{% trans %}Estimated balance{% endtrans %}</span>
                                <strong>{{ adminStats.finance.balance|number_format(0, ',', ' ') }} {% trans %}FCFA{% endtrans %}</strong>
                            </div>

                            <div class="mt-3 text-muted small">
                                {% trans %}Registrations recorded{% endtrans %} :
                                <strong>{{ adminStats.finance.registrations }}</strong>
                            </div>
                        </div>
                    </div>

                    <div class="col-xl-6 mb-4">
                        <div class="fs-panel">
                            <div class="fs-panel-title">{% trans %}Academic tracking{% endtrans %}</div>

                            <div class="fs-mini-kpi">
                                <span>{% trans %}Assessments without grade{% endtrans %}</span>
                                <strong>{{ adminStats.pedagogy.pendingMarks }}</strong>
                            </div>

                            <div class="fs-mini-kpi">
                                <span>{% trans %}Graded assessments{% endtrans %}</span>
                                <strong>{{ adminStats.pedagogy.completedMarks }}</strong>
                            </div>

                            <div class="fs-mini-kpi">
                                <span>{% trans %}Assigned lessons{% endtrans %}</span>
                                <strong>{{ adminStats.cards[4].value }}</strong>
                            </div>

                            <div class="mt-3">
                                <a class="btn btn-outline-primary btn-sm"
                                href="{{ path('teacher_displayTeacher', {'displayLaters': 1, 'a': 0, 'm': 0, 's': 0, 'rPwd': 0}) }}">
                                    {% trans %}View pending grades{% endtrans %}
                                </a>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="row">
                    <div class="col-xl-4 mb-4">
                        <div class="fs-panel h-100">
                            <div class="fs-panel-title">{% trans %}Latest staff{% endtrans %}</div>

                            <div class="table-responsive">
                                <table class="table fs-table-clean table-hover">
                                    <thead>
                                        <tr>
                                            <th>{% trans %}Name{% endtrans %}</th>
                                            <th>{% trans %}Role{% endtrans %}</th>
                                        </tr>
                                    </thead>

                                    <tbody>
                                    {% for teacher in adminStats.recentTeachers %}
                                        <tr>
                                            <td>{{ teacher.fullName }}</td>
                                            <td>{{ teacher.duty ? teacher.duty.duty : '-' }}</td>
                                        </tr>
                                    {% else %}
                                        <tr>
                                            <td colspan="2" class="text-muted">
                                                {% trans %}No data available.{% endtrans %}
                                            </td>
                                        </tr>
                                    {% endfor %}
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>

                    <div class="col-xl-4 mb-4">
                        <div class="fs-panel h-100">
                            <div class="fs-panel-title">{% trans %}Latest students{% endtrans %}</div>

                            <div class="table-responsive">
                                <table class="table fs-table-clean table-hover">
                                    <thead>
                                        <tr>
                                            <th>{% trans %}Student{% endtrans %}</th>
                                            <th>{% trans %}Class{% endtrans %}</th>
                                        </tr>
                                    </thead>

                                    <tbody>
                                    {% for student in adminStats.recentStudents %}
                                        <tr>
                                            <td>{{ student.fullName }}</td>
                                            <td>{{ student.classroom ? student.classroom.classroom : '-' }}</td>
                                        </tr>
                                    {% else %}
                                        <tr>
                                            <td colspan="2" class="text-muted">
                                                {% trans %}No data available.{% endtrans %}
                                            </td>
                                        </tr>
                                    {% endfor %}
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>

                    <div class="col-xl-4 mb-4">
                        <div class="fs-panel h-100">
                            <div class="fs-panel-title">{% trans %}Recent classes{% endtrans %}</div>

                            <div>
                                {% for classroom in adminStats.recentClassrooms %}
                                    <span class="fs-list-pill">
                                        <i class="fe fe-grid"></i>{{ classroom.classroom }}
                                    </span>
                                {% else %}
                                    <div class="text-muted">
                                        {% trans %}No classes recorded.{% endtrans %}
                                    </div>
                                {% endfor %}
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            {% elseif teacherStats is not null %}
                {% set evaluationSubmittedTotal = teacherStats.evaluationSubmittedTotal|default(teacherStats.evaluationCount|default(0)) %}
                {% set evaluationPendingTotal = teacherStats.evaluationPendingTotal|default(teacherStats.pendingMarks|default(0)) %}
                {% set evaluationTerms = teacherStats.evaluationTerms|default([]) %}

                <div class="row">
                    <div class="col-sm-6 col-xl-3 mb-4">
                        <div class="fs-stat-card">
                            <div class="fs-stat-icon bg-primary-transparent text-primary">
                                <i class="fe fe-layers"></i>
                            </div>
                            <div class="fs-stat-label">{% trans %}Assigned lessons{% endtrans %}</div>
                            <div class="fs-stat-value">{{ teacherStats.assignedLessons }}</div>
                        </div>
                    </div>

                    <div class="col-sm-6 col-xl-3 mb-4">
                        <div class="fs-stat-card">
                            <div class="fs-stat-icon bg-success-transparent text-success">
                                <i class="fe fe-grid"></i>
                            </div>
                            <div class="fs-stat-label">{% trans %}Tracked classes{% endtrans %}</div>
                            <div class="fs-stat-value">{{ teacherStats.classroomCount }}</div>
                        </div>
                    </div>

                    <div class="col-sm-6 col-xl-3 mb-4">
                        <div class="fs-stat-card fs-stat-done">
                            <div class="fs-stat-icon bg-warning-transparent text-warning">
                                <i class="fe fe-check-circle"></i>
                            </div>
                            <div class="fs-stat-label">{% trans %}Submitted assessments{% endtrans %}</div>
                            <div class="fs-stat-value">{{ teacherStats.evaluationSubmittedTotal }}</div>
                        </div>
                    </div>

                    <div class="col-sm-6 col-xl-3 mb-4">
                        <div class="fs-stat-card fs-stat-pending">
                            <div class="fs-stat-icon bg-danger-transparent text-danger">
                                <i class="fe fe-alert-circle"></i>
                            </div>
                            <div class="fs-stat-label">{% trans %}Remaining grades{% endtrans %}</div>
                            <div class="fs-stat-value">{{ teacherStats.evaluationPendingTotal }}</div>
                        </div>
                    </div>
                </div>

                <div class="row">
                    {% for term in teacherStats.evaluationTerms %}
                        {% set percent = term.totalCount > 0 ? ((term.doneCount / term.totalCount) * 100)|round : 0 %}

                        <div class="col-md-4 mb-4">
                            <div class="fs-term-card h-100">
                                <div class="fs-term-card-header">
                                    <div>
                                        <span class="fs-term-label">{% trans %}Term{% endtrans %}</span>
                                        <h5>{{ term.name }}</h5>
                                    </div>

                                    <div class="fs-term-percent">
                                        {{ percent }}%
                                    </div>
                                </div>

                                <div class="fs-term-progress">
                                    <div style="width: {{ percent }}%;"></div>
                                </div>

                                <div class="fs-term-values">
                                    <div class="fs-term-value done">
                                        <span>{% trans %}Submitted assessments{% endtrans %}</span>
                                        <strong>{{ term.doneCount }}</strong>
                                    </div>

                                    <div class="fs-term-value pending">
                                        <span>{% trans %}Remaining grades{% endtrans %}</span>
                                        <strong>{{ term.pendingCount }}</strong>
                                    </div>
                                </div>

                                <div class="fs-term-total">
                                    {% trans %}Expected total{% endtrans %} :
                                    <strong>{{ term.totalCount }}</strong>
                                </div>
                            </div>
                        </div>
                    {% endfor %}
                </div>

                <div class="row">
                    <div class="col-xl-12 mb-4">
                        <div class="fs-eval-followup">
                            <div class="fs-eval-followup-header">
                                <h4>{% trans %}Assessment tracking{% endtrans %}</h4>
                                <p>{% trans %}List of submitted assessments and remaining grades by term.{% endtrans %}</p>
                            </div>

                            {% for term in teacherStats.evaluationTerms %}
                                <div class="fs-term-section">
                                    <div class="fs-term-section-title">
                                        <h5>{{ term.name }}</h5>
                                        <span>
                                            {{ term.doneCount }} {% trans %}submitted{% endtrans %} /
                                            {{ term.pendingCount }} {% trans %}remaining{% endtrans %}
                                        </span>
                                    </div>

                                    <div class="row g-3">
                                        <div class="col-lg-6">
                                            <div class="fs-eval-box fs-eval-box-done">
                                                <div class="fs-eval-box-title">
                                                    <span>
                                                        <i class="fe fe-check-circle me-1"></i>
                                                        {% trans %}Submitted assessments{% endtrans %}
                                                    </span>
                                                    <strong>{{ term.doneCount }}</strong>
                                                </div>

                                                <div class="table-responsive">
                                                    <table class="table table-sm fs-eval-table mb-0">
                                                        <thead>
                                                            <tr>
                                                                <th>{% trans %}Assessment{% endtrans %}</th>
                                                                <th>{% trans %}Class{% endtrans %}</th>
                                                                <th>{% trans %}Subject{% endtrans %}</th>
                                                            </tr>
                                                        </thead>

                                                        <tbody>
                                                            {% for item in term.done %}
                                                                <tr>
                                                                    <td>{{ item.sequence }}</td>
                                                                    <td>
                                                                        <span class="fs-class-badge">{{ item.classroom }}</span>
                                                                    </td>
                                                                    <td>{{ item.subject }}</td>
                                                                </tr>
                                                            {% else %}
                                                                <tr>
                                                                    <td colspan="3" class="text-muted text-center py-3">
                                                                        {% trans %}No submitted assessments.{% endtrans %}
                                                                    </td>
                                                                </tr>
                                                            {% endfor %}
                                                        </tbody>
                                                    </table>
                                                </div>
                                            </div>
                                        </div>

                                        <div class="col-lg-6">
                                            <div class="fs-eval-box fs-eval-box-pending">
                                                <div class="fs-eval-box-title">
                                                    <span>
                                                        <i class="fe fe-clock me-1"></i>
                                                        {% trans %}Pending assessments{% endtrans %}
                                                    </span>
                                                    <strong>{{ term.pendingCount }}</strong>
                                                </div>

                                                <div class="table-responsive">
                                                    <table class="table table-sm fs-eval-table mb-0">
                                                        <thead>
                                                            <tr>
                                                                <th>{% trans %}Assessment{% endtrans %}</th>
                                                                <th>{% trans %}Class{% endtrans %}</th>
                                                                <th>{% trans %}Subject{% endtrans %}</th>
                                                            </tr>
                                                        </thead>

                                                        <tbody>
                                                            {% for item in term.pending %}
                                                                <tr>
                                                                    <td>{{ item.sequence }}</td>
                                                                    <td>
                                                                        <span class="fs-class-badge">{{ item.classroom }}</span>
                                                                    </td>
                                                                    <td>{{ item.subject }}</td>
                                                                </tr>
                                                            {% else %}
                                                                <tr>
                                                                    <td colspan="3" class="text-muted text-center py-3">
                                                                        {% trans %}No pending assessments.{% endtrans %}
                                                                    </td>
                                                                </tr>
                                                            {% endfor %}
                                                        </tbody>
                                                    </table>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            {% endfor %}
                        </div>
                    </div>
                </div>

            {% endif %}
    </div>
</div>
{% endblock %}
