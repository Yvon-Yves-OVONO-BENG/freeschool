{% extends 'base.html.twig' %}

{% block title %}{% trans %}Save expense{% endtrans %}{% endblock %}

{% block infoMessage %}
	{% include "includes/_info_message.html.twig" %}
{% endblock %}

{% block stylesheets %}
	{{ parent() }}
	<link rel="stylesheet" href="{{ asset('build/custom/css/freeschool-expenses-premium.css') }}">
{% endblock %}

{% block body %}
	<div class="hor-content main-content fs-expense-page">
		<div class="container">
			<div class="fs-expense-menu-safe-space" aria-hidden="true"></div>

			<section class="fs-expense-hero">
				<div class="fs-expense-hero__content">
					<div>
						<span class="fs-expense-eyebrow">
							<i class="fa fa-money"></i>
							{% trans %}Expenses workspace{% endtrans %}
						</span>

						<h1 class="fs-expense-title">
							{% trans %}Save expense{% endtrans %}
						</h1>

						<p class="fs-expense-subtitle">
							{% trans %}Register a new expense with date, amount, reason and rubric in a refined and responsive premium interface.{% endtrans %}
						</p>
					</div>

					<div class="fs-expense-hero__actions">
						<div class="fs-expense-hero-stat">
							<span class="fs-expense-hero-stat__icon">
								<i class="fe fe-list"></i>
							</span>
							<span class="fs-expense-hero-stat__label">{% trans %}Total expenses{% endtrans %}</span>
							<strong class="fs-expense-hero-stat__value">{{ numberOfDepenses }}</strong>
						</div>

						<a href="{{ path('display_depense') }}" class="fs-expense-btn fs-expense-btn--light">
							<i class="fa fa-eye"></i>
							<span>{% trans %}Dislay expenses{% endtrans %}</span>
						</a>
					</div>
				</div>
			</section>

			<section class="fs-expense-form-card">
				<div class="fs-expense-card__header">
					<div>
						<span class="fs-expense-chip">
							<i class="fe fe-edit"></i>
							{% trans %}Expense form{% endtrans %}
						</span>

						<h2>{% trans %}Expense registration{% endtrans %}</h2>

						<p>{% trans %}Fill the required information and save the expense. Your Symfony form fields are preserved.{% endtrans %}</p>
					</div>

					<span class="fs-expense-card__icon">
						<i class="fa fa-save"></i>
					</span>
				</div>

				{{ form_start(formDepense, {'attr': {'class': 'fs-expense-form needs-validation', 'novalidate': 'novalidate'}}) }}
					<div class="fs-expense-form-grid">
						<div class="fs-expense-field fs-expense-field--blue">
							<span class="fs-expense-field__icon">
								<i class="fe fe-calendar"></i>
							</span>
							<div class="fs-floating-field fs-symfony-row">
								{{ form_row(formDepense.createdAt, {'attr': {'class': 'form-control form-control-sm fs-floating-control'}}) }}
							</div>
						</div>

						<div class="fs-expense-field fs-expense-field--green">
							<span class="fs-expense-field__icon">
								<i class="fe fe-credit-card"></i>
							</span>
							<div class="fs-floating-field fs-symfony-row">
								{{ form_row(formDepense.montant, {'attr': {'class': 'form-control form-control-sm fs-floating-control'}}) }}
							</div>
						</div>

						<div class="fs-expense-field fs-expense-field--orange">
							<span class="fs-expense-field__icon">
								<i class="fe fe-message-square"></i>
							</span>
							<div class="fs-floating-field fs-symfony-row">
								{{ form_row(formDepense.motif, {'attr': {'class': 'form-control form-control-sm fs-floating-control'}}) }}
							</div>
						</div>

						<div class="fs-expense-field fs-expense-field--violet">
							<span class="fs-expense-field__icon">
								<i class="fe fe-layers"></i>
							</span>
							<div class="fs-floating-field fs-symfony-row">
								{{ form_row(formDepense.rubrique, {'attr': {'class': 'form-control select2-show-search fs-floating-control'}}) }}
							</div>
						</div>
					</div>

					<div class="fs-expense-form-actions">
						<a href="{{ path('display_depense') }}" class="fs-expense-btn fs-expense-btn--ghost">
							<i class="fa fa-eye"></i>
							<span>{% trans %}Dislay expenses{% endtrans %}</span>
						</a>

						<button type="submit" class="fs-expense-btn fs-expense-btn--primary fs-expense-submit-btn" name="addStudent">
							<span class="fs-expense-submit-spinner" aria-hidden="true"></span>
							<i class="fa fa-save fs-expense-submit-icon"></i>
							<span>{% trans %}Save{% endtrans %}</span>
						</button>
					</div>
				{{ form_end(formDepense) }}
			</section>
		</div>
	</div>
{% endblock %}

{% block javascripts %}
	{{ parent() }}
	<script src="{{ asset('build/custom/js/freeschool-expenses-premium.js') }}"></script>
{% endblock %}
