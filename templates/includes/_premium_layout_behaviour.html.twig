    margin-left: auto;
  }

  .fs-premium-card-toolbar__actions > * {
    margin: 0 !important;
  }

  .fs-premium-card-toolbar__actions form {
    display: inline-flex;
    align-items: center;
  }

  .fs-premium-card-toolbar__actions .btn,
  .fs-premium-card-toolbar__actions button,
  .fs-premium-card-toolbar__actions a[class*="-btn"],
  .fs-premium-card-toolbar__actions span[class*="-btn"],
  .fs-premium-orphan-actions .btn,
