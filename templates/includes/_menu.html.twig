<style>
	:root {
		--fs4-primary: #2563eb;
		--fs4-primary-dark: #1d4ed8;
		--fs4-text: #0f172a;
		--fs4-muted: #64748b;
		--fs4-border: #e2e8f0;
		--fs4-soft: #f8fafc;
		--fs4-shadow: 0 20px 55px rgba(15, 23, 42, .18);

		--fs4-header-z: 30000;
		--fs4-menu-z: 29900;
		--fs4-dropdown-z: 32000;
		--fs4-submenu-z: 31000;
		--fs4-overlay-z: 29000;

		--fs4-desktop-header-height: 72px;
		--fs4-desktop-menu-height: 58px;
		--fs4-mobile-header-height: 64px;
	}

	/* =========================================================
	   HEADER FIXE
	   ========================================================= */

	.fs4-header,
	.hor-header.fs4-header,
	.header.fs4-header,
	.top-header.fs4-header {
		position: fixed !important;
		top: 0 !important;
		left: 0 !important;
		right: 0 !important;
		width: 100% !important;
		z-index: var(--fs4-header-z) !important;
		overflow: visible !important;
		background: linear-gradient(90deg, #050816 0%, #14143c 45%, #342c82 100%) !important;
		box-shadow: 0 10px 30px rgba(15, 23, 42, .22) !important;
		border-bottom: 1px solid rgba(255,255,255,.12) !important;
	}

	body.fs4-has-header {
		padding-top: var(--fs4-desktop-header-height) !important;
	}

	body.fs4-has-header.fs4-has-menu {
		padding-top: var(--fs4-desktop-header-height) !important;
	}

	.sticky.fs4-menu-shell {
		margin-bottom: 0 !important;
	}

	.fs4-menu-shell + *,
	.fs4-menu-shell ~ .app-content,
	.fs4-menu-shell ~ .main-content,
	.fs4-menu-shell ~ .page,
	.fs4-menu-shell ~ .page-main {
		margin-top: 0 !important;
		padding-top: 0 !important;
	}

	.fs4-header .container,
	.fs4-header-inner,
	.fs4-actions,
	.fs4-actions .dropdown {
		overflow: visible !important;
	}

	.fs4-header-inner {
		position: relative;
		min-height: var(--fs4-desktop-header-height);
		display: grid;
		grid-template-columns: 240px minmax(0, 1fr) minmax(320px, 440px);
		align-items: center;
		gap: 16px;
	}

	.fs4-brand {
		display: inline-flex;
		align-items: center;
		text-decoration: none;
		min-width: 0;
	}

	.fs4-brand img {
		max-height: 52px;
		width: auto;
		object-fit: contain;
	}

	.fs4-center {
		text-align: center;
		color: #fff;
		min-width: 0;
		padding: 0 10px;
	}

	.fs4-school-name {
		display: block;
		font-size: 15px;
		font-weight: 800;
		letter-spacing: -.02em;
		line-height: 1.15;
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}

	.fs4-school-section {
		margin-top: 7px;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 8px;
		max-width: 100%;
		font-size: 12px;
		font-weight: 600;
		color: rgba(255,255,255,.82);
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}

	.fs4-flag {
		width: 19px;
		height: 19px;
		border-radius: 50%;
		object-fit: cover;
		box-shadow: 0 0 0 2px rgba(255,255,255,.22);
	}

	.fs4-actions {
		position: relative;
		z-index: var(--fs4-dropdown-z) !important;
		display: flex;
		justify-content: flex-end;
		align-items: center;
		gap: 9px;
		min-width: 0;
	}

	.fs4-actions .dropdown {
		position: relative !important;
		z-index: var(--fs4-dropdown-z) !important;
	}

	.fs4-pill {
		height: 42px;
		display: inline-flex;
		align-items: center;
		gap: 9px;
		padding: 0 13px;
		border-radius: 14px;
		border: 1px solid rgba(255,255,255,.16);
		background: rgba(255,255,255,.13);
		color: #fff !important;
		text-decoration: none;
		backdrop-filter: blur(12px);
		transition: .18s ease;
		max-width: 100%;
	}

	.fs4-pill:hover,
	.fs4-pill[aria-expanded="true"] {
		background: rgba(255,255,255,.22);
		color: #fff !important;
	}

	.fs4-pill-icon {
		width: 28px;
		height: 28px;
		min-width: 28px;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		border-radius: 10px;
		background: rgba(255,255,255,.18);
		font-size: 14px;
	}

	.fs4-pill-text {
		font-size: 13px;
		font-weight: 700;
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}

	.fs4-avatar {
		width: 28px;
		height: 28px;
		min-width: 28px;
		border-radius: 10px;
		background: #fff;
		color: var(--fs4-primary-dark);
		display: inline-flex;
		align-items: center;
		justify-content: center;
		font-size: 13px;
		font-weight: 900;
	}

	.fs4-dropdown,
	.fs4-header .dropdown-menu.fs4-dropdown,
	.fs4-header .dropdown-menu.show.fs4-dropdown,
	.fs4-header .dropdown-menu[data-bs-popper].fs4-dropdown {
		position: absolute !important;
		top: calc(100% + 8px) !important;
		right: 0 !important;
		left: auto !important;
		inset: auto 0 auto auto !important;
		transform: none !important;
		z-index: var(--fs4-dropdown-z) !important;
		margin: 0 !important;
		padding: 9px !important;
		border: 1px solid var(--fs4-border) !important;
		border-radius: 18px !important;
		box-shadow: var(--fs4-shadow) !important;
		min-width: 240px;
		background: #fff !important;
	}

	.fs4-dropdown .dropdown-item {
		display: flex !important;
		align-items: center;
		gap: 10px;
		padding: 10px 12px !important;
		border-radius: 12px;
		color: #334155 !important;
		font-size: 13px;
		font-weight: 600;
		transition: transform .18s ease, background-color .18s ease, color .18s ease;
	}

	.fs4-dropdown .dropdown-item:hover {
		transform: translateX(6px);
		background: #eff6ff !important;
		color: var(--fs4-primary-dark) !important;
	}

	.fs4-dropdown .dropdown-item i {
		width: 18px;
		text-align: center;
		color: var(--fs4-primary);
	}

	.fs4-dropdown .dropdown-item[href*="logout"],
	.fs4-dropdown .dropdown-item:last-child {
		color: #dc2626 !important;
	}

	.fs4-dropdown .dropdown-item[href*="logout"] i,
	.fs4-dropdown .dropdown-item:last-child i {
		color: #dc2626 !important;
	}

	.fs4-dropdown .dropdown-item[href*="logout"]:hover,
	.fs4-dropdown .dropdown-item:last-child:hover {
		background: #fef2f2 !important;
		color: #b91c1c !important;
	}

	.fs4-mobile-btn {
		display: none;
		width: 44px;
		height: 44px;
		min-width: 44px;
		border: 1px solid rgba(255,255,255,.18);
		border-radius: 14px;
		background: rgba(255,255,255,.13);
		color: #fff;
		align-items: center;
		justify-content: center;
		cursor: pointer;
		box-shadow: inset 0 1px 0 rgba(255,255,255,.15), 0 8px 20px rgba(15,23,42,.15);
		backdrop-filter: blur(12px);
		transition: transform .18s ease, background-color .18s ease, border-color .18s ease;
	}

	.fs4-mobile-btn:hover,
	body.fs4-menu-open #fs4MenuToggle,
	body.fs4-actions-open #fs4ActionsToggle {
		background: rgba(255,255,255,.22);
		border-color: rgba(255,255,255,.28);
	}

	.fs4-mobile-btn:active {
		transform: scale(.96);
	}

	.fs4-mobile-btn i {
		font-size: 22px;
		line-height: 1;
	}

	.fs4-hamburger-lines {
		width: 22px;
		height: 18px;
		display: flex;
		flex-direction: column;
		justify-content: center;
		gap: 5px;
	}

	.fs4-hamburger-lines span {
		display: block;
		width: 100%;
		height: 2px;
		border-radius: 99px;
		background: #fff;
		transform-origin: center;
		transition: transform .22s ease, opacity .18s ease;
	}

	body.fs4-menu-open .fs4-hamburger-lines span:nth-child(1) {
		transform: translateY(7px) rotate(45deg);
	}

	body.fs4-menu-open .fs4-hamburger-lines span:nth-child(2) {
		opacity: 0;
	}

	body.fs4-menu-open .fs4-hamburger-lines span:nth-child(3) {
		transform: translateY(-7px) rotate(-45deg);
	}

	/* =========================================================
	   MENU DESKTOP FIXE
	   ========================================================= */

	.fs4-menu-overlay {
		display: none;
	}

	@media (min-width: 992px) {
		.sticky.fs4-menu-shell {
			position: fixed !important;
			top: var(--fs4-desktop-header-height) !important;
			left: 0 !important;
			right: 0 !important;
			width: 100% !important;
			z-index: var(--fs4-menu-z) !important;
			background: #fff !important;
			overflow: visible !important;
		}

		.fs4-horizontal,
		.horizontal-main.fs4-horizontal {
			position: relative !important;
			z-index: var(--fs4-menu-z) !important;
			background: rgba(255,255,255,.98) !important;
			border-bottom: 1px solid var(--fs4-border) !important;
			box-shadow: 0 8px 24px rgba(15,23,42,.06) !important;
			overflow: visible !important;
			backdrop-filter: blur(14px);
		}

		.fs4-horizontal .horizontal-mainwrapper {
			width: 100% !important;
			max-width: 100% !important;
			min-height: var(--fs4-desktop-menu-height) !important;
			display: flex !important;
			align-items: center !important;
			padding-left: 18px !important;
			padding-right: 18px !important;
			overflow: visible !important;
		}

		.fs4-horizontal .horizontalMenu {
			width: 100% !important;
			overflow: visible !important;
		}

		.fs4-horizontal .horizontalMenu-list {
			position: relative !important;
			width: 100% !important;
			display: flex !important;
			align-items: center !important;
			justify-content: center !important;
			flex-wrap: nowrap !important;
			gap: 4px !important;
			margin: 0 !important;
			padding: 7px 0 !important;
			list-style: none !important;
			overflow: visible !important;
		}

		.fs4-horizontal .horizontalMenu-list > li {
			position: relative !important;
			flex: 0 0 auto !important;
		}

		.fs4-horizontal .horizontalMenu-list > li.fs4-mega-item {
			position: static !important;
		}

		.fs4-horizontal .horizontalMenu-list > li > a {
			min-height: 38px !important;
			display: inline-flex !important;
			align-items: center !important;
			gap: 6px !important;
			padding: 0 10px !important;
			border-radius: 13px !important;
			color: #334155 !important;
			font-size: 12.5px !important;
			font-weight: 600 !important;
			text-decoration: none !important;
			white-space: nowrap !important;
			transition: .18s ease !important;
		}

		.fs4-horizontal .horizontalMenu-list > li > a:hover,
		.fs4-horizontal .horizontalMenu-list > li:hover > a {
			background: #eff6ff !important;
			color: var(--fs4-primary-dark) !important;
		}

		.fs4-horizontal .hor-icon,
		.fs4-horizontal i.fe,
		.fs4-horizontal i.si {
			width: 16px !important;
			min-width: 16px !important;
			height: 16px !important;
			display: inline-flex !important;
			align-items: center !important;
			justify-content: center !important;
			text-align: center !important;
			color: var(--fs4-primary) !important;
			font-size: 14px !important;
		}

		.fs4-horizontal .horizontal-icon {
			margin-left: 2px !important;
			font-size: 12px !important;
			color: var(--fs4-primary) !important;
			transition: transform .18s ease !important;
		}

		.fs4-horizontal .horizontalMenu-list > li:hover > a .horizontal-icon {
			transform: rotate(180deg);
		}

		/* Sous-menus simples */
		.fs4-horizontal .sub-menu {
			position: absolute !important;
			top: 100% !important;
			left: 0 !important;
			display: none !important;
			min-width: 285px !important;
			padding: 8px !important;
			border: 1px solid var(--fs4-border) !important;
			border-radius: 18px !important;
			background: #fff !important;
			box-shadow: 0 22px 55px rgba(15, 23, 42, .16) !important;
			overflow: visible !important;
			z-index: var(--fs4-submenu-z) !important;
		}

		.fs4-horizontal li:hover > .sub-menu,
		.fs4-horizontal .sub-menu:hover {
			display: block !important;
		}

		.fs4-horizontal .horizontalMenu-list > li > .sub-menu::before,
		.fs4-horizontal .horizontalMenu-list > li > .horizontal-megamenu::before {
			content: "";
			position: absolute;
			left: 0;
			right: 0;
			top: -12px;
			height: 12px;
			background: transparent;
		}

		/* Sous-sous-menus */
		.fs4-horizontal .sub-menu-sub {
			position: relative !important;
		}

		.fs4-horizontal .sub-menu-sub > a::after {
			content: "›";
			margin-left: auto;
			color: #94a3b8;
			font-size: 18px;
			font-weight: 900;
			line-height: 1;
		}

		.fs4-horizontal .sub-menu-sub > .sub-menu {
			position: absolute !important;
			top: 0 !important;
			left: calc(100% + 8px) !important;
			display: none !important;
			min-width: 305px !important;
			max-height: 72vh !important;
			overflow-y: auto !important;
			overflow-x: visible !important;
			z-index: calc(var(--fs4-submenu-z) + 1) !important;
		}

		.fs4-horizontal .sub-menu-sub:hover > .sub-menu,
		.fs4-horizontal .sub-menu-sub > .sub-menu:hover {
			display: block !important;
		}

		/* Méga-menus : ouverture uniquement du li survolé */
		.fs4-horizontal .horizontal-megamenu {
			position: absolute !important;
			top: 100% !important;
			left: 18px !important;
			right: 18px !important;
			display: none !important;
			width: auto !important;
			max-width: none !important;
			max-height: calc(100vh - 155px) !important;
			overflow-y: auto !important;
			overflow-x: hidden !important;
			padding: 0 !important;
			border: 1px solid var(--fs4-border) !important;
			border-radius: 22px !important;
			background: #fff !important;
			box-shadow: 0 24px 65px rgba(15, 23, 42, .18) !important;
			z-index: var(--fs4-submenu-z) !important;
			pointer-events: none !important;
		}

		.fs4-horizontal .fs4-mega-item:hover > .horizontal-megamenu {
			display: block !important;
			pointer-events: auto !important;
		}

		.fs4-horizontal .horizontal-megamenu > .container {
			width: 100% !important;
			max-width: 100% !important;
			padding: 0 !important;
		}

		.fs4-horizontal .mega-menubg {
			border: 0 !important;
			border-radius: 22px !important;
			padding: 14px !important;
			background: #fff !important;
			box-shadow: none !important;
		}

		.fs4-horizontal .mega-menubg .row {
			margin: 0 !important;
			row-gap: 8px !important;
		}

		.fs4-horizontal .mega-menubg [class*="col-"] {
			padding: 0 8px !important;
		}

		.fs4-horizontal .link-list ul {
			margin: 0 !important;
			padding: 0 !important;
			list-style: none !important;
		}

		.fs4-horizontal .link-list li a,
		.fs4-horizontal .sub-menu li a {
			min-height: 38px !important;
			display: flex !important;
			align-items: center !important;
			gap: 9px !important;
			padding: 9px 10px !important;
			border-radius: 12px !important;
			color: #334155 !important;
			font-size: 12.5px !important;
			font-weight: 600 !important;
			text-decoration: none !important;
			line-height: 1.25 !important;
			transition: transform .18s ease, background-color .18s ease, color .18s ease !important;
		}

		.fs4-horizontal .link-list li a:hover,
		.fs4-horizontal .sub-menu li a:hover {
			background: #eff6ff !important;
			color: var(--fs4-primary-dark) !important;
			transform: translateX(4px) !important;
		}

		.fs4-horizontal .link-list h3 {
			min-height: 40px !important;
			margin: 0 0 6px !important;
			padding: 10px 12px !important;
			border-radius: 14px !important;
			background: #f8fafc !important;
			color: var(--fs4-text) !important;
			font-size: 12.5px !important;
			font-weight: 900 !important;
			display: flex !important;
			align-items: center !important;
			gap: 9px !important;
		}

		/* Chef's space : n'ouvre plus quand on survole un autre menu */
		.fs4-horizontal .fs4-chef-item > .fs4-chef-megamenu {
			left: 18px !important;
			right: 18px !important;
			width: auto !important;
		}

		.fs4-horizontal .fs4-chef-megamenu .row {
			display: grid !important;
			grid-template-columns: repeat(4, minmax(0, 1fr)) !important;
			gap: 14px !important;
			margin: 0 !important;
		}

		.fs4-horizontal .fs4-chef-megamenu [class*="col-"] {
			width: auto !important;
			max-width: none !important;
			flex: none !important;
			padding: 0 !important;
		}

		.fs4-horizontal .fs4-chef-megamenu .link-list ul {
			display: grid !important;
			gap: 6px !important;
		}
	}

	/* =========================================================
	   MOBILE - CORRECTION DEFINITIVE
	   ========================================================= */

	@media (max-width: 991.98px) {
		body.fs4-has-header,
		body.fs4-has-header.fs4-has-menu {
			padding-top: var(--fs4-mobile-header-height) !important;
		}

		body.fs4-menu-open {
			overflow: hidden !important;
		}

		.fs4-header-inner {
			min-height: var(--fs4-mobile-header-height) !important;
			display: grid !important;
			grid-template-columns: 48px minmax(0, 1fr) 48px !important;
			gap: 8px !important;
		}

		.fs4-mobile-btn {
			display: inline-flex !important;
		}

		@media (max-width: 991.98px) {

	.fs4-brand-school {
		display: block !important;
		min-width: 0;
		width: 100%;
	}

	.fs4-brand-school .fs4-brand {
		display: none !important;
	}

	.fs4-brand-school .fs4-center {
		display: block !important;
		width: 100%;
		padding: 0 !important;
		text-align: center !important;
	}

	.fs4-brand-school .fs4-school-name {
		display: block;
		width: 100%;
		white-space: nowrap !important;
		overflow: hidden !important;
		text-overflow: ellipsis !important;
		text-align: center !important;
	}

	.fs4-brand-school .fs4-school-section {
		display: none !important;
	}
}

		.fs4-center {
			padding: 0 !important;
			text-align: center !important;
		}

		.fs4-school-name {
			font-size: 13px !important;
			font-weight: 800 !important;
		}

		.fs4-school-section {
			display: none !important;
		}

		/* Overlay - grise la page */
		.fs4-menu-overlay {
			position: fixed !important;
			top: var(--fs4-mobile-header-height) !important;
			left: 0 !important;
			right: 0 !important;
			bottom: 0 !important;
			z-index: var(--fs4-overlay-z) !important;
			display: block !important;
			background: rgba(15, 23, 42, 0.5) !important;
			opacity: 0 !important;
			pointer-events: none !important;
			transition: opacity 0.3s ease !important;
		}

		body.fs4-menu-open .fs4-menu-overlay {
			opacity: 1 !important;
			pointer-events: auto !important;
		}

		/*
		 * Menu mobile : la carte flottante est portée par le conteneur .fs4-menu-shell.
		 * Cela évite que les styles historiques de .sticky/.horizontal-main créent
		 * un contexte d'empilement qui place le menu derrière l'overlay.
		 */
		.sticky.fs4-menu-shell {
			position: fixed !important;
			top: calc(var(--fs4-mobile-header-height) + 8px) !important;
			left: 12px !important;
			right: 12px !important;
			width: auto !important;
			height: auto !important;
			max-height: calc(100dvh - var(--fs4-mobile-header-height) - 24px) !important;
			z-index: calc(var(--fs4-header-z) + 2) !important;
			display: block !important;
			visibility: hidden !important;
			opacity: 0 !important;
			pointer-events: none !important;
			transform: translateY(-12px) scale(.98) !important;
			transform-origin: top center !important;
			transition: opacity .24s ease, transform .28s cubic-bezier(.2,.8,.2,1), visibility 0s linear .28s !important;
			overflow-y: auto !important;
			overflow-x: hidden !important;
			overscroll-behavior: contain !important;
			-webkit-overflow-scrolling: touch !important;
			padding: 10px !important;
			margin: 0 !important;
			background: #ffffff !important;
			border: 1px solid var(--fs4-border) !important;
			border-radius: 20px !important;
			box-shadow: var(--fs4-shadow) !important;
			isolation: isolate !important;
		}

		body.fs4-menu-open .sticky.fs4-menu-shell {
			visibility: visible !important;
			opacity: 1 !important;
			pointer-events: auto !important;
			transform: translateY(0) scale(1) !important;
			transition-delay: 0s !important;
		}

		.fs4-horizontal,
		.horizontal-main.fs4-horizontal {
			position: static !important;
