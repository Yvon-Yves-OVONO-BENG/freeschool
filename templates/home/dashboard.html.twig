{% extends 'base.html.twig' %}

{% block title %}{% trans %}Dashboard{% endtrans %}{% endblock %}

{% block subTitle %}
    {% if dashboardType == 'admin' %}
        {% trans %}Administrator dashboard{% endtrans %}
    {% else %}
        {% trans %}Teacher dashboard{% endtrans %}
    {% endif %}
{% endblock %}

