							<label class="fs-floating-label" for="termFirstByClass">
								<i class="fe fe-calendar"></i>
								{% trans %}Period{% endtrans %}
							</label>

							<div class="invalid-feedback">{% trans %}Please choose a period !{% endtrans %}</div>
						</div>

						<div class="fs-bt-form__actions">
							<button class="fs-bt-btn fs-bt-btn--primary fs-bt-submit-btn" type="submit" name="printBestStudentsPerClass">
								<i class="fa fa-print fs-bt-submit-icon"></i>
								<span>{% trans %}Print{% endtrans %}</span>
							</button>
						</div>
					</form>
				</section>

				<section class="fs-bt-card" data-module-card>
					<div class="fs-bt-card__header">
						<span class="fs-bt-card__icon fs-bt-card__icon--violet">
							<i class="fe fe-book-open"></i>
						</span>
						<div>
							<h3>{% trans %}Top five by subjects{% endtrans %}</h3>
