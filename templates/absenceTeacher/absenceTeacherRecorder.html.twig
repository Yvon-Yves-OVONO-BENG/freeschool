{% extends 'base.html.twig' %}

{% block title %}{% trans %}Enter hours of absence{% endtrans %}{% endblock %}

{% block subTitle %}
	{% trans %}MANAGEMENT OF HOURS OF ABSENCE{% endtrans %}
	{% if is_granted ('ROLE_ADMIN') or is_granted ('ROLE_SUPER_ADMIN') %}
		{% trans %}OF{% endtrans %} [ {{ teacher.fullName }} ]
	{% endif %}
{% endblock %}

{% block infoMessage %}
	{% include "includes/_info_message.html.twig" %}
{% endblock %}

{% block currentUser %}
	{{ teacher.fullName }}
{% endblock %}

{% block stylesheets %}
	{{ parent() }}
	<link rel="stylesheet" href="{{ asset('build/custom/css/freeschool-teacher-absence-recorder-premium.css') }}">
{% endblock %}

{% block body %}
	<div class="hor-content main-content fs-ta-page">
		<div class="container">
			<div class="fs-ta-menu-safe-space" aria-hidden="true"></div>

			<section class="fs-ta-hero">
				<div class="fs-ta-hero__content">
					<div>
						<span class="fs-ta-eyebrow">
							<i class="fe fe-watch"></i>
							{% trans %}Teacher absence workspace{% endtrans %}
						</span>

						<h1 class="fs-ta-title">
							{% trans %}Management of Teacher's Absence Hours{% endtrans %}
						</h1>

						<p class="fs-ta-subtitle">
							{% trans %}Choose a term, enter, update and print teacher absence hours through a clean responsive premium workspace.{% endtrans %}
						</p>
					</div>

					<div class="fs-ta-hero__actions">
						<div class="fs-ta-hero-stat">
							<span class="fs-ta-hero-stat__icon">
								<i class="fe fe-user-check"></i>
							</span>
							<span class="fs-ta-hero-stat__label">{% trans %}Supervisor{% endtrans %}</span>
							<strong class="fs-ta-hero-stat__value">{{ teacher.fullName }}</strong>
						</div>

						{% if selectedTerm is defined %}
							<div class="fs-ta-hero-stat">
								<span class="fs-ta-hero-stat__icon">
									<i class="fe fe-calendar"></i>
								</span>
								<span class="fs-ta-hero-stat__label">{% trans %}Term{% endtrans %}</span>
								<strong class="fs-ta-hero-stat__value">{% trans %}N°{% endtrans %} {{ selectedTerm.term }}</strong>
							</div>

							<div class="fs-ta-hero-stat fs-ta-hero-stat--soft">
								<span class="fs-ta-hero-stat__icon">
									<i class="fe fe-users"></i>
								</span>
								<span class="fs-ta-hero-stat__label">{% trans %}Effective{% endtrans %}</span>
								<strong class="fs-ta-hero-stat__value">{{ teachers|length }}</strong>
							</div>
						{% endif %}
					</div>
				</div>
			</section>

			<section class="fs-ta-filter-card">
				<div class="fs-ta-filter-card__header">
					<div>
						<span class="fs-ta-chip">
							<i class="fe fe-filter"></i>
							{% trans %}Term selection{% endtrans %}
						</span>

						<h2>{% trans %}Choose term{% endtrans %}</h2>

						<p>{% trans %}Select the period to display, enter or update teacher absence hours.{% endtrans %}</p>
					</div>
				</div>

				<div class="fs-ta-filter-layout">
					<form action="{{ path('absence_absenceTeacherRecorder', {'slug': teacher.slug}) }}" method="post" class="fs-ta-filter-form needs-validation" novalidate>
						<div class="fs-floating-field fs-required-field">
							<select name="term" id="term" class="form-control select2 custom-select fs-floating-control" data-placeholder="{% trans %}Choose a period{% endtrans %}" required="required">
								<option label="{% trans %}Choose a period{% endtrans %}" value="">
									{% trans %}Choose a period{% endtrans %}
								</option>

								{% for term in terms %}
									{% if term.term != annualTerm %}
										<option value="{{ term.id }}"
											{% if selectedTerm is defined %}
												{% if selectedTerm.id == term.id %}
													selected
												{% endif %}
											{% endif %}>
											{% trans %}Term{% endtrans %} {{ term.term }}
										</option>
									{% endif %}
								{% endfor %}
							</select>

							<label class="fs-floating-label" for="term">
								<i class="fe fe-calendar"></i>
								{% trans %}Period{% endtrans %}
							</label>

							<div class="invalid-feedback">
								{% trans %}Please choose a period !{% endtrans %}
							</div>
						</div>

						<div class="fs-ta-filter-form__actions">
							<button class="fs-ta-btn fs-ta-btn--primary fs-ta-submit-btn" type="submit" name="displayAbsenceRecorder">
								<span class="fs-ta-submit-spinner" aria-hidden="true"></span>
								<i class="fa fa-eye fs-ta-submit-icon"></i>
								<span>{% trans %}Display{% endtrans %}</span>
							</button>
						</div>
					</form>

					{% if selectedTerm is defined %}
						{% if absences|length > 0 %}
							{% if is_granted('ROLE_ADMIN') or is_granted('ROLE_PROVISEUR') or is_granted('ROLE_SURVEILLANT_GENERAL') or is_granted ('ROLE_SUPER_ADMIN') %}
								{% if mySession.get('verrou').verrou is not null and mySession.get('verrou').verrou == 0 %}
									<form action="{{ path('absence_absenceTeacherRecorder', {'slug': teacher.slug}) }}" method="post" class="fs-ta-delete-form" onsubmit="return confirm('{% trans %}Do you want to delete the teachers hours of absence {% endtrans %} --- {% trans %}term{% endtrans %} N°{{ selectedTerm.term }} ?');">
										<input type="hidden" name="term" value="{{ selectedTerm.id }}">

										<button class="fs-ta-btn fs-ta-btn--danger fs-ta-submit-btn" type="submit" name="removeAllAbsences">
											<span class="fs-ta-submit-spinner" aria-hidden="true"></span>
											<i class="fa fa-eraser fs-ta-submit-icon"></i>
											<span>{% trans %}Delete all these hours of absence{% endtrans %}</span>
										</button>
									</form>
								{% endif %}
							{% endif %}
						{% endif %}
					{% endif %}
				</div>
			</section>

			{% if selectedTerm is defined %}
				<section class="fs-ta-card">
					<div class="fs-ta-card__header">
						<div class="fs-ta-summary">
							<div class="fs-ta-summary__item">
								<span class="fs-ta-summary__icon">
									<i class="fe fe-calendar"></i>
								</span>
								<span class="fs-ta-summary__label">{% trans %}Term{% endtrans %}</span>
								<strong class="fs-ta-summary__value">{% trans %}N°{% endtrans %} {{ selectedTerm.term }}</strong>
							</div>

							<div class="fs-ta-summary__item">
								<span class="fs-ta-summary__icon">
									<i class="fe fe-users"></i>
								</span>
								<span class="fs-ta-summary__label">{% trans %}Effective{% endtrans %}</span>
								<strong class="fs-ta-summary__value">{{ teachers|length }}</strong>
							</div>
						</div>

						<a href="{{ path('printAbsenceTeacherReport') }}" type="button" class="fs-ta-btn fs-ta-btn--ghost" target="_blank">
							<i class="fe fe-printer"></i>
							<span>{% trans %}Print{% endtrans %}</span>
						</a>
					</div>

					<div class="fs-ta-card__body">
						{% if absenceToUpdate == null %}
							{% if absences|length > 0 %}
								<div class="fs-ta-table-toolbar">
									<div>
										<span class="fs-ta-chip fs-ta-chip--soft">
											<i class="fe fe-grid"></i>
											{% trans %}Recorded absences{% endtrans %}
										</span>
										<h2>{% trans %}Teacher absence hours already entered{% endtrans %}</h2>
									</div>

									<div class="fs-ta-search">
										<i class="fe fe-search"></i>
										<input type="text" class="fs-ta-search-input" placeholder="{% trans %}Search teacher, hours, user...{% endtrans %}">
									</div>
								</div>

								<div class="fs-ta-table-wrap">
									<table class="table fs-ta-table fs-ta-dynamic-table" id="fsTeacherAbsenceTable">
										<thead>
											<tr>
												<th>
													<button type="button" class="fs-ta-sort" data-sort-index="0">
														<span>{% trans %}N°{% endtrans %}</span>
														<i class="fe fe-chevron-down"></i>
													</button>
												</th>
												<th>
													<button type="button" class="fs-ta-sort" data-sort-index="1">
														<span>{% trans %}Full name{% endtrans %}</span>
														<i class="fe fe-chevron-down"></i>
													</button>
												</th>
												<th>
													<button type="button" class="fs-ta-sort" data-sort-index="2">
														<span>{% trans %}Hours away{% endtrans %}</span>
														<i class="fe fe-chevron-down"></i>
													</button>
												</th>

												{% if is_granted('ROLE_ADMIN') or is_granted ('ROLE_SUPER_ADMIN') %}
													<th>
														<button type="button" class="fs-ta-sort" data-sort-index="3">
															<span>{% trans %}Entered by{% endtrans %}</span>
															<i class="fe fe-chevron-down"></i>
														</button>
													</th>
													<th>
														<button type="button" class="fs-ta-sort" data-sort-index="4">
															<span>{% trans %}Update by{% endtrans %}</span>
															<i class="fe fe-chevron-down"></i>
														</button>
													</th>
												{% endif %}

												{% if mySession.get('verrou').verrou is not null and mySession.get('verrou').verrou == 0 %}
													<th>{% trans %}Actions{% endtrans %}</th>
												{% endif %}
											</tr>
										</thead>

										<tbody>
											{% set i = 1 %}
											{% for absence in absences %}
												<tr>
													<td data-label="{% trans %}N°{% endtrans %}">
														<span class="fs-ta-rank">{{ i }}</span>
													</td>

													<td data-label="{% trans %}Full name{% endtrans %}">
														<div class="fs-ta-teacher-cell">
															<span class="fs-ta-avatar">{{ absence.teacher.fullName|slice(0, 1)|upper }}</span>
															<div>
																<strong>{{ absence.teacher.fullName }}</strong>
																<span>
																	<i class="fe fe-user-check"></i>
																	{% trans %}Teacher{% endtrans %}
																</span>
															</div>
														</div>
													</td>

													<td data-label="{% trans %}Hours away{% endtrans %}">
														<span class="fs-ta-hours">{{ absence.absenceTeacher }}</span>
													</td>

													{% if is_granted('ROLE_ADMIN') or is_granted ('ROLE_SUPER_ADMIN') %}
														<td data-label="{% trans %}Entered by{% endtrans %}">
															<div class="fs-ta-meta">
																<strong>{{ absence.createdBy.fullName }}</strong>
																<small>{% trans %}At{% endtrans %} : {{ absence.createdAt|date('d/m/Y') }} - {{ absence.createdAt|date('H:i:s') }}</small>
															</div>
														</td>

														<td data-label="{% trans %}Update by{% endtrans %}">
															<div class="fs-ta-meta">
																<strong>{{ absence.updatedBy ? absence.updatedBy.fullName : "//" }}</strong>
																<small>{% trans %}At{% endtrans %} : {{ absence.updatedBy ? absence.updatedAt|date('d/m/Y') : "//" }} - {{ absence.updatedBy ? absence.updatedAt|date('H:i:s') : "//" }}</small>
															</div>
														</td>
													{% endif %}

													{% if mySession.get('verrou').verrou is not null and mySession.get('verrou').verrou == 0 %}
														<td data-label="{% trans %}Actions{% endtrans %}" class="fs-ta-actions">
															<form action="{{ path('absence_absenceTeacherRecorder', {'slug': teacher.slug}) }}" method="post">
																<input type="hidden" name="term" value="{{ selectedTerm.id }}">
																<input type="hidden" name="absence" value="{{ absence.id }}">

																<button type="submit" class="fs-ta-icon-btn fs-ta-icon-btn--primary" data-bs-toggle="tooltip" title="{% trans %}Edit the absence hours for {{ absence.teacher.fullName }}{% endtrans %}" name="absenceToUpdate">
																	<i class="fa fa-pencil-square-o"></i>
																</button>
															</form>
														</td>
													{% endif %}
												</tr>

												{% set i = i + 1 %}
											{% endfor %}
										</tbody>
									</table>
								</div>

								<div class="fs-ta-table-footer">
									<div class="fs-ta-result-count"></div>

									<div class="fs-ta-footer-controls">
										<label class="fs-ta-page-size">
											<span>{% trans %}Rows{% endtrans %}</span>
											<select class="fs-ta-rows-per-page">
												<option value="5">5</option>
												<option value="10" selected>10</option>
												<option value="25">25</option>
												<option value="50">50</option>
											</select>
										</label>

										<div class="fs-ta-pagination" aria-label="{% trans %}Pagination{% endtrans %}"></div>
									</div>
								</div>
							{% else %}
								{% if not is_granted('ROLE_ADMIN') or is_granted ('ROLE_SUPER_ADMIN') %}
									{% if mySession.get('verrou').verrou is not null and mySession.get('verrou').verrou == 0 %}
										<form action="{{ path('absence_absenceTeacherRecorder', {'slug': teacher.slug}) }}" method="POST" class="fs-ta-entry-form" onreset="return confirm('Do you want to reset all typed absences ?')">
											<input type="hidden" name="term" value="{{ selectedTerm.id }}">
											<input type="hidden" name="numberOfTeachers" value="{{ teachers|length }}">

											<div class="fs-ta-entry-header">
												<div>
													<span class="fs-ta-chip">
														<i class="fe fe-edit"></i>
														{% trans %}New entry{% endtrans %}
													</span>
													<h2>{% trans %}Enter hours of absence{% endtrans %}</h2>
												</div>
											</div>

											<div class="fs-ta-entry-grid">
												{% set i = 1 %}
												{% for teacher in teachers %}
													<div class="fs-ta-entry-row">
														<input type="hidden" name="teacher{{ i }}" value="{{ teacher.id }}">

														<div class="fs-ta-teacher-cell">
															<span class="fs-ta-avatar">{{ teacher.fullName|slice(0, 1)|upper }}</span>
															<div>
																<strong>{{ teacher.fullName }}</strong>
																<span>
																	<i class="fe fe-user-check"></i>
																	{% trans %}Teacher{% endtrans %}
																</span>
															</div>
														</div>

														<div class="fs-floating-field fs-required-field">
															<input type="number" name="absence{{ i }}" required="required" min="0" max="500" step="1" class="form-control fs-floating-control" value="0">

															<label class="fs-floating-label">
																<i class="fe fe-clock"></i>
																{% trans %}Hours away{% endtrans %}
															</label>

															<div class="invalid-feedback">
																{% trans %}Required field{% endtrans %}
															</div>
														</div>
													</div>

													{% set i = i + 1 %}
												{% endfor %}
											</div>

											<div class="fs-ta-form-actions">
												<input type="reset" class="fs-ta-btn fs-ta-btn--reset" value="Cancel">

												<button type="submit" class="fs-ta-btn fs-ta-btn--primary fs-ta-submit-btn" name="saveAbsence">
													<span class="fs-ta-submit-spinner" aria-hidden="true"></span>
													<i class="fa fa-save fs-ta-submit-icon"></i>
													<span>{% trans %}Save{% endtrans %}</span>
												</button>
											</div>
										</form>
									{% else %}
										<div class="fs-ta-locked">
											<i class="fe fe-lock"></i>
											{% trans %}Access denied. The entry of hours of absence for this quarter's account is locked.{% endtrans %}
										</div>
									{% endif %}
								{% else %}
									<div class="fs-ta-empty">
										<i class="fe fe-folder"></i>
										<strong>{% trans %}No entry yet{% endtrans %}</strong>
										<span>{% trans %}These hours of absence are not yet entered by the supervisor{% endtrans %}</span>
									</div>
								{% endif %}
							{% endif %}
						{% else %}
							{% if mySession.get('verrou').verrou is not null and mySession.get('verrou').verrou == 0 %}
								<form action="{{ path('absence_absenceTeacherRecorder', {'slug': teacher.slug}) }}" method="post" class="fs-ta-update-form">
									<input type="hidden" name="term" value="{{ selectedTerm.id }}">
									<input type="hidden" name="absenceToUpdateId" value="{{ absenceToUpdate.id }}">

									<div class="fs-ta-update-card">
										<div class="fs-ta-teacher-cell">
											<span class="fs-ta-avatar">{{ absenceToUpdate.teacher.fullName|slice(0, 1)|upper }}</span>
											<div>
												<strong>{{ absenceToUpdate.teacher.fullName }}</strong>
												<span>
													<i class="fe fe-edit"></i>
													{% trans %}Update mode{% endtrans %}
												</span>
											</div>
										</div>

										<div class="fs-floating-field fs-required-field">
											<input type="number" name="updatedAbsence" required="required" min="0" step="1" value="{{ absenceToUpdate.absenceTeacher }}" class="form-control fs-floating-control">

											<label class="fs-floating-label">
												<i class="fe fe-clock"></i>
												{% trans %}Hours away{% endtrans %}
											</label>

											<div class="invalid-feedback">
												{% trans %}Required field{% endtrans %}
											</div>
										</div>

										<button type="submit" class="fs-ta-btn fs-ta-btn--primary fs-ta-submit-btn" name="updateAbsence">
											<span class="fs-ta-submit-spinner" aria-hidden="true"></span>
											<i class="fa fa-save fs-ta-submit-icon"></i>
											<span>{% trans %}Save Changes{% endtrans %}</span>
										</button>
									</div>
								</form>
							{% endif %}
						{% endif %}
					</div>
				</section>
			{% endif %}
		</div>
	</div>
{% endblock %}

{% block javascripts %}
	{{ parent() }}
	<script src="{{ asset('build/custom/js/freeschool-teacher-absence-recorder-premium.js') }}"></script>
{% endblock %}
