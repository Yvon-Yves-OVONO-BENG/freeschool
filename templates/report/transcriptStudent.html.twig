{% extends 'base.html.twig' %}

{% block title %}{% trans %}Transcript's Students{% endtrans %}{% endblock %}

{% block subTitle %}
	{% trans %}REPORTS MANAGMENT{% endtrans %}
{% endblock %}

{% block stylesheets %}
	{{ parent() }}
	<link rel="stylesheet" href="{{ asset('build/custom/css/freeschool-transcripts-students-premium.css') }}">
{% endblock %}

{% block body %}
	<div class="hor-content main-content fs-ts-page">
		<div class="container">
			<div class="fs-ts-menu-safe-space" aria-hidden="true"></div>

			<section class="fs-ts-hero">
				<div class="fs-ts-hero__content">
					<div>
						<span class="fs-ts-eyebrow">
							<i class="fa fa-file-text-o"></i>
							{% trans %}Transcripts workspace{% endtrans %}
						</span>

						<h1 class="fs-ts-title">
							{% trans %}TRANSCRIPT'S STUDENTS MANAGMENT{% endtrans %}
						</h1>

						<p class="fs-ts-subtitle">
							{% trans %}Display, print and send student transcripts by class, evaluation, term or annual period through a refined premium workspace.{% endtrans %}
						</p>
					</div>

					<div class="fs-ts-hero__actions">
						{% if verrouInsolvable %}
							<a href="{{ path('desactive_print_report_insolvable', {'transcript': 1}) }}" class="fs-ts-btn fs-ts-btn--danger-soft">
								<i class="fe fe-x-circle"></i>
								<span>{% trans %}Uneable print transcript of insolvable{% endtrans %}</span>
							</a>
						{% else %}
							<a href="{{ path('activate_print_report_insolvable', {'transcript': 1}) }}" class="fs-ts-btn fs-ts-btn--success-soft">
								<i class="fe fe-check-circle"></i>
								<span>{% trans %}Eable print transcript of insolvable{% endtrans %}</span>
							</a>
						{% endif %}

						{% if methodIsPost and selectedClassroom.id is not null %}
							<div class="fs-ts-stat">
								<span class="fs-ts-stat__icon">
									<i class="fe fe-users"></i>
								</span>
								<span class="fs-ts-stat__label">{% trans %}Students{% endtrans %}</span>
								<strong class="fs-ts-stat__value">{{ students|length }}</strong>
							</div>
						{% endif %}
					</div>
				</div>
			</section>

			{% for message in app.flashes('danger') %}
				<div class="fs-ts-alert fs-ts-alert--danger" role="alert">
					<i class="fa fa-frown-o"></i>
					<span>{{ message }}</span>
				</div>
			{% endfor %}

			{% for message in app.flashes('error') %}
				<div class="fs-ts-alert fs-ts-alert--danger" role="alert">
					<i class="fa fa-chain-broken"></i>
					<span>{{ message }}</span>
				</div>
			{% endfor %}

			<section class="fs-ts-filter-card">
				<div class="fs-ts-filter-card__header">
					<div>
						<span class="fs-ts-chip">
							<i class="fe fe-filter"></i>
							{% trans %}Filters{% endtrans %}
						</span>
						<h2>{% trans %}Choose a class and period{% endtrans %}</h2>
					</div>

					{% if methodIsPost and selectedClassroom.id is not null %}
						<div class="fs-ts-stats-row">
							<div class="fs-ts-mini-stat">
								<span class="fs-ts-mini-stat__icon">
									<i class="fe fe-home"></i>
								</span>
								<span class="fs-ts-mini-stat__label">{% trans %}Classroom{% endtrans %}</span>
								<strong class="fs-ts-mini-stat__value">{{ selectedClassroom.classroom }}</strong>
							</div>

							<div class="fs-ts-mini-stat">
								<span class="fs-ts-mini-stat__icon">
									<i class="fe fe-users"></i>
								</span>
								<span class="fs-ts-mini-stat__label">{% trans %}Number of students{% endtrans %}</span>
								<strong class="fs-ts-mini-stat__value">{{ students|length }}</strong>
							</div>
						</div>
					{% endif %}
				</div>

				<form action="{{ path('transcript_student') }}" method="post" class="fs-ts-form fs-ts-filter-form needs-validation" novalidate>
					<div class="fs-floating-field fs-required-field">
						<select class="form-control select2-show-search fs-floating-control" data-placeholder="" name="classroom" id="classroom" required>
							<option value="" label="">{% trans %}Choose a class{% endtrans %}</option>

							{% if subSystem == 'Francophone / French Speaker' %}
								{% if school.education.education == 'Général' %}
									{% include "includes/_selectClassrooms.html.twig" %}
								{% else %}
									{% include "includes/_selectClassroomsTech.html.twig" %}
								{% endif %}
							{% else %}
								{% include "includes/_selectClassroomsEn.html.twig" %}
							{% endif %}
						</select>

						<label class="fs-floating-label" for="classroom">
							<i class="fe fe-home"></i>
							{% trans %}Classroom{% endtrans %}
						</label>

						<div class="invalid-feedback">{% trans %}Please choose a classroom !{% endtrans %}</div>
					</div>

					<div class="fs-floating-field fs-required-field">
						<select name="period" id="term" class="form-control select2 custom-select fs-floating-control" required>
							<option value=""></option>

							<optgroup label="{% trans %}Evaluations{% endtrans %}">
								{% for sequence in sequences %}
									<option value="s{{ sequence.id }}" {% if selectedSequence.id == sequence.id %}selected{% endif %}>
										{% trans %}Evaluation{% endtrans %} {{ sequence.sequence }}
									</option>
								{% endfor %}
							</optgroup>

							<optgroup label="{% trans %}Term{% endtrans %}">
								{% for term in terms %}
									{% if term.term != annualTerm %}
										<option value="t{{ term.id }}" {% if selectedTerm.id == term.id %}selected{% endif %}>
											{% trans %}Term{% endtrans %} {{ term.term }}
										</option>
									{% endif %}
								{% endfor %}
							</optgroup>

							<optgroup label="{% trans %}Annual{% endtrans %}">
								{% for term in terms %}
									{% if term.term == annualTerm %}
										<option value="t{{ term.id }}" {% if selectedTerm.id == term.id %}selected{% endif %}>
											{% trans %}Annual{% endtrans %}
										</option>
									{% endif %}
								{% endfor %}
							</optgroup>
						</select>

						<label class="fs-floating-label" for="term">
							<i class="fe fe-calendar"></i>
							{% trans %}Period{% endtrans %}
						</label>

						<div class="invalid-feedback">{% trans %}Please choose a period !{% endtrans %}</div>
					</div>

					<button class="fs-ts-btn fs-ts-btn--primary fs-ts-submit-btn" type="submit" name="displayStudents">
						<span class="fs-ts-submit-spinner" aria-hidden="true"></span>
						<i class="fa fa-list fs-ts-submit-icon"></i>
						<span>{% trans %}Display{% endtrans %}</span>
					</button>
				</form>
			</section>

			{% if methodIsPost %}
				<section class="fs-ts-card">
					<div class="fs-ts-card__header">
						<div>
							<span class="fs-ts-chip">
								<i class="fe fe-grid"></i>
								{% trans %}Dynamic table{% endtrans %}
							</span>

							<h2 class="fs-ts-card-title">
								{% if selectedSequence.id is not null %}
									{% trans %}Transcript's students evaluation{% endtrans %} {% trans %}N° 0{% endtrans %}{{ selectedSequence.sequence }}
								{% else %}
									{% if selectedTerm.id is not null %}
										{% if selectedTerm.term == 0 %}
											{% trans %}Transcript's students{% endtrans %} - {% trans %}Annual{% endtrans %}
										{% else %}
											{% trans %}Transcript's students term{% endtrans %} {% trans %}N° 0{% endtrans %}{{ selectedTerm.term }}
										{% endif %}
									{% else %}
										{% trans %}Annuals transcript{% endtrans %}
									{% endif %}
								{% endif %}
							</h2>
						</div>

						<div class="fs-ts-card__actions">
							<div class="fs-ts-search">
								<i class="fe fe-search"></i>
								<input type="text" id="fsTsSearch" class="fs-ts-search-input" placeholder="{% trans %}Search student...{% endtrans %}">
							</div>

							<button type="button" class="fs-ts-btn fs-ts-btn--ghost fs-ts-print-table">
								<i class="fe fe-printer"></i>
								<span>{% trans %}Print table{% endtrans %}</span>
							</button>
						</div>
					</div>

					{% if selectedClassroom.id is not null and students|length > 0 %}
						<div class="fs-ts-actions-panel">
							<div class="fs-ts-stats-row">
								<div class="fs-ts-mini-stat">
									<span class="fs-ts-mini-stat__icon">
										<i class="fe fe-home"></i>
									</span>
									<span class="fs-ts-mini-stat__label">{% trans %}Classroom{% endtrans %}</span>
									<strong class="fs-ts-mini-stat__value">{{ selectedClassroom.classroom }}</strong>
								</div>

								<div class="fs-ts-mini-stat">
									<span class="fs-ts-mini-stat__icon">
										<i class="fe fe-users"></i>
									</span>
									<span class="fs-ts-mini-stat__label">{% trans %}Students{% endtrans %}</span>
									<strong class="fs-ts-mini-stat__value">{{ students|length }}</strong>
								</div>
							</div>

							<div class="fs-ts-action-group">
								{% if selectedSequence.id is not null %}
									<form action="{{ path('print_transcript_sequence_classroom') }}" method="post" target="_blank" data-no-spinner="1">
										<input type="hidden" name="slugClassroom" value="{{ selectedClassroom.slug }}">
										<input type="hidden" name="sequenceId" value="{{ selectedSequence.id }}">
										<button type="submit" class="fs-ts-btn fs-ts-btn--primary" name="printAllTranscripts">
											<i class="si si-printer"></i>
											<span>{% trans %}Print all transcripts{% endtrans %}</span>
										</button>
									</form>

									<form action="{{ path('send_transcript_sequence_classroom') }}" method="post">
										<input type="hidden" name="slugClassroom" value="{{ selectedClassroom.slug }}">
										<input type="hidden" name="sequenceId" value="{{ selectedSequence.id }}">
										<button type="submit" class="fs-ts-btn fs-ts-btn--ghost" name="printAllTranscripts">
											<i class="fa fa-send-o"></i>
											<span>{% trans %}Send to all{% endtrans %}</span>
										</button>
									</form>
								{% else %}
									{% if selectedTerm.id is not null and selectedTerm.term != 0 %}
										<form action="{{ path('print_transcript_term_classroom') }}" method="post" target="_blank" data-no-spinner="1">
											<input type="hidden" name="slugClassroom" value="{{ selectedClassroom.slug }}">
											<input type="hidden" name="term" value="{{ selectedTerm.id }}">
											<button type="submit" class="fs-ts-btn fs-ts-btn--primary" name="printAllTranscripts">
												<i class="si si-printer"></i>
												<span>{% trans %}Print all transcripts{% endtrans %}</span>
											</button>
										</form>

										<form action="{{ path('send_transcript_term_classroom') }}" method="post">
											<input type="hidden" name="slugClassroom" value="{{ selectedClassroom.slug }}">
											<input type="hidden" name="term" value="{{ selectedTerm.id }}">
											<button type="submit" class="fs-ts-btn fs-ts-btn--ghost" name="printAllTranscripts">
												<i class="fa fa-send-o"></i>
												<span>{% trans %}Send to all{% endtrans %}</span>
											</button>
										</form>
									{% else %}
										<form action="{{ path('print_transcript_annual_classroom') }}" method="post" target="_blank" data-no-spinner="1">
											<input type="hidden" name="slugClassroom" value="{{ selectedClassroom.slug }}">
											<input type="hidden" name="term" value="{{ selectedTerm.id }}">
											<button type="submit" class="fs-ts-btn fs-ts-btn--primary" name="printAllTranscripts">
												<i class="si si-printer"></i>
												<span>{% trans %}Print all transcripts{% endtrans %}</span>
											</button>
										</form>

										<form action="{{ path('send_transcript_annual_classroom') }}" method="post">
											<input type="hidden" name="slugClassroom" value="{{ selectedClassroom.slug }}">
											<input type="hidden" name="term" value="{{ selectedTerm.id }}">
											<button type="submit" class="fs-ts-btn fs-ts-btn--ghost" name="printAllTranscripts">
												<i class="fa fa-send-o"></i>
												<span>{% trans %}Send to all{% endtrans %}</span>
											</button>
										</form>
									{% endif %}
								{% endif %}
							</div>
						</div>
					{% endif %}

					<div class="fs-ts-table-wrap">
						<table class="table fs-ts-table fs-ts-dynamic-table" id="fsTsTable">
							<thead>
								<tr>
									<th>
										<button type="button" class="fs-ts-sort" data-sort-index="0">
											<span>{% trans %}N°{% endtrans %}</span>
											<i class="fe fe-chevron-down"></i>
										</button>
									</th>
									<th>
										<button type="button" class="fs-ts-sort" data-sort-index="1">
											<span>{% trans %}Full name{% endtrans %}</span>
											<i class="fe fe-chevron-down"></i>
										</button>
									</th>
									<th class="text-center">{% trans %}Transcript{% endtrans %}</th>
								</tr>
							</thead>

							<tbody>
								{% set i = 1 %}
								{% for registrationHistory in registrationHistories %}
									{% set student = registrationHistory.student %}
									{% set history = registrationHistory.history %}

									{% set totalApeeFees = 0 %}
									{% set totalComputerFees = 0 %}
									{% set totalMedicalBookletFees = 0 %}
									{% set totalCleanSchoolFees = 0 %}
									{% set totalPhotoFees = 0 %}

									{% for histor in history %}
										{% set totalApeeFees = totalApeeFees + histor.apeeFees %}
										{% set totalComputerFees = totalComputerFees + histor.computerFees %}
										{% set totalMedicalBookletFees = totalMedicalBookletFees + histor.medicalBookletFees %}
										{% set totalCleanSchoolFees = totalCleanSchoolFees + histor.cleanSchoolFees %}
										{% set totalPhotoFees = totalPhotoFees + histor.photoFees %}
									{% endfor %}

									{% set totalAvance = totalApeeFees + totalComputerFees + totalMedicalBookletFees + totalCleanSchoolFees + totalPhotoFees %}
									{% set totalFees = feesTable.apeeFees + feesTable.computerFees + feesTable.medicalBookletFees + feesTable.cleanSchoolFees + feesTable.photoFees %}

									<tr>
										<td data-label="{% trans %}N°{% endtrans %}">
											<span class="fs-ts-index">{{ i }}</span>
										</td>

										<td data-label="{% trans %}Full name{% endtrans %}">
											<div class="fs-ts-student-cell">
												<span class="fs-ts-avatar">{{ student.fullName|slice(0, 1)|upper }}</span>
												<div>
													<strong>{{ student.fullName }}</strong>
													{% if student.solvable %}
														<span class="fs-ts-status fs-ts-status--success">
															<i class="fe fe-check-circle"></i>
															{% trans %}Printable{% endtrans %}
														</span>
													{% else %}
														<span class="fs-ts-status fs-ts-status--danger">
															<i class="fe fe-lock"></i>
															{% trans %}Printing not possible{% endtrans %}
														</span>
													{% endif %}
												</div>
											</div>
										</td>

										<td class="text-center" data-label="{% trans %}Transcript{% endtrans %}">
											<div class="fs-ts-action-group">
												{% if student.solvable %}
													{% if selectedSequence.id is not null %}
														<a href="{{ path('print_transcript_sequence_student', {'slugStudent': student.slug, 'sequenceId': selectedSequence.id}) }}" target="_blank" class="fs-ts-action fs-ts-action--print" data-bs-toggle="tooltip" title="{% trans %}Print report of {% endtrans %} {{ student.fullName }}">
															<i class="si si-printer"></i>
															<span>{% trans %}Print transcript{% endtrans %}</span>
														</a>
														<a href="{{ path('send_transcript_sequence_student', {'slugStudent': student.slug, 'sequenceId': selectedSequence.id}) }}" class="fs-ts-action fs-ts-action--send">
															<i class="fa fa-send-o"></i>
															<span>{% trans %}Send{% endtrans %}</span>
														</a>
													{% else %}
														{% if selectedTerm.id is not null and selectedTerm.term != 0 %}
															<a href="{{ path('print_transcript_term_student', {'slugStudent': student.slug, 'slugTerm': selectedTerm.slug}) }}" target="_blank" class="fs-ts-action fs-ts-action--print" data-bs-toggle="tooltip" title="{% trans %}Print report of {% endtrans %} {{ student.fullName }}">
																<i class="si si-printer"></i>
																<span>{% trans %}Print transcript{% endtrans %}</span>
															</a>
															<a href="{{ path('send_transcript_term_student', {'slugStudent': student.slug, 'slugTerm': selectedTerm.slug}) }}" class="fs-ts-action fs-ts-action--send">
																<i class="fa fa-send-o"></i>
																<span>{% trans %}Send{% endtrans %}</span>
															</a>
														{% else %}
															<a href="{{ path('print_transcript_annual_student', {'slugStudent': student.slug, 'slugTerm': selectedTerm.slug}) }}" target="_blank" class="fs-ts-action fs-ts-action--print" data-bs-toggle="tooltip" title="{% trans %}Print report of {% endtrans %} {{ student.fullName }}">
																<i class="si si-printer"></i>
																<span>{% trans %}Print transcript{% endtrans %}</span>
															</a>
															<a href="{{ path('send_transcript_annual_student', {'slugStudent': student.slug, 'slugTerm': selectedTerm.slug}) }}" class="fs-ts-action fs-ts-action--send">
																<i class="fa fa-send-o"></i>
																<span>{% trans %}Send{% endtrans %}</span>
															</a>
														{% endif %}
													{% endif %}
												{% else %}
													<span class="fs-ts-action fs-ts-action--disabled">
														<i class="si si-printer"></i>
														<span>{% trans %}Printing not possible{% endtrans %}</span>
													</span>
												{% endif %}
											</div>
										</td>
									</tr>

									{% set i = i + 1 %}
								{% else %}
									<tr>
										<td colspan="3">
											<div class="fs-ts-empty">
												<i class="fe fe-folder"></i>
												<strong>{% trans %}No student found{% endtrans %}</strong>
												<span>{% trans %}Choose another classroom or period to display transcripts.{% endtrans %}</span>
											</div>
										</td>
									</tr>
								{% endfor %}
							</tbody>
						</table>
					</div>

					<div class="fs-ts-table-footer">
						<div class="fs-ts-table-footer__left">
							<span class="fs-ts-result-count"></span>
						</div>

						<div class="fs-ts-footer-controls">
							<label class="fs-ts-page-size">
								<span>{% trans %}Rows{% endtrans %}</span>
								<select class="fs-ts-rows-per-page">
									<option value="5">5</option>
									<option value="10" selected>10</option>
									<option value="25">25</option>
									<option value="50">50</option>
								</select>
							</label>

							<div class="fs-ts-pagination" aria-label="{% trans %}Pagination{% endtrans %}"></div>
						</div>
					</div>
				</section>
			{% endif %}
		</div>
	</div>
{% endblock %}

{% block javascripts %}
	{{ parent() }}
	<script src="{{ asset('build/custom/js/freeschool-transcripts-students-premium.js') }}"></script>
{% endblock %}
