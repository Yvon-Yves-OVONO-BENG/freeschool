    <script id="fs-mobile-mark-recorder-final-script">
        (function () {
            'use strict';

            function applyMobileFix() {
                if (!window.matchMedia('(max-width: 767.98px)').matches) {
                    return;
                }

                document.querySelectorAll('.fs-existing-marks-table tbody tr').forEach(function (row) {
                    var sexCell = row.querySelector('.fs-mark-col-sex');
                    var actionCell = row.querySelector('.fs-mark-col-action');
                    var actionButton = row.querySelector('button[name="markToUpdate"]');

                    if (sexCell) {
                        sexCell.style.setProperty('display', 'none', 'important');
                    }

                    row.querySelectorAll('.fs-mark-col-audit').forEach(function (cell) {
                        cell.style.setProperty('display', 'none', 'important');
                    });

                    if (actionCell) {
                        actionCell.classList.remove('d-none', 'dtr-hidden');
                        actionCell.style.setProperty('display', 'flex', 'important');
                        actionCell.style.setProperty('visibility', 'visible', 'important');
                        actionCell.style.setProperty('opacity', '1', 'important');
                    }

                    if (actionButton) {
                        actionButton.classList.remove('d-none', 'dtr-hidden');
                        actionButton.style.setProperty('display', 'inline-flex', 'important');
                        actionButton.style.setProperty('visibility', 'visible', 'important');
                        actionButton.style.setProperty('opacity', '1', 'important');
                    }
                });

                document.querySelectorAll('.fs-new-marks-table .fs-mark-col-sex, .fs-new-marks-table .fs-mark-col-hidden')
                    .forEach(function (cell) {
                        cell.style.setProperty('display', 'none', 'important');
                    });
            }

            function runSeveralTimes() {
                applyMobileFix();
                window.setTimeout(applyMobileFix, 150);
                window.setTimeout(applyMobileFix, 500);
                window.setTimeout(applyMobileFix, 1200);
            }

            if (document.readyState === 'loading') {
                document.addEventListener('DOMContentLoaded', runSeveralTimes);
            } else {
                runSeveralTimes();
            }

            window.addEventListener('pageshow', runSeveralTimes);
            window.addEventListener('resize', runSeveralTimes);

            new MutationObserver(function () {
                window.requestAnimationFrame(applyMobileFix);
            }).observe(document.documentElement, {
                childList: true,
                subtree: true
            });
        })();
    </script>


    <script>
document.addEventListener('DOMContentLoaded', function () {
    if (typeof Chart === 'undefined') {
        console.error('{% trans %}Chart.js is not loaded.{% endtrans %}');
        return;
    }

    const successRateCanvas = document.getElementById('successRateChart');
    const distributionCanvas = document.getElementById('distributionChart');
    const notesCanvas = document.getElementById('notesChart');

    if (!successRateCanvas || !distributionCanvas || !notesCanvas) {
        return;
    }

    /*
     * json_encode génère directement des nombres JavaScript valides.
     * Il ne faut pas utiliser number_format ici, car number_format
     * transforme les valeurs en chaînes de caractères.
     */
    

    const sousMoyenneFilles =
    {{ nombreSousMoyenneFille|default(0)|json_encode|raw }};

const moyenneFilles =
    {{ nombreMoyenneFille|default(0)|json_encode|raw }};

const sousMoyenneGarcons =
    {{ nombreSousMoyenneGarcon|default(0)|json_encode|raw }};

const moyenneGarcons =
    {{ nombreMoyenneGarcon|default(0)|json_encode|raw }};


/* Élèves classés */

const fillesClassees =
    sousMoyenneFilles + moyenneFilles;

const garconsClasses =
    sousMoyenneGarcons + moyenneGarcons;

const totalClasses =
    fillesClassees + garconsClasses;


/* Calcul sécurisé des taux */

const tauxFilles = fillesClassees > 0
    ? (moyenneFilles / fillesClassees) * 100
    : 0;

const tauxGarcons = garconsClasses > 0
    ? (moyenneGarcons / garconsClasses) * 100
    : 0;

const tauxClasse = totalClasses > 0
    ? ((moyenneFilles + moyenneGarcons) / totalClasses) * 100
    : 0;


/* Notes */

const noteMinFilles =
    {{ noteMinMax['minMarkGirls']|default(0)|json_encode|raw }};

const noteMaxFilles =
    {{ noteMinMax['maxMarkGirls']|default(0)|json_encode|raw }};

const noteMinGarcons =
    {{ noteMinMax['minMarkBoys']|default(0)|json_encode|raw }};

const noteMaxGarcons =
    {{ noteMinMax['maxMarkBoys']|default(0)|json_encode|raw }};

const noteMaxClasse =
    {{ noteMinMax['maxMarkClass']|default(0)|json_encode|raw }};

const noteMinClasse = Math.min(
    noteMinFilles,
    noteMinGarcons
);


/*
 * Affiche la valeur de chaque barre directement sur le graphique.
 * Une valeur égale à zéro reste donc visible au-dessus de l'axe.
 */
const fsValueLabelsPlugin = {
    id: 'fsValueLabels',

    afterDatasetsDraw: function (chart) {
        const ctx = chart.ctx;

        chart.data.datasets.forEach(function (dataset, datasetIndex) {
            const meta = chart.getDatasetMeta(datasetIndex);

            if (!meta || meta.hidden) {
                return;
            }

            meta.data.forEach(function (element, index) {
                const numericValue = Number(dataset.data[index]);

                if (!Number.isFinite(numericValue)) {
                    return;
                }

                let position = null;

                if (element && typeof element.tooltipPosition === 'function') {
                    position = element.tooltipPosition();
                } else if (element && element._model) {
                    position = {
                        x: element._model.x,
                        y: element._model.y
                    };
                }

                if (!position) {
                    return;
                }

                const displayValue = Number.isInteger(numericValue)
                    ? String(numericValue)
                    : numericValue.toFixed(2).replace('.', ',');

                ctx.save();
                ctx.fillStyle = dataset.valueLabelColor || '#0f172a';
                ctx.font = '700 12px Arial, sans-serif';
                ctx.textAlign = 'center';
                ctx.textBaseline = 'bottom';
                ctx.fillText(
                    displayValue,
                    position.x,
                    numericValue === 0 ? position.y - 5 : position.y - 7
                );
                ctx.restore();
            });
        });
    }
};


/*
 * Le projet peut charger Chart.js 2.x ou 3/4.x.
 * La syntaxe des axes n'est pas la même selon la version.
 * On force ici l'axe des notes à partir de 0 pour que la barre 14
 * ne soit plus confondue avec la ligne de base.
 */
const fsChartMajorVersion = parseInt(
    String(Chart.version || '2').split('.')[0],
    10
);

const fsNotesScales = fsChartMajorVersion >= 3
    ? {
        x: {
            stacked: false,
            grid: {
                display: false
            },
            ticks: {
                color: '#334155',
                font: {
                    weight: '700'
                }
            }
        },
        y: {
            stacked: false,
            beginAtZero: true,
            min: 0,
            max: 20,
            grace: '8%',
            grid: {
                color: 'rgba(148, 163, 184, 0.18)',
                drawBorder: false
            },
            ticks: {
                color: '#64748b',
                stepSize: 2
            }
        }
    }
    : {
        xAxes: [{
            stacked: false,
            gridLines: {
                display: false
            },
            ticks: {
                fontColor: '#334155',
                fontStyle: 'bold'
            }
        }],
        yAxes: [{
            stacked: false,
            ticks: {
                beginAtZero: true,
                min: 0,
                max: 20,
                stepSize: 2,
                fontColor: '#64748b'
            },
            gridLines: {
                color: 'rgba(148, 163, 184, 0.18)',
                drawBorder: false
            }
        }]
    };

if (window.fsSuccessRateChart) {
    window.fsSuccessRateChart.destroy();
}

if (window.fsDistributionChart) {
    window.fsDistributionChart.destroy();
}

if (window.fsNotesChart) {
