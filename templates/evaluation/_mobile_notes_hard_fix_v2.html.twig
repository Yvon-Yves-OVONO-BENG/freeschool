{# 
Correctif mobile renforcé FreeSchool - saisie et modification des notes.
À inclure TOUT À LA FIN du template Twig réellement utilisé pour la saisie des notes :
{% include 'evaluation/_mobile_notes_hard_fix_v2.html.twig' %}
#}

<style id="fs-mobile-notes-hard-fix-v2">
@media (max-width: 767.98px) {
    .fs-mark-page .fs-mobile-existing-notes,
    .fs-mark-page .fs-mobile-existing-notes tbody,
    .fs-mark-page .fs-mobile-entry-notes,
    .fs-mark-page .fs-mobile-entry-notes tbody {
        display: block !important;
        width: 100% !important;
        min-width: 0 !important;
        overflow: visible !important;
    }

    .fs-mark-page .fs-mobile-existing-notes thead,
    .fs-mark-page .fs-mobile-existing-notes tfoot,
    .fs-mark-page .fs-mobile-entry-notes thead,
    .fs-mark-page .fs-mobile-entry-notes tfoot {
        display: none !important;
    }

    .fs-mark-page .fs-mobile-existing-notes tbody tr {
        display: grid !important;
        grid-template-columns: 30px minmax(0, 1fr) 60px 92px !important;
        align-items: center !important;
        gap: 7px !important;
        width: 100% !important;
        min-width: 0 !important;
        margin: 0 0 10px !important;
        padding: 11px !important;
        border: 1px solid #e3e9f3 !important;
        border-radius: 13px !important;
        background: #fff !important;
        box-shadow: 0 4px 14px rgba(30, 49, 84, .06) !important;
        box-sizing: border-box !important;
    }

    .fs-mark-page .fs-mobile-entry-notes tbody tr {
        display: grid !important;
        grid-template-columns: 30px minmax(0, 1fr) 70px !important;
        align-items: center !important;
        gap: 8px !important;
        width: 100% !important;
        min-width: 0 !important;
        margin: 0 0 10px !important;
        padding: 11px !important;
        border: 1px solid #e3e9f3 !important;
        border-radius: 13px !important;
        background: #fff !important;
        box-shadow: 0 4px 14px rgba(30, 49, 84, .06) !important;
        box-sizing: border-box !important;
    }

    .fs-mark-page .fs-mobile-existing-notes tbody tr > td,
    .fs-mark-page .fs-mobile-entry-notes tbody tr > td {
        display: block !important;
        width: auto !important;
        min-width: 0 !important;
        max-width: none !important;
        padding: 0 !important;
        margin: 0 !important;
        border: 0 !important;
        text-align: left !important;
        vertical-align: middle !important;
        background: transparent !important;
        box-sizing: border-box !important;
    }

    .fs-mark-page .fs-note-cell-index {
        grid-column: 1 !important;
        text-align: center !important;
        font-size: 12px !important;
        color: #64748b !important;
    }

    .fs-mark-page .fs-note-cell-name {
        grid-column: 2 !important;
        min-width: 0 !important;
        white-space: normal !important;
        word-break: normal !important;
        overflow-wrap: anywhere !important;
        hyphens: none !important;
        line-height: 1.2 !important;
        font-size: 12px !important;
        font-weight: 700 !important;
        color: #13213a !important;
    }

    .fs-mark-page .fs-note-cell-mark {
        grid-column: 3 !important;
        display: flex !important;
        align-items: center !important;
        justify-content: center !important;
    }

    .fs-mark-page .fs-note-cell-action {
        grid-column: 4 !important;
        display: flex !important;
        align-items: center !important;
        justify-content: flex-end !important;
        visibility: visible !important;
        opacity: 1 !important;
        overflow: visible !important;
    }

    .fs-mark-page .fs-note-cell-action form {
        display: block !important;
        width: 100% !important;
        margin: 0 !important;
    }

    .fs-mark-page .fs-note-cell-sex,
    .fs-mark-page .fs-note-cell-meta,
    .fs-mark-page .fs-note-cell-hidden {
        display: none !important;
    }

    .fs-mark-page .fs-note-cell-mark input {
        display: block !important;
        width: 58px !important;
        min-width: 58px !important;
        height: 42px !important;
        margin: 0 auto !important;
        padding: 6px !important;
        border: 1px solid #d8e1ee !important;
        border-radius: 11px !important;
        text-align: center !important;
        font-size: 14px !important;
        font-weight: 800 !important;
        line-height: 1 !important;
        background: #fff !important;
        color: #0f1f38 !important;
        box-sizing: border-box !important;
    }

    .fs-mark-page button[name="markToUpdate"].fs-note-edit-btn {
        display: inline-flex !important;
        align-items: center !important;
        justify-content: center !important;
        gap: 5px !important;
        width: 88px !important;
        min-width: 88px !important;
        height: 40px !important;
        margin: 0 !important;
        padding: 0 9px !important;
        border: 1px solid #4f46e5 !important;
        border-radius: 10px !important;
        background: #4f46e5 !important;
        color: #fff !important;
        font-size: 11px !important;
        font-weight: 800 !important;
        line-height: 1 !important;
        visibility: visible !important;
        opacity: 1 !important;
        position: static !important;
        transform: none !important;
        overflow: visible !important;
        z-index: 5 !important;
    }

    .fs-mark-page button[name="markToUpdate"].fs-note-edit-btn i {
        display: inline-block !important;
        margin: 0 !important;
        color: inherit !important;
        font-size: 13px !important;
    }

    .fs-mark-page .fs-note-edit-text {
        display: inline !important;
        white-space: nowrap !important;
    }

    .fs-mark-page form.fs-mobile-single-mark-form .row {
        display: grid !important;
        grid-template-columns: minmax(0, 1fr) 72px !important;
        gap: 10px !important;
        align-items: center !important;
        margin: 0 !important;
    }

    .fs-mark-page form.fs-mobile-single-mark-form .row > div {
        width: auto !important;
        max-width: none !important;
        margin: 0 !important;
        padding: 0 !important;
        text-align: left !important;
    }

    .fs-mark-page form.fs-mobile-single-mark-form .row > div:last-child {
        grid-column: 1 / -1 !important;
    }

    .fs-mark-page form.fs-mobile-single-mark-form input[name="mark"] {
        width: 100% !important;
        min-width: 0 !important;
        height: 44px !important;
        text-align: center !important;
        font-weight: 800 !important;
    }

    .fs-mark-page form.fs-mobile-single-mark-form button[name="updateMark"] {
        width: 100% !important;
        min-height: 44px !important;
    }
}
</style>

<script>
(function () {
    'use strict';

    function cleanText(value) {
        return (value || '').replace(/\s+/g, ' ').trim();
    }

    function isSexCell(cell) {
        if (!cell || cell.querySelector('input, button, form, select, textarea')) {
            return false;
        }

        return /^(F|M|FEMALE|MALE|FILLE|GARÇON|GARCON)$/i.test(cleanText(cell.textContent));
    }

    function resetClasses(cell) {
        cell.classList.remove(
            'fs-note-cell-index',
            'fs-note-cell-name',
            'fs-note-cell-sex',
            'fs-note-cell-mark',
            'fs-note-cell-action',
            'fs-note-cell-meta',
            'fs-note-cell-hidden'
        );
    }

    function classifyExistingTable(table) {
        table.classList.add('fs-mobile-existing-notes');

        table.querySelectorAll('tbody tr').forEach(function (row) {
            var cells = Array.prototype.filter.call(row.children, function (child) {
                return child.tagName === 'TD';
            });

            if (!cells.length) {
                return;
            }

            cells.forEach(resetClasses);

            var markInput = row.querySelector('input[readonly][name^="mark"]');
            var editButton = row.querySelector('button[name="markToUpdate"]');
            var markCell = markInput ? markInput.closest('td') : null;
            var actionCell = editButton ? editButton.closest('td') : null;
            var sexCell = cells.find(isSexCell) || null;

            cells[0].classList.add('fs-note-cell-index');

            if (cells[1]) {
                cells[1].classList.add('fs-note-cell-name');
            }

            if (sexCell) {
                sexCell.classList.add('fs-note-cell-sex');
            }

            if (markCell) {
                markCell.classList.add('fs-note-cell-mark');
            }

            if (actionCell) {
                actionCell.classList.add('fs-note-cell-action');
            }

            cells.forEach(function (cell) {
                if (
                    !cell.classList.contains('fs-note-cell-index') &&
                    !cell.classList.contains('fs-note-cell-name') &&
                    !cell.classList.contains('fs-note-cell-sex') &&
                    !cell.classList.contains('fs-note-cell-mark') &&
                    !cell.classList.contains('fs-note-cell-action')
                ) {
                    cell.classList.add('fs-note-cell-meta');
                }
            });

            if (editButton) {
                editButton.classList.add('fs-note-edit-btn');

                if (!editButton.querySelector('.fs-note-edit-text')) {
                    var label = document.createElement('span');
                    label.className = 'fs-note-edit-text';
                    label.textContent = '{% trans %}Edit{% endtrans %}';
                    editButton.appendChild(label);
                }
            }
        });
    }

    function classifyEntryTable(table) {
        table.classList.add('fs-mobile-entry-notes');

        table.querySelectorAll('tbody tr').forEach(function (row) {
            var cells = Array.prototype.filter.call(row.children, function (child) {
                return child.tagName === 'TD';
            });

            if (!cells.length) {
                return;
            }

            cells.forEach(resetClasses);

            var markInput = row.querySelector(
                'input.note-input, input[type="number"][name^="mark"]'
            );
            var markCell = markInput ? markInput.closest('td') : null;
            var sexCell = cells.find(isSexCell) || null;
            var hiddenCell = cells.find(function (cell) {
                var inputs = cell.querySelectorAll('input');
                return inputs.length > 0 &&
                    Array.prototype.every.call(inputs, function (input) {
                        return input.type === 'hidden';
                    }) &&
                    cleanText(cell.textContent) === '';
            }) || null;

            cells[0].classList.add('fs-note-cell-index');

            if (hiddenCell) {
                hiddenCell.classList.add('fs-note-cell-hidden');
            }

            var nameCell = cells.find(function (cell) {
                return cell !== cells[0] &&
                    cell !== hiddenCell &&
                    cell !== sexCell &&
                    cell !== markCell &&
                    !cell.querySelector('input, button, form, select, textarea');
            }) || null;

            if (nameCell) {
                nameCell.classList.add('fs-note-cell-name');
            }

            if (sexCell) {
                sexCell.classList.add('fs-note-cell-sex');
            }

            if (markCell) {
                markCell.classList.add('fs-note-cell-mark');
            }

            cells.forEach(function (cell) {
                if (
                    !cell.classList.contains('fs-note-cell-index') &&
                    !cell.classList.contains('fs-note-cell-name') &&
                    !cell.classList.contains('fs-note-cell-sex') &&
                    !cell.classList.contains('fs-note-cell-mark') &&
                    !cell.classList.contains('fs-note-cell-hidden')
                ) {
                    cell.classList.add('fs-note-cell-meta');
                }
            });
        });
    }

    function applyFix() {
        var root = document.querySelector('.fs-mark-page');

        if (!root) {
            return;
        }

        root.querySelectorAll('table').forEach(function (table) {
            var hasExistingMarks =
                table.querySelector('button[name="markToUpdate"]') ||
                table.querySelector('input[readonly][name^="mark"]');

            var hasEntryMarks =
                table.querySelector('input.note-input') ||
                table.querySelector('input[type="number"][name^="mark"]');

            if (hasExistingMarks) {
                classifyExistingTable(table);
            } else if (hasEntryMarks) {
                classifyEntryTable(table);
            }
        });

        root.querySelectorAll('form').forEach(function (form) {
            if (form.querySelector('input[name="evaluationToUpdate"]')) {
                form.classList.add('fs-mobile-single-mark-form');
            }
        });
    }

    var scheduled = false;

    function scheduleFix() {
        if (scheduled) {
            return;
        }

        scheduled = true;

        window.requestAnimationFrame(function () {
            scheduled = false;
            applyFix();
        });
    }

    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', applyFix);
    } else {
        applyFix();
    }

    window.addEventListener('resize', scheduleFix);
    window.addEventListener('pageshow', scheduleFix);

    var observer = new MutationObserver(scheduleFix);
    observer.observe(document.documentElement, {
        childList: true,
        subtree: true
    });
})();
</script>
