{% extends 'base.html.twig' %}

{% block title %}{% trans %}Expenses{% endtrans %}{% endblock %}

{% block subTitle %}
	{% if is_granted('ROLE_INTENDANT') %}
		{% trans %}SPENDING REGISTRATION MANAGMENT{% endtrans %}
	{% else %}
		{% trans %}SPENDINGS MANAGMENT{% endtrans %}
	{% endif %}
{% endblock %}

{% block infoMessage %}
	{% include "includes/_info_message.html.twig" %}
{% endblock %}

{% block stylesheets %}
	{{ parent() }}
	<link rel="stylesheet" href="{{ asset('build/custom/css/freeschool-expenses-premium.css') }}">
{% endblock %}

{% block body %}
	<div class="hor-content main-content fs-expense-page">
		<div class="container">
			<div class="fs-expense-menu-safe-space" aria-hidden="true"></div>

			<section class="fs-expense-hero">
				<div class="fs-expense-hero__content">
					<div>
						<span class="fs-expense-eyebrow">
							<i class="fa fa-money"></i>
							{% trans %}Expenses workspace{% endtrans %}
						</span>

						<h1 class="fs-expense-title">
							{% trans %}Expenses{% endtrans %}
						</h1>

						<p class="fs-expense-subtitle">
							{% trans %}View, print and manage all expenditures through a refined, dynamic and responsive premium table.{% endtrans %}
						</p>
					</div>

					<div class="fs-expense-hero__actions">
						<div class="fs-expense-hero-stat">
							<span class="fs-expense-hero-stat__icon">
								<i class="fe fe-list"></i>
							</span>
							<span class="fs-expense-hero-stat__label">{% trans %}Total Expenses{% endtrans %}</span>
							<strong class="fs-expense-hero-stat__value">{{ numberOfDepenses }}</strong>
						</div>

						{% if is_granted('ROLE_ADMIN') or is_granted ('ROLE_SUPER_ADMIN') or is_granted('ROLE_PROVISEUR') or is_granted('ROLE_SECRETAIRE') %}
							{% if mySession.get('verrou').verrou is not null and mySession.get('verrou').verrou == 0 %}
								<form action="{{ path('save_depense') }}" method="post" class="fs-expense-inline-form">
									<button type="submit" class="fs-expense-btn fs-expense-btn--success-light fs-expense-submit-btn" name="addNewDepense">
										<span class="fs-expense-submit-spinner" aria-hidden="true"></span>
										<i class="fa fa-plus fs-expense-submit-icon"></i>
										<span>{% trans %}Add a new expense{% endtrans %}</span>
									</button>
								</form>
							{% endif %}
						{% endif %}

						<form action="{{ path('print_etat_depense') }}" method="post" target="_blank" class="fs-expense-inline-form" data-no-spinner="1">
							<button type="submit" class="fs-expense-btn fs-expense-btn--light fs-expense-submit-btn" name="printSchoolFeesStatement">
								<i class="fa fa-print fs-expense-submit-icon"></i>
								<span>{% trans %}Print Financial Statements of Expenditures{% endtrans %}</span>
							</button>
						</form>
					</div>
				</div>
			</section>

			<section class="fs-expense-summary-grid">
				<div class="fs-expense-summary-card">
					<span class="fs-expense-summary-card__icon">
						<i class="fe fe-list"></i>
					</span>
					<span>{% trans %}Total Expenses{% endtrans %}</span>
					<strong>{{ numberOfDepenses }}</strong>
				</div>

				<div class="fs-expense-summary-card">
					<span class="fs-expense-summary-card__icon fs-expense-summary-card__icon--green">
						<i class="fe fe-shield"></i>
					</span>
					<span>{% trans %}Status{% endtrans %}</span>
					<strong>
						{% if mySession.get('verrou').verrou is not null and mySession.get('verrou').verrou == 0 %}
							{% trans %}Editable{% endtrans %}
						{% else %}
							{% trans %}Locked{% endtrans %}
						{% endif %}
					</strong>
				</div>

				<div class="fs-expense-summary-card">
					<span class="fs-expense-summary-card__icon fs-expense-summary-card__icon--gold">
						<i class="fe fe-printer"></i>
					</span>
					<span>{% trans %}Output{% endtrans %}</span>
					<strong>{% trans %}PDF{% endtrans %}</strong>
				</div>
			</section>

			<section class="fs-expense-table-card">
				<div class="fs-expense-card__header">
					<div>
						<span class="fs-expense-chip">
							<i class="fe fe-grid"></i>
							{% trans %}Dynamic table{% endtrans %}
						</span>

						<h2>{% trans %}Expenses list{% endtrans %}</h2>

						<p>{% trans %}Search, sort and manage expenditure records without losing readability on mobile screens.{% endtrans %}</p>
					</div>

					<div class="fs-expense-search">
						<i class="fe fe-search"></i>
						<input type="text" class="fs-expense-search-input" placeholder="{% trans %}Search date, amount, reason, rubric...{% endtrans %}">
					</div>
				</div>

				<div class="fs-expense-card__body">
					<div class="fs-expense-table-wrap">
						<table class="table fs-expense-table fs-expense-dynamic-table" id="fsExpensesTable">
							<thead>
								<tr>
									<th><button type="button" class="fs-expense-sort" data-sort-index="0"><span>{% trans %}Date{% endtrans %}</span><i class="fe fe-chevron-down"></i></button></th>
									<th><button type="button" class="fs-expense-sort" data-sort-index="1"><span>{% trans %}Amount{% endtrans %}</span><i class="fe fe-chevron-down"></i></button></th>
									<th><button type="button" class="fs-expense-sort" data-sort-index="2"><span>{% trans %}Reason{% endtrans %}</span><i class="fe fe-chevron-down"></i></button></th>
									<th><button type="button" class="fs-expense-sort" data-sort-index="3"><span>{% trans %}Rubric{% endtrans %}</span><i class="fe fe-chevron-down"></i></button></th>
									{% if is_granted('ROLE_ADMIN') or is_granted ('ROLE_SUPER_ADMIN') or is_granted('ROLE_PROVISEUR') %}
										{% if mySession.get('verrou').verrou is not null and mySession.get('verrou').verrou == 0 %}
											<th>{% trans %}Actions{% endtrans %}</th>
										{% endif %}
									{% endif %}
								</tr>
							</thead>

							<tbody>
								{% for depense in depenses %}
									<tr>
										<td data-label="{% trans %}Date{% endtrans %}">
											<span class="fs-expense-date">
												<i class="fe fe-calendar"></i>
												{{ depense.createdAt|date('d-m-Y') }}
											</span>
										</td>

										<td data-label="{% trans %}Amount{% endtrans %}">
											<span class="fs-expense-amount">{{ depense.montant|number_format(0, '.', ' ') }}</span>
										</td>

										<td data-label="{% trans %}Reason{% endtrans %}">
											<span class="fs-expense-reason">{{ depense.motif }}</span>
										</td>

										<td data-label="{% trans %}Rubric{% endtrans %}">
											<span class="fs-expense-rubric">
												<i class="fe fe-layers"></i>
												{{ depense.rubrique.rubrique }}
											</span>
										</td>

										{% if is_granted('ROLE_ADMIN') or is_granted ('ROLE_SUPER_ADMIN') or is_granted('ROLE_PROVISEUR') %}
											{% if mySession.get('verrou').verrou is not null and mySession.get('verrou').verrou == 0 %}
												<td data-label="{% trans %}Actions{% endtrans %}" class="fs-expense-actions">
													<div class="dropdown fs-expense-dropdown">
														<a href="javascript:void(0);" class="fs-expense-option-btn" data-bs-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
															<span>{% trans %}Options{% endtrans %}</span>
															<i class="fa fa-angle-down"></i>
														</a>

														<div class="dropdown-menu">
															<a class="dropdown-item" href="{{ path('dedit_depense', {'id': depense.id}) }}">
																<i class="fe fe-edit me-2"></i>
																{% trans %}Edit{% endtrans %}
															</a>

															<a class="dropdown-item" href="javascript:void(0);"
																onclick="swal({
																	'title': 'Danger',
																	'type': 'error',
																	'text': 'Do you want to delete this expenses ?',
																	'showCancelButton': true,
																	'confirmButtonText': 'Yes',
																	'confirmButtonColor': '#f00',
																	'cancelButtonText': 'No',
																	'cancelButtonColor': '#186106',
																	'confirmButtonPath': '{{ path('delete_depense', {'id': depense.id}) }}'});">
																<i class="fa fa-trash me-2"></i>
																{% trans %}Delete{% endtrans %}
															</a>
														</div>
													</div>
												</td>
											{% endif %}
										{% endif %}
									</tr>
								{% else %}
									<tr>
										<td colspan="5">
											<div class="fs-expense-empty">
												<i class="fe fe-folder"></i>
												<strong>{% trans %}No expense found{% endtrans %}</strong>
												<span>{% trans %}Add a new expense to display it here.{% endtrans %}</span>
											</div>
										</td>
									</tr>
								{% endfor %}
							</tbody>
						</table>
					</div>

					<div class="fs-expense-table-footer">
						<div class="fs-expense-result-count"></div>

						<div class="fs-expense-footer-controls">
							<label class="fs-expense-page-size">
								<span>{% trans %}Rows{% endtrans %}</span>
								<select class="fs-expense-rows-per-page">
									<option value="5">5</option>
									<option value="10" selected>10</option>
									<option value="25">25</option>
									<option value="50">50</option>
								</select>
							</label>

							<div class="fs-expense-pagination" aria-label="{% trans %}Pagination{% endtrans %}"></div>
						</div>
					</div>
				</div>
			</section>
		</div>
	</div>
{% endblock %}

{% block javascripts %}
	{{ parent() }}
	<script src="{{ asset('build/custom/js/freeschool-expenses-premium.js') }}"></script>
{% endblock %}
