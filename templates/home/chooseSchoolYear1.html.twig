<!DOCTYPE html>
<html lang="en" dir="ltr">
	<head>

		<!-- Meta data -->
		<meta charset="UTF-8">
        <meta name="description" content="La gestion d'un établissement n'a jamais été facile avec FreeSchool">
		<meta name='viewport' content='width=device-width, initial-scale=1.0, user-scalable=0'>
		<meta content="Freeschool - Application complète de gestions scolaire" name="description">
		<meta content="Spruko Private Limited" name="author">
		<meta name="keywords" content="admin, admin template, dashboard, admin dashboard, responsive, bootstrap, bootstrap 5, admin theme, admin themes, bootstrap admin template, scss, ui, crm, modern, flat">
    
        <!-- Balises Open Graph pour le partage sur les réseaux sociaux -->
        <meta property="og:title" content="https://freedomsoftwarepro.com">
        <meta property="og:image" content="{{ asset ('build/custom2/images/brand/favicon.png')}}, l'image d'aperçu sur facebook">
        <meta property="og:type" content="website">

        <!-- Balises Twitter Cards -->
        <meta name="twitter:card" content="summary_large_image">
        <meta name="twitter:title" content="https://freedomsoftwarepro.com">
        <meta name="twitter:image" content="{{ asset ('build/custom2/images/brand/favicon.png')}}, l'image d'aperçu sur twitter">

        <link rel="canonical" href="https://www.freedomsoftwarepro.com"> 
		<!-- Title -->
		<title>{% trans %}FreeSchool - Under construction{% endtrans %}</title>

		<!--Favicon -->
		<link rel="icon" href="{{ asset ('build/custom2/images/brand/favicon.png')}}" type="image/x-icon"/>

		<!--Bootstrap css -->
		<link href="{{ asset ('build/custom2/plugins/bootstrap/css/bootstrap.min.css')}}" rel="stylesheet">

		<!-- Style css -->
		<link href="{{ asset ('build/custom2/css/style.css')}}" rel="stylesheet" />
		<link href="{{ asset ('build/custom2/css/dark.css')}}" rel="stylesheet" />
		<link href="{{ asset ('build/custom2/css/skin-modes.css')}}" rel="stylesheet" />

		<!-- Animate css -->
		<link href="{{ asset ('build/custom2/css/animated.css')}}" rel="stylesheet" />

		<!---Icons css-->
		<link href="{{ asset ('build/custom2/css/icons.css')}}" rel="stylesheet" />

		<!--- INTERNAL JQUERY-COUNTDOWN CSS -->
		<link href="{{ asset ('build/custom2/plugins/jquery-countdown/jquery.countdown.css')}}" rel="stylesheet" type="text/css">

	    <!-- Color Skin css -->
		<link id="theme" href="{{ asset ('build/custom2/colors/color1.css')}}" rel="stylesheet" type="text/css"/>

	</head>

	<body class="construction">

		<div class="page">
			<div class="page-content">
				<div class="container text-center">
					<div class="row justify-content-center">
						<div class="col-md-6">
							<div class="custom-content">
								<div class="text-white">
									<div class="card-body">
										<img src="{{ asset ('build/custom2/images/maintenance.png')}}" alt="mantenance">
										<h2 class="text-white-80 mb-5">{% trans %}Please wait...{% endtrans %}</h2>
										
									</div>
									<div class="row mt-5">
										<div class="col-md-10 d-block mx-auto">
											<div class="input-group  mb-7">
												
											</div>
										</div>
									</div>
									<div class="custom-btns">
										<h4 class="text-white-80 mb-5">{% trans %}G.B.H.S ODZA / G.B.H.S ODZA{% endtrans %}</h4>
									</div>
								</div>
							</div>
						</div>
					</div>
				</div>
			</div>
		</div>

		<!-- Jquery js-->
		<script src="{{ asset ('build/custom2/js/jquery.min.js')}}"></script>

		<!-- Bootstrap5 js-->
		<script src="{{ asset ('build/custom2/plugins/bootstrap/popper.min.js')}}"></script>
		<script src="{{ asset ('build/custom2/plugins/bootstrap/js/bootstrap.min.js')}}"></script>

		<!--Othercharts js-->
		<script src="{{ asset ('build/custom2/plugins/othercharts/jquery.sparkline.min.js')}}"></script>

		<!-- Circle-progress js-->
		<script src="{{ asset ('build/custom2/js/circle-progress.min.js')}}"></script>

		<!-- Jquery-rating js-->
		<script src="{{ asset ('build/custom2/plugins/rating/jquery.rating-stars.js')}}"></script>

		<!-- INTERNAL JQUERY-COUNTDOWN JS-->
		<script src="{{ asset ('build/custom2/plugins/jquery-countdown/jquery.plugin.min.js')}}"></script>
		<script src="{{ asset ('build/custom2/plugins/jquery-countdown/jquery.countdown.js')}}"></script>
		<script src="{{ asset ('build/custom2/plugins/jquery-countdown/countdown.js')}}"></script>

		<!-- Custom js-->
		<script src="{{ asset ('build/custom2/js/custom.js')}}"></script>

	</body>
</html>
