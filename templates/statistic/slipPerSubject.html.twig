{% extends 'base.html.twig' %}

{% block title %}{% trans %}Slip Per Subject{% endtrans %}{% endblock %}

{% block subTitle %}
	{% trans %}STATISTIC SHEETS PER SUBJECT MANAGMENT{% endtrans %}
{% endblock %}

{% block infoMessage %}
	{% include "includes/_info_message.html.twig" %}
{% endblock %}

{% block stylesheets %}
	{{ parent() }}
	<link rel="stylesheet" href="{{ asset('build/custom/css/freeschool-statistics-suite-premium.css') }}">
{% endblock %}

{% block body %}
	<div class="hor-content main-content fs-stat-page">
		<div class="container">
			<div class="fs-stat-menu-safe-space" aria-hidden="true"></div>

			<section class="fs-stat-hero">
				<div class="fs-stat-hero__content">
					<div>
						<span class="fs-stat-eyebrow">
							<i class="fa fa-bar-chart"></i>
							{% trans %}Subject statistics{% endtrans %}
						</span>

						<h1 class="fs-stat-title">{% trans %}Statistics of subjects{% endtrans %}</h1>

						<p class="fs-stat-subtitle">
							{% trans %}Print discipline statistics, performance summaries, teaching hours and program coverage reports.{% endtrans %}
						</p>
					</div>

					<div class="fs-stat-hero__actions">
						
						<div class="fs-stat-hero-stat">
							<span class="fs-stat-hero-stat__icon">
								<i class="fe fe-printer"></i>
							</span>
							<span class="fs-stat-hero-stat__label">{% trans %}Output{% endtrans %}</span>
							<strong class="fs-stat-hero-stat__value">{% trans %}PDF{% endtrans %}</strong>
						</div>
					</div>
				</div>
			</section>

			<div class="fs-stat-grid ">
				
<section class="fs-stat-card">
	<div class="fs-stat-card__header">
		<div>
			<span class="fs-stat-chip">
				<i class="fa fa-bar-chart"></i>
				{% trans %}Printing workspace{% endtrans %}
			</span>
			<h2 class="fs-stat-card__title">{% trans %}Statistics by discipline{% endtrans %}</h2>
			<p class="fs-stat-card__subtitle">{% trans %}Choose a subject and period to print statistics by discipline.{% endtrans %}</p>
		</div>
		<span class="fs-stat-card__icon">
			<i class="fa fa-bar-chart"></i>
		</span>
	</div>
	<div class="fs-stat-card__body">
		<form action="{{ path('statistic_printSlipPerSubject') }}" method="post" target="_blank" class="fs-stat-form needs-validation" novalidate data-no-spinner="1">
			<div class="fs-floating-field fs-required-field">
	<select name="subject" id="subject_discipline" class="form-control select2-show-search fs-floating-control" data-placeholder="" required>
		<option value="" label=""></option>
		<option value="0">{% trans %}All Subjects{% endtrans %}</option>
		{% for subject in subjects %}
			<option value="{{ subject.id }}">{{ subject.subject }}</option>
		{% endfor %}
	</select>
	<label class="fs-floating-label" for="subject_discipline">
		<i class="fe fe-book"></i>
		{% trans %}Subject{% endtrans %}
	</label>
	<div class="invalid-feedback">{% trans %}Please choose a subject !{% endtrans %}</div>
</div>
<div class="fs-floating-field fs-required-field">
	<select name="period" id="period_discipline" class="form-control select2-show-search fs-floating-control" data-placeholder="" required>
		<option value="" label=""></option>
		<optgroup label="{% trans %}Evaluations{% endtrans %}">
			{% for sequence in sequences %}
				<option value="s{{ sequence.id }}">{% trans %}Evaluation{% endtrans %} {{ sequence.sequence }}</option>
			{% endfor %}
		</optgroup>
		<optgroup label="{% trans %}Terms{% endtrans %}">
			{% for term in terms %}
				{% if term.term != annualTerm %}
					<option value="t{{ term.id }}">{% trans %}Term{% endtrans %} {{ term.term }}</option>
				{% endif %}
			{% endfor %}
		</optgroup>
		{% for term in terms %}
			{% if term.term == annualTerm %}
				<option value="a{{ term.id }}">{% trans %}Annual{% endtrans %}</option>
			{% endif %}
		{% endfor %}
	</select>
	<label class="fs-floating-label" for="period_discipline">
		<i class="fe fe-calendar"></i>
		{% trans %}Period{% endtrans %}
	</label>
	<div class="invalid-feedback">{% trans %}Please choose a period !{% endtrans %}</div>
</div>
			<div class="fs-stat-form__actions">
				<button class="fs-stat-btn fs-stat-btn--primary fs-stat-submit-btn" type="submit" name="printSlipPerSubject">
					<i class="fa fa-print fs-stat-submit-icon"></i>
					<span>{% trans %}Print{% endtrans %}</span>
				</button>
			</div>
		</form>
		
	</div>
</section>

<section class="fs-stat-card">
	<div class="fs-stat-card__header">
		<div>
			<span class="fs-stat-chip">
				<i class="fa fa-area-chart"></i>
				{% trans %}Printing workspace{% endtrans %}
			</span>
			<h2 class="fs-stat-card__title">{% trans %}Overall summary of performance by subject{% endtrans %}</h2>
			<p class="fs-stat-card__subtitle">{% trans %}Choose a period to print the overall performance summary for all subjects.{% endtrans %}</p>
		</div>
		<span class="fs-stat-card__icon">
			<i class="fa fa-area-chart"></i>
		</span>
	</div>
	<div class="fs-stat-card__body">
		<form action="{{ path('statistic_printSlipPerSubject', {'resume': 1}) }}" method="post" target="_blank" class="fs-stat-form fs-stat-form--one needs-validation" novalidate data-no-spinner="1">
			<input type="hidden" name="subject" value="0"><div class="fs-floating-field fs-required-field">
	<select name="period" id="period_overall" class="form-control select2-show-search fs-floating-control" data-placeholder="" required>
		<option value="" label=""></option>
		<optgroup label="{% trans %}Evaluations{% endtrans %}">
			{% for sequence in sequences %}
				<option value="s{{ sequence.id }}">{% trans %}Evaluation{% endtrans %} {{ sequence.sequence }}</option>
			{% endfor %}
		</optgroup>
		<optgroup label="{% trans %}Terms{% endtrans %}">
			{% for term in terms %}
				{% if term.term != annualTerm %}
					<option value="t{{ term.id }}">{% trans %}Term{% endtrans %} {{ term.term }}</option>
				{% endif %}
			{% endfor %}
		</optgroup>
		{% for term in terms %}
			{% if term.term == annualTerm %}
				<option value="a{{ term.id }}">{% trans %}Annual{% endtrans %}</option>
			{% endif %}
		{% endfor %}
	</select>
	<label class="fs-floating-label" for="period_overall">
		<i class="fe fe-calendar"></i>
		{% trans %}Period{% endtrans %}
	</label>
	<div class="invalid-feedback">{% trans %}Please choose a period !{% endtrans %}</div>
</div>
			<div class="fs-stat-form__actions">
				<button class="fs-stat-btn fs-stat-btn--primary fs-stat-submit-btn" type="submit" name="printSlipPerSubject">
					<i class="fa fa-print fs-stat-submit-icon"></i>
					<span>{% trans %}Print{% endtrans %}</span>
				</button>
			</div>
		</form>
		
	</div>
</section>

