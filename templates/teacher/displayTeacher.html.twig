{% extends 'base.html.twig' %}

{% block title %}{% trans %}Display Teacher{% endtrans %}{% endblock %}

{% block subTitle %}
    {% if displayLaters == true %}
        {% trans %}TEACHERS LATE IN RECORDING MARKS{% endtrans %}
    {% else %}
        {% trans %}STAFF MANAGMENT{% endtrans %}
    {% endif %}
{% endblock %}

{% block infoMessage %}
    {% include "includes/_info_message.html.twig" %}
{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('build/custom/css/freeschool-teacher-display-premium.css') }}">
{% endblock %}

{% block body %}
    {% set canManageTeachers = false %}
    {% if is_granted('ROLE_ADMIN') or is_granted ('ROLE_SUPER_ADMIN') or is_granted('ROLE_PROVISEUR') %}
        {% if mySession.get('verrou').verrou is not null and mySession.get('verrou').verrou == 0 %}
            {% set canManageTeachers = true %}
        {% endif %}
    {% endif %}

    <div class="hor-content main-content fs-teacher-page">
        <div class="container">
            <div class="fs-teacher-menu-safe-space" aria-hidden="true"></div>

            <section class="fs-teacher-hero">
                <div class="fs-teacher-hero__content">
                    <span class="fs-teacher-eyebrow">
                        <i class="fe fe-users"></i>
                        {% trans %}Staff workspace{% endtrans %}
                    </span>

                    <h1 class="fs-teacher-title">
                        {% if displayLaters == true %}
                            {% trans %}TEACHERS LATE IN RECORDING MARKS{% endtrans %}
                        {% else %}
                            {% trans %}STAFF MANAGMENT{% endtrans %}
                        {% endif %}
                    </h1>

                    <p class="fs-teacher-subtitle">
                        {% if displayLaters == true %}
                            {% trans %}Track teachers with pending mark entries using a premium and highly readable interface.{% endtrans %}
                        {% else %}
                            {% trans %}Manage, review and supervise your staff through a refined high-definition SaaS workspace.{% endtrans %}
                        {% endif %}
                    </p>
                </div>

                <div class="fs-teacher-hero__right">
                    <div class="fs-teacher-hero-stat">
                        <span class="fs-teacher-hero-stat__icon"><i class="fe fe-layers"></i></span>
                        <span class="fs-teacher-hero-stat__label">
                            {% if displayLaters == true %}
                                {% trans %}Pending records{% endtrans %}
                            {% else %}
                                {% trans %}Registered staff{% endtrans %}
                            {% endif %}
                        </span>
                        <strong class="fs-teacher-hero-stat__value">
                            {% if displayLaters == true %}
                                {{ evaluations|length }}
                            {% else %}
                                {{ teachers|length }}
                            {% endif %}
                        </strong>
                    </div>

                    {% if displayLaters == true %}
                        <a href="{{ path('teacher_displayTeacher') }}" class="fs-teacher-btn fs-teacher-btn--hero-soft">
                            <i class="fe fe-eye"></i>
                            <span>{% trans %}Display staff list{% endtrans %}</span>
                        </a>
                    {% else %}
                        {% if canManageTeachers %}
                            <a href="{{ path('teacher_saveTeacher') }}" class="fs-teacher-btn fs-teacher-btn--hero-add" name="addNewTeacher">
                                <i class="fe fe-user-plus"></i>
                                <span>{% trans %}Add new staff{% endtrans %}</span>
                            </a>
                        {% endif %}

                        <a href="{{ path('teacher_displayTeacher', {'displayLaters': true}) }}" class="fs-teacher-btn fs-teacher-btn--hero-soft">
                            <i class="fe fe-alert-circle"></i>
                            <span>{% trans %}Late mark records{% endtrans %}</span>
                        </a>
                    {% endif %}
                </div>
            </section>

            <section class="fs-teacher-filter-card">
                    <div class="fs-teacher-filter-card__header">
                        <div>
                            <span class="fs-teacher-card-badge">
                                <i class="fe fe-filter"></i>
                                {% trans %}Advanced filters{% endtrans %}
                            </span>
                            <h2 class="fs-teacher-card-title">{% trans %}Search teachers late in recording marks{% endtrans %}</h2>
                        </div>
                    </div>

                    <div class="fs-teacher-filter-card__body">
                        <form action="{{ path('teacher_displayTeacher', {'displayLaters': true})}}" method="post" class="fs-teacher-filter-form needs-validation" novalidate>
                            <div class="fs-select-field">
                                <label class="fs-select-label">{% trans %}Evaluation{% endtrans %}</label>
                                <select name="sequence" class="form-select fs-select-control" required="required" id="validationSequence" aria-describedby="validationSequenceFeedback">
                                    <option value="">{% trans %}Choose a evaluation{% endtrans %}</option>
                                    {% for sequence in sequences %}
                                        {% if sequence.sequence != 0 %}
                                            <option value="{{ sequence.id }}"
                                                {% if selectedSequence is defined and selectedSequence is not null and selectedSequence.id == sequence.id %}selected{% endif %}
                                            >
                                                {% trans %}Evaluation{% endtrans %} {{ sequence.sequence }}
                                            </option>
                                        {% endif %}
                                    {% endfor %}
                                </select>
                                <div id="validationSequenceFeedback" class="invalid-feedback">
                                    {% trans %}Please select a valid term.{% endtrans %}
                                </div>
                            </div>

                            <div class="fs-select-field">
                                <label class="fs-select-label">{% trans %}Level{% endtrans %}</label>
                                <select name="level" class="form-select fs-select-control">
                                    <option value="0">{% trans %}All levels{% endtrans %}</option>
                                    {% for level in levels %}
                                        <option value="{{ level.id }}" {% if selectedLevel is defined and selectedLevel is not null and selectedLevel.id == level.id %}selected{% endif %}>
                                            {% trans %}Level{% endtrans %} {{ level.level }}
                                        </option>
                                    {% endfor %}
                                </select>
                            </div>

                            <button type="submit" class="fs-teacher-btn fs-teacher-btn--primary" name="notRecordedMark">
                                <i class="fe fe-eye"></i>
                                <span>{% trans %}Display{% endtrans %}</span>
                            </button>

                            {% if evaluations|length > 0 and selectedSequence is defined and selectedSequence %}
                                {% if selectedLevel is defined and selectedLevel is not null %}
                                    <a class="fs-teacher-btn fs-teacher-btn--ghost" target="_blank" href="{{ path('teacher_printLaters', {'idS': selectedSequence.id, 'idL': selectedLevel.id}) }}">
                                        <i class="fe fe-printer"></i>
                                        <span>{% trans %}Print{% endtrans %}</span>
                                    </a>
                                {% else %}
                                    <a class="fs-teacher-btn fs-teacher-btn--ghost" target="_blank" href="{{ path('teacher_printLaters', {'idS': selectedSequence.id}) }}">
                                        <i class="fe fe-printer"></i>
                                        <span>{% trans %}Print{% endtrans %}</span>
                                    </a>
                                {% endif %}
                            {% endif %}
                        </form>
                    </div>
                </section>

            <section class="fs-teacher-table-card">
                <div class="fs-teacher-table-card__header">
                    <div>
                        <span class="fs-teacher-card-badge">
                            <i class="fe fe-grid"></i>
                            {% trans %}Dynamic table{% endtrans %}
                        </span>

                        <h2 class="fs-teacher-card-title">
                            {% if displayLaters == true %}
                                {% trans %}Delayed mark recording list{% endtrans %}
                            {% else %}
                                {% trans %}Registered staff list{% endtrans %}
                            {% endif %}
                        </h2>
                    </div>

                    <div class="fs-teacher-table-tools">
                        <div class="fs-teacher-search">
                            <i class="fe fe-search"></i>
                            <input type="text" id="fsTeacherSearch" placeholder="{% trans %}Search...{% endtrans %}">
                        </div>

                        <button type="button" class="fs-teacher-btn fs-teacher-btn--ghost" id="fsTeacherPrint">
                            <i class="fe fe-printer"></i>
                            <span>{% trans %}Print{% endtrans %}</span>
                        </button>
                    </div>
                </div>

                {% if displayLaters == true %}
                    <div class="fs-teacher-summary-row">
                        <div class="fs-teacher-summary-pill">
                            <span>{% trans %}Courses without marks{% endtrans %}</span>
                            <strong>{{ evaluations|length }}</strong>
                        </div>

                        {% if selectedTerm is defined and selectedTerm %}
                            <div class="fs-teacher-summary-pill">
                                <span>{% trans %}Term{% endtrans %}</span>
                                <strong>{{ selectedTerm.term }}</strong>
                            </div>
                        {% endif %}

                        <div class="fs-teacher-summary-pill">
                            <span>{% trans %}Level{% endtrans %}</span>
                            <strong>{{ selectedLevel ? selectedLevel.level : 'ALL' }}</strong>
                        </div>
                    </div>
                {% endif %}

                <div class="fs-teacher-table-wrap">
                    <table class="table fs-teacher-table" id="fsTeacherTable">
                        <thead>
                            {% if displayLaters == true %}
                                <tr>
                                    <th>
                                        <button type="button" class="fs-teacher-sort" data-sort-index="0">
                                            <span>{% trans %}Full name{% endtrans %}</span><i class="fe fe-chevron-down"></i>
                                        </button>
                                    </th>
                                    <th>
                                        <button type="button" class="fs-teacher-sort" data-sort-index="1">
                                            <span>{% trans %}Evaluation{% endtrans %}</span><i class="fe fe-chevron-down"></i>
                                        </button>
                                    </th>
                                    <th>
                                        <button type="button" class="fs-teacher-sort" data-sort-index="2">
                                            <span>{% trans %}Classroom{% endtrans %}</span><i class="fe fe-chevron-down"></i>
                                        </button>
                                    </th>
                                    <th>
                                        <button type="button" class="fs-teacher-sort" data-sort-index="3">
                                            <span>{% trans %}Subject{% endtrans %}</span><i class="fe fe-chevron-down"></i>
                                        </button>
                                    </th>
                                </tr>
                            {% else %}
                                <tr>
                                    <th>
                                        <button type="button" class="fs-teacher-sort" data-sort-index="0">
                                            <span>{% trans %}N°{% endtrans %}</span><i class="fe fe-chevron-down"></i>
                                        </button>
                                    </th>
                                    <th>{% trans %}Profile{% endtrans %}</th>
                                    <th>
                                        <button type="button" class="fs-teacher-sort" data-sort-index="2">
                                            <span>{% trans %}Full name{% endtrans %}</span><i class="fe fe-chevron-down"></i>
                                        </button>
                                    </th>
                                    <th>
                                        <button type="button" class="fs-teacher-sort" data-sort-index="3">
                                            <span>{% trans %}Phone{% endtrans %}</span><i class="fe fe-chevron-down"></i>
                                        </button>
                                    </th>
                                    <th>
                                        <button type="button" class="fs-teacher-sort" data-sort-index="4">
                                            <span>{% trans %}Details{% endtrans %}</span><i class="fe fe-chevron-down"></i>
                                        </button>
                                    </th>
                                    {% if canManageTeachers %}
                                        <th>{% trans %}Actions{% endtrans %}</th>
                                    {% endif %}
                                </tr>
                            {% endif %}
                        </thead>

                        <tbody>
                            {% if displayLaters == true %}
                                {% for evaluation in evaluations %}
                                    <tr>
                                        <td data-label="{% trans %}Full name{% endtrans %}">
                                            <div class="fs-teacher-name-cell">
                                                <strong>{{ evaluation.lesson.teacher.fullName }}</strong>
                                            </div>
                                        </td>
                                        <td data-label="{% trans %}Evaluation{% endtrans %}">
                                            <span class="fs-pill fs-pill--primary">{{ evaluation.sequence.sequence }}</span>
                                        </td>
                                        <td data-label="{% trans %}Classroom{% endtrans %}">
                                            <span class="fs-pill fs-pill--soft">{{ evaluation.lesson.classroom.classroom }}</span>
                                        </td>
                                        <td data-label="{% trans %}Subject{% endtrans %}">
                                            <span class="fs-pill fs-pill--violet">{{ evaluation.lesson.subject.subject }}</span>
                                        </td>
                                    </tr>
                                {% else %}
                                    <tr>
                                        <td colspan="4">
                                            <div class="fs-teacher-empty">
                                                <i class="fe fe-folder"></i>
                                                <strong>{% trans %}No delayed record found{% endtrans %}</strong>
                                                <span>{% trans %}Try another evaluation or level.{% endtrans %}</span>
                                            </div>
                                        </td>
                                    </tr>
                                {% endfor %}
                            {% else %}
                                {% set i = 1 %}
                                {% for teacher in teachers %}
                                    <tr>
                                        <td data-label="{% trans %}N°{% endtrans %}"><span class="fs-row-number">{{ i }}</span></td>
                                        <td data-label="{% trans %}Profile{% endtrans %}">
                                            <div class="fs-teacher-avatar">
                                                <span>{{ (teacher.fullName ?? teacher.name ?? 'T')|slice(0,1)|upper }}</span>
                                            </div>
                                        </td>
                                        <td data-label="{% trans %}Full name{% endtrans %}">
                                            <div class="fs-teacher-name-cell">
                                                <strong>{{ teacher.fullName ?? teacher.name ?? '—' }}</strong>
                                                <span>{{ teacher.administrativeNumber ?: '—' }}</span>
                                            </div>
                                        </td>
                                        <td data-label="{% trans %}Phone{% endtrans %}">
                                            <span class="fs-teacher-contact">{{ teacher.phoneNumber ?: '—' }}</span>
                                        </td>
                                        <td data-label="{% trans %}Details{% endtrans %}">
                                            <div class="fs-teacher-details">
                                                {% if teacher.duty is not null %}
                                                    <span class="fs-pill fs-pill--primary">{{ teacher.duty.duty }}</span>
                                                {% else %}
                                                    <span class="fs-pill fs-pill--soft">{% trans %}Duty not filled{% endtrans %}</span>
                                                {% endif %}

                                                {% if teacher.grade is not null %}
                                                    <span class="fs-pill fs-pill--violet">{{ teacher.grade.grade }}</span>
                                                {% else %}
                                                    <span class="fs-pill fs-pill--soft">{% trans %}Rank not filled{% endtrans %}</span>
                                                {% endif %}

                                                {% if teacher.department is not null %}
                                                    <span class="fs-pill fs-pill--soft">{{ teacher.department.department }}</span>
                                                {% else %}
                                                    <span class="fs-pill fs-pill--soft">{% trans %}Department not filled{% endtrans %}</span>
                                                {% endif %}
                                            </div>
                                        </td>
                                        {% if canManageTeachers %}
                                            <td data-label="{% trans %}Actions{% endtrans %}">
                                                <div class="fs-teacher-actions">
                                                    <div class="dropdown">
                                                        <button class="fs-teacher-action-btn" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                                            <span>{% trans %}Options{% endtrans %}</span>
                                                            <i class="fe fe-chevron-down"></i>
                                                        </button>
                                                        <div class="dropdown-menu fs-teacher-dropdown">
                                                            <a class="dropdown-item" href="{{ path('teacher_editTeacher', {'slug': teacher.slug}) }}">
                                                                <i class="fe fe-edit me-2"></i>{% trans %}Edit{% endtrans %}
                                                            </a>
                                                            <a class="dropdown-item text-danger" href="javascript:void(0);"
                                                                onclick="swal({
                                                                    'title': 'Danger',
                                                                    'type': 'error',
                                                                    'text': 'Do you want to delete the staff ' + ' {{ teacher.fullName ?? teacher.name ?? '' }} ?',
                                                                    'showCancelButton': true,
                                                                    'confirmButtonText': 'Yes',
                                                                    'confirmButtonColor': '#f00',
                                                                    'cancelButtonText': 'No',
                                                                    'cancelButtonColor': '#186106',
                                                                    'confirmButtonPath': '{{ path('teacher_deleteTeacher', {'slug': teacher.slug}) }} '});">
                                                                <i class="fe fe-trash me-2"></i>{% trans %}Delete{% endtrans %}
                                                            </a>
                                                        </div>
                                                    </div>
                                                </div>
                                            </td>
                                        {% endif %}
                                    </tr>
                                    {% set i = i + 1 %}
                                {% else %}
                                    <tr>
                                        <td colspan="{% if canManageTeachers %}6{% else %}5{% endif %}">
                                            <div class="fs-teacher-empty">
                                                <i class="fe fe-folder"></i>
                                                <strong>{% trans %}No staff found{% endtrans %}</strong>
                                                <span>{% trans %}You can start by adding a new staff member.{% endtrans %}</span>
                                            </div>
                                        </td>
                                    </tr>
                                {% endfor %}
                            {% endif %}
                        </tbody>
                    </table>
                </div>

                <div class="fs-teacher-table-footer">
                    <div class="fs-teacher-table-footer__left">
                        <span id="fsTeacherResultCount"></span>
                    </div>

                    <div class="fs-teacher-footer-controls">
                        <label class="fs-teacher-page-size">
                            <span>{% trans %}Rows{% endtrans %}</span>
                            <select id="fsTeacherRowsPerPage">
                                <option value="5">5</option>
                                <option value="10" selected>10</option>
                                <option value="25">25</option>
                                <option value="50">50</option>
                            </select>
                        </label>

                        <div class="fs-teacher-pagination" id="fsTeacherPagination" aria-label="{% trans %}Pagination{% endtrans %}"></div>
                    </div>
                </div>
            </section>
        </div>
    </div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script src="{{ asset('build/custom/js/freeschool-teacher-display-premium.js') }}"></script>
{% endblock %}
