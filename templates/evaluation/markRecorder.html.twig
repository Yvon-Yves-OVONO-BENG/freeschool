{% extends 'base.html.twig' %}

{% block title %}{% trans %}Note entry{% endtrans %}{% endblock %}

{% block subTitle %}
    {% trans %}NOTE MANAGEMENT{% endtrans %}
    {% if is_granted ('ROLE_ADMIN') or is_granted ('ROLE_SUPER_ADMIN') %}
         {% trans %}OF{% endtrans %} [ {{teacher.fullName }} ]
    {% endif %}
{% endblock %}
{% block infoMessage %}
    {% include "includes/_info_message.html.twig" %}
{% endblock %}

{% block currentUser %}
    {{teacher.fullName }}
{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('build/custom/css/freeschool-mark-recorder-premium-clean.css') }}?v=20260724-3">

    <style id="fs-mobile-mark-recorder-final-fix">
        .fs-mark-edit-label {
            display: none;
        }

        @media (max-width: 767.98px) {
            .fs-mark-page .dataTables_wrapper,
            .fs-mark-page .dataTables_scroll,
            .fs-mark-page .dataTables_scrollBody,
            .fs-mark-page .col-md-12 {
                width: 100% !important;
                max-width: 100% !important;
                overflow: visible !important;
            }

            .fs-mark-page .fs-existing-marks-table,
            .fs-mark-page .fs-existing-marks-table tbody,
            .fs-mark-page .fs-new-marks-table,
            .fs-mark-page .fs-new-marks-table tbody {
                display: block !important;
                width: 100% !important;
                min-width: 0 !important;
                max-width: 100% !important;
                overflow: visible !important;
                white-space: normal !important;
            }

            .fs-mark-page .fs-existing-marks-table thead,
            .fs-mark-page .fs-existing-marks-table tfoot,
            .fs-mark-page .fs-new-marks-table thead,
            .fs-mark-page .fs-new-marks-table tfoot {
                display: none !important;
            }

            .fs-mark-page .fs-existing-marks-table tbody tr {
                display: grid !important;
                grid-template-columns: 34px minmax(0, 1fr) 68px !important;
                grid-template-areas:
                    "number fullname mark"
                    "action action action" !important;
                align-items: center !important;
                gap: 10px !important;
                width: 100% !important;
                min-width: 0 !important;
                max-width: 100% !important;
                margin: 0 0 11px !important;
                padding: 12px !important;
                border: 1px solid #dfe7f2 !important;
                border-radius: 14px !important;
                background: #fff !important;
                box-shadow: 0 5px 16px rgba(30, 49, 84, .07) !important;
                overflow: visible !important;
                box-sizing: border-box !important;
            }

            .fs-mark-page .fs-existing-marks-table tbody tr > td,
            .fs-mark-page .fs-new-marks-table tbody tr > td {
                width: auto !important;
                min-width: 0 !important;
                max-width: none !important;
                height: auto !important;
                margin: 0 !important;
                padding: 0 !important;
                border: 0 !important;
                background: transparent !important;
                white-space: normal !important;
                box-sizing: border-box !important;
            }

            .fs-mark-page .fs-mark-col-index {
                grid-area: number !important;
                display: flex !important;
                align-items: center !important;
                justify-content: center !important;
                white-space: nowrap !important;
                word-break: keep-all !important;
                overflow-wrap: normal !important;
                font-size: 12px !important;
                color: #64748b !important;
            }

            .fs-mark-page .fs-mark-col-name {
                grid-area: fullname !important;
                display: block !important;
                min-width: 0 !important;
                white-space: normal !important;
                word-break: normal !important;
                overflow-wrap: break-word !important;
                hyphens: none !important;
                line-height: 1.25 !important;
                font-size: 12px !important;
                font-weight: 800 !important;
                color: #10213d !important;
            }

            .fs-mark-page .fs-mark-col-sex,
            .fs-mark-page .fs-mark-col-audit,
            .fs-mark-page .fs-mark-col-hidden {
                display: none !important;
            }

            .fs-mark-page .fs-mark-col-note {
                grid-area: mark !important;
                display: flex !important;
                align-items: center !important;
                justify-content: center !important;
            }

            .fs-mark-page .fs-mark-col-note .form-control {
                display: block !important;
                width: 62px !important;
                min-width: 62px !important;
                max-width: 62px !important;
                height: 44px !important;
                margin: 0 !important;
                padding: 6px !important;
                border: 1px solid #d6e0ed !important;
                border-radius: 12px !important;
                text-align: center !important;
                font-size: 15px !important;
                font-weight: 900 !important;
                line-height: 1 !important;
                color: #0f1f38 !important;
                background: #fff !important;
                box-shadow: none !important;
            }

            .fs-mark-page .fs-mark-col-action {
                grid-area: action !important;
                display: flex !important;
                width: 100% !important;
                min-width: 0 !important;
                max-width: 100% !important;
                align-items: center !important;
                justify-content: stretch !important;
                visibility: visible !important;
                opacity: 1 !important;
                overflow: visible !important;
                position: static !important;
                transform: none !important;
            }

            .fs-mark-page .fs-mark-col-action form {
                display: block !important;
                width: 100% !important;
                margin: 0 !important;
            }

            .fs-mark-page .fs-mark-edit-button {
                display: inline-flex !important;
                width: 100% !important;
                min-width: 0 !important;
                min-height: 42px !important;
                align-items: center !important;
                justify-content: center !important;
                gap: 7px !important;
                margin: 0 !important;
                padding: 10px 14px !important;
                border: 1px solid #4f46e5 !important;
                border-radius: 11px !important;
                background: #4f46e5 !important;
                color: #fff !important;
                font-size: 12px !important;
                font-weight: 800 !important;
                line-height: 1 !important;
                visibility: visible !important;
                opacity: 1 !important;
                position: static !important;
                transform: none !important;
                z-index: 20 !important;
            }

            .fs-mark-page .fs-mark-edit-button i,
            .fs-mark-page .fs-mark-edit-label {
                display: inline-block !important;
                color: inherit !important;
            }

            .fs-mark-page .fs-new-marks-table tbody tr {
                display: grid !important;
                grid-template-columns: 34px minmax(0, 1fr) 72px !important;
                grid-template-areas: "number fullname mark" !important;
                align-items: center !important;
                gap: 10px !important;
                width: 100% !important;
                min-width: 0 !important;
                max-width: 100% !important;
                margin: 0 0 11px !important;
                padding: 12px !important;
                border: 1px solid #dfe7f2 !important;
                border-radius: 14px !important;
                background: #fff !important;
                box-shadow: 0 5px 16px rgba(30, 49, 84, .07) !important;
                box-sizing: border-box !important;
            }

            .fs-mark-page .fs-single-mark-update-form .row {
                display: grid !important;
                grid-template-columns: minmax(0, 1fr) 78px !important;
                gap: 10px !important;
                align-items: center !important;
                margin: 16px 0 !important;
            }

            .fs-mark-page .fs-single-mark-update-form .row > div {
                width: auto !important;
                max-width: none !important;
                margin: 0 !important;
                padding: 0 !important;
                text-align: left !important;
            }

            .fs-mark-page .fs-single-mark-update-form .row > div:nth-child(3) {
                grid-column: 1 / -1 !important;
            }

            .fs-mark-page .fs-single-mark-update-form input[name="mark"] {
                width: 100% !important;
                height: 44px !important;
                text-align: center !important;
                font-weight: 900 !important;
            }

            .fs-mark-page .fs-single-mark-update-form button[name="updateMark"] {
                width: 100% !important;
                min-height: 44px !important;
            }
        }
    </style>

{% endblock %}


