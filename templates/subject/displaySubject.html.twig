{% extends 'base.html.twig' %}

{% block title %}{% trans %}Display Subject{% endtrans %}{% endblock %}

{% block subTitle %}
	{% trans %}SUBJECTS MANAGMENT{% endtrans %}
{% endblock %}

{% block infoMessage %}
	{% include "includes/_info_message.html.twig" %}
{% endblock %}

{% block stylesheets %}
	{{ parent() }}
	<link rel="stylesheet" href="{{ asset('build/custom/css/freeschool-subject-display-premium.css') }}">
{% endblock %}

{% block body %}
	{% set canManageSubjects = false %}
	{% if is_granted('ROLE_ADMIN') or is_granted ('ROLE_SUPER_ADMIN') or is_granted('ROLE_PROVISEUR') %}
		{% if mySession.get('verrou').verrou is not null and mySession.get('verrou').verrou == 0 %}
			{% set canManageSubjects = true %}
		{% endif %}
	{% endif %}

	<div class="hor-content main-content fs-subject-page">
		<div class="container">
			<div class="fs-subject-menu-safe-space" aria-hidden="true"></div>

			<section class="fs-subject-hero">
				<div class="fs-subject-hero__content">
					<div>
						<span class="fs-subject-eyebrow">
							<i class="fe fe-book-open"></i>
							{% trans %}Academic structure{% endtrans %}
						</span>

						<h1 class="fs-subject-title">
							{% trans %}SUBJECTS MANAGMENT{% endtrans %}
						</h1>

						<p class="fs-subject-subtitle">
							{% trans %}Manage subjects, departments, groups and assigned classes through a refined premium workspace.{% endtrans %}
						</p>
					</div>

					<div class="fs-subject-hero__right">
						<div class="fs-subject-hero-stat">
							<span class="fs-subject-hero-stat__icon">
								<i class="fe fe-book"></i>
							</span>
							<span class="fs-subject-hero-stat__label">{% trans %}Recorded subjects{% endtrans %}</span>
							<strong class="fs-subject-hero-stat__value">{{ subjects|length }}</strong>
						</div>

						{% if canManageSubjects %}
							<a href="{{ path('subject_saveSubject') }}" class="fs-subject-btn fs-subject-btn--hero-add" name="addNewSubject">
								<i class="fe fe-plus"></i>
								<span>{% trans %}Add new subject{% endtrans %}</span>
							</a>
						{% endif %}
					</div>
				</div>
			</section>

			<section class="fs-subject-card">
				<div class="fs-subject-card__header">
					<div>
						<span class="fs-subject-card-badge">
							<i class="fe fe-list"></i>
							{% trans %}Dynamic table{% endtrans %}
						</span>

						<h2 class="fs-subject-card-title">{% trans %}Registered subjects{% endtrans %}</h2>
					</div>

					<div class="fs-subject-table-tools">
						<div class="fs-subject-search">
							<i class="fe fe-search"></i>
							<input type="text" id="fsSubjectSearch" placeholder="{% trans %}Search subject...{% endtrans %}">
						</div>

						<button type="button" class="fs-subject-btn fs-subject-btn--ghost" id="fsSubjectPrint">
							<i class="fe fe-printer"></i>
							<span>{% trans %}Print{% endtrans %}</span>
						</button>
					</div>
				</div>

				<div class="fs-subject-table-wrap">
					<table class="table fs-subject-table" id="fsSubjectTable">
						<thead>
							<tr>
								<th>
									<button type="button" class="fs-subject-sort" data-sort-index="0">
										<span>{% trans %}Subject{% endtrans %}</span>
										<i class="fe fe-chevron-down"></i>
									</button>
								</th>
								<th>
									<button type="button" class="fs-subject-sort" data-sort-index="1">
										<span>{% trans %}Group{% endtrans %}</span>
										<i class="fe fe-chevron-down"></i>
									</button>
								</th>
								<th>
									<button type="button" class="fs-subject-sort" data-sort-index="2">
										<span>{% trans %}Department{% endtrans %}</span>
										<i class="fe fe-chevron-down"></i>
									</button>
								</th>
								<th>
									<button type="button" class="fs-subject-sort" data-sort-index="3">
										<span>{% trans %}Educational facilitator{% endtrans %}</span>
										<i class="fe fe-chevron-down"></i>
									</button>
								</th>
								{% if canManageSubjects %}
									<th class="text-center">{% trans %}Actions{% endtrans %}</th>
								{% endif %}
							</tr>
						</thead>

						<tbody>
							{% for subject in subjects %}
								<tr>
									<td data-label="{% trans %}Subject{% endtrans %}">
										<div class="fs-subject-name-cell">
											<span class="fs-subject-icon"><i class="fe fe-book-open"></i></span>
											<strong>{{ subject.subject }}</strong>
										</div>
									</td>

									<td data-label="{% trans %}Group{% endtrans %}">
										<span class="fs-subject-pill fs-subject-pill--primary">{{ subject.category.category }}</span>
									</td>

									<td data-label="{% trans %}Department{% endtrans %}">
										<span class="fs-subject-pill fs-subject-pill--soft">{{ subject.department ? subject.department.department : '—' }}</span>
									</td>

									<td data-label="{% trans %}Educational facilitator{% endtrans %}">
										<div class="fs-subject-facilitator">
											<span class="fs-subject-avatar">
												{{ subject.department and subject.department.educationalFacilitator ? subject.department.educationalFacilitator.fullName|slice(0, 1)|upper : '?' }}
											</span>
											<div>
												<strong>{{ subject.department ? (subject.department.educationalFacilitator ? subject.department.educationalFacilitator.fullName : '—') : '—' }}</strong>
												<span>{% trans %}Facilitator{% endtrans %}</span>
											</div>
										</div>
									</td>

									{% if canManageSubjects %}
										<td class="text-center" data-label="{% trans %}Actions{% endtrans %}">
											<div class="fs-subject-actions">
												<a href="{{ path ('subject_classes', { 'slug': subject.slug }) }}" class="fs-subject-action fs-subject-action--classes">
													<i class="fe fe-home"></i>
													<span>{% trans %}Classs{% endtrans %}</span>
													<b>{{ subject.lessons|length }}</b>
												</a>

												<form action="{{ path('subject_editSubject', {'slug': subject.slug}) }}" method="post" class="fs-subject-action-form">
													<button type="submit" class="fs-subject-action fs-subject-action--edit" name="subjectToUpdate" data-bs-toggle="tooltip" title="{% trans %}Edit the subject {{ subject.subject }}{% endtrans %}">
														<i class="fe fe-edit"></i>
														<span>{% trans %}Edit{% endtrans %}</span>
													</button>
												</form>

												{% if subject.lessons|length > 0 %}
													<a class="fs-subject-action fs-subject-action--delete" href="javascript:void(0);"
														onclick="swal({
															'title': '{% trans %}Danger{% endtrans %}',
															'text': '{% trans %}Delete denied. This subject is allowed to lesson !{% endtrans %}',
															'type': 'error',
															'showCancelButton': true,
															'showConfirmButton': false,
															'confirmButtonText': false,
															'cancelButtonText': 'OK',
															'cancelButtonColor': '#088318'
														})">
														<i class="fe fe-trash"></i>
														<span>{% trans %}Delete{% endtrans %}</span>
													</a>
												{% else %}
													<a class="fs-subject-action fs-subject-action--delete" href="javascript:void(0);"
														onclick="swal({
															'title': '{% trans %}Warning !{% endtrans %}',
															'type': 'warning',
															'text': '{% trans %}Do you want to delete this subject ?{% endtrans %}',
															'showCancelButton': true,
															'confirmButtonText': '{% trans %}Yes{% endtrans %}',
															'confirmButtonColor': '#f00',
															'cancelButtonText': '{% trans %}No{% endtrans %}',
															'cancelButtonColor': '#186106',
															'confirmButtonPath': '{{ path('subject_deleteSubject', {'slug': subject.slug}) }} '});">
														<i class="fe fe-trash"></i>
														<span>{% trans %}Delete{% endtrans %}</span>
													</a>
												{% endif %}
											</div>
										</td>
									{% endif %}
								</tr>
							{% else %}
								<tr>
									<td colspan="{% if canManageSubjects %}5{% else %}4{% endif %}">
										<div class="fs-subject-empty">
											<i class="fe fe-folder"></i>
											<strong>{% trans %}No subject found{% endtrans %}</strong>
											<span>{% trans %}Start by creating a new subject.{% endtrans %}</span>
										</div>
									</td>
								</tr>
							{% endfor %}
						</tbody>
					</table>
				</div>

				<div class="fs-subject-table-footer">
					<div class="fs-subject-table-footer__left">
						<span id="fsSubjectResultCount"></span>
					</div>

					<div class="fs-subject-footer-controls">
						<label class="fs-subject-page-size">
							<span>{% trans %}Rows{% endtrans %}</span>
							<select id="fsSubjectRowsPerPage">
								<option value="5">5</option>
								<option value="10" selected>10</option>
								<option value="25">25</option>
								<option value="50">50</option>
							</select>
						</label>

						<div class="fs-subject-pagination" id="fsSubjectPagination" aria-label="{% trans %}Pagination{% endtrans %}"></div>
					</div>
				</div>
			</section>
		</div>
	</div>
{% endblock %}

{% block javascripts %}
	{{ parent() }}
	<script src="{{ asset('build/custom/js/freeschool-subject-display-premium.js') }}"></script>
{% endblock %}
